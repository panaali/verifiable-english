{
  "version": "ve-assurance-manifest@1",
  "spec": "docs/spec/assurance-manifest.md",
  "migration_plan": "docs/spec/SEMANTICS-MIGRATION-PLAN.md",
  "outcome_classes": {
    "verdict": "a checked semantic answer (Valid, Satisfied, Found, ALL, CONFLICT, Checked, ...)",
    "unknown": "semantic UNKNOWN: the checker ran to completion and bounded search or proof found neither answer",
    "rejection": "the input is invalid; a VEError code other than ResourceLimit",
    "budget": "ResourceLimit: a deterministic public work budget or structural cap was reached",
    "operational": "CheckerUnavailable: no verdict was obtained (backend missing or mismatched, crash, timeout, malformed output, or a migrated operation reached a non-authoritative engine); never a verdict, never UNKNOWN, never ResourceLimit"
  },
  "authorities": {
    "python": "Python produces the verdict; Lean and Rust are optional cross-checks or test oracles",
    "migrated": "Lean produces the verdict; every Python entry raises AuthorityViolation (CheckerUnavailable)",
    "lean-only": "no Python implementation may exist (migration plan section 6); under python authority the operation is CheckerUnavailable"
  },
  "trusted": {
    "lean:kernel": "Lean 4 kernel and the axioms propext, Classical.choice and Quot.sound; every theorem is audited against lean/axioms.txt by lean/audit.py",
    "lean:compiler": "Lean 4.24.0 compiler, runtime, standard library and IO of the compiled one-shot runners",
    "lean:decoders": "the hand-written JSON and wire decoders, canonical serializers and SHA-256 identity code listed under lean_decoders; no refinement theorem relates them to the wire specification (decoded models are proved admissible, decoded formulas are typed by the proved checker)",
    "lean:runner-glue": "lean/Main.lean, lean/NormsMain.lean and the dispatch in VE/Route/Run.lean, VE/Norms/Run.lean and VE/Order/ProfileGate.lean (partly pinned by route_gate and runEvaluationCaseReported_eq)",
    "lean:order-surface-parser": "VE/Order/Surface.lean, the order text parser; no round-trip theorem",
    "python:implementation": "the Python functions named in `python` produce the verdict while authority is python; conformance and three-way tests compare them with Lean and Rust, but no theorem covers them",
    "python:wire": "ve/wire.py canonical JSON and restricted decoding, and ve/identity.py SHA-256 identities",
    "python:backend-adapter": "ve/backends/lean.py case encoding and result classification, and the comparison of Lean rows with the expected acceptance in the calling function",
    "python:surface": "English, fluent and natural surface parsing and desugaring to ASTs, including the Earley all-derivations gate (the W7 round-trip proof is the separate remedy)",
    "python:display": "renderers, legends, explanations and diagnostic wording",
    "python:record-identity": "graph_id, record_id, bundle_id, report ids assembled in Python, and checker_build",
    "python:composition-rule": "argument.py reachability walk, leaf list and composed flag (class C until the Lean graph mode)",
    "python:readings-rule": "readings.py disjunction and shared-model premise assembly and the ALL/SOME/NONE relabelling (class C until Readings.lean)",
    "python:equivalence.compare": "the two-direction rule of equivalence.compare (class C, trusted and narrowed)",
    "python:argument-diagnostics": "CheckerConflict, ContradictoryPremises, Incomplete, ResourceLimit and InvalidInput statuses; display that asserts no consequence"
  },
  "reviewed_broad_handlers": {
    "ve/__main__.py:_main": "display only: an English rendering of an already computed record is omitted (`display_omitted`); the verdict fields are untouched",
    "ve/assist/api.py:call_tool": "CheckerUnavailable is caught first and keeps its code; other RuntimeErrors are logged as a rejected BackendError call, never a verdict",
    "ve/assist/cli.py:main": "CheckerUnavailable, raised or returned in an action or tool result (exit_code), exits 5 and the action is not saved; other failures print an error and exit 2",
    "ve/assist/proposer.py:_call": "the language-model backend boundary; a proposer failure is logged, and proposals are untrusted input that is checked afterwards",
    "ve/assist/recovery.py:RecoveryService._command": "the command error is journalled by exception type and re-raised or recorded; nothing is converted into a verdict",
    "ve/assist/recovery.py:RecoveryService._legacy_command": "as _command, for the legacy journal format",
    "ve/assist/recovery.py:RecoveryService._replay_inner": "journal replay: a recorded failure must recur; the comparison with the journal decides",
    "ve/assist/recovery.py:RecoveryService.request_proposer": "the language-model backend boundary; a failed proposal is an outcome of kind `failed`",
    "ve/assist/session.py:AssistSession.apply": "CheckerUnavailable is caught with VEError and keeps its code; other RuntimeErrors are logged as BackendError",
    "ve/assist/session.py:AssistSession.paraphrase_formula": "display only: falls back to the canonical rendering",
    "ve/natural.py:render_natural_sentence": "display only: selects an English wording whose one-reading audit passes",
    "ve/printer.py:natural_document": "display only: retries with a different wording and re-raises when that fails too",
    "ve/stream_audit.py:decoded_views": "decoder audit of text: a crashing decoder yields no view, which is the conservative outcome"
  },
