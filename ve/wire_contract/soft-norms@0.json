      "summary": "unsupported profile"
    },
    "SOFT_INVALID_ARRAY": {
      "class": "InvalidInput",
      "summary": "invalid array"
    },
    "SOFT_INVALID_RULE_FIELDS": {
      "class": "InvalidInput",
      "summary": "invalid rule fields"
    },
    "SOFT_INVALID_INPUT": {
      "class": "InvalidInput",
      "summary": "invalid input"
    }
  },
  "residual": "SOFT_INVALID_INPUT",
  "phases": [
    {
      "name": "envelope",
      "checks": [
        {
          "id": "1.1",
          "kind": "exact_keys",
          "at": "/environment",
          "keys": [
            "language",
            "profiles",
            "spec_revision",
            "vocabulary"
          ],
          "code": "SOFT_INVALID_INPUT",
          "text": "InvalidInput: invalid environment envelope"
        },
        {
          "id": "1.2",
          "kind": "const",
          "at": "/environment/language",
          "value": "ve.core@0.2",
          "code": "SOFT_UNSUPPORTED_PROFILE",
          "text": "UnsupportedProfile: Unsupported language"
        },
        {
          "id": "1.3",
          "kind": "type",
          "at": "/environment/profiles",
          "type": {
            "array_of": "string"
          },
          "code": "SOFT_UNSUPPORTED_PROFILE",
          "text": "UnsupportedProfile: profiles must be a sorted unique array"
        },
        {
          "id": "1.4",
          "kind": "const",
          "at": "/environment/spec_revision",
          "value": "ve-v0.2-expand2-2026-09-25",
          "code": "SOFT_UNSUPPORTED_PROFILE",
          "text": "UnsupportedProfile: Unsupported specification revision"
        },
        {
          "id": "1.5a",
          "kind": "keys",
          "at": "/environment/vocabulary",
          "required": [
            "sorts",
            "predicates",
            "constants"
          ],
          "optional": [
            "soft"
          ],
          "code": "SOFT_INVALID_INPUT",
          "text": "InvalidInput: invalid vocabulary"
        },
        {
          "id": "1.5b",
          "kind": "type",
          "at": "/environment/vocabulary/sorts",
          "type": "object",
          "code": "SOFT_INVALID_INPUT",
          "text": "InvalidInput: invalid vocabulary"
        },
        {
          "id": "1.5c",
          "kind": "type",
          "at": "/environment/vocabulary/predicates",
          "type": "object",
          "code": "SOFT_INVALID_INPUT",
          "text": "InvalidInput: invalid vocabulary"
        },
        {
          "id": "1.5d",
          "kind": "type",
          "at": "/environment/vocabulary/constants",
          "type": "object",
          "code": "SOFT_INVALID_INPUT",
          "text": "InvalidInput: invalid vocabulary"
        },
        {
          "id": "1.6",
          "kind": "type",
          "at": "/norms",
          "type": "array",
          "code": "SOFT_INVALID_INPUT",
          "text": "InvalidInput: expected an array of norm objects"
        },
        {
          "id": "1.7",
          "kind": "max_items",
          "at": "/norms",
          "limit": "MAX_RULES",
          "code": "SOFT_RESOURCE_LIMIT",
          "text": "ResourceLimit: rules"
        }
      ]
    },
    {
      "name": "declarations",
      "checks": [
        {
          "id": "pred-name",
          "each": "/environment/vocabulary/predicates/*",
          "checks": [
            {
              "id": "2.1a",
              "kind": "name",
              "at": "@",
              "on": "key",
              "class": "not_soft_reserved",
              "code": "SOFT_INVALID_NAME",
              "text": "InvalidInput: invalid soft name {key}"
            },
            {
              "id": "2.1b",
              "kind": "name",
              "at": "@",
              "on": "key",
              "class": "no_double_underscore",
              "when": [
                {
                  "present": "@/regulated"
                }
              ],
              "code": "SOFT_INVALID_NAME",
              "text": "InvalidInput: invalid soft name {key}"
            }
          ]
        },
        {
          "id": "pred-instruction",
          "each": "/environment/vocabulary/predicates/*",
          "checks": [
            {
              "id": "2.2a",
              "kind": "type",
              "at": "@/instruction_of",
              "type": "string",
              "code": "SOFT_INVALID_INPUT",
              "text": "InvalidInput: instruction_of on {key}"
            },
            {
              "id": "2.2b",
              "kind": "excludes",
              "at": "@",
              "member": "regulated",
              "when": [
                {
                  "present": "@/instruction_of"
                }
              ],
              "code": "SOFT_INVALID_INPUT",
              "text": "InvalidInput: instruction_of on {key}"
            },
            {
              "id": "2.2c",
              "kind": "excludes",
              "at": "@",
              "member": "defined",
              "when": [
                {
                  "present": "@/instruction_of"
                }
              ],
              "code": "SOFT_INVALID_INPUT",
              "text": "InvalidInput: instruction_of on {key}"
            }
          ]
        },
        {
          "id": "2.3",
          "kind": "hook",
          "at": "/environment",
          "hook": "w1_declarations",
          "returns": [
            "message"
          ],
          "inherited": true,
          "says": "W1's environment decoder accepts `/environment` with `instruction_of` removed from every predicate, `soft` removed from the vocabulary, and the profiles reduced to `norms@0`, `relational-fol@0` and those of `data@0`, `definitions@0`, `documents@1` and `time@0` that it lists.",
          "code": "SOFT_INVALID_INPUT",
          "text": "{message}"
        },
        {
          "id": "2.4",
          "kind": "keys",
          "at": "/environment/vocabulary/soft",
          "required": [
            "outranking"
          ],
          "optional": [
            "parties",
            "ranks",
            "outranks",
            "ties",
            "exception_decider"
          ],
          "code": "SOFT_INVALID_BLOCK",
          "text": "InvalidInput: invalid soft block"
        },
        {
          "id": "2.5",
          "kind": "type",
          "at": "/environment/vocabulary/soft/parties",
          "type": "array",
          "code": "SOFT_INVALID_ARRAY",
          "text": "InvalidInput: parties must be an array"
        },
        {
          "id": "2.6",
          "kind": "max_items",
          "at": "/environment/vocabulary/soft/parties",
          "limit": "MAX_SOFT_PARTIES",
          "code": "SOFT_RESOURCE_LIMIT",
          "text": "ResourceLimit: parties"
        },
        {
          "id": "parties",
          "each": "/environment/vocabulary/soft/parties/*",
          "checks": [
            {
              "id": "2.7a",
              "kind": "name",
              "class": "soft_name",
              "code": "SOFT_INVALID_NAME",
              "text": "InvalidInput: invalid soft name {value}"
            },
            {
              "id": "2.7b",
              "kind": "unique_so_far",
              "code": "SOFT_DUPLICATE_DECLARATION",
              "text": "DuplicateDeclaration: party {value}"
            }
          ]
        },
        {
          "id": "2.8a",
          "kind": "type",
          "at": "/environment/vocabulary/soft/ranks",
          "type": "array",
          "code": "SOFT_INVALID_ARRAY",
          "text": "InvalidInput: ranks must be an array"
        },
        {
          "id": "2.8b",
          "kind": "max_items",
          "at": "/environment/vocabulary/soft/ranks",
          "limit": "MAX_SOFT_RANKS",
          "code": "SOFT_RESOURCE_LIMIT",
          "text": "ResourceLimit: ranks"
        },
        {
          "id": "ranks",
          "each": "/environment/vocabulary/soft/ranks/*",
          "checks": [
            {
              "id": "2.8c",
              "kind": "name",
              "class": "soft_name",
              "code": "SOFT_INVALID_NAME",
              "text": "InvalidInput: invalid soft name {value}"
            },
            {
              "id": "2.8d",
              "kind": "unique_so_far",
              "code": "SOFT_DUPLICATE_DECLARATION",
              "text": "DuplicateDeclaration: rank {value}"
            }
          ]
        },
        {
          "id": "2.9a",
          "kind": "keys",
          "at": "/environment/vocabulary/soft/outranking",
          "required": [
            "mode"
          ],
          "optional": [
            "decided_by"
          ],
          "code": "SOFT_INVALID_OUTRANKING",
          "text": "InvalidInput: invalid outranking flag"
        },
        {
          "id": "2.9b",
          "kind": "enum",
          "at": "/environment/vocabulary/soft/outranking/mode",
          "values": [
            "strict",
            "holistic"
          ],
          "code": "SOFT_INVALID_OUTRANKING",
          "text": "InvalidInput: invalid outranking flag"
        },
        {
          "id": "2.10",
          "kind": "excludes",
          "at": "/environment/vocabulary/soft/outranking",
          "member": "decided_by",
          "when": [
            {
              "equals": [
                "/environment/vocabulary/soft/outranking/mode",
                "strict"
              ]
            }
          ],
          "code": "SOFT_STRICT_OUTRANKING_DECIDER",
          "text": "InvalidInput: strict outranking has no decider"
        },
        {
          "id": "2.11",
          "kind": "type",
          "at": "/environment/vocabulary/soft/outranking/decided_by",
          "type": "string",
          "code": "SOFT_INVALID_DECIDER",
          "text": "InvalidInput: invalid decider for outranking"
        },
        {
          "id": "2.12",
          "kind": "requires",
          "at": "/environment/vocabulary/soft/outranking",
          "member": "decided_by",
          "when": [
            {
              "equals": [
                "/environment/vocabulary/soft/outranking/mode",
                "holistic"
              ]
            }
          ],
          "code": "SOFT_MISSING_DECIDER",
          "text": "MissingExceptionDecider: outranking"
        },
        {
          "id": "2.13",
          "kind": "name",
          "at": "/environment/vocabulary/soft/outranking/decided_by",
          "class": "decider",
          "code": "SOFT_INVALID_DECIDER",
          "text": "InvalidInput: invalid decider for outranking"
        },
        {
          "id": "2.14",
          "kind": "name",
          "at": "/environment/vocabulary/soft/exception_decider",
          "class": "decider",
          "code": "SOFT_INVALID_DECIDER",
          "text": "InvalidInput: invalid decider for exception"
        },
        {
          "id": "2.15",
          "kind": "type",
          "at": "/environment/vocabulary/soft/outranks",
          "type": "array",
          "code": "SOFT_INVALID_ARRAY",
          "text": "InvalidInput: outranks must be an array"
        },
        {
          "id": "outranks",
          "each": "/environment/vocabulary/soft/outranks/*",
          "checks": [
            {
              "id": "2.16a",
              "kind": "type",
              "type": {
                "tuple": [
                  "string",
                  "string"
                ]
              },
              "code": "SOFT_INVALID_OUTRANKS_PAIR",
              "text": "InvalidInput: invalid outranks pair"
            },
            {
              "id": "outranks-pair",
              "each": "@/*",
              "checks": [
                {
                  "id": "2.16b",
                  "kind": "unique_so_far",
                  "code": "SOFT_INVALID_OUTRANKS_PAIR",
                  "text": "InvalidInput: invalid outranks pair"
                }
              ]
            },
            {
              "id": "2.16c",
              "kind": "unique_so_far",
              "code": "SOFT_INVALID_OUTRANKS_PAIR",
              "text": "InvalidInput: invalid outranks pair"
            }
          ]
        },
        {
          "id": "2.17a",
          "kind": "type",
          "at": "/environment/vocabulary/soft/ties",
          "type": "array",
          "code": "SOFT_INVALID_ARRAY",
          "text": "InvalidInput: ties must be an array"
        },
        {
          "id": "ties",
          "each": "/environment/vocabulary/soft/ties/*",
          "checks": [
            {
              "id": "2.17b",
              "kind": "type",
              "type": {
                "tuple": [
                  "string",
                  "string"
                ]
              },
              "code": "SOFT_INVALID_TIES_PAIR",
              "text": "InvalidInput: invalid ties pair"
            },
            {
              "id": "ties-pair",
              "each": "@/*",
              "checks": [
                {
                  "id": "2.17c",
                  "kind": "unique_so_far",
                  "code": "SOFT_INVALID_TIES_PAIR",
                  "text": "InvalidInput: invalid ties pair"
                }
              ]
            },
            {
              "id": "2.17d",
              "kind": "unique_so_far",
              "code": "SOFT_INVALID_TIES_PAIR",
              "text": "InvalidInput: invalid ties pair"
            }
          ]
        }
      ]
    },
    {
      "name": "profiles",
      "checks": [
        {
          "id": "3.1",
          "kind": "sorted_unique",
          "at": "/environment/profiles",
          "code": "SOFT_UNSUPPORTED_PROFILE",
          "text": "UnsupportedProfile: profiles must be sorted and unique"
        },
        {
          "id": "profile-items",
          "each": "/environment/profiles/*",
          "checks": [
            {
              "id": "3.2",
              "kind": "hook",
              "hook": "profile_registered",
              "says": "The item is one of `closure@0`, `data@0`, `definitions@0`, `documents@1`, `nary@0`, `norms@0`, `order@0`, `relational-fol@0`, `soft-norms@0` and `time@0`.",
              "code": "SOFT_UNSUPPORTED_PROFILE",
              "text": "UnsupportedProfile: Unsupported profile {value}"
            }
          ]
        },
        {
          "id": "3.3a",
          "kind": "requires",
          "at": "/environment/profiles",
          "item": "relational-fol@0",
          "code": "SOFT_UNSUPPORTED_PROFILE",
          "text": "UnsupportedProfile: Missing profile relational-fol@0"
        },
        {
          "id": "3.3b",
          "kind": "requires",
          "at": "/environment/profiles",
          "item": "soft-norms@0",
          "code": "SOFT_UNSUPPORTED_PROFILE",
          "text": "UnsupportedProfile: soft-norms@0 is required"
        },
        {
          "id": "3.3c",
          "kind": "requires",
          "at": "/environment/profiles",
          "item": "norms@0",
          "code": "SOFT_UNSUPPORTED_PROFILE",
          "text": "UnsupportedProfile: soft-norms@0 requires norms@0"
        },
        {
          "id": "3.4a",
          "kind": "excludes",
          "at": "/environment/profiles",
          "item": "closure@0",
          "code": "SOFT_UNSUPPORTED_PROFILE",
          "text": "UnsupportedProfile: the norms route admits FOL documents only"
        },
        {
          "id": "3.4b",
          "kind": "excludes",
          "at": "/environment/profiles",
          "item": "nary@0",
          "code": "SOFT_UNSUPPORTED_PROFILE",
          "text": "UnsupportedProfile: the norms route admits FOL documents only"
        },
        {
          "id": "3.4c",
          "kind": "excludes",
          "at": "/environment/profiles",
          "item": "order@0",
          "code": "SOFT_UNSUPPORTED_PROFILE",
          "text": "UnsupportedProfile: the norms route admits FOL documents only"
        },
        {
          "id": "3.5a",
          "kind": "hook",
          "at": "/environment/vocabulary/predicates",
          "hook": "no_definitions",
          "says": "No predicate has a definition.",
          "code": "SOFT_UNSUPPORTED_PROFILE",
          "text": "UnsupportedProfile: norms route with definitions is not implemented"
        },
        {
          "id": "3.5b",
          "kind": "hook",
          "at": "/environment/vocabulary/predicates",
          "hook": "no_data_flags",
          "says": "No predicate has a functional or total data flag.",
          "code": "SOFT_UNSUPPORTED_PROFILE",
          "text": "UnsupportedProfile: norms route with data flags is not implemented"
        }
      ]
    },
    {
      "name": "rule-fields",
      "checks": [
        {
          "id": "rules-fields",
          "each": "/norms/*",
          "checks": [
            {
              "id": "4.1a",
              "kind": "exact_keys",
              "at": "@",
              "keys": [
                "norm"
              ],
              "code": "SOFT_INVALID_INPUT",
              "text": "InvalidInput: expected norm object"
            },
            {
              "id": "4.1b",
              "kind": "type",
              "at": "@/norm",
              "type": "object",
              "code": "SOFT_INVALID_INPUT",
              "text": "InvalidInput: expected norm object"
            },
            {
              "id": "4.1c",
              "kind": "keys",
              "at": "@/norm",
              "required": [
                "name",
                "predicate",
                "sign",
                "guard",
                "unless",
                "over"
              ],
              "optional": [
                "mode",
                "rank",
                "alterable",
                "exception",
                "hard"
              ],
              "code": "SOFT_INVALID_INPUT",
              "text": "InvalidInput: invalid norm fields"
            },
            {
              "id": "4.2a",
              "kind": "hook",
              "at": "@/norm",
              "hook": "w1_rule_fields",
              "returns": [
                "message"
              ],
              "inherited": true,
              "says": "W1's rule decoder accepts the item's `norm` restricted to `name`, `predicate`, `sign`, `guard`, `unless` and `over`, its `name` is a rule name, and it has at most 8 carve-outs.",
              "code": "SOFT_INVALID_INPUT",
              "text": "{message}"
            },
            {
              "id": "over-names",
              "each": "@/norm/over/*",
              "checks": [
                {
                  "id": "4.2b",
                  "kind": "unique_so_far",
                  "args": {
                    "name": "@1/norm/name"
                  },
                  "code": "SOFT_INVALID_INPUT",
                  "text": "InvalidInput: duplicate over {value} in rule {name}"
                }
              ]
            },
            {
              "id": "4.3",
              "kind": "enum",
              "at": "@/norm/mode",
              "values": [
                "strict",
                "default"
              ],
              "args": {
                "name": "@/norm/name"
              },
              "code": "SOFT_INVALID_RULE_FIELDS",
              "text": "InvalidInput: invalid mode for rule {name}"
            },
            {
              "id": "4.4",
              "kind": "type",
              "at": "@/norm/rank",
              "type": [
                "null",
                "string"
              ],
              "args": {
                "name": "@/norm/name"
              },
              "code": "SOFT_INVALID_RULE_FIELDS",
              "text": "InvalidInput: invalid soft fields for {name}"
            },
            {
              "id": "4.5a",
              "kind": "type",
              "at": "@/norm/alterable",
              "type": {
                "array_of": "string"
              },
              "args": {
                "name": "@/norm/name"
              },
              "code": "SOFT_INVALID_ALTERABLE",
              "text": "InvalidInput: alterable of rule {name} must be sorted and distinct"
            },
            {
              "id": "4.5b",
              "kind": "sorted_unique",
              "at": "@/norm/alterable",
              "args": {
                "name": "@/norm/name"
              },
              "code": "SOFT_INVALID_ALTERABLE",
              "text": "InvalidInput: alterable of rule {name} must be sorted and distinct"
            },
            {
              "id": "4.6",
              "kind": "type",
              "at": "@/norm/hard",
              "type": "boolean",
              "args": {
                "name": "@/norm/name"
              },
              "code": "SOFT_INVALID_RULE_FIELDS",
              "text": "InvalidInput: hard of rule {name} must be Boolean"
            },
            {
              "id": "4.7a",
              "kind": "enum",
              "at": "@/norm/mode",
              "values": [
                "strict"
              ],
              "when": [
                {
                  "equals": [
                    "@/norm/hard",
                    true
                  ]
                }
              ],
              "args": {
                "name": "@/norm/name"
              },
              "code": "SOFT_HARD_CONSTRAINT",
              "text": "HardConstraintAltered: rule {name}"
            },
            {
              "id": "4.7b",
              "kind": "max_items",
              "at": "@/norm/alterable",
              "limit": 0,
              "when": [
                {
                  "equals": [
                    "@/norm/hard",
                    true
                  ]
                }
              ],
              "args": {
                "name": "@/norm/name"
              },
              "code": "SOFT_HARD_CONSTRAINT",
              "text": "HardConstraintAltered: rule {name}"
            },
            {
              "id": "4.8",
              "kind": "type",
              "at": "@/norm/exception",
              "type": "null",
              "when": [
                {
                  "differs": [
                    "@/norm/mode",
                    "default"
                  ]
                }
              ],
              "args": {
                "name": "@/norm/name"
              },
              "code": "SOFT_STRICT_EXCEPTION",
              "text": "InvalidInput: rule {name} is strict and declares an exception"
            },
            {
