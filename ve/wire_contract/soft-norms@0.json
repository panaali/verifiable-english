    },
    "SOFT_INVALID_OUTRANKS_PAIR": {
      "class": "InvalidInput",
      "summary": "invalid outranks pair"
    },
    "SOFT_INVALID_BLOCK": {
      "class": "InvalidInput",
      "summary": "invalid block"
    },
