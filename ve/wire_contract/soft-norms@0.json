    },
    "SOFT_TIE_AGAINST_ORDER": {
      "class": "InvalidInput",
      "summary": "tie against order"
    },
    "SOFT_DEPENDENCY_CYCLE": {
      "class": "InvalidInput",
      "summary": "dependency cycle"
    },
    "SOFT_UNKNOWN_PARTY": {
      "class": "UnknownSymbol",
      "summary": "unknown party"
    },
    "SOFT_STRICT_EXCEPTION": {
      "class": "InvalidInput",
      "summary": "strict exception"
    },
    "SOFT_EXCEPTION_ARRAY": {
      "class": "InvalidInput",
      "summary": "exception array"
    },
    "SOFT_INVALID_FACTORS": {
      "class": "InvalidInput",
      "summary": "invalid factors"
    },
    "SOFT_INVALID_ALTERABLE": {
      "class": "InvalidInput",
      "summary": "invalid alterable"
    },
    "SOFT_HARD_CONSTRAINT": {
      "class": "InvalidInput",
      "summary": "hard constraint"
    },
    "SOFT_INVALID_EXCEPTION_CONDITION": {
      "class": "InvalidInput",
      "summary": "invalid exception condition"
    },
    "SOFT_OVER_HARD": {
      "class": "InvalidInput",
      "summary": "over hard"
    },
