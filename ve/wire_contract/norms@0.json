{
  "contract": "norms@0",
  "revision": 1,
  "format": 1,
  "status": "shadow",
  "input": [
    "environment",
    "norms"
  ],
  "adapter": "norm_source",
  "uses": [
    "limits",
    "names"
  ],
  "codes": {
    "NORMS_INVALID_ENVIRONMENT": {
      "class": "InvalidInput",
      "summary": "invalid environment"
    },
    "NORMS_PROFILE_REQUIRED": {
      "class": "InvalidInput",
      "summary": "profile required"
    },
    "NORMS_INVALID_UNIT": {
      "class": "InvalidInput",
      "summary": "invalid unit"
    },
    "NORMS_INVALID_RULE_FIELDS": {
      "class": "InvalidInput",
      "summary": "invalid rule fields"
    },
    "NORMS_INVALID_NAME": {
      "class": "InvalidInput",
      "summary": "invalid name"
    },
    "NORMS_RESERVED_NAME": {
      "class": "InvalidInput",
      "summary": "reserved name"
    },
    "NORMS_UNKNOWN_PREDICATE": {
      "class": "InvalidInput",
      "summary": "unknown predicate"
    },
    "NORMS_UNKNOWN_RULE": {
      "class": "InvalidInput",
      "summary": "unknown rule"
    },
    "NORMS_PRECEDENCE_ACROSS_PREDICATES": {
      "class": "InvalidInput",
      "summary": "precedence across predicates"
    },
    "NORMS_DEPENDENCY_CYCLE": {
      "class": "InvalidInput",
      "summary": "dependency cycle"
    },
    "NORMS_INVALID_INPUT": {
      "class": "InvalidInput",
      "summary": "invalid input"
    },
    "NORMS_INVALID_FORMULA": {
      "class": "SyntaxError",
      "summary": "invalid formula"
    },
    "NORMS_DUPLICATE_DECLARATION": {
      "class": "DuplicateDeclaration",
      "summary": "duplicate declaration"
    },
    "NORMS_TYPE_MISMATCH": {
      "class": "TypeMismatch",
      "summary": "type mismatch"
    },
    "NORMS_UNKNOWN_SYMBOL": {
      "class": "UnknownSymbol",
      "summary": "unknown symbol"
    },
    "NORMS_UNBOUND_VARIABLE": {
      "class": "UnboundVariable",
      "summary": "unbound variable"
    },
    "NORMS_RESOURCE_LIMIT": {
      "class": "ResourceLimit",
      "summary": "resource limit"
    },
    "NORMS_UNSUPPORTED_PROFILE": {
      "class": "UnsupportedProfile",
      "summary": "unsupported profile"
    }
  },
  "residual": "NORMS_INVALID_INPUT",
  "phases": [
    {
      "name": "environment",
      "checks": [
        {
          "id": "1.1",
          "kind": "hook",
          "at": "/environment",
          "hook": "w1_environment",
          "returns": [
            "message"
          ],
          "inherited": true,
          "says": "W1's environment decoder accepts `/environment`: the route's decoder when `/environment/profiles` lacks `norms@0`, and the norms route's decoder when it lists `norms@0`, applied to the placeholder environment when it also lists `norm-defaults@0`.",
          "code": "NORMS_INVALID_ENVIRONMENT",
          "text": "{message}"
        }
      ]
    },
    {
      "name": "profiles",
      "checks": [
        {
          "id": "2.1",
          "kind": "requires",
          "at": "/environment/profiles",
          "item": "norms@0",
          "code": "NORMS_PROFILE_REQUIRED",
          "text": "UnsupportedProfile: norms@0 is required"
        },
        {
          "id": "2.2",
          "kind": "max_items",
          "at": "/norms",
          "limit": "MAX_RULES",
          "code": "NORMS_RESOURCE_LIMIT",
          "text": "ResourceLimit: rules"
        }
      ]
    },
    {
      "name": "rule-shape",
      "checks": [
        {
          "id": "units",
          "each": "/norms/*",
          "checks": [
            {
              "id": "3.1",
              "kind": "exact_keys",
              "at": "@",
              "keys": [
                "norm"
              ],
              "code": "NORMS_INVALID_UNIT",
              "text": "InvalidInput: expected norm object"
            },
            {
              "id": "3.2",
              "kind": "type",
              "at": "@/norm",
              "type": "object",
              "code": "NORMS_INVALID_UNIT",
              "text": "InvalidInput: expected norm object"
            },
            {
              "id": "3.3",
              "kind": "exact_keys",
              "at": "@/norm",
              "keys": [
                "name",
                "predicate",
                "sign",
                "guard",
                "unless",
                "over"
              ],
              "code": "NORMS_INVALID_RULE_FIELDS",
              "text": "InvalidInput: invalid norm fields"
            },
            {
              "id": "3.4",
              "kind": "type",
              "at": "@/norm/unless",
              "type": "array",
              "code": "NORMS_INVALID_RULE_FIELDS",
              "text": "InvalidInput: unless and over must be arrays"
            },
            {
              "id": "3.5",
              "kind": "type",
              "at": "@/norm/over",
              "type": "array",
              "code": "NORMS_INVALID_RULE_FIELDS",
              "text": "InvalidInput: unless and over must be arrays"
            },
            {
              "id": "3.6",
              "kind": "type",
              "at": "@/norm/predicate",
              "type": "string",
              "code": "NORMS_INVALID_RULE_FIELDS",
              "text": "InvalidInput: rule predicate and precedence edges must be strings"
            },
            {
              "id": "parents",
              "each": "@/norm/over/*",
              "checks": [
                {
                  "id": "3.7",
                  "kind": "type",
                  "type": "string",
                  "code": "NORMS_INVALID_RULE_FIELDS",
                  "text": "InvalidInput: rule predicate and precedence edges must be strings"
                }
              ]
            },
            {
              "id": "guard-syntax",
              "kind": "classifier",
              "classifier": "guard_syntax",
              "at": "@/norm/guard",
              "emits": [
                {
                  "id": "3.8a",
                  "code": "NORMS_RESOURCE_LIMIT",
                  "text": "{message}",
                  "returns": [
                    "message"
                  ],
                  "inherited": true,
                  "says": "The item's `norm/guard` decodes as one formula within the rule's node and depth budget."
                },
                {
                  "id": "3.8b",
                  "code": "NORMS_INVALID_FORMULA",
                  "text": "{message}",
                  "returns": [
                    "message"
                  ],
                  "inherited": true,
                  "says": "The item's `norm/guard` is built from the first-order tags of the P0 wire form, each with its number of members and its variable indices in range."
                }
              ]
            },
            {
              "id": "carve-outs",
              "each": "@/norm/unless/*",
              "checks": [
                {
                  "id": "carve-out-syntax",
                  "kind": "classifier",
                  "classifier": "carve_out_syntax",
                  "at": "@",
                  "emits": [
                    {
                      "id": "3.9a",
                      "code": "NORMS_RESOURCE_LIMIT",
                      "text": "{message}",
                      "returns": [
                        "message"
                      ],
                      "inherited": true,
                      "says": "The item decodes as one formula within the budget that the enclosing item's `norm/guard` and the earlier carve-outs have used."
                    },
                    {
                      "id": "3.9b",
                      "code": "NORMS_INVALID_FORMULA",
                      "text": "{message}",
                      "returns": [
                        "message"
                      ],
                      "inherited": true,
                      "says": "The item is built from the first-order tags of the P0 wire form, each with its number of members and its variable indices in range."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "rules",
      "checks": [
        {
          "id": "rules",
          "each": "/norms/*",
          "checks": [
            {
              "id": "4.1",
              "kind": "name",
              "at": "@/norm/name",
              "class": "rule_name",
              "code": "NORMS_INVALID_NAME",
              "text": "InvalidInput: invalid rule name '{value}'"
            },
            {
              "id": "4.2",
              "kind": "unique_so_far",
              "at": "@/norm/name",
              "code": "NORMS_DUPLICATE_DECLARATION",
              "text": "DuplicateDeclaration: rule {value}"
            },
            {
              "id": "4.3",
              "kind": "hook",
              "at": "@/norm/name",
              "hook": "rule_name_not_reserved",
              "says": "When `/environment/profiles` contains `norm-defaults@0`: the item's `norm/name` does not start with `unsaid--`.",
              "code": "NORMS_RESERVED_NAME",
              "text": "InvalidInput: reserved name {value}"
            },
            {
              "id": "4.4",
              "kind": "hook",
              "at": "@/norm/predicate",
              "hook": "regulated_predicate",
              "says": "The predicate named by the item's `norm/predicate` is declared with `regulated`.",
              "code": "NORMS_UNKNOWN_PREDICATE",
              "text": "UnknownSymbol: regulated predicate {value}"
            },
            {
              "id": "4.5",
              "kind": "type",
              "at": "@/norm/sign",
              "type": "boolean",
              "code": "NORMS_INVALID_RULE_FIELDS",
              "text": "InvalidInput: invalid sign or too many carve-outs"
            },
            {
              "id": "4.6",
              "kind": "max_items",
              "at": "@/norm/unless",
              "limit": "MAX_CARVE_OUTS",
              "code": "NORMS_INVALID_RULE_FIELDS",
              "text": "InvalidInput: invalid sign or too many carve-outs"
            },
            {
              "id": "rule-typing",
              "kind": "classifier",
              "classifier": "rule_typing",
              "at": "@",
              "emits": [
                {
                  "id": "4.7a",
                  "code": "NORMS_TYPE_MISMATCH",
                  "text": "{message}",
                  "returns": [
                    "message"
                  ],
                  "inherited": true,
                  "says": "The item's `norm/guard` and then each of its `norm/unless` are well typed over the sorts of its predicate; the fault is a type mismatch."
                },
                {
                  "id": "4.7b",
                  "code": "NORMS_UNKNOWN_SYMBOL",
                  "text": "{message}",
                  "returns": [
                    "message"
                  ],
                  "inherited": true,
                  "says": "The item's `norm/guard` and then each of its `norm/unless` are well typed over the sorts of its predicate; the fault is a predicate, constant or binder sort that is not a declared name."
                },
                {
                  "id": "4.7c",
                  "code": "NORMS_UNBOUND_VARIABLE",
                  "text": "{message}",
                  "returns": [
                    "message"
                  ],
                  "inherited": true,
                  "says": "The item's `norm/guard` and then each of its `norm/unless` are well typed over the sorts of its predicate; the fault is a variable index outside its scope."
                },
                {
                  "id": "4.7d",
                  "code": "NORMS_RESOURCE_LIMIT",
                  "text": "{message}",
                  "returns": [
                    "message"
                  ],
                  "inherited": true,
                  "says": "The guards and carve-outs of the `rules` items up to and including this one together have at most 10,000 nodes."
                },
                {
                  "id": "4.7e",
                  "code": "NORMS_UNSUPPORTED_PROFILE",
                  "text": "{message}",
                  "returns": [
                    "message"
                  ],
                  "inherited": true,
                  "says": "The item's `norm/guard` and then each of its `norm/unless` are well typed over the sorts of its predicate; the fault is a binder of sort `$string` under `data@0`."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "references",
      "checks": [
        {
          "id": "rule-refs",
          "each": "/norms/*",
          "checks": [
            {
              "id": "over-refs",
              "each": "@/norm/over/*",
              "checks": [
                {
                  "id": "5.1",
                  "kind": "declared_in",
                  "set": "/norms/*/norm/name",
                  "code": "NORMS_UNKNOWN_RULE",
                  "text": "UnknownRule: rule {value}"
                },
                {
                  "id": "5.2",
                  "kind": "hook",
                  "hook": "over_same_predicate",
                  "returns": [
                    "rule",
                    "predicate",
                    "parent_predicate"
                  ],
                  "says": "The rule named by the item has the same `predicate` as the enclosing item's rule.",
                  "code": "NORMS_PRECEDENCE_ACROSS_PREDICATES",
                  "text": "PrecedenceAcrossPredicates: rule {rule} on {predicate}, rule {value} on {parent_predicate}"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "semantic",
      "checks": [
        {
          "id": "6.1",
          "kind": "hook",
          "at": "/norms",
          "hook": "precedence_acyclic",
          "returns": [
            "detail"
          ],
          "says": "The precedence graph over `/norms`, with an edge from each rule to each rule its `over` names, is acyclic.",
          "code": "NORMS_DEPENDENCY_CYCLE",
          "text": "DependencyCycle: {detail}"
        },
        {
          "id": "6.2",
          "kind": "hook",
          "at": "/norms",
          "hook": "precedence_depth_fits",
          "says": "Every rule's precedence height, which is 1 for a rule that no rule names in `over` and otherwise 1 more than the greatest height of the rules that name it, is at most 16.",
          "code": "NORMS_RESOURCE_LIMIT",
          "text": "ResourceLimit: precedence depth"
        },
        {
          "id": "6.3",
          "kind": "hook",
          "at": "/norms",
          "hook": "layers_acyclic",
          "returns": [
            "detail"
          ],
          "says": "The graph over the regulated predicates, with an edge from a rule's predicate to each regulated predicate its guard or carve-outs mention, is acyclic.",
          "code": "NORMS_DEPENDENCY_CYCLE",
          "text": "DependencyCycle: {detail}"
        }
      ]
    }
  ]
}
