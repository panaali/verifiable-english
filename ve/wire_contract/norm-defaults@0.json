{
  "contract": "norm-defaults@0",
  "revision": 1,
  "format": 1,
  "status": "shadow",
  "input": [
    "environment",
    "norms"
  ],
  "adapter": "norm_defaults_source",
  "uses": [
    "limits",
    "names",
    "norms@0"
  ],
  "codes": {
    "NORM_DEFAULTS_RESOURCE_LIMIT": {
      "class": "ResourceLimit",
      "summary": "resource limit"
    },
    "NORM_DEFAULTS_INVALID_INPUT": {
      "class": "InvalidInput",
      "summary": "invalid input"
    }
  },
  "residual": "NORM_DEFAULTS_INVALID_INPUT",
  "phases": [
    {
      "name": "environment",
      "checks": [
        {
          "id": "w1-environment",
          "kind": "include",
          "contract": "norms@0",
          "phases": [
            "environment"
          ]
        }
      ]
    },
    {
      "name": "rule-shape",
      "checks": [
        {
          "id": "w1-shape",
          "kind": "include",
          "contract": "norms@0",
          "phases": [
            "rule-shape"
          ]
        }
      ]
    },
    {
      "name": "norms",
      "checks": [
        {
          "id": "w1",
          "kind": "include",
          "contract": "norms@0",
          "phases": [
            "profiles",
            "rules",
            "references",
            "semantic"
          ]
        }
      ]
    },
    {
      "name": "limits",
      "checks": [
        {
          "id": "5.1",
          "kind": "hook",
          "hook": "filled_vocabulary_fits",
          "says": "The declared predicates and the unspecified predicates are together at most 256.",
          "code": "NORM_DEFAULTS_RESOURCE_LIMIT",
          "text": "ResourceLimit: vocabulary size"
        },
        {
          "id": "5.2",
          "kind": "hook",
          "hook": "filled_rules_fit",
          "says": "The rules of `/norms` and the unspecified predicates are together at most 256.",
          "code": "NORM_DEFAULTS_RESOURCE_LIMIT",
          "text": "ResourceLimit: rules"
        },
        {
          "id": "5.3",
          "kind": "hook",
          "hook": "unspecified_names_fit",
          "says": "Every unspecified predicate's name is at most 56 bytes long in UTF-8.",
          "code": "NORM_DEFAULTS_RESOURCE_LIMIT",
          "text": "ResourceLimit: unspecified name length"
        }
      ]
    },
    {
      "name": "fill",
      "checks": [
        {
          "id": "6.1",
          "kind": "hook",
          "hook": "filled_ast_fits",
          "says": "The guards and carve-outs of `/norms` and one fill guard per unspecified predicate together have at most 10,000 nodes.",
          "code": "NORM_DEFAULTS_RESOURCE_LIMIT",
          "text": "ResourceLimit: AST exceeds 10,000 nodes"
        },
        {
          "id": "6.2",
          "kind": "hook",
          "hook": "filled_precedence_depth_fits",
          "says": "Every rule on an unspecified predicate has precedence height at most 15.",
          "code": "NORM_DEFAULTS_RESOURCE_LIMIT",
          "text": "ResourceLimit: precedence depth"
        },
        {
          "id": "6.3",
          "kind": "hook",
          "hook": "fill_premises_fit",
          "returns": [
            "label"
          ],
          "says": "The pair premises of `Fill_T` together have at most 10,000 nodes, and each is at most 64 levels deep.",
          "code": "NORM_DEFAULTS_RESOURCE_LIMIT",
          "text": "ResourceLimit: fill premise {label}"
        }
      ]
    }
  ]
}
