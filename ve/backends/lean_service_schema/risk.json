{
  "$id": "risk.json",
  "$comment": "Mode risk: Risk.Run.runCaseReported (formerly ve_risk_route). A case on the risk path (usesRiskPath) is answered by the risk runner; every other case is delegated unchanged to the alternatives mode's runner.",
  "row": {"x-select": [
    {"when": {"$ref": "#/$defs/risk_path"}, "then": {"anyOf": [
      {"$ref": "common.json#/$defs/case_error"},
      {"$ref": "common.json#/$defs/route_path_error"},
      {"x-select": [
        {"when": {"$ref": "#/$defs/kind/admission"}, "then": {"$ref": "#/$defs/admission"}},
        {"when": {"$ref": "#/$defs/kind/risk-elaborate"}, "then": {"$ref": "#/$defs/elaborate"}},
        {"when": {"$ref": "#/$defs/kind/risk-decision"}, "then": {"$ref": "#/$defs/decision"}},
        {"when": {"allOf": [{"$ref": "#/$defs/kind/risk-conflict"}, {"required": ["witness"]}]},
         "then": {"$ref": "alternatives.json#/$defs/conflict_witness"}},
        {"when": {"$ref": "#/$defs/kind/risk-conflict"}, "then": {"$ref": "#/$defs/conflict"}},
        {"when": {"allOf": [{"$ref": "#/$defs/kind/risk-followable"}, {"required": ["witness"]}]},
         "then": {"$ref": "#/$defs/followable_witness"}},
        {"when": {"$ref": "#/$defs/kind/risk-followable"}, "then": {"$ref": "#/$defs/followable"}},
        {"when": {"$ref": "#/$defs/kind/risk-audit"}, "then": {"$ref": "#/$defs/audit"}},
        {"when": {"$ref": "#/$defs/kind/risk-certificate"}, "then": {"$ref": "#/$defs/certificate"}}]}]}},
    {"when": true, "then": {"$ref": "alternatives.json#/row"}}]},
  "$defs": {
    "risk_path": {"$comment": "Risk.Run.usesRiskPath: the risk@0 profile, the environment's risk block or a risk-* kind.",
      "type": "object", "anyOf": [
        {"required": ["environment"], "properties": {"environment": {
          "type": "object", "required": ["profiles"], "properties": {"profiles": {
            "type": "array", "contains": {"const": "risk@0"}}}}}},
        {"required": ["environment"], "properties": {"environment": {"type": "object", "required": ["risk"]}}},
        {"required": ["kind"], "properties": {"kind": {"type": "string", "pattern": "risk-.*"}}}]},
    "kind": {
      "admission": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "admission"}}},
      "risk-elaborate": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "risk-elaborate"}}},
      "risk-decision": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "risk-decision"}}},
      "risk-conflict": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "risk-conflict"}}},
      "risk-followable": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "risk-followable"}}},
      "risk-audit": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "risk-audit"}}},
      "risk-certificate": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "risk-certificate"}}}},
    "risk_labels": {"$comment": "Risk.Background.riskPremiseLabels.",
      "type": "array", "items": {"enum": ["risk:certain_possible", "risk:severity_closure", "risk:classes_distinct", "risk:order", "risk:class_functional", "risk:class"]}},
    "admission": {"$comment": "Risk.Run.encodeAdmitted: W2's admission answer, conditional on the source labels and the risk premises.",
      "type": "object", "required": ["id", "status", "admitted", "report", "report_id", "kinds", "conditional_on"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "status": {"const": "ok"},
        "admitted": {"const": true},
        "report": {"$ref": "common.json#/$defs/bound_report"},
        "report_id": {"$ref": "common.json#/$defs/hex64"},
        "kinds": {"type": "array", "items": {"$ref": "common.json#/$defs/kind"}, "x-equals": "/document/units/*/kind"},
        "conditional_on": {"$ref": "common.json#/$defs/strings"}}},
    "elaborate": {"$comment": "Risk.Wire.regenerated: the policy identities, E_risk's generated vocabulary, the legend, the risk premises, the unranked severity pairs, then the alternatives fields of the inlined tree and Norms.Wire.regenerated.",
      "type": "object", "required": ["id", "status", "environment_id", "document_hash", "e_risk", "legend", "risk_premises",
        "unranked_severities", "inlined", "alternatives", "base_premises", "followable", "unmapped_obligations", "order",
        "background", "premises", "conflict_targets", "fragment"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "status": {"const": "ok"},
        "environment_id": {"$ref": "common.json#/$defs/hex64"},
        "document_hash": {"$ref": "common.json#/$defs/hex64"},
        "e_risk": {"type": "object", "required": ["sort", "classes", "predicates", "words"], "additionalProperties": false,
          "properties": {
            "sort": {"type": "string"},
            "classes": {"$ref": "common.json#/$defs/strings"},
            "predicates": {"type": "object", "additionalProperties": {"$ref": "common.json#/$defs/strings"}},
            "words": {"type": "object", "required": ["risk__or_worse", "risk__less_worst"], "additionalProperties": false,
              "properties": {"risk__or_worse": {"$ref": "common.json#/$defs/string_pair"},
                             "risk__less_worst": {"$ref": "common.json#/$defs/string_pair"}}}}},
        "legend": {"$ref": "common.json#/$defs/nonempty_strings"},
        "risk_premises": {"type": "array", "items": {"$ref": "common.json#/$defs/labelled",
          "properties": {"label": {"enum": ["risk:certain_possible", "risk:severity_closure", "risk:classes_distinct", "risk:order", "risk:class_functional", "risk:class"]}}}},
        "unranked_severities": {"type": "array", "items": {"$ref": "common.json#/$defs/string_pair"}},
        "inlined": {"$ref": "alternatives.json#/$defs/regenerated/inlined"},
        "alternatives": {"$ref": "alternatives.json#/$defs/regenerated/alternatives"},
        "base_premises": {"$ref": "common.json#/$defs/labelled_list"},
        "followable": {"$ref": "alternatives.json#/$defs/regenerated/followable"},
        "unmapped_obligations": {"$ref": "alternatives.json#/$defs/regenerated/unmapped_obligations"},
        "order": {"$ref": "common.json#/$defs/strings"},
        "background": {"$ref": "common.json#/$defs/norms_background"},
        "premises": {"$ref": "common.json#/$defs/layer_premises"},
        "conflict_targets": {"$ref": "common.json#/$defs/conflict_targets"},
        "fragment": {"type": "boolean"}}},
    "cell": {"type": "object", "required": ["alternative", "harm"], "additionalProperties": false,
      "properties": {"alternative": {"type": "string"}, "harm": {"type": "string"}}},
    "endpoint": {"$comment": "Risk.Run.endpointJson and dirName.",
      "estimate": {"type": "string"}, "side": {"enum": ["lo", "hi"]}, "direction": {"enum": ["down", "up"]}},
    "decision": {"$comment": "Risk.Run.runDecision: the identities, then a CONFLICT or the per-alternative evaluation.",
      "anyOf": [
        {"type": "object", "required": ["id", "status", "environment_id", "document_hash", "decision_record_id", "verdict",
           "target", "tuple", "text"], "additionalProperties": false,
         "properties": {
           "id": {"$ref": "common.json#/$defs/id_ok"},
           "status": {"const": "ok"},
           "environment_id": {"$ref": "common.json#/$defs/hex64"},
           "document_hash": {"$ref": "common.json#/$defs/hex64"},
           "decision_record_id": {"$ref": "common.json#/$defs/hex64_or_empty"},
           "verdict": {"const": "CONFLICT"},
           "target": {"type": "string"},
           "tuple": {"$ref": "common.json#/$defs/strings"},
           "text": {"$ref": "common.json#/$defs/text"}}},
        {"type": "object", "required": ["id", "status", "environment_id", "document_hash", "decision_record_id", "tables",
           "statuses", "worst_cases", "margins", "record_invalid", "record_conflict", "lines", "legend", "clear",
           "conditional_on", "text"], "additionalProperties": false,
         "properties": {
           "id": {"$ref": "common.json#/$defs/id_ok"},
           "status": {"const": "ok"},
           "environment_id": {"$ref": "common.json#/$defs/hex64"},
           "document_hash": {"$ref": "common.json#/$defs/hex64"},
           "decision_record_id": {"$ref": "common.json#/$defs/hex64_or_empty"},
           "tables": {"type": "object", "required": ["might", "leads"], "additionalProperties": false,
             "properties": {
               "might": {"type": "array", "items": {
                 "type": "object", "required": ["alternative", "harm"], "additionalProperties": false,
                 "properties": {"alternative": {"type": "string"}, "harm": {"type": "string"},
                   "witness": {"type": "array", "items": {
                     "type": "object", "required": ["quantity", "value"], "additionalProperties": false,
                     "properties": {"quantity": {"type": "string"}, "value": {"type": "string"}}}}}}},
               "leads": {"type": "array", "items": {"$ref": "#/$defs/cell"}}}},
           "statuses": {"type": "array", "items": {
             "type": "object", "required": ["alternative", "permitted", "required", "clear", "rules", "by_default"],
             "additionalProperties": false,
             "properties": {
               "alternative": {"type": "string"},
               "permitted": {"type": "boolean"},
               "required": {"type": "boolean"},
               "clear": {"type": "boolean"},
               "rules": {"type": "array", "items": {"type": "integer", "minimum": 1}},
               "by_default": {"type": "boolean"}},
             "if": {"properties": {"rules": {"maxItems": 0}}},
             "then": {"properties": {"by_default": {"const": true}}},
             "else": {"properties": {"by_default": {"const": false}}}}},
           "worst_cases": {"type": "object", "additionalProperties": {"type": "array", "items": {
             "type": "object", "required": ["harm", "class"], "additionalProperties": false,
             "properties": {"harm": {"type": "string"}, "class": {"type": "string"}}}}},
           "margins": {"type": "array", "items": {
             "type": "object", "required": ["estimate", "side", "alternative", "direction"], "additionalProperties": false,
             "properties": {
               "estimate": {"$ref": "#/$defs/endpoint/estimate"},
               "side": {"$ref": "#/$defs/endpoint/side"},
               "alternative": {"type": "string"},
               "direction": {"$ref": "#/$defs/endpoint/direction"},
               "nearest": {"type": "string"},
               "no_single_valid_change": {"const": true}},
             "anyOf": [{"required": ["nearest"], "not": {"required": ["no_single_valid_change"]}},
                       {"required": ["no_single_valid_change"], "not": {"required": ["nearest"]}}]}},
           "record_invalid": {"type": "array", "items": {
             "type": "object", "required": ["estimate", "side", "direction", "value", "diagnostic"],
             "additionalProperties": false,
             "properties": {
               "estimate": {"$ref": "#/$defs/endpoint/estimate"},
               "side": {"$ref": "#/$defs/endpoint/side"},
               "direction": {"$ref": "#/$defs/endpoint/direction"},
               "value": {"type": "string"},
               "diagnostic": {"$ref": "common.json#/$defs/text"}}}},
           "record_conflict": {"type": "array", "items": {
             "type": "object", "required": ["estimate", "side", "direction", "value"], "additionalProperties": false,
             "properties": {
               "estimate": {"$ref": "#/$defs/endpoint/estimate"},
               "side": {"$ref": "#/$defs/endpoint/side"},
               "direction": {"$ref": "#/$defs/endpoint/direction"},
               "value": {"type": "string"}}}},
           "lines": {"type": "object", "required": ["unexamined_possible", "assumed_ruled_out", "point_estimates",
               "default_decided", "dilemmas"], "additionalProperties": false,
             "properties": {
               "unexamined_possible": {"$ref": "common.json#/$defs/strings"},
               "assumed_ruled_out": {"type": "object", "required": ["decider", "cells"], "additionalProperties": false,
                 "properties": {"decider": {"type": "string"}, "cells": {"$ref": "common.json#/$defs/strings"}}},
               "point_estimates": {"$ref": "common.json#/$defs/strings"},
               "default_decided": {"$ref": "common.json#/$defs/strings"},
               "dilemmas": {"$ref": "common.json#/$defs/strings", "maxItems": 1}}},
           "legend": {"$ref": "common.json#/$defs/nonempty_strings", "maxItems": 3},
           "clear": {"$ref": "common.json#/$defs/strings"},
           "conditional_on": {"$ref": "common.json#/$defs/strings"},
           "text": {"$ref": "common.json#/$defs/text"}}}]},
    "conflict": {"$comment": "Risk.Run.runConflict over certificate packages: the verdict and the targets (no detail).",
      "type": "object", "required": ["id", "status", "verdict", "targets"], "additionalProperties": false,
      "properties": {
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "status": {"const": "ok"},
        "verdict": {"enum": ["CONFLICT-FREE", "UNKNOWN"]},
        "targets": {"$ref": "common.json#/$defs/strings"}}},
    "followable_witness": {"$comment": "Risk.Run.runFollowable with a dilemma witness.",
      "anyOf": [
        {"type": "object", "required": ["id", "status", "verdict", "text"], "additionalProperties": false,
         "properties": {"id": {"$ref": "common.json#/$defs/id_ok"}, "status": {"const": "ok"},
                        "verdict": {"enum": ["not computed", "UNKNOWN"]}, "text": {"$ref": "common.json#/$defs/text"}}},
        {"type": "object", "required": ["id", "status", "verdict", "chooser", "diagnosis", "text"],
         "additionalProperties": false,
         "properties": {"id": {"$ref": "common.json#/$defs/id_ok"}, "status": {"const": "ok"},
                        "verdict": {"const": "DILEMMA"}, "chooser": {"type": "string", "x-equals": "/witness/chooser"},
                        "diagnosis": {"$ref": "common.json#/$defs/text"}, "text": {"$ref": "common.json#/$defs/text"}}}]},
    "followable": {"$comment": "Risk.Run.runFollowable over a certificate package: FOLLOWABLE carries the source labels and no text.",
      "anyOf": [
        {"type": "object", "required": ["id", "status", "verdict", "text"], "additionalProperties": false,
         "properties": {"id": {"$ref": "common.json#/$defs/id_ok"}, "status": {"const": "ok"},
                        "verdict": {"enum": ["not computed", "UNKNOWN"]}, "text": {"$ref": "common.json#/$defs/text"}}},
        {"type": "object", "required": ["id", "status", "verdict", "conditional_on"], "additionalProperties": false,
         "properties": {"id": {"$ref": "common.json#/$defs/id_ok"}, "status": {"const": "ok"},
                        "verdict": {"const": "FOLLOWABLE"}, "conditional_on": {"$ref": "common.json#/$defs/strings"}}}]},
    "audit": {"$comment": "Risk.Run.runAudit: the audited alternative and the answers to the three audit questions.",
      "type": "object", "required": ["id", "status", "alternative", "q1", "q2", "procedure", "q3", "not_concluded"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "status": {"const": "ok"},
        "alternative": {"type": "string"},
        "q1": {"$ref": "common.json#/$defs/text"},
        "q2": {"$ref": "common.json#/$defs/text"},
        "procedure": {"$ref": "common.json#/$defs/strings"},
        "q3": {"$ref": "common.json#/$defs/strings"},
        "not_concluded": {"$ref": "common.json#/$defs/strings", "maxItems": 1}}},
    "certificate": {"$comment": "Risk.Run.runCertificate: the certificate's verdict and the premises it is conditional on.",
      "type": "object", "required": ["id", "status", "valid", "conditional_on"], "additionalProperties": false,
      "properties": {
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "status": {"const": "ok"},
        "valid": {"type": "boolean"},
        "conditional_on": {"$ref": "common.json#/$defs/strings"}}}
  }
}
