{
  "$id": "risk.json",
  "$comment": "Mode risk: Risk.Run.runCaseReported (formerly ve_risk_route). A case on the risk path (usesRiskPath) is answered by the risk runner; every other case is delegated unchanged to the alternatives mode's runner.",
  "row": {
    "x-select": [
      {
        "then": {
          "anyOf": [
            {"$ref": "common.json#/$defs/case_error"},
            {"$ref": "common.json#/$defs/route_path_error"},
            {
              "x-select": [
                {"then": {"$ref": "#/$defs/admission"}, "when": {"$ref": "#/$defs/kind/admission"}},
                {"then": {"$ref": "#/$defs/elaborate"}, "when": {"$ref": "#/$defs/kind/risk-elaborate"}},
                {"then": {"$ref": "#/$defs/decision"}, "when": {"$ref": "#/$defs/kind/risk-decision"}},
                {
                  "then": {"$ref": "alternatives.json#/$defs/conflict_witness"},
                  "when": {"allOf": [{"$ref": "#/$defs/kind/risk-conflict"}, {"required": ["witness"]}]}
                },
                {"then": {"$ref": "#/$defs/conflict"}, "when": {"$ref": "#/$defs/kind/risk-conflict"}},
                {
                  "then": {"$ref": "#/$defs/followable_witness"},
                  "when": {"allOf": [{"$ref": "#/$defs/kind/risk-followable"}, {"required": ["witness"]}]}
                },
                {"then": {"$ref": "#/$defs/followable"}, "when": {"$ref": "#/$defs/kind/risk-followable"}},
                {"then": {"$ref": "#/$defs/audit"}, "when": {"$ref": "#/$defs/kind/risk-audit"}},
                {"then": {"$ref": "#/$defs/certificate"}, "when": {"$ref": "#/$defs/kind/risk-certificate"}}
              ]
            }
          ]
        },
        "when": {"$ref": "#/$defs/risk_path"}
      },
      {"then": {"$ref": "alternatives.json#/row"}, "when": true}
    ]
  },
  "$defs": {
    "admission": {
      "$comment": "Risk.Run.encodeAdmitted: W2's admission answer, conditional on the source labels and the risk premises.",
      "additionalProperties": false,
      "properties": {
        "admitted": {"const": true},
        "conditional_on": {"$ref": "common.json#/$defs/strings"},
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "kinds": {"items": {"$ref": "common.json#/$defs/kind"}, "type": "array", "x-equals": "/document/units/*/kind"},
        "report": {"$ref": "common.json#/$defs/bound_report"},
        "report_id": {"$ref": "common.json#/$defs/hex64"},
        "status": {"const": "ok"}
      },
      "required": ["id", "status", "admitted", "report", "report_id", "kinds", "conditional_on"],
      "type": "object"
    },
    "audit": {
      "$comment": "Risk.Run.runAudit: the audited alternative and the answers to the three audit questions.",
      "additionalProperties": false,
      "properties": {
        "alternative": {"type": "string"},
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "not_concluded": {"$ref": "common.json#/$defs/strings", "maxItems": 1},
        "procedure": {"$ref": "common.json#/$defs/strings"},
        "q1": {"$ref": "common.json#/$defs/text"},
        "q2": {"$ref": "common.json#/$defs/text"},
        "q3": {"$ref": "common.json#/$defs/strings"},
        "status": {"const": "ok"}
      },
      "required": ["id", "status", "alternative", "q1", "q2", "procedure", "q3", "not_concluded"],
      "type": "object"
    },
    "cell": {
      "additionalProperties": false,
      "properties": {"alternative": {"type": "string"}, "harm": {"type": "string"}},
      "required": ["alternative", "harm"],
      "type": "object"
    },
    "certificate": {
      "$comment": "Risk.Run.runCertificate: the certificate's verdict and the premises it is conditional on.",
      "additionalProperties": false,
      "properties": {
        "conditional_on": {"$ref": "common.json#/$defs/strings"},
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "status": {"const": "ok"},
        "valid": {"type": "boolean"}
      },
      "required": ["id", "status", "valid", "conditional_on"],
      "type": "object"
    },
    "conflict": {
      "$comment": "Risk.Run.runConflict over certificate packages: the verdict and the targets (no detail).",
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "status": {"const": "ok"},
        "targets": {"$ref": "common.json#/$defs/strings"},
        "verdict": {"enum": ["CONFLICT-FREE", "UNKNOWN"]}
      },
      "required": ["id", "status", "verdict", "targets"],
      "type": "object"
    },
    "decision": {
      "$comment": "Risk.Run.runDecision: the identities, then a CONFLICT or the per-alternative evaluation.",
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "decision_record_id": {"$ref": "common.json#/$defs/hex64_or_empty"},
            "document_hash": {"$ref": "common.json#/$defs/hex64"},
            "environment_id": {"$ref": "common.json#/$defs/hex64"},
            "id": {"$ref": "common.json#/$defs/id_ok"},
            "status": {"const": "ok"},
            "target": {"type": "string"},
            "text": {"$ref": "common.json#/$defs/text"},
            "tuple": {"$ref": "common.json#/$defs/strings"},
            "verdict": {"const": "CONFLICT"}
          },
          "required": [
            "id",
            "status",
            "environment_id",
            "document_hash",
            "decision_record_id",
            "verdict",
            "target",
            "tuple",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "clear": {"$ref": "common.json#/$defs/strings"},
            "conditional_on": {"$ref": "common.json#/$defs/strings"},
            "decision_record_id": {"$ref": "common.json#/$defs/hex64_or_empty"},
            "document_hash": {"$ref": "common.json#/$defs/hex64"},
            "environment_id": {"$ref": "common.json#/$defs/hex64"},
            "id": {"$ref": "common.json#/$defs/id_ok"},
            "legend": {"$ref": "common.json#/$defs/nonempty_strings", "maxItems": 3},
            "lines": {
              "additionalProperties": false,
              "properties": {
                "assumed_ruled_out": {
                  "additionalProperties": false,
                  "properties": {"cells": {"$ref": "common.json#/$defs/strings"}, "decider": {"type": "string"}},
                  "required": ["decider", "cells"],
                  "type": "object"
                },
                "default_decided": {"$ref": "common.json#/$defs/strings"},
                "dilemmas": {"$ref": "common.json#/$defs/strings", "maxItems": 1},
                "point_estimates": {"$ref": "common.json#/$defs/strings"},
                "unexamined_possible": {"$ref": "common.json#/$defs/strings"}
              },
              "required": ["unexamined_possible", "assumed_ruled_out", "point_estimates", "default_decided", "dilemmas"],
              "type": "object"
            },
            "margins": {
              "items": {
                "additionalProperties": false,
                "anyOf": [
                  {"not": {"required": ["no_single_valid_change"]}, "required": ["nearest"]},
                  {"not": {"required": ["nearest"]}, "required": ["no_single_valid_change"]}
                ],
                "properties": {
                  "alternative": {"type": "string"},
                  "direction": {"$ref": "#/$defs/endpoint/direction"},
                  "estimate": {"$ref": "#/$defs/endpoint/estimate"},
                  "nearest": {"type": "string"},
                  "no_single_valid_change": {"const": true},
                  "side": {"$ref": "#/$defs/endpoint/side"}
                },
                "required": ["estimate", "side", "alternative", "direction"],
                "type": "object"
              },
              "type": "array"
            },
            "record_conflict": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "direction": {"$ref": "#/$defs/endpoint/direction"},
                  "estimate": {"$ref": "#/$defs/endpoint/estimate"},
                  "side": {"$ref": "#/$defs/endpoint/side"},
                  "value": {"type": "string"}
                },
                "required": ["estimate", "side", "direction", "value"],
                "type": "object"
              },
              "type": "array"
            },
            "record_invalid": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "diagnostic": {"$ref": "common.json#/$defs/text"},
                  "direction": {"$ref": "#/$defs/endpoint/direction"},
                  "estimate": {"$ref": "#/$defs/endpoint/estimate"},
                  "side": {"$ref": "#/$defs/endpoint/side"},
                  "value": {"type": "string"}
                },
                "required": ["estimate", "side", "direction", "value", "diagnostic"],
                "type": "object"
              },
              "type": "array"
            },
            "status": {"const": "ok"},
            "statuses": {
              "items": {
                "additionalProperties": false,
                "else": {"properties": {"by_default": {"const": false}}},
                "if": {"properties": {"rules": {"maxItems": 0}}},
                "properties": {
                  "alternative": {"type": "string"},
                  "by_default": {"type": "boolean"},
                  "clear": {"type": "boolean"},
                  "permitted": {"type": "boolean"},
                  "required": {"type": "boolean"},
                  "rules": {"items": {"minimum": 1, "type": "integer"}, "type": "array"}
                },
                "required": ["alternative", "permitted", "required", "clear", "rules", "by_default"],
                "then": {"properties": {"by_default": {"const": true}}},
                "type": "object"
              },
              "type": "array"
            },
            "tables": {
              "additionalProperties": false,
              "properties": {
                "leads": {"items": {"$ref": "#/$defs/cell"}, "type": "array"},
                "might": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "alternative": {"type": "string"},
                      "harm": {"type": "string"},
                      "witness": {
                        "items": {
                          "additionalProperties": false,
                          "properties": {"quantity": {"type": "string"}, "value": {"type": "string"}},
                          "required": ["quantity", "value"],
                          "type": "object"
                        },
                        "type": "array"
                      }
                    },
                    "required": ["alternative", "harm"],
                    "type": "object"
                  },
                  "type": "array"
                }
              },
              "required": ["might", "leads"],
              "type": "object"
            },
            "text": {"$ref": "common.json#/$defs/text"},
            "worst_cases": {
              "additionalProperties": {
                "items": {
                  "additionalProperties": false,
                  "properties": {"class": {"type": "string"}, "harm": {"type": "string"}},
                  "required": ["harm", "class"],
                  "type": "object"
                },
                "type": "array"
              },
              "type": "object"
            }
          },
          "required": [
            "id",
            "status",
            "environment_id",
            "document_hash",
            "decision_record_id",
            "tables",
            "statuses",
            "worst_cases",
            "margins",
            "record_invalid",
            "record_conflict",
            "lines",
            "legend",
            "clear",
            "conditional_on",
            "text"
          ],
          "type": "object"
        }
      ]
    },
    "elaborate": {
      "$comment": "Risk.Wire.regenerated: the policy identities, E_risk's generated vocabulary, the legend, the risk premises, the unranked severity pairs, then the alternatives fields of the inlined tree and Norms.Wire.regenerated.",
      "additionalProperties": false,
      "properties": {
        "alternatives": {"$ref": "alternatives.json#/$defs/regenerated/alternatives"},
        "background": {"$ref": "common.json#/$defs/norms_background"},
        "base_premises": {"$ref": "common.json#/$defs/labelled_list"},
        "conflict_targets": {"$ref": "common.json#/$defs/conflict_targets"},
        "document_hash": {"$ref": "common.json#/$defs/hex64"},
        "e_risk": {
          "additionalProperties": false,
          "properties": {
            "classes": {"$ref": "common.json#/$defs/strings"},
            "predicates": {"additionalProperties": {"$ref": "common.json#/$defs/strings"}, "type": "object"},
            "sort": {"type": "string"},
            "words": {
              "additionalProperties": false,
              "properties": {
                "risk__less_worst": {"$ref": "common.json#/$defs/string_pair"},
                "risk__or_worse": {"$ref": "common.json#/$defs/string_pair"}
              },
              "required": ["risk__or_worse", "risk__less_worst"],
              "type": "object"
            }
          },
          "required": ["sort", "classes", "predicates", "words"],
          "type": "object"
        },
        "environment_id": {"$ref": "common.json#/$defs/hex64"},
        "followable": {"$ref": "alternatives.json#/$defs/regenerated/followable"},
        "fragment": {"type": "boolean"},
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "inlined": {"$ref": "alternatives.json#/$defs/regenerated/inlined"},
        "legend": {"$ref": "common.json#/$defs/nonempty_strings"},
        "order": {"$ref": "common.json#/$defs/strings"},
        "premises": {"$ref": "common.json#/$defs/layer_premises"},
        "risk_premises": {
          "items": {
            "$ref": "common.json#/$defs/labelled",
            "properties": {
              "label": {
                "enum": [
                  "risk:certain_possible",
                  "risk:severity_closure",
                  "risk:classes_distinct",
                  "risk:order",
                  "risk:class_functional",
                  "risk:class"
                ]
              }
            }
          },
          "type": "array"
        },
        "status": {"const": "ok"},
        "unmapped_obligations": {"$ref": "alternatives.json#/$defs/regenerated/unmapped_obligations"},
        "unranked_severities": {"items": {"$ref": "common.json#/$defs/string_pair"}, "type": "array"}
      },
      "required": [
        "id",
        "status",
        "environment_id",
        "document_hash",
        "e_risk",
        "legend",
        "risk_premises",
        "unranked_severities",
        "inlined",
        "alternatives",
        "base_premises",
        "followable",
        "unmapped_obligations",
        "order",
        "background",
        "premises",
        "conflict_targets",
        "fragment"
      ],
      "type": "object"
    },
    "endpoint": {
      "$comment": "Risk.Run.endpointJson and dirName.",
      "direction": {"enum": ["down", "up"]},
      "estimate": {"type": "string"},
      "side": {"enum": ["lo", "hi"]}
    },
    "followable": {
      "$comment": "Risk.Run.runFollowable over a certificate package: FOLLOWABLE carries the source labels and no text.",
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "id": {"$ref": "common.json#/$defs/id_ok"},
            "status": {"const": "ok"},
            "text": {"$ref": "common.json#/$defs/text"},
            "verdict": {"enum": ["not computed", "UNKNOWN"]}
          },
          "required": ["id", "status", "verdict", "text"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "conditional_on": {"$ref": "common.json#/$defs/strings"},
            "id": {"$ref": "common.json#/$defs/id_ok"},
            "status": {"const": "ok"},
            "verdict": {"const": "FOLLOWABLE"}
          },
          "required": ["id", "status", "verdict", "conditional_on"],
          "type": "object"
        }
      ]
    },
    "followable_witness": {
      "$comment": "Risk.Run.runFollowable with a dilemma witness.",
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "id": {"$ref": "common.json#/$defs/id_ok"},
            "status": {"const": "ok"},
            "text": {"$ref": "common.json#/$defs/text"},
            "verdict": {"enum": ["not computed", "UNKNOWN"]}
          },
          "required": ["id", "status", "verdict", "text"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "chooser": {"type": "string", "x-equals": "/witness/chooser"},
            "diagnosis": {"$ref": "common.json#/$defs/text"},
            "id": {"$ref": "common.json#/$defs/id_ok"},
            "status": {"const": "ok"},
            "text": {"$ref": "common.json#/$defs/text"},
            "verdict": {"const": "DILEMMA"}
          },
          "required": ["id", "status", "verdict", "chooser", "diagnosis", "text"],
          "type": "object"
        }
      ]
    },
    "kind": {
      "admission": {"properties": {"kind": {"const": "admission"}}, "required": ["kind"], "type": "object"},
      "risk-audit": {"properties": {"kind": {"const": "risk-audit"}}, "required": ["kind"], "type": "object"},
      "risk-certificate": {"properties": {"kind": {"const": "risk-certificate"}}, "required": ["kind"], "type": "object"},
      "risk-conflict": {"properties": {"kind": {"const": "risk-conflict"}}, "required": ["kind"], "type": "object"},
      "risk-decision": {"properties": {"kind": {"const": "risk-decision"}}, "required": ["kind"], "type": "object"},
      "risk-elaborate": {"properties": {"kind": {"const": "risk-elaborate"}}, "required": ["kind"], "type": "object"},
      "risk-followable": {"properties": {"kind": {"const": "risk-followable"}}, "required": ["kind"], "type": "object"}
    },
    "risk_labels": {
      "$comment": "Risk.Background.riskPremiseLabels.",
      "items": {
        "enum": [
          "risk:certain_possible",
          "risk:severity_closure",
          "risk:classes_distinct",
          "risk:order",
          "risk:class_functional",
          "risk:class"
        ]
      },
      "type": "array"
    },
    "risk_path": {
      "$comment": "Risk.Run.usesRiskPath: the risk@0 profile, the environment's risk block or a risk-* kind.",
      "anyOf": [
        {
          "properties": {
            "environment": {
              "properties": {"profiles": {"contains": {"const": "risk@0"}, "type": "array"}},
              "required": ["profiles"],
              "type": "object"
            }
          },
          "required": ["environment"]
        },
        {"properties": {"environment": {"required": ["risk"], "type": "object"}}, "required": ["environment"]},
        {"properties": {"kind": {"pattern": "risk-.*", "type": "string"}}, "required": ["kind"]}
      ],
      "type": "object"
    }
  }
}
