    "fill_premises": {
      "$comment": "Readings.Run.runValidateND (UnspecifiedWire.fillPremisesJson): under the unspecified completion, per reading with content its Fill_T, each premise labelled unsaid:pair:<r>,<m>.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "index": {"$ref": "common.json#/$defs/nat"},
          "premises": {
            "items": {
              "additionalProperties": false,
              "properties": {"ast": {"$ref": "common.json#/$defs/generated_formula"}, "label": {"type": "string"}},
              "required": ["label", "ast"],
              "type": "object"
            },
            "type": "array"
          },
          "set": {"type": "string"}
        },
        "required": ["set", "index", "premises"],
        "type": "object"
      },
      "type": "array"
    },
    "filled": {
      "$comment": "Readings.Run.runValidateND (UnspecifiedWire.filledJson): under the unspecified completion, the filled frame's environment (unspecified read as deny, norm-defaults@0 removed, every unsaid__p added) and the filled units, the F_p units last.",
      "additionalProperties": false,
      "properties": {"environment": {"$comment": "the filled environment"}, "units": {"type": "array"}},
      "required": ["environment", "units"],
      "type": "object"
    },
    "key": {
      "$comment": "Readings.Wire key JSON: one generated key.",
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {"bearer": {"type": "string"}, "excepted": {"type": "string"}},
          "required": ["excepted"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {"bearer": {"type": "string"}, "off": {"type": "string"}, "party": {"type": "string"}},
          "required": ["off", "party"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {"higher": {"type": "string"}, "lower": {"type": "string"}, "outweighs": {"type": "string"}},
          "required": ["outweighs", "lower", "higher"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {"act": {"type": "string"}, "lim": {"type": "string"}},
          "required": ["lim", "act"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {"act": {"type": "string"}, "cond": {"type": "string"}, "condition": {"type": "string"}},
          "required": ["cond", "act", "condition"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {"aimed": {"type": "string"}},
          "required": ["aimed"],
          "type": "object"
        }
      ]
    },
    "keys": {
      "items": {
        "additionalProperties": false,
        "properties": {"key": {"$ref": "#/$defs/key"}, "name": {"type": "string"}},
        "required": ["key", "name"],
        "type": "object"
      },
      "type": "array"
    },
    "kind": {
      "readings-certificate": {"properties": {"kind": {"const": "readings-certificate"}}, "required": ["kind"], "type": "object"},
      "readings-choice": {"properties": {"kind": {"const": "readings-choice"}}, "required": ["kind"], "type": "object"},
      "readings-conflict": {"properties": {"kind": {"const": "readings-conflict"}}, "required": ["kind"], "type": "object"},
      "readings-dead": {"properties": {"kind": {"const": "readings-dead"}}, "required": ["kind"], "type": "object"},
      "readings-elaborate": {"properties": {"kind": {"const": "readings-elaborate"}}, "required": ["kind"], "type": "object"},
      "readings-model": {"properties": {"kind": {"const": "readings-model"}}, "required": ["kind"], "type": "object"},
      "readings-separate": {"properties": {"kind": {"const": "readings-separate"}}, "required": ["kind"], "type": "object"},
      "readings-validate": {"properties": {"kind": {"const": "readings-validate"}}, "required": ["kind"], "type": "object"},
      "readings-verdicts": {"properties": {"kind": {"const": "readings-verdicts"}}, "required": ["kind"], "type": "object"}
    },
    "model": {
      "$comment": "Readings.Run.runModel: the model's check, the conclusion's value, the first failing premise and the choice it encodes.",
      "additionalProperties": false,
      "properties": {
        "assumed": {"$ref": "#/$defs/choice"},
        "choice": {"$ref": "#/$defs/choice"},
        "conclusion_value": {"type": "boolean"},
        "first_failing": {"type": ["string", "null"]},
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "status": {"const": "ok"},
        "valid": {"type": "boolean"}
      },
      "required": ["id", "status", "valid", "conclusion_value", "first_failing", "assumed", "choice"],
      "type": "object"
    },
    "pair": {
      "$comment": "Readings.Run.pairJson: a separating situation's facts; other_value exactly when the other reading owns no generated key.",
      "additionalProperties": false,
      "properties": {
        "other_admissible": {"type": "boolean"},
        "other_value": {"type": ["boolean", "null"]},
        "separated": {"type": "boolean"},
        "situation": {"type": "string"},
        "witness": {"type": "string"},
        "witness_admissible": {"type": "boolean"},
        "witness_value": {"type": ["boolean", "null"]}
      },
      "required": ["situation", "witness", "separated", "witness_admissible", "witness_value", "other_admissible"],
      "type": "object"
    },
    "separate": {
      "$comment": "Readings.Run.runCase readings-separate: the requested set and situation's pair facts.",
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "pair": {"$ref": "#/$defs/pair", "properties": {"situation": {"x-equals": "/situation"}}},
        "set": {"type": "string", "x-equals": "/set"},
        "status": {"const": "ok"}
      },
      "required": ["id", "status", "set", "pair"],
      "type": "object"
    },
    "validate": {
      "$comment": "Readings.Run.validateResult: no content-bearing set, or one entry per content-bearing open set; under the unspecified completion (Readings.Run.runValidateND) also fill_premises and filled.",
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "content_bearing": {"const": false},
            "fill_premises": {"$ref": "#/$defs/fill_premises"},
            "filled": {"$ref": "#/$defs/filled"},
            "id": {"$ref": "common.json#/$defs/id_ok"},
            "status": {"const": "ok"}
          },
          "required": ["id", "status", "content_bearing"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "content_bearing": {"const": true},
            "fill_premises": {"$ref": "#/$defs/fill_premises"},
            "filled": {"$ref": "#/$defs/filled"},
            "id": {"$ref": "common.json#/$defs/id_ok"},
            "sets": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "candidates": {"items": {"$ref": "#/$defs/candidate"}, "type": "array"},
                  "findings": {
                    "items": {"pattern": "(SeparatedByDecisionOnly: |SeparatedByActOnly: ).*", "type": "string"},
                    "type": "array"
                  },
                  "pairs": {
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "other": {"type": "string"},
                        "pair": {"$ref": "#/$defs/pair"},
                        "reading": {"type": "string"}
                      },
                      "required": ["reading", "other", "pair"],
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "set": {"type": "string"},
                  "version": {"$ref": "common.json#/$defs/nat"}
                },
                "required": ["set", "version", "candidates", "pairs", "findings"],
                "type": "object"
              },
              "type": "array"
            },
            "status": {"const": "ok"}
          },
          "required": ["id", "status", "content_bearing", "sets"],
          "type": "object"
        }
      ]
    },
    "verdicts": {
      "$comment": "Readings.Run.runVerdicts (readings-defaults RD-3): on the enumerated route, the question's answer folded in Lean over the compatible choices taking assumed: the result in the form the report gives it, one entry per choice with its rows and what Lean made of each piece of evidence, the labels E3 cites, the dead readings, the untaken candidates and the dead evidence (premises), and the English plan.",
      "additionalProperties": false,
      "properties": {
        "dead": {"items": {"$ref": "#/$defs/verdicts_dead"}, "type": "array"},
        "dead_readings": {
          "anyOf": [
            {"type": "null"},
            {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "finding": {"pattern": "DeadReading: .*", "type": "string"},
                  "index": {"$ref": "common.json#/$defs/nat"},
                  "set": {"type": "string"}
                },
                "required": ["set", "index", "finding"],
                "type": "object"
              },
              "type": "array"
            }
          ]
        },
        "english": {"items": {"$ref": "#/$defs/verdicts_line"}, "type": "array"},
        "finding_sets": {"$ref": "common.json#/$defs/strings"},
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "labels": {"$ref": "common.json#/$defs/strings"},
        "per_choice": {"items": {"$ref": "#/$defs/verdicts_row"}, "type": "array"},
        "question": {"type": "string"},
        "restrictions": {"$ref": "common.json#/$defs/strings"},
        "result": {"$ref": "#/$defs/verdicts_result"},
        "route": {"const": "enumerated"},
        "status": {"const": "ok"},
        "untaken": {"$ref": "#/$defs/choice"}
      },
      "required": [
        "id",
        "status",
        "route",
        "question",
        "finding_sets",
        "restrictions",
        "result",
        "per_choice",
        "labels",
        "dead_readings",
        "untaken",
        "dead",
        "english"
      ],
      "type": "object"
    },
    "verdicts_dead": {
      "$comment": "Readings.Run.deadOf: what Lean made of one dead reading's certificate.",
      "additionalProperties": false,
      "properties": {"accepted": {"type": "boolean"}, "index": {"$ref": "common.json#/$defs/nat"}, "set": {"type": "string"}},
      "required": ["accepted"],
      "type": "object"
    },
    "verdicts_line": {
      "$comment": "Readings.Line.json: one line of the English plan (readings-defaults 2.4).",
      "additionalProperties": false,
      "properties": {
        "frame": {"type": "string"},
        "gaps": {"type": "array"},
        "label": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "readings": {"$ref": "#/$defs/choice"},
        "result": {"type": ["string", "null"]}
      },
      "required": ["frame", "result", "readings", "model", "gaps", "label"],
      "type": "object"
    },
    "verdicts_result": {
      "$comment": "Readings.Run.resultOf: the question's result in the form the report gives it (conflictResult, premisesResult, entailmentResult, or W2's budget shape); the caller relays it.",
      "additionalProperties": false,
      "properties": {
        "assumed": {"$comment": "relayed as Lean gives it"},
        "budget": {"$comment": "relayed as Lean gives it"},
        "candidates": {"$comment": "relayed as Lean gives it"},
        "choice": {"$comment": "relayed as Lean gives it"},
        "choices": {"$comment": "relayed as Lean gives it"},
        "conditional_on": {"$comment": "relayed as Lean gives it"},
        "conflict_status": {"$comment": "relayed as Lean gives it"},
        "countermodel": {"$comment": "relayed as Lean gives it"},
        "countermodels": {"$comment": "relayed as Lean gives it"},
        "evidence": {"$comment": "relayed as Lean gives it"},
        "model": {"$comment": "relayed as Lean gives it"},
        "proof": {"$comment": "relayed as Lean gives it"},
        "proofs": {"$comment": "relayed as Lean gives it"},
        "reading_premises_used": {"$comment": "relayed as Lean gives it"},
        "restrictions": {"$comment": "relayed as Lean gives it"},
        "route": {"const": "enumerated"},
        "status": {"$comment": "relayed as Lean gives it"},
        "status_text": {"$comment": "relayed as Lean gives it"},
        "units": {"$comment": "relayed as Lean gives it"},
        "verdict": {"$comment": "relayed as Lean gives it"},
        "witnesses": {"$comment": "relayed as Lean gives it"}
      },
      "required": ["route"],
      "type": "object"
    },
    "verdicts_row": {
      "$comment": "Readings.Run.perChoiceJson: one compatible choice taking assumed, its rows and what Lean made of each piece of its evidence (maps keyed by the piece: accepted, its refusal, its shown model, its filled gaps).",
      "additionalProperties": false,
      "properties": {
        "choice": {"$ref": "#/$defs/choice"},
        "conflict": {"enum": ["CONFLICT-FREE", "CONFLICT", "UNKNOWN", "proved", "refuted", "model", "INCONSISTENT"]},
        "errors": {"additionalProperties": {"type": "string"}, "type": "object"},
        "evidence": {"additionalProperties": {"type": "boolean"}, "type": "object"},
        "gaps": {"additionalProperties": {"type": "array"}, "type": "object"},
        "premises": {"enum": ["CONFLICT-FREE", "CONFLICT", "UNKNOWN", "proved", "refuted", "model", "INCONSISTENT"]},
        "query": {"enum": ["CONFLICT-FREE", "CONFLICT", "UNKNOWN", "proved", "refuted", "model", "INCONSISTENT"]},
        "shown": {
          "additionalProperties": {"$comment": "a shown model, the generator's complete model"},
          "type": "object"
        },
        "status_text": {"type": ["string", "null"]}
      },
      "required": ["choice", "conflict", "evidence", "errors", "shown", "gaps", "status_text"],
      "type": "object"
    }
  }
}
