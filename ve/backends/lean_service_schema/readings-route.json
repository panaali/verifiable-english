{
  "$id": "readings-route.json",
  "$comment": "Mode readings-route: Readings.Run.runCaseReported (formerly ve_readings_route). readings-validate and readings-separate are the readings runner's; every other case goes, with readings@1 stripped from its profiles, to the runner Compose.dispatch names (rights, soft-norms or norm-defaults, else norms; Readings.Run.runLower). The client does not evaluate Compose.dispatch, so such a row is any of those four modes' rows for the case.",
  "row": {
    "x-select": [
      {
        "then": {
          "anyOf": [
            {"$ref": "common.json#/$defs/case_error"},
            {"$ref": "common.json#/$defs/route_path_error"},
            {"$ref": "#/$defs/validate"}
          ]
        },
        "when": {"$ref": "#/$defs/kind/readings-validate"}
      },
      {
        "then": {
          "anyOf": [
            {"$ref": "common.json#/$defs/case_error"},
            {"$ref": "common.json#/$defs/route_path_error"},
            {"$ref": "#/$defs/separate"}
          ]
        },
        "when": {"$ref": "#/$defs/kind/readings-separate"}
      },
      {
        "then": {
          "anyOf": [
            {"$ref": "rights.json#/row"},
            {"$ref": "soft-norms.json#/row"},
            {"$ref": "norm-defaults.json#/row"},
            {"$ref": "norms.json#/row"}
          ]
        },
        "when": true
      }
    ]
  },
  "$defs": {
    "candidate": {
      "$comment": "Readings.Run.candidateJson: a pending candidate, or its document hash, owned and shared keys and findings.",
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {"id": {"type": "string"}, "index": {"$ref": "common.json#/$defs/nat"}, "pending": {"const": true}},
          "required": ["id", "index", "pending"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "document_hash": {"$ref": "common.json#/$defs/hex64"},
            "findings": {"$ref": "common.json#/$defs/nonempty_strings"},
            "id": {"type": "string"},
            "index": {"$ref": "common.json#/$defs/nat"},
            "owned": {"$ref": "#/$defs/keys"},
            "pending": {"const": false},
            "shared": {"$ref": "#/$defs/keys"}
          },
          "required": ["id", "index", "pending", "document_hash", "owned", "shared", "findings"],
          "type": "object"
        }
      ]
    },
    "key": {
      "$comment": "Readings.Wire key JSON: one generated key.",
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {"bearer": {"type": "string"}, "excepted": {"type": "string"}},
          "required": ["excepted"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {"bearer": {"type": "string"}, "off": {"type": "string"}, "party": {"type": "string"}},
          "required": ["off", "party"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {"higher": {"type": "string"}, "lower": {"type": "string"}, "outweighs": {"type": "string"}},
          "required": ["outweighs", "lower", "higher"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {"act": {"type": "string"}, "lim": {"type": "string"}},
          "required": ["lim", "act"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {"act": {"type": "string"}, "cond": {"type": "string"}, "condition": {"type": "string"}},
          "required": ["cond", "act", "condition"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {"aimed": {"type": "string"}},
          "required": ["aimed"],
          "type": "object"
        }
      ]
    },
    "keys": {
      "items": {
        "additionalProperties": false,
        "properties": {"key": {"$ref": "#/$defs/key"}, "name": {"type": "string"}},
        "required": ["key", "name"],
        "type": "object"
      },
      "type": "array"
    },
    "kind": {
      "readings-separate": {"properties": {"kind": {"const": "readings-separate"}}, "required": ["kind"], "type": "object"},
      "readings-validate": {"properties": {"kind": {"const": "readings-validate"}}, "required": ["kind"], "type": "object"}
    },
    "pair": {
      "$comment": "Readings.Run.pairJson: a separating situation's facts; other_value exactly when the other reading owns no generated key.",
      "additionalProperties": false,
      "properties": {
        "other_admissible": {"type": "boolean"},
        "other_value": {"type": ["boolean", "null"]},
        "separated": {"type": "boolean"},
        "situation": {"type": "string"},
        "witness": {"type": "string"},
        "witness_admissible": {"type": "boolean"},
        "witness_value": {"type": ["boolean", "null"]}
      },
      "required": ["situation", "witness", "separated", "witness_admissible", "witness_value", "other_admissible"],
      "type": "object"
    },
    "separate": {
      "$comment": "Readings.Run.runCase readings-separate: the requested set and situation's pair facts.",
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "pair": {"$ref": "#/$defs/pair", "properties": {"situation": {"x-equals": "/situation"}}},
        "set": {"type": "string", "x-equals": "/set"},
        "status": {"const": "ok"}
      },
      "required": ["id", "status", "set", "pair"],
      "type": "object"
    },
    "validate": {
      "$comment": "Readings.Run.validateResult: no content-bearing set, or one entry per content-bearing open set.",
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "content_bearing": {"const": false},
            "id": {"$ref": "common.json#/$defs/id_ok"},
            "status": {"const": "ok"}
          },
          "required": ["id", "status", "content_bearing"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "content_bearing": {"const": true},
            "id": {"$ref": "common.json#/$defs/id_ok"},
            "sets": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "candidates": {"items": {"$ref": "#/$defs/candidate"}, "type": "array"},
                  "findings": {
                    "items": {"pattern": "(SeparatedByDecisionOnly: |SeparatedByActOnly: ).*", "type": "string"},
                    "type": "array"
                  },
                  "pairs": {
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "other": {"type": "string"},
                        "pair": {"$ref": "#/$defs/pair"},
                        "reading": {"type": "string"}
                      },
                      "required": ["reading", "other", "pair"],
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "set": {"type": "string"},
                  "version": {"$ref": "common.json#/$defs/nat"}
                },
                "required": ["set", "version", "candidates", "pairs", "findings"],
                "type": "object"
              },
              "type": "array"
            },
            "status": {"const": "ok"}
          },
          "required": ["id", "status", "content_bearing", "sets"],
          "type": "object"
        }
      ]
    }
  }
}
