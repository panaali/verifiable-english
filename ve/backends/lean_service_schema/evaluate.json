{
  "$id": "evaluate.json",
  "$comment": "Mode evaluate: Order.runEvaluationCaseReported (Bridge.runCase, Closure.Bridge.runCase). A kind field selects a countermodel request and must be exactly countermodel.",
  "row": {
    "anyOf": [
      {"$ref": "common.json#/$defs/case_error"},
      {"$ref": "common.json#/$defs/error"},
      {
        "x-select": [
          {"then": {"$ref": "#/$defs/document"}, "when": {"$ref": "common.json#/$defs/no_kind"}},
          {
            "then": {"$ref": "#/$defs/countermodel"},
            "when": {"properties": {"kind": {"const": "countermodel"}}, "required": ["kind"], "type": "object"}
          }
        ]
      }
    ]
  },
  "$defs": {
    "countermodel": {
      "additionalProperties": false,
      "properties": {"id": {"type": "string", "x-equals": "/id"}, "refutes": {"type": "boolean"}, "status": {"const": "ok"}},
      "required": ["id", "status", "refutes"],
      "type": "object"
    },
    "document": {
      "$comment": "That value is the conjunction of values is the service's.",
      "additionalProperties": false,
      "properties": {
        "canonical": {"type": "string"},
        "id": {"type": "string", "x-equals": "/id"},
        "status": {"const": "ok"},
        "value": {"type": "boolean"},
        "values": {"$ref": "common.json#/$defs/values"}
      },
      "required": ["id", "status", "values", "value", "canonical"],
      "type": "object"
    }
  }
}
