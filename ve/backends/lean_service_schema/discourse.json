{
  "$id": "discourse.json",
  "$comment": "Mode discourse: Discourse.Run.runCaseReported (formerly ve_discourse_route). A case on the discourse path (usesDiscoursePath) is answered by the discourse runner; every other case is delegated unchanged to the route mode's runner.",
  "row": {
    "x-select": [
      {
        "then": {
          "anyOf": [
            {"$ref": "common.json#/$defs/case_error"},
            {"$ref": "common.json#/$defs/route_path_error"},
            {
              "x-select": [
                {"then": {"$ref": "#/$defs/admission"}, "when": {"$ref": "#/$defs/kind/admission"}},
                {"then": {"$ref": "#/$defs/validity"}, "when": {"$ref": "#/$defs/kind/discourse-validity"}},
                {"then": {"$ref": "#/$defs/resolve"}, "when": {"$ref": "#/$defs/kind/discourse-resolve"}},
                {"then": {"$ref": "#/$defs/joint"}, "when": {"$ref": "#/$defs/kind/discourse-joint"}}
              ]
            }
          ]
        },
        "when": {"$ref": "#/$defs/discourse_path"}
      },
      {"then": {"$ref": "route.json#/row"}, "when": true}
    ]
  },
  "$defs": {
    "admission": {
      "$comment": "Discourse.Run.encodeAdmission: the wrapper's admission (ve-document@2, or a lifted ve-document@1 text whose identities are empty and whose joint is the missing manifest).",
      "additionalProperties": false,
      "properties": {
        "admitted": {"enum": [true, "UNKNOWN"]},
        "bound": {"additionalProperties": {"$ref": "common.json#/$defs/generated_formula"}, "type": "object"},
        "definitions_version": {"$ref": "common.json#/$defs/hex64_or_empty"},
        "document_id": {"$ref": "common.json#/$defs/hex64_or_empty"},
        "environment_id": {"$ref": "common.json#/$defs/hex64_or_empty"},
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "inner_report_id": {"$ref": "common.json#/$defs/hex64_or_empty"},
        "joint": {"$ref": "#/$defs/joint_count"},
        "kinds": {"items": {"$ref": "common.json#/$defs/kind"}, "type": "array"},
        "meaning_ids": {"additionalProperties": {"$ref": "common.json#/$defs/hex64"}, "type": "object"},
        "pending": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [{"type": "string"}, {"pattern": "PresuppositionUnresolved: .*", "type": "string"}],
            "type": "array"
          },
          "type": "array"
        },
        "presuppositions": {"additionalProperties": {"pattern": "discourse:presupposition:.*", "type": "string"}, "type": "object"},
        "reading_verdicts": {"additionalProperties": {"const": "UNKNOWN (joint choices)"}, "type": "object"},
        "references": {"items": {"$ref": "#/$defs/reference"}, "type": "array"},
        "report": {"$ref": "common.json#/$defs/report"},
        "report_id": {"$ref": "common.json#/$defs/hex64_or_empty"},
        "self_truth": {"$ref": "common.json#/$defs/strings"},
        "source_id": {"$ref": "common.json#/$defs/hex64_or_empty"},
        "status": {"const": "ok"},
        "statuses": {"additionalProperties": {"enum": ["CHECKED", "OPEN", "LABELLED", "UNFORMALISED"]}, "type": "object"},
        "validity": {"$ref": "#/$defs/validity_map"}
      },
      "required": [
        "id",
        "status",
        "admitted",
        "reading_verdicts",
        "report",
        "report_id",
        "inner_report_id",
        "document_id",
        "source_id",
        "environment_id",
        "definitions_version",
        "kinds",
        "references",
        "bound",
        "meaning_ids",
        "presuppositions",
        "pending",
        "validity",
        "self_truth",
        "statuses",
        "joint"
      ],
      "type": "object"
    },
    "discourse_path": {
      "$comment": "Discourse.Run.usesDiscoursePath: a document text, the ve.discourse@1 profile in a profile list of strings (Route.Gate.profilesOf), or a discourse-* kind.",
      "anyOf": [
        {"properties": {"document": {"type": "string"}}, "required": ["document"]},
        {
          "properties": {
            "environment": {
              "properties": {
                "profiles": {"contains": {"const": "ve.discourse@1"}, "items": {"type": "string"}, "type": "array"}
              },
              "required": ["profiles"],
              "type": "object"
            }
          },
          "required": ["environment"]
        },
        {"properties": {"kind": {"pattern": "discourse-.*", "type": "string"}}, "required": ["kind"]}
      ],
      "type": "object"
    },
    "joint": {
      "$comment": "Discourse.Run.runJoint: the compatible choices and their disjunction, or the diagnostic.",
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "choices": {
              "items": {
                "items": {
                  "maxItems": 3,
                  "minItems": 3,
                  "prefixItems": [{"type": "string"}, {"$ref": "common.json#/$defs/nat"}, {"$ref": "common.json#/$defs/nat"}],
                  "type": "array"
                },
                "type": "array"
              },
              "minItems": 1,
              "type": "array"
            },
            "id": {"$ref": "common.json#/$defs/id_ok"},
            "joint": {"$ref": "common.json#/$defs/generated_formula"},
            "status": {"const": "ok"},
            "verdict": {"const": "COMPLETE"}
          },
          "required": ["id", "status", "verdict", "choices", "joint"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "diagnostic": {"$ref": "common.json#/$defs/text"},
            "id": {"$ref": "common.json#/$defs/id_ok"},
            "status": {"const": "ok"},
            "verdict": {"enum": ["UNKNOWN", "INVALID"]}
          },
          "required": ["id", "status", "verdict", "diagnostic"],
          "type": "object"
        }
      ]
    },
    "joint_count": {
      "$comment": "The number of compatible joint choices, or the joint error.",
      "anyOf": [{"minimum": 1, "type": "integer"}, {"$ref": "common.json#/$defs/text"}]
    },
    "kind": {
      "admission": {"properties": {"kind": {"const": "admission"}}, "required": ["kind"], "type": "object"},
      "discourse-joint": {"properties": {"kind": {"const": "discourse-joint"}}, "required": ["kind"], "type": "object"},
      "discourse-resolve": {"properties": {"kind": {"const": "discourse-resolve"}}, "required": ["kind"], "type": "object"},
      "discourse-validity": {"properties": {"kind": {"const": "discourse-validity"}}, "required": ["kind"], "type": "object"}
    },
    "reference": {
      "$comment": "Discourse.Admission.referencesJson: a mention, its unit, its form, its front-matter target (Wire.decodeTarget's fields) and its status.",
      "additionalProperties": false,
      "properties": {
        "form": {
          "enum": [
            "pronoun",
            "demonstrative",
            "definite",
            "ordinal_pair",
            "such",
            "possessive",
            "plural",
            "section_ref",
            "definition_ref",
            "document_name",
            "citation",
            "navigation"
          ]
        },
        "mention": {"type": "string"},
        "status": {"enum": ["pending", "navigation", "resolved"]},
        "target": {
          "additionalProperties": false,
          "properties": {
            "content_name": {"type": "string"},
            "kind": {"$ref": "#/$defs/target_kind"},
            "members": {"$ref": "common.json#/$defs/strings"},
            "name": {"type": "string"},
            "pair": {"$ref": "common.json#/$defs/string_pair"},
            "units": {"$ref": "common.json#/$defs/strings"},
            "version": {"$ref": "common.json#/$defs/nat"}
          },
          "required": ["kind"],
          "type": "object"
        },
        "unit": {"type": "string"}
      },
      "required": ["mention", "unit", "form", "target", "status"],
      "type": "object"
    },
    "resolve": {
      "$comment": "Discourse.Run.runResolve: each bound unit's resolution, each mention's accessible and recorded targets, well-formedness and the joint count.",
      "additionalProperties": false,
      "properties": {
        "environment_id": {"$ref": "common.json#/$defs/hex64"},
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "joint": {"$ref": "#/$defs/joint_count"},
        "mentions": {
          "additionalProperties": {
            "additionalProperties": false,
            "properties": {
              "accessible": {"items": {"$ref": "#/$defs/resolved_target"}, "type": "array"},
              "accessible_recorded": {"type": "boolean"},
              "pin": {"$ref": "common.json#/$defs/nat"},
              "recorded": {"$ref": "#/$defs/resolved_target"}
            },
            "required": ["accessible", "recorded", "accessible_recorded"],
            "type": "object"
          },
          "type": "object"
        },
        "source_id": {"$ref": "common.json#/$defs/hex64"},
        "status": {"const": "ok"},
        "units": {
          "additionalProperties": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "formula": {"$ref": "common.json#/$defs/generated_formula"},
                  "meaning_id": {"$ref": "common.json#/$defs/hex64"},
                  "status": {"const": "resolved"}
                },
                "required": ["status", "formula", "meaning_id"],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {"error": {"$ref": "common.json#/$defs/text"}, "status": {"const": "error"}},
                "required": ["status", "error"],
                "type": "object"
              }
            ]
          },
          "type": "object"
        },
        "well_formed": {"$ref": "common.json#/$defs/text"}
      },
      "required": ["id", "status", "units", "mentions", "well_formed", "environment_id", "source_id", "joint"],
      "type": "object"
    },
    "resolved_target": {
      "$comment": "Discourse.Run.targetJson: members and units only when nonempty.",
      "additionalProperties": false,
      "properties": {
        "kind": {"$ref": "#/$defs/target_kind"},
        "members": {"$ref": "common.json#/$defs/strings", "minItems": 1},
        "name": {"type": "string"},
        "pair": {"$ref": "common.json#/$defs/string_pair"},
        "units": {"$ref": "common.json#/$defs/strings", "minItems": 1}
      },
      "required": ["kind"],
      "type": "object"
    },
    "target_kind": {"enum": ["entity", "predicate", "unit", "anchor", "rule", "claim", "document"]},
    "validity": {
      "$comment": "Discourse.Run discourse-validity: each validity claim's verdict.",
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "status": {"const": "ok"},
        "validity": {"$ref": "#/$defs/validity_map"}
      },
      "required": ["id", "status", "validity"],
      "type": "object"
    },
    "validity_map": {
      "$comment": "Discourse.Admission.verdictText per validity-claim unit.",
      "additionalProperties": {"pattern": "checked|refuted|none|unconfirmed \\(.*", "type": "string"},
      "type": "object"
    }
  }
}
