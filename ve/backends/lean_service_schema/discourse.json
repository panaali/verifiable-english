{
  "$id": "discourse.json",
  "$comment": "Mode discourse: Discourse.Run.runCaseReported (formerly ve_discourse_route). A case on the discourse path (usesDiscoursePath) is answered by the discourse runner; every other case is delegated unchanged to the route mode's runner.",
  "row": {"x-select": [
    {"when": {"$ref": "#/$defs/discourse_path"}, "then": {"anyOf": [
      {"$ref": "common.json#/$defs/case_error"},
      {"$ref": "common.json#/$defs/route_path_error"},
      {"x-select": [
        {"when": {"$ref": "#/$defs/kind/admission"}, "then": {"$ref": "#/$defs/admission"}},
        {"when": {"$ref": "#/$defs/kind/discourse-validity"}, "then": {"$ref": "#/$defs/validity"}},
        {"when": {"$ref": "#/$defs/kind/discourse-resolve"}, "then": {"$ref": "#/$defs/resolve"}},
        {"when": {"$ref": "#/$defs/kind/discourse-joint"}, "then": {"$ref": "#/$defs/joint"}}]}]}},
    {"when": true, "then": {"$ref": "route.json#/row"}}]},
  "$defs": {
    "discourse_path": {"$comment": "Discourse.Run.usesDiscoursePath: a document text, the ve.discourse@1 profile in a profile list of strings (Route.Gate.profilesOf), or a discourse-* kind.",
      "type": "object", "anyOf": [
        {"required": ["document"], "properties": {"document": {"type": "string"}}},
        {"required": ["environment"], "properties": {"environment": {
          "type": "object", "required": ["profiles"], "properties": {"profiles": {
            "type": "array", "items": {"type": "string"}, "contains": {"const": "ve.discourse@1"}}}}}},
        {"required": ["kind"], "properties": {"kind": {"type": "string", "pattern": "discourse-.*"}}}]},
    "kind": {
      "admission": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "admission"}}},
      "discourse-validity": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "discourse-validity"}}},
      "discourse-resolve": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "discourse-resolve"}}},
      "discourse-joint": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "discourse-joint"}}}},
    "target_kind": {"enum": ["entity", "predicate", "unit", "anchor", "rule", "claim", "document"]},
    "reference": {"$comment": "Discourse.Admission.referencesJson: a mention, its unit, its form, its front-matter target (Wire.decodeTarget's fields) and its status.",
      "type": "object", "required": ["mention", "unit", "form", "target", "status"], "additionalProperties": false,
      "properties": {
        "mention": {"type": "string"},
        "unit": {"type": "string"},
        "form": {"enum": ["pronoun", "demonstrative", "definite", "ordinal_pair", "such", "possessive", "plural",
                          "section_ref", "definition_ref", "document_name", "citation", "navigation"]},
        "target": {"type": "object", "required": ["kind"], "additionalProperties": false,
          "properties": {
            "kind": {"$ref": "#/$defs/target_kind"},
            "name": {"type": "string"},
            "version": {"$ref": "common.json#/$defs/nat"},
            "members": {"$ref": "common.json#/$defs/strings"},
            "pair": {"$ref": "common.json#/$defs/string_pair"},
            "units": {"$ref": "common.json#/$defs/strings"},
            "content_name": {"type": "string"}}},
        "status": {"enum": ["pending", "navigation", "resolved"]}}},
    "validity_map": {"$comment": "Discourse.Admission.verdictText per validity-claim unit.",
      "type": "object", "additionalProperties": {"type": "string", "pattern": "checked|refuted|none|unconfirmed \\(.*\\)"}},
    "joint_count": {"$comment": "The number of compatible joint choices, or the joint error.",
      "anyOf": [{"type": "integer", "minimum": 1}, {"$ref": "common.json#/$defs/text"}]},
    "admission": {"$comment": "Discourse.Run.encodeAdmission: the wrapper's admission (ve-document@2, or a lifted ve-document@1 text whose identities are empty and whose joint is the missing manifest).",
      "type": "object", "required": ["id", "status", "admitted", "reading_verdicts", "report", "report_id", "inner_report_id",
        "document_id", "source_id", "environment_id", "definitions_version", "kinds", "references", "bound", "meaning_ids",
        "presuppositions", "pending", "validity", "self_truth", "statuses", "joint"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "status": {"const": "ok"},
        "admitted": {"enum": [true, "UNKNOWN"]},
        "reading_verdicts": {"type": "object", "additionalProperties": {"const": "UNKNOWN (joint choices)"}},
        "report": {"$ref": "common.json#/$defs/report"},
        "report_id": {"$ref": "common.json#/$defs/hex64_or_empty"},
        "inner_report_id": {"$ref": "common.json#/$defs/hex64_or_empty"},
        "document_id": {"$ref": "common.json#/$defs/hex64_or_empty"},
        "source_id": {"$ref": "common.json#/$defs/hex64_or_empty"},
        "environment_id": {"$ref": "common.json#/$defs/hex64_or_empty"},
        "definitions_version": {"$ref": "common.json#/$defs/hex64_or_empty"},
        "kinds": {"type": "array", "items": {"$ref": "common.json#/$defs/kind"}},
        "references": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
        "bound": {"type": "object", "additionalProperties": {"$ref": "common.json#/$defs/generated_formula"}},
        "meaning_ids": {"type": "object", "additionalProperties": {"$ref": "common.json#/$defs/hex64"}},
        "presuppositions": {"type": "object", "additionalProperties": {
          "type": "string", "pattern": "discourse:presupposition:.+: (proved|assumed) \\(.*\\)|discourse:presupposition:.+: unresolved"}},
        "pending": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2,
          "prefixItems": [{"type": "string"}, {"type": "string", "pattern": "PresuppositionUnresolved: .+"}]}},
        "validity": {"$ref": "#/$defs/validity_map"},
        "self_truth": {"$ref": "common.json#/$defs/strings"},
        "statuses": {"type": "object", "additionalProperties": {"enum": ["CHECKED", "OPEN", "LABELLED", "UNFORMALISED"]}},
        "joint": {"$ref": "#/$defs/joint_count"}}},
    "validity": {"$comment": "Discourse.Run discourse-validity: each validity claim's verdict.",
      "type": "object", "required": ["id", "status", "validity"], "additionalProperties": false,
      "properties": {
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "status": {"const": "ok"},
        "validity": {"$ref": "#/$defs/validity_map"}}},
    "resolved_target": {"$comment": "Discourse.Run.targetJson: members and units only when nonempty.",
      "type": "object", "required": ["kind"], "additionalProperties": false,
      "properties": {
        "kind": {"$ref": "#/$defs/target_kind"},
        "name": {"type": "string"},
        "members": {"$ref": "common.json#/$defs/strings", "minItems": 1},
        "pair": {"$ref": "common.json#/$defs/string_pair"},
        "units": {"$ref": "common.json#/$defs/strings", "minItems": 1}}},
    "resolve": {"$comment": "Discourse.Run.runResolve: each bound unit's resolution, each mention's accessible and recorded targets, well-formedness and the joint count.",
      "type": "object", "required": ["id", "status", "units", "mentions", "well_formed", "environment_id", "source_id", "joint"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "status": {"const": "ok"},
        "units": {"type": "object", "additionalProperties": {"anyOf": [
          {"type": "object", "required": ["status", "formula", "meaning_id"], "additionalProperties": false,
           "properties": {"status": {"const": "resolved"}, "formula": {"$ref": "common.json#/$defs/generated_formula"},
                          "meaning_id": {"$ref": "common.json#/$defs/hex64"}}},
          {"type": "object", "required": ["status", "error"], "additionalProperties": false,
           "properties": {"status": {"const": "error"}, "error": {"$ref": "common.json#/$defs/text"}}}]}},
        "mentions": {"type": "object", "additionalProperties": {
          "type": "object", "required": ["accessible", "recorded", "accessible_recorded"], "additionalProperties": false,
          "properties": {
            "accessible": {"type": "array", "items": {"$ref": "#/$defs/resolved_target"}},
            "recorded": {"$ref": "#/$defs/resolved_target"},
            "accessible_recorded": {"type": "boolean"},
            "pin": {"$ref": "common.json#/$defs/nat"}}}},
        "well_formed": {"$ref": "common.json#/$defs/text"},
        "environment_id": {"$ref": "common.json#/$defs/hex64"},
        "source_id": {"$ref": "common.json#/$defs/hex64"},
        "joint": {"$ref": "#/$defs/joint_count"}}},
    "joint": {"$comment": "Discourse.Run.runJoint: the compatible choices and their disjunction, or the diagnostic.",
      "anyOf": [
        {"type": "object", "required": ["id", "status", "verdict", "choices", "joint"], "additionalProperties": false,
         "properties": {
           "id": {"$ref": "common.json#/$defs/id_ok"},
           "status": {"const": "ok"},
           "verdict": {"const": "COMPLETE"},
           "choices": {"type": "array", "minItems": 1, "items": {"type": "array", "items": {
             "type": "array", "minItems": 3, "maxItems": 3,
             "prefixItems": [{"type": "string"}, {"$ref": "common.json#/$defs/nat"}, {"$ref": "common.json#/$defs/nat"}]}}},
           "joint": {"$ref": "common.json#/$defs/generated_formula"}}},
        {"type": "object", "required": ["id", "status", "verdict", "diagnostic"], "additionalProperties": false,
         "properties": {
           "id": {"$ref": "common.json#/$defs/id_ok"},
           "status": {"const": "ok"},
           "verdict": {"enum": ["UNKNOWN", "INVALID"]},
           "diagnostic": {"$ref": "common.json#/$defs/text"}}}]}
  }
}
