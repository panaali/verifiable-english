        "then": {
          "anyOf": [{"$ref": "common.json#/$defs/case_error"}, {"$ref": "#/$defs/refusal"}, {"$ref": "#/$defs/answer"}]
        },
        "when": {"not": {"required": ["software"]}, "type": "object"}
      },
      {
        "then": {
          "anyOf": [
            {"$ref": "common.json#/$defs/case_error"},
            {"$ref": "#/$defs/refusal"},
            {"$ref": "#/$defs/answer_software"}
          ]
        },
        "when": true
