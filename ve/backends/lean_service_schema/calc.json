        "meaning_id": {"$ref": "common.json#/$defs/hex64"},
        "rows": {"type": "array", "x-zip": {"items": {"$ref": "#/$defs/claim_row"}, "of": "/claims"}},
        "status": {"const": "ok"}
      },
      "required": ["status", "meaning_id", "rows"],
      "type": "object"
    },
