{
  "$id": "norm-defaults.json",
  "$comment": "Mode norm-defaults: NormDefaults.Run.runCaseReported (formerly ve_norm_defaults_route). A case on the norm-defaults path (usesNormDefaultsPath) is answered by the norm-defaults runner; every other case is delegated unchanged to the norms mode's runner.",
  "row": {
    "x-select": [
      {
        "then": {
          "anyOf": [
            {"$ref": "common.json#/$defs/case_error"},
            {"$ref": "common.json#/$defs/route_path_error"},
            {
              "x-select": [
                {
                  "then": {"anyOf": [{"$ref": "common.json#/$defs/admission"}, {"$ref": "#/$defs/soft_admission"}]},
                  "when": {"$ref": "#/$defs/kind/admission"}
                },
                {
                  "then": {"anyOf": [{"$ref": "#/$defs/elaborate"}, {"$ref": "#/$defs/layered_elaborate"}]},
                  "when": {"$ref": "#/$defs/kind/norm-defaults-elaborate"}
                },
                {
                  "then": {"$ref": "#/$defs/witness_conflict"},
                  "when": {"allOf": [{"$ref": "#/$defs/kind/norm-defaults-conflict"}, {"required": ["witness"]}]}
                },
                {
                  "then": {"$ref": "common.json#/$defs/packages_conflict"},
                  "when": {"$ref": "#/$defs/kind/norm-defaults-conflict"}
                },
                {"then": {"$ref": "#/$defs/status"}, "when": {"$ref": "#/$defs/kind/norm-defaults-status"}},
                {
                  "then": {"$ref": "#/$defs/gaps_model"},
                  "when": {"allOf": [{"$ref": "#/$defs/kind/norm-defaults-gaps"}, {"required": ["model"]}]}
                },
                {"then": {"$ref": "#/$defs/gaps"}, "when": {"$ref": "#/$defs/kind/norm-defaults-gaps"}},
                {
                  "then": {"$ref": "#/$defs/certificate"},
                  "when": {"$ref": "#/$defs/kind/norm-defaults-certificate"}
                },
                {"then": {"$ref": "#/$defs/report_row"}, "when": {"$ref": "#/$defs/kind/norm-defaults-report"}},
                {
                  "then": {"$ref": "#/$defs/defaults_elaborate"},
                  "when": {"$ref": "#/$defs/kind/defaults-elaborate"}
                },
                {
                  "then": {"$ref": "#/$defs/defaults_coherence"},
                  "when": {"$ref": "#/$defs/kind/defaults-coherence"}
                },
                {
                  "then": {"$ref": "#/$defs/defaults_certificate"},
                  "when": {"$ref": "#/$defs/kind/defaults-certificate"}
                },
                {"then": {"$ref": "#/$defs/defaults_model"}, "when": {"$ref": "#/$defs/kind/defaults-model"}},
                {"then": {"$ref": "#/$defs/defaults_zone"}, "when": {"$ref": "#/$defs/kind/defaults-zone"}},
                {
                  "then": {"$ref": "norms.json#/$defs/acts-elaborate"},
                  "when": {"$ref": "#/$defs/kind/acts-elaborate"}
                }
              ]
            }
          ]
        },
        "when": {"$ref": "#/$defs/norm_defaults_path"}
      },
      {"then": {"$ref": "norms.json#/row"}, "when": true}
    ]
  },
  "$defs": {
    "atom": {
      "additionalProperties": false,
      "properties": {"predicate": {"type": "string"}, "tuple": {"$ref": "common.json#/$defs/strings"}},
      "required": ["predicate", "tuple"],
      "type": "object"
    },
    "base_environment": {
      "$comment": "NormDefaults.Wire.withUnsaid of SoftNorms.Wire.basePrimeJson or Rights.Wire.basePrimeJsonR: Norms.Replay.baseEnvironmentJson of the request environment, with the decision predicates and the unsaid predicates added.",
      "additionalProperties": false,
      "properties": {
        "language": {"type": "string", "x-equals": "/environment/language"},
        "profiles": {"$ref": "common.json#/$defs/strings"},
        "spec_revision": {"type": "string", "x-equals": "/environment/spec_revision"},
        "vocabulary": {
          "additionalProperties": false,
          "properties": {
            "constants": {
              "else": {"x-equals": "/environment/vocabulary/constants"},
              "if": {"x-case": {"$ref": "common.json#/$defs/request_block/events"}},
              "then": {
                "additionalProperties": {
                  "additionalProperties": false,
                  "properties": {"description": {"type": "string"}, "sort": {"type": "string"}},
                  "required": ["sort", "description"],
                  "type": "object"
                }
              },
              "type": "object"
            },
            "predicates": {
              "additionalProperties": {
                "properties": {"arguments": {"$ref": "common.json#/$defs/strings"}},
                "required": ["arguments"],
                "type": "object"
              },
              "type": "object"
            },
            "sorts": {"type": "object", "x-equals": "/environment/vocabulary/sorts"}
          },
          "required": ["sorts", "predicates", "constants"],
          "type": "object"
        }
      },
      "required": ["language", "profiles", "spec_revision", "vocabulary"],
      "type": "object"
    },
    "certificate": {
      "$comment": "norm-defaults-certificate: the replay's verdict and its premise count.",
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "premises": {"$ref": "common.json#/$defs/nat"},
        "status": {"const": "ok"},
        "valid": {"type": "boolean"}
      },
      "required": ["id", "status", "valid", "premises"],
      "type": "object"
    },
    "defaults_certificate": {
      "$comment": "Defaults.Wire.certFields (defaults-certificate): FOLLOWS with its basis, form and kept assumptions (defaults_certificate_sound), or UNKNOWN with its reason (CertReplay.reason).",
      "additionalProperties": false,
      "else": {
        "allOf": [
          {"required": ["reason"]},
          {"not": {"required": ["basis"]}},
          {"not": {"required": ["form"]}},
          {"not": {"required": ["assumptions"]}},
          {"not": {"required": ["deciders"]}}
        ]
      },
      "if": {"properties": {"verdict": {"const": "FOLLOWS"}}},
      "properties": {
        "assumptions": {"$ref": "common.json#/$defs/strings"},
        "basis": {"enum": ["strict", "needs", "unsettled"]},
        "deciders": {"$ref": "common.json#/$defs/strings"},
        "form": {"enum": ["short", "long"]},
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "reason": {"type": "string"},
        "status": {"const": "ok"},
        "verdict": {"enum": ["FOLLOWS", "UNKNOWN"]}
      },
      "required": ["id", "status", "verdict"],
      "then": {"allOf": [{"required": ["basis", "form", "assumptions", "deciders"]}, {"not": {"required": ["reason"]}}]},
      "type": "object"
    },
    "defaults_coherence": {
      "$comment": "Defaults.Wire.coherenceFields (defaults-coherence): the verdict and each colliding pair's status; with COLLISION, the pair the request's collision names, the tuple Lean finds (collisionTuple), DE7's deciders (giveWayDeciders) and the situation.",
      "additionalProperties": false,
      "else": {"allOf": [{"not": {"required": ["collision"]}}, {"not": {"required": ["situation"]}}]},
      "if": {"properties": {"verdict": {"const": "COLLISION"}}},
      "properties": {
        "collision": {
          "additionalProperties": false,
          "properties": {
            "deciders": {"$ref": "common.json#/$defs/strings"},
            "rules": {"$ref": "common.json#/$defs/string_pair", "x-equals": "/collision/rules"},
            "tuple": {"$ref": "common.json#/$defs/strings"}
          },
          "required": ["rules", "tuple", "deciders"],
          "type": "object"
        },
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "pairs": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "rules": {"$ref": "common.json#/$defs/string_pair"},
              "status": {"enum": ["resolved", "collision", "unknown"]}
            },
            "required": ["rules", "status"],
            "type": "object"
          },
          "type": "array"
        },
        "situation": {"$ref": "#/$defs/defaults_situation"},
        "status": {"const": "ok"},
        "verdict": {"enum": ["COHERENT", "COLLISION", "UNKNOWN"]}
      },
      "required": ["id", "status", "verdict", "pairs"],
      "then": {"required": ["collision", "situation"]},
      "type": "object"
    },
    "defaults_elaborate": {
      "$comment": "Defaults.Wire.elaborateFields (defaults-elaborate): Dflt_T's labelled premises, then each colliding pair's two rule names and coherence premise (Defaults.Wire.elaborateRows).",
      "additionalProperties": false,
      "properties": {
        "coherence_targets": {
          "items": {
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [{"type": "string"}, {"type": "string"}, {"$ref": "common.json#/$defs/generated_formula"}],
            "type": "array"
          },
          "type": "array"
        },
        "deciders": {"$ref": "common.json#/$defs/strings"},
        "default_premises": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [{"$ref": "common.json#/$defs/text"}, {"$ref": "common.json#/$defs/generated_formula"}],
            "type": "array"
          },
          "type": "array"
        },
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "status": {"const": "ok"}
      },
      "required": ["id", "status", "deciders", "default_premises", "coherence_targets"],
      "type": "object"
    },
    "defaults_model": {
      "$comment": "Defaults.Wire.modelFields (defaults-model): DOES-NOT-FOLLOW with the situation and each exception the text's own conditions force there (defaults_model_sound, forcedAt_sound), or UNKNOWN.",
      "additionalProperties": false,
      "else": {"allOf": [{"not": {"required": ["situation"]}}, {"not": {"required": ["forced"]}}]},
      "if": {"properties": {"verdict": {"const": "DOES-NOT-FOLLOW"}}},
      "properties": {
        "forced": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "condition": {"$ref": "common.json#/$defs/nat"},
              "rule": {"type": "string"},
              "tuple": {"$ref": "common.json#/$defs/strings"}
            },
            "required": ["rule", "condition", "tuple"],
            "type": "object"
          },
          "type": "array"
        },
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "situation": {"$ref": "#/$defs/defaults_situation"},
        "status": {"const": "ok"},
        "verdict": {"enum": ["DOES-NOT-FOLLOW", "UNKNOWN"]}
      },
      "required": ["id", "status", "verdict"],
      "then": {"required": ["situation", "forced"]},
      "type": "object"
    },
    "defaults_situation": {
      "$comment": "Defaults.Wire.situationJson: every unsaid table of the checked filled situation (NormDefaults.Wire.witnessRow), rows as entity ids.",
      "additionalProperties": false,
      "properties": {
        "filling": {
          "additionalProperties": {"items": {"$ref": "common.json#/$defs/strings"}, "type": "array"},
          "type": "object"
        }
      },
      "required": ["filling"],
      "type": "object"
    },
    "defaults_zone": {
      "$comment": "Defaults.Wire.zoneFields (defaults-zone): the zone (defaultZoneOf); with byDefault (its value) or leftTo, DE10's form (zoneFormOf), forcedAll (forcedAllOf) and the completions shown, each a list of rows; with noCompletion its labels; with unknown its reason.",
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "allOf": [
              {"not": {"required": ["form"]}},
              {"not": {"required": ["forced_all"]}},
              {"not": {"required": ["completions"]}}
            ]
          },
          "if": {"properties": {"zone": {"enum": ["byDefault", "leftTo"]}}},
          "then": {"required": ["form", "forced_all", "completions"]}
        },
        {
          "else": {"not": {"required": ["value"]}},
          "if": {"properties": {"zone": {"const": "byDefault"}}},
          "then": {"required": ["value"]}
        },
        {
          "else": {"not": {"required": ["labels"]}},
          "if": {"properties": {"zone": {"const": "noCompletion"}}},
          "then": {"required": ["labels"]}
        },
        {
          "else": {"not": {"required": ["reason"]}},
          "if": {"properties": {"zone": {"const": "unknown"}}},
          "then": {"required": ["reason"]}
        }
      ],
      "properties": {
        "completions": {"items": {"items": {"$ref": "#/$defs/defaults_zone_line"}, "type": "array"}, "type": "array"},
        "forced_all": {
          "items": {
            "additionalProperties": false,
            "properties": {"rule": {"type": "string"}, "tuple": {"$ref": "common.json#/$defs/strings"}},
            "required": ["rule", "tuple"],
            "type": "object"
          },
          "type": "array"
        },
        "form": {"enum": ["short", "long"]},
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "labels": {"$ref": "common.json#/$defs/strings"},
        "reason": {"type": "string"},
        "status": {"const": "ok"},
        "value": {"type": "boolean"},
        "zone": {"enum": ["byDefault", "leftTo", "notSaid", "noCompletion", "unknown"]}
      },
      "required": ["id", "status", "zone"],
      "type": "object"
    },
    "defaults_zone_line": {
      "$comment": "Defaults.Wire.ZoneLine.json: one true decision of the completion shown, DE11 (a stated condition's index), DE10f (in forcedAll) or DE13 (the decision by its key).",
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "condition": {"$ref": "common.json#/$defs/nat"},
            "row": {"const": "DE11"},
            "rule": {"type": "string"},
            "tuple": {"$ref": "common.json#/$defs/strings"}
          },
          "required": ["row", "rule", "condition", "tuple"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "row": {"const": "DE10f"},
            "rule": {"type": "string"},
            "tuple": {"$ref": "common.json#/$defs/strings"}
          },
          "required": ["row", "rule", "tuple"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "decision": {"$ref": "soft-norms.json#/$defs/decision_key"},
            "row": {"const": "DE13"},
            "tuple": {"$ref": "common.json#/$defs/strings"}
          },
          "required": ["row", "decision", "tuple"],
          "type": "object"
        }
      ]
    },
    "elaborate": {
      "$comment": "NormDefaults.Wire.regeneratedU: Norms.Wire.regenerated of fill U, then Fill_T, the unspecified predicates, their unsaid predicates, the default-reached targets and the fragment flag of fill U.",
      "additionalProperties": false,
      "properties": {
        "background": {"$ref": "common.json#/$defs/norms_background"},
        "conflict_targets": {"$ref": "common.json#/$defs/conflict_targets"},
        "document_hash": {"type": "string"},
        "environment_id": {"type": "string"},
        "fill": {
          "items": {
            "additionalProperties": false,
            "properties": {"ast": {"$ref": "common.json#/$defs/generated_formula"}, "generator": {"const": "fill"}},
            "required": ["generator", "ast"],
            "type": "object"
          },
          "type": "array"
        },
        "fill_hash": {"type": "string"},
        "fill_labels": {"$ref": "common.json#/$defs/strings"},
        "filled_environment_id": {"type": "string"},
        "fragment": {"type": "boolean"},
        "fragment_fill": {"type": "boolean"},
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "order": {"$ref": "common.json#/$defs/strings"},
        "premises": {"$ref": "common.json#/$defs/layer_premises"},
        "reached": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "ast": {"$ref": "common.json#/$defs/generated_formula"},
              "predicate": {"type": "string"},
              "sorts": {"$ref": "common.json#/$defs/strings"}
            },
            "required": ["predicate", "sorts", "ast"],
            "type": "object"
          },
          "type": "array"
        },
        "status": {"const": "ok"},
        "unsaid": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "description": {"minLength": 1, "type": "string"},
              "name": {"pattern": "unsaid__.*", "type": "string"},
              "sorts": {"$ref": "common.json#/$defs/strings"}
            },
            "required": ["name", "sorts", "description"],
            "type": "object"
          },
          "type": "array"
        },
        "unspecified": {"$ref": "common.json#/$defs/strings"},
        "wordings": {
          "$comment": "Norms.Wire.plainWordings of the source: one wording per plain predicate with an act, by its name.",
          "$ref": "common.json#/$defs/string_map"
        }
      },
      "required": [
        "id",
        "status",
        "order",
        "background",
        "premises",
        "conflict_targets",
        "fragment",
        "fill",
        "unspecified",
        "unsaid",
        "reached",
        "fragment_fill",
        "filled_environment_id",
        "fill_hash",
        "fill_labels",
        "environment_id",
        "document_hash",
        "wordings"
      ],
      "type": "object"
    },
    "gaps": {
      "$comment": "norm-defaults-gaps without a model: whether a certificate shows no gap.",
      "additionalProperties": false,
      "properties": {
        "gaps": {"enum": ["none", "unknown"]},
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "predicate": {"type": "string", "x-equals": "/predicate"},
        "status": {"const": "ok"}
      },
      "required": ["id", "status", "gaps", "predicate"],
      "type": "object"
    },
    "gaps_model": {
      "$comment": "norm-defaults-gaps with a model: whether the default is reached in it.",
      "additionalProperties": false,
      "properties": {
        "gaps": {"enum": ["reachable", "unknown"]},
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "predicate": {"type": "string", "x-equals": "/predicate"},
        "status": {"const": "ok"}
      },
      "required": ["id", "status", "gaps", "predicate"],
      "type": "object"
    },
    "kind": {
      "acts-elaborate": {"properties": {"kind": {"const": "acts-elaborate"}}, "required": ["kind"], "type": "object"},
      "admission": {"properties": {"kind": {"const": "admission"}}, "required": ["kind"], "type": "object"},
      "defaults-certificate": {"properties": {"kind": {"const": "defaults-certificate"}}, "required": ["kind"], "type": "object"},
      "defaults-coherence": {"properties": {"kind": {"const": "defaults-coherence"}}, "required": ["kind"], "type": "object"},
      "defaults-elaborate": {"properties": {"kind": {"const": "defaults-elaborate"}}, "required": ["kind"], "type": "object"},
      "defaults-model": {"properties": {"kind": {"const": "defaults-model"}}, "required": ["kind"], "type": "object"},
      "defaults-zone": {"properties": {"kind": {"const": "defaults-zone"}}, "required": ["kind"], "type": "object"},
      "norm-defaults-certificate": {"properties": {"kind": {"const": "norm-defaults-certificate"}}, "required": ["kind"], "type": "object"},
      "norm-defaults-conflict": {"properties": {"kind": {"const": "norm-defaults-conflict"}}, "required": ["kind"], "type": "object"},
      "norm-defaults-elaborate": {"properties": {"kind": {"const": "norm-defaults-elaborate"}}, "required": ["kind"], "type": "object"},
      "norm-defaults-gaps": {"properties": {"kind": {"const": "norm-defaults-gaps"}}, "required": ["kind"], "type": "object"},
      "norm-defaults-report": {"properties": {"kind": {"const": "norm-defaults-report"}}, "required": ["kind"], "type": "object"},
      "norm-defaults-status": {"properties": {"kind": {"const": "norm-defaults-status"}}, "required": ["kind"], "type": "object"}
    },
    "layered_elaborate": {
      "$comment": "NormDefaults.Wire.layeredElaborate (the soft and rights branches): regeneratedU of fill U, then the soft and rights layer premises of the route's base, its environment id and document hash, and its base environment.",
      "additionalProperties": false,
      "properties": {
        "background": {"$ref": "common.json#/$defs/norms_background"},
        "base_environment": {"$ref": "#/$defs/base_environment"},
        "conflict_targets": {"$ref": "common.json#/$defs/conflict_targets"},
        "document_hash": {"type": "string"},
        "environment_id": {"type": "string"},
        "events_premises": {"$ref": "common.json#/$defs/labelled_list"},
        "fill": {
          "items": {
            "additionalProperties": false,
            "properties": {"ast": {"$ref": "common.json#/$defs/generated_formula"}, "generator": {"const": "fill"}},
            "required": ["generator", "ast"],
            "type": "object"
          },
          "type": "array"
        },
        "fragment": {"type": "boolean"},
        "fragment_fill": {"type": "boolean"},
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "order": {"$ref": "common.json#/$defs/strings"},
        "premises": {"$ref": "common.json#/$defs/layer_premises"},
        "reached": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "ast": {"$ref": "common.json#/$defs/generated_formula"},
              "predicate": {"type": "string"},
              "sorts": {"$ref": "common.json#/$defs/strings"}
            },
            "required": ["predicate", "sorts", "ast"],
            "type": "object"
          },
          "type": "array"
        },
        "rights": {"$ref": "common.json#/$defs/labelled_list"},
        "soft": {"$ref": "common.json#/$defs/labelled_list"},
        "status": {"const": "ok"},
        "unsaid": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "description": {"minLength": 1, "type": "string"},
              "name": {"pattern": "unsaid__.*", "type": "string"},
              "sorts": {"$ref": "common.json#/$defs/strings"}
            },
            "required": ["name", "sorts", "description"],
            "type": "object"
          },
          "type": "array"
        },
        "unspecified": {"$ref": "common.json#/$defs/strings"}
      },
      "required": [
        "id",
        "status",
        "order",
        "background",
        "premises",
        "conflict_targets",
        "fragment",
        "fill",
        "unspecified",
        "unsaid",
        "reached",
        "fragment_fill",
        "soft",
        "rights",
        "environment_id",
        "document_hash",
        "base_environment"
      ],
      "type": "object"
    },
    "norm_defaults_path": {
      "$comment": "NormDefaults.Run.usesNormDefaultsPath: the norm-defaults@0 profile in a profile list of strings (Wire.hasProfile), a regulated predicate whose default is unspecified (Wire.unspecifiedNames), or a norm-defaults-* kind.",
      "anyOf": [
        {
          "properties": {
            "environment": {
              "properties": {
                "profiles": {"contains": {"const": "norm-defaults@0"}, "items": {"type": "string"}, "type": "array"}
              },
              "required": ["profiles"],
              "type": "object"
            }
          },
          "required": ["environment"]
        },
        {
          "properties": {
            "environment": {
              "properties": {
                "vocabulary": {
                  "properties": {
                    "predicates": {
                      "not": {
                        "additionalProperties": {
                          "not": {
                            "properties": {
                              "regulated": {
                                "properties": {"default": {"const": "unspecified"}},
                                "required": ["default"],
                                "type": "object"
                              }
                            },
                            "required": ["regulated"],
                            "type": "object"
                          }
                        }
                      },
                      "type": "object"
                    }
                  },
                  "required": ["predicates"],
                  "type": "object"
                }
              },
              "required": ["vocabulary"],
              "type": "object"
            }
          },
          "required": ["environment"]
        },
        {"properties": {"kind": {"pattern": "norm-defaults-.*", "type": "string"}}, "required": ["kind"]}
      ],
      "type": "object"
    },
    "report_line": {
      "$comment": "NormDefaults.Wire.LineU.toJson: one regulated predicate's lines (spec 3.2); `witness` (NormDefaults.Wire.WitnessRow.toJson: the tuple's entity ids and every unsaid table of the checked filled situation) and `value` (NormDefaults.Wire.completedLabel: the completion's value where no author rule decides) exactly on a reachable line.",
      "additionalProperties": false,
      "else": {"not": {"required": ["value"]}},
      "if": {"required": ["witness"]},
      "properties": {
        "completion": {"enum": ["deny", "allow", "unspecified"]},
        "inherits_from": {"$ref": "common.json#/$defs/strings"},
        "lines": {"$ref": "common.json#/$defs/strings"},
        "predicate": {"type": "string"},
        "reached": {"enum": ["none", "reachable", "unknown"]},
        "value": {"enum": ["yes", "no", "unsaid"]},
        "witness": {
          "additionalProperties": false,
          "properties": {
            "filling": {
              "additionalProperties": {"items": {"$ref": "common.json#/$defs/strings"}, "type": "array"},
              "type": "object"
            },
            "tuple": {"$ref": "common.json#/$defs/strings"}
          },
          "required": ["tuple", "filling"],
          "type": "object"
        }
      },
      "required": ["predicate", "completion", "reached", "lines", "inherits_from"],
      "then": {"required": ["value"]},
      "type": "object"
    },
    "report_row": {
      "$comment": "NormDefaults.Wire.ReportG.toJson (norm-defaults-report): the lines of every regulated predicate, the residual and the findings.",
      "additionalProperties": false,
      "properties": {
        "findings": {"$ref": "common.json#/$defs/strings"},
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "report": {"items": {"$ref": "#/$defs/report_line"}, "type": "array"},
        "residual": {
          "additionalProperties": false,
          "properties": {
            "gaps": {"$ref": "common.json#/$defs/strings"},
            "ungrounded_defaults": {"$ref": "common.json#/$defs/nat"}
          },
          "required": ["gaps", "ungrounded_defaults"],
          "type": "object"
        },
        "status": {"const": "ok"}
      },
      "required": ["id", "status", "report", "residual", "findings"],
      "type": "object"
    },
    "soft_admission": {
      "$comment": "NormDefaults.Admission.encodeAdmittedX (the soft branch's admission, Run.runCase's soft dispatch): W2's admission answer on the filled soft tree and the open coherence premises the report assumes, as the soft route's admission answer lists them.",
      "additionalProperties": false,
      "properties": {
        "admitted": {"const": true},
        "conditional_on": {"$ref": "soft-norms.json#/$defs/coherence_labels"},
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "kinds": {"items": {"$ref": "common.json#/$defs/kind"}, "type": "array", "x-equals": "/document/units/*/kind"},
        "report": {"$ref": "common.json#/$defs/bound_report"},
        "report_id": {"$ref": "common.json#/$defs/hex64"},
        "status": {"const": "ok"}
      },
      "required": ["id", "status", "admitted", "report", "report_id", "kinds", "conditional_on"],
      "type": "object"
    },
    "status": {
      "$comment": "NormDefaults.Run.runOtherCase and Wire.runLayered norm-defaults-status: the requested predicate's point status, then NormDefaults.Wire.statusFields: the tuple's entity ids, the deciding author rules, each with the request rule it comes from (Wire.ruleSources: an acts@0 part's split rule, a rights@0 fan-out's norm or bar rule's bar, else itself), and the atoms where two UNDECIDED fillings differ.",
      "additionalProperties": false,
      "properties": {
        "differs": {"items": {"$ref": "#/$defs/atom"}, "type": "array"},
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "point_status": {"enum": ["SETTLED yes", "SETTLED no", "UNDECIDED", "UNKNOWN"]},
        "predicate": {"type": "string", "x-equals": "/predicate"},
        "rules": {"$ref": "common.json#/$defs/strings", "x-unique-strings": true},
        "sources": {
          "items": {
            "additionalProperties": false,
            "properties": {"rule": {"type": "string"}, "source": {"type": "string"}},
            "required": ["rule", "source"],
            "type": "object"
          },
          "type": "array"
        },
        "status": {"const": "ok"},
        "tuple": {"$ref": "common.json#/$defs/strings", "x-equals": "/tuple"}
      },
      "required": ["id", "status", "point_status", "predicate", "tuple", "rules", "sources", "differs"],
      "type": "object",
      "x-same-length": ["rules", "sources"]
    },
    "witness_conflict": {
      "$comment": "A conflict witness replay (NormDefaults.Wire.replayWitnessU and Wire.witnessConflictX): the requested target; exactly a CONFLICT also carries NormDefaults.Wire.conflictFields: the tuple's entity ids, the kind, the deciding assignment and the deciding author rules.",
      "additionalProperties": false,
      "else": {
        "allOf": [
          {"not": {"required": ["tuple"]}},
          {"not": {"required": ["kind"]}},
          {"not": {"required": ["under"]}},
          {"not": {"required": ["rules"]}}
        ]
      },
      "if": {"properties": {"verdict": {"const": "CONFLICT"}}},
      "properties": {
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "kind": {"enum": ["settled", "latent"]},
        "rules": {"$ref": "common.json#/$defs/strings"},
        "status": {"const": "ok"},
        "target": {"type": "string", "x-equals": "/witness/target"},
        "targets": {"$ref": "common.json#/$defs/strings"},
        "tuple": {"$ref": "common.json#/$defs/strings"},
        "under": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "predicate": {"type": "string"},
              "tuple": {"$ref": "common.json#/$defs/strings"},
              "value": {"type": "boolean"}
            },
            "required": ["predicate", "tuple", "value"],
            "type": "object"
          },
          "type": "array"
        },
        "verdict": {"enum": ["CONFLICT", "UNKNOWN"]}
      },
      "required": ["id", "status", "verdict", "target", "targets"],
      "then": {"required": ["tuple", "kind", "under", "rules"]},
      "type": "object"
    }
  }
}
