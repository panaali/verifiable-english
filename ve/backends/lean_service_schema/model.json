{
  "$id": "model.json",
  "$comment": "Standalone checked finite model and recomputed identity.",
  "row": {
    "anyOf": [
      {"$ref": "common.json#/$defs/case_error"},
      {"$ref": "common.json#/$defs/error"},
      {
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "x-equals": "/id"},
          "model_id": {"$ref": "common.json#/$defs/hex64"},
          "status": {"const": "ok"},
          "valid": {"const": true}
        },
        "required": ["id", "status", "valid", "model_id"],
        "type": "object"
      }
    ]
  }
}
