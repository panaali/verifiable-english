{
  "$id": "envelope.json",
  "$comment": "Service.Protocol lines. `handshake` is the first line; the context of `response` is the request: {id (the nonce), mode, cases (decoded), digests (SHA-256 of each case text as sent, null when the cases text does not split into cases), bytes (trimmed cases text)}. A bound request error is kept; any other mismatch is operational. Binding: the response echoes the nonce and mode, and result i is {index: i, digest: the digest of case i, result}, so omitted, reordered, duplicated and substituted results are rejected without semantic checks; a request error echoes the nonce, the mode and every case digest (docs/spec/lean-service.md, threat model). Every rejection, a request error or a result whose status is error, carries `code` (Service.Protocol.rejectionCode).",
  "handshake": {
    "$comment": "Service.Protocol.handshake: this protocol, every mode, the code domain, the limits and the handle table.",
    "additionalProperties": false,
    "properties": {
      "codes": {
        "$comment": "Service.Protocol.rejectionCodes: exactly the code domain of the rows (common.json code), so a service with another code list is refused at its start.",
        "const": [
          "InvalidInput",
          "SyntaxError",
          "UnknownSymbol",
          "DuplicateDeclaration",
          "UnboundVariable",
          "ShadowedVariable",
          "TypeMismatch",
          "InvalidModel",
          "UnsupportedProfile",
          "ResourceLimit",
          "AdmissionError",
          "CheckerUnavailable"
        ]
      },
      "handles": {
        "$comment": "Service.Protocol.Handles: the case member naming a handle and the table's bounds, exactly: the client keeps the same table (Handles.insert).",
        "additionalProperties": false,
        "properties": {"max": {"const": 64}, "max_bytes": {"const": 67108864}, "member": {"const": "environment_handle"}},
        "required": ["member", "max", "max_bytes"],
        "type": "object"
      },
      "lean": {"type": "string"},
      "limits": {
        "$comment": "VE.Limits.stated: the runtime envelope's limits, exactly: the client reads every limit from here (ve/limits.py).",
        "additionalProperties": false,
        "properties": {
          "json_depth": {"const": 256},
          "max_cases": {"const": 4096},
          "max_depth": {"const": 64},
          "max_entities": {"const": 1000},
          "max_evaluations": {"const": 1000000},
          "max_identifier_bytes": {"const": 64},
          "max_index": {"const": 9007199254740991},
          "max_line_bytes": {"const": 16777216},
          "max_nodes": {"const": 10000},
          "max_package_bytes": {"const": 16777216},
          "max_predicates": {"const": 256},
          "max_sorts": {"const": 32},
          "max_source_bytes": {"const": 65536},
          "max_tuples": {"const": 100000}
        },
        "required": [
          "max_source_bytes",
          "max_package_bytes",
          "max_depth",
          "max_nodes",
          "max_sorts",
          "max_predicates",
          "max_entities",
          "max_tuples",
          "max_identifier_bytes",
          "max_evaluations",
          "max_index",
          "json_depth",
          "max_line_bytes",
          "max_cases"
        ],
        "type": "object"
      },
      "modes": {
        "$comment": "Service.registry: exactly the registered modes, in order: the client reads its mode list from here (ve/backends/service_schema.py MODES), so a service with other modes is refused at its start.",
        "const": [
          "evaluate",
          "check-certificate",
          "order",
          "route",
          "norms",
          "english",
          "english.read",
          "english.grammar",
          "english.check",
          "environment",
          "model",
          "check",
          "identity",
          "parse",
          "graph",
          "readings",
          "readings-choices",
          "bundle",
          "family-norms",
          "soft-norms",
          "rights",
          "speech-acts",
          "reports",
          "alternatives",
          "risk",
          "risk-eval",
          "quantity",
          "norm-defaults",
          "discourse",
          "readings-route",
          "diagnose",
          "document",
          "english.question",
          "search-budget",
          "ask",
          "words",
          "metered",
          "calc"
        ]
      },
      "protocol": {"const": 2},
      "service": {"const": "ve-lean@1"}
    },
    "required": ["service", "protocol", "modes", "codes", "limits", "handles"],
    "type": "object"
  },
  "response": {"anyOf": [{"$ref": "#/$defs/ok"}, {"$ref": "#/$defs/error"}]},
  "$defs": {
    "bound": {
      "$comment": "Service.Protocol.bound: the result's position, the digest of its case and the runner's result for that case; beside a rejection (an error row with a text error), its code and the generator an InvalidModel(generator) message names (Service.Protocol.coding), beside any other result neither.",
      "additionalProperties": false,
      "else": {"not": {"anyOf": [{"required": ["code"]}, {"required": ["generator"]}]}},
      "if": {
        "properties": {
          "result": {
            "properties": {"error": {"type": "string"}, "status": {"const": "error"}},
            "required": ["status", "error"],
            "type": "object"
          }
        }
      },
      "properties": {
        "code": {"$ref": "common.json#/$defs/code"},
        "digest": {"x-digest": true},
        "generator": {"type": "string"},
        "index": {"x-index": true},
        "result": {"x-row": true}
      },
      "required": ["index", "digest", "result"],
      "then": {"required": ["code"]},
      "type": "object"
    },
    "error": {
      "$comment": "Service.Protocol.requestError: a request error is bound like a response, to the nonce, the mode and the digests of the cases as sent (null when the cases text does not split into cases). The unbound lineError answers no request.",
      "additionalProperties": false,
      "properties": {
        "code": {"$ref": "common.json#/$defs/code"},
        "digests": {"x-equals": "/digests"},
        "error": {"$ref": "common.json#/$defs/text"},
        "id": {"type": "string", "x-equals": "/id"},
        "mode": {"type": "string", "x-equals": "/mode"},
        "status": {"const": "error"}
      },
      "required": ["id", "status", "mode", "digests", "error", "code"],
      "type": "object"
    },
    "ok": {
      "additionalProperties": false,
      "properties": {
        "counts": {
          "additionalProperties": false,
          "properties": {
            "bytes": {"type": "integer", "x-equals": "/bytes"},
            "cases": {"type": "integer", "x-count": "/cases"},
            "errors": {"$ref": "common.json#/$defs/nat"}
          },
          "required": ["cases", "bytes", "errors"],
          "type": "object"
        },
        "id": {"type": "string", "x-equals": "/id"},
        "mode": {"type": "string", "x-equals": "/mode"},
        "results": {"type": "array", "x-length": "/cases", "x-rows": {"$ref": "#/$defs/bound"}},
        "status": {"const": "ok"}
      },
      "required": ["id", "status", "mode", "results", "counts"],
      "type": "object",
      "x-count-where": {
        "array": "/results",
        "equals": "/counts/errors",
        "where": {
          "properties": {"result": {"properties": {"status": {"const": "error"}}, "required": ["status"], "type": "object"}},
          "type": "object"
        }
      }
    }
  }
}
