{
  "$id": "english.command.json",
  "$comment": "Mode english.command: VE.Commands.Run.caseReported. readInstruction's outcome for one command wording.",
  "row": {
    "anyOf": [
      {"$ref": "common.json#/$defs/case_error"},
      {
        "additionalProperties": false,
        "properties": {"error": {"$ref": "common.json#/$defs/text"}, "id": {"x-echo": "/id"}, "status": {"const": "error"}},
        "required": ["id", "status", "error"],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "x-equals": "/id"},
          "result": {"$ref": "#/$defs/answer"},
          "status": {"const": "ok"}
        },
        "required": ["id", "status", "result"],
        "type": "object"
      }
    ]
  },
  "$defs": {
    "alternative": {
      "$comment": "VE.Commands.Run.altIndexes: one alternative of many (StepOutcome.many): its shape and the positions of its readings in the answer's readings, one per step of a sequence.",
      "additionalProperties": false,
      "properties": {
        "readings": {"items": {"$ref": "common.json#/$defs/nat"}, "type": "array"},
        "shape": {"enum": ["core", "preposed", "after", "seq", "form", "purpose"]}
      },
      "required": ["shape", "readings"],
      "type": "object"
    },
    "answer": {
      "anyOf": [
        {
          "$comment": "readInstruction's one reading, and whether it is a Then step (after_previous).",
          "additionalProperties": false,
          "properties": {
            "after_previous": {"type": "boolean"},
            "legend": {"items": {"$ref": "common.json#/$defs/text"}, "minItems": 1, "type": "array"},
            "outcome": {"const": "one"},
            "reading": {"$ref": "#/$defs/reading"},
            "unit": {"type": "string", "x-equals": "/unit"},
            "wording": {"type": "string", "x-equals": "/wording"}
          },
          "required": ["unit", "wording", "legend", "outcome", "reading", "after_previous"],
          "type": "object"
        },
        {
          "$comment": "readInstruction's stated sequence: one reading per step, in order, and speech-acts' paraphraseSteps.",
          "additionalProperties": false,
          "properties": {
            "legend": {"items": {"$ref": "common.json#/$defs/text"}, "minItems": 1, "type": "array"},
            "outcome": {"const": "steps"},
            "paraphrase": {"$ref": "common.json#/$defs/text"},
            "readings": {"items": {"$ref": "#/$defs/reading"}, "type": "array"},
            "unit": {"type": "string", "x-equals": "/unit"},
            "wording": {"type": "string", "x-equals": "/wording"}
          },
          "required": ["unit", "wording", "legend", "outcome", "readings", "paraphrase"],
          "type": "object"
        },
        {
          "$comment": "readInstruction's competing alternatives (2 to readingsBound): every alternative's readings, in order, and each alternative's shape and reading positions.",
          "additionalProperties": false,
          "properties": {
            "alternatives": {"items": {"$ref": "#/$defs/alternative"}, "type": "array"},
            "legend": {"items": {"$ref": "common.json#/$defs/text"}, "minItems": 1, "type": "array"},
            "outcome": {"const": "many"},
            "readings": {"items": {"$ref": "#/$defs/reading"}, "type": "array"},
            "unit": {"type": "string", "x-equals": "/unit"},
            "wording": {"type": "string", "x-equals": "/wording"}
          },
          "required": ["unit", "wording", "legend", "outcome", "readings", "alternatives"],
          "type": "object"
        },
        {
          "$comment": "readInstruction's refusal: its code, class and text (QueryMismatch's text is the unit).",
          "additionalProperties": false,
          "properties": {
            "class": {"$ref": "common.json#/$defs/text"},
            "code": {"$ref": "common.json#/$defs/text"},
            "legend": {"items": {"$ref": "common.json#/$defs/text"}, "minItems": 1, "type": "array"},
            "outcome": {"const": "refused"},
            "text": {"$ref": "common.json#/$defs/text"},
            "unit": {"type": "string", "x-equals": "/unit"},
            "wording": {"type": "string", "x-equals": "/wording"}
          },
          "required": ["unit", "wording", "legend", "outcome", "code", "class", "text"],
          "type": "object"
        },
        {
          "$comment": "readInstruction at its work limit (Texts.limitText).",
          "additionalProperties": false,
          "properties": {
            "legend": {"items": {"$ref": "common.json#/$defs/text"}, "minItems": 1, "type": "array"},
            "outcome": {"const": "limit"},
            "text": {"$ref": "common.json#/$defs/text"},
            "unit": {"type": "string", "x-equals": "/unit"},
            "wording": {"type": "string", "x-equals": "/wording"}
          },
          "required": ["unit", "wording", "legend", "outcome", "text"],
          "type": "object"
        },
        {
          "$comment": "A reading with a purpose clause (CI-7b; no reader writes it yet).",
          "additionalProperties": false,
          "properties": {
            "legend": {"items": {"$ref": "common.json#/$defs/text"}, "minItems": 1, "type": "array"},
            "outcome": {"const": "mixed"},
            "purpose": {"$ref": "common.json#/$defs/text"},
            "reading": {"$ref": "#/$defs/reading"},
            "unit": {"type": "string", "x-equals": "/unit"},
            "wording": {"type": "string", "x-equals": "/wording"}
          },
          "required": ["unit", "wording", "legend", "outcome", "reading", "purpose"],
          "type": "object"
        }
      ]
    },
    "fill": {
      "$comment": "VE.Commands.Run.readingJson: a fill's constant and words, and their span in code points of the wording (null for the proof task's query, and when the reading's start in the wording is not known).",
      "additionalProperties": false,
      "properties": {
        "constant": {"$ref": "common.json#/$defs/text"},
        "span": {
          "anyOf": [
            {"type": "null"},
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [{"$ref": "common.json#/$defs/nat"}, {"$ref": "common.json#/$defs/nat"}],
              "type": "array"
            }
          ]
        },
        "words": {"$ref": "common.json#/$defs/text"}
      },
      "required": ["constant", "words", "span"],
      "type": "object"
    },
    "reading": {
      "$comment": "VE.Commands.Run.readingJson: the command object (SA 3.2), its fills (at most one: a decoded environment's predicates have at most two argument sorts), the proof task's query (else null) and speech-acts' paraphrase.",
      "additionalProperties": false,
      "properties": {
        "command": {
          "additionalProperties": false,
          "properties": {
            "act": {"$ref": "common.json#/$defs/text"},
            "args": {"items": {"$ref": "common.json#/$defs/text"}, "maxItems": 1, "type": "array"},
            "force": {"enum": ["require", "forbid"]},
            "guard": {"$ref": "common.json#/$defs/generated_formula"}
          },
          "required": ["force", "act", "args", "guard"],
          "type": "object"
        },
        "fills": {"items": {"$ref": "#/$defs/fill"}, "maxItems": 1, "type": "array"},
        "paraphrase": {"$ref": "common.json#/$defs/text"},
        "query": {"anyOf": [{"type": "null"}, {"$ref": "common.json#/$defs/text"}]}
      },
      "required": ["command", "fills", "query", "paraphrase"],
      "type": "object"
    }
  }
}
