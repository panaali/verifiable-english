{
  "$id": "route.json",
  "$comment": "Mode route: Route.Run.runCaseReported. The case kind (default evaluate) selects the result shape.",
  "row": {"anyOf": [{"$ref": "common.json#/$defs/case_error"}, {"$ref": "#/$defs/error"}, {"$ref": "#/$defs/ok"}]},
  "$defs": {
    "background": {
      "$comment": "Route.Wire.runBackground and Core.Layers.runBackground: the regenerated Background twice, with one generator per premise; its contents are the service's (core formulas on the core family).",
      "additionalProperties": false,
      "properties": {
        "background": {"$ref": "common.json#/$defs/generated_core_formulas"},
        "generators": {"items": {"$ref": "common.json#/$defs/generator"}, "type": "array"},
        "id": {"type": "string", "x-equals": "/id"},
        "premises": {"$ref": "common.json#/$defs/generated_core_formulas"},
        "status": {"const": "ok"}
      },
      "required": ["id", "status", "background", "premises", "generators"],
      "type": "object",
      "x-equal-fields": ["background", "premises"],
      "x-same-length": ["background", "premises", "generators"]
    },
    "bundle": {
      "$comment": "Definitions.Bundle.runBundle: every requested lemma is checked, in order, under its meaning id (binding to the request's lemmas).",
      "additionalProperties": false,
      "properties": {
        "checked": {"$ref": "common.json#/$defs/nat", "x-count": "/lemmas"},
        "id": {"type": "string", "x-equals": "/id"},
        "lemmas": {"items": {"$ref": "common.json#/$defs/hex64"}, "type": "array", "x-equals": "/lemmas/*/meaning_id"},
        "status": {"const": "ok"}
      },
      "required": ["id", "status", "checked", "lemmas"],
      "type": "object"
    },
    "certificate": {
      "$comment": "background: the number of regenerated Background premises (fullBackground); its value is the service's.",
      "additionalProperties": false,
      "properties": {
        "background": {"$ref": "common.json#/$defs/nat", "x-background-bound": true},
        "id": {"type": "string", "x-equals": "/id"},
        "status": {"const": "ok"},
        "steps": {"$ref": "common.json#/$defs/nat", "x-max-steps": {"cap": 1000000, "default": 10000}},
        "valid": {"type": "boolean"}
      },
      "required": ["id", "status", "valid", "background", "steps"],
      "type": "object"
    },
    "countermodel": {
      "additionalProperties": false,
      "properties": {"id": {"type": "string", "x-equals": "/id"}, "refutes": {"type": "boolean"}, "status": {"const": "ok"}},
      "required": ["id", "status", "refutes"],
      "type": "object"
    },
    "dependency-order": {
      "$comment": "Route.dependencyOrder: that the order passes verifyOrder for the request's nodes (dag_acyclic) is the service's.",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "x-equals": "/id"},
        "order": {"$ref": "common.json#/$defs/strings"},
        "status": {"const": "ok"}
      },
      "required": ["id", "status", "order"],
      "type": "object"
    },
    "error": {
      "$comment": "Route.Run.runCaseReported: the generator of an InvalidModel message (generatorOf, the service's); valid: false iff the request kind is certificate.",
      "additionalProperties": false,
      "else": {"not": {"required": ["valid"]}},
      "if": {"x-case": {"$ref": "#/$defs/kind/certificate"}},
      "properties": {
        "error": {"$ref": "common.json#/$defs/text"},
        "generator": {"type": "string"},
        "id": {"x-echo": "/id"},
        "status": {"const": "error"},
        "valid": {"const": false}
      },
      "required": ["id", "status", "error"],
      "then": {"required": ["valid"]},
      "type": "object"
    },
    "evaluate": {
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "x-equals": "/id"},
        "status": {"const": "ok"},
        "values": {"$ref": "common.json#/$defs/values"}
      },
      "required": ["id", "status", "values"],
      "type": "object"
    },
    "kind": {
      "admission": {"properties": {"kind": {"const": "admission"}}, "required": ["kind"], "type": "object"},
      "background": {"properties": {"kind": {"const": "background"}}, "required": ["kind"], "type": "object"},
      "bundle": {"properties": {"kind": {"const": "bundle"}}, "required": ["kind"], "type": "object"},
      "certificate": {"properties": {"kind": {"const": "certificate"}}, "required": ["kind"], "type": "object"},
      "countermodel": {"properties": {"kind": {"const": "countermodel"}}, "required": ["kind"], "type": "object"},
      "dependency-order": {"properties": {"kind": {"const": "dependency-order"}}, "required": ["kind"], "type": "object"},
      "evaluate": {"properties": {"kind": {"const": "evaluate"}}, "required": ["kind"], "type": "object"},
      "label": {"properties": {"kind": {"const": "label"}}, "required": ["kind"], "type": "object"}
    },
    "label": {
      "$comment": "The canonical label is the requested one (parseLabel_render).",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "x-equals": "/id"},
        "label": {"$ref": "common.json#/$defs/label", "x-equals": "/label"},
        "status": {"const": "ok"}
      },
      "required": ["id", "status", "label"],
      "type": "object"
    },
    "ok": {
      "$comment": "The answer the case kind selects (Route.Run.dispatch).",
      "x-select": [
        {"then": {"$ref": "#/$defs/evaluate"}, "when": {"$ref": "common.json#/$defs/no_kind"}},
        {"then": {"$ref": "#/$defs/evaluate"}, "when": {"$ref": "#/$defs/kind/evaluate"}},
        {"then": {"$ref": "#/$defs/countermodel"}, "when": {"$ref": "#/$defs/kind/countermodel"}},
        {"then": {"$ref": "#/$defs/certificate"}, "when": {"$ref": "#/$defs/kind/certificate"}},
        {"then": {"$ref": "#/$defs/dependency-order"}, "when": {"$ref": "#/$defs/kind/dependency-order"}},
        {"then": {"$ref": "#/$defs/bundle"}, "when": {"$ref": "#/$defs/kind/bundle"}},
        {"then": {"$ref": "#/$defs/background"}, "when": {"$ref": "#/$defs/kind/background"}},
        {"then": {"$ref": "#/$defs/label"}, "when": {"$ref": "#/$defs/kind/label"}},
        {"then": {"$ref": "common.json#/$defs/admission"}, "when": {"$ref": "#/$defs/kind/admission"}}
      ]
    }
  }
}
