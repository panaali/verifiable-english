{
  "$id": "norms.json",
  "$comment": "Mode norms: Norms.Run.runCaseReported. A case on the norms path (Norms.Run.usesNormsPath) is answered by the norms runner; every other case is delegated unchanged to route.",
  "row": {"x-select": [
    {"when": {"$ref": "#/$defs/norms_path"}, "then": {"anyOf": [
      {"$ref": "common.json#/$defs/case_error"},
      {"$ref": "common.json#/$defs/error"},
      {"x-select": [
        {"when": {"$ref": "#/$defs/kind/admission"}, "then": {"$ref": "common.json#/$defs/admission"}},
        {"when": {"$ref": "#/$defs/kind/background"}, "then": {"$ref": "route.json#/$defs/background"}},
        {"when": {"$ref": "route.json#/$defs/kind/evaluate"}, "then": {"$ref": "route.json#/$defs/evaluate"}},
        {"when": {"$ref": "route.json#/$defs/kind/countermodel"}, "then": {"$ref": "route.json#/$defs/countermodel"}},
        {"when": {"$ref": "route.json#/$defs/kind/certificate"}, "then": {"$ref": "route.json#/$defs/certificate"}},
        {"when": {"$ref": "#/$defs/kind/norms-elaborate"}, "then": {"$ref": "#/$defs/norms-elaborate"}},
        {"when": {"$ref": "#/$defs/kind/norms-certificate"}, "then": {"$ref": "#/$defs/norms-certificate"}},
        {"when": {"allOf": [{"$ref": "#/$defs/kind/norms-conflict"}, {"required": ["witness"]}]},
         "then": {"$ref": "#/$defs/norms-witness"}},
        {"when": {"$ref": "#/$defs/kind/norms-conflict"}, "then": {"$ref": "#/$defs/norms-conflict"}}]}]}},
    {"when": true, "then": {"$ref": "route.json#/row"}}]},
  "$defs": {
    "norms_path": {"$comment": "Norms.Run.usesNormsPath (a regulated predicate, a norms field, a norms-* kind or a unit with norm content) or Plain.layered (a reports@0 or soft-norms@0 environment).",
      "type": "object", "anyOf": [
        {"required": ["norms"]},
        {"required": ["environment"], "properties": {"environment": {
          "type": "object", "required": ["profiles"], "properties": {"profiles": {
            "type": "array", "contains": {"enum": ["reports@0", "soft-norms@0"]}}}}}},
        {"required": ["kind"], "properties": {"kind": {"type": "string", "pattern": "norms-.*"}}},
        {"required": ["environment"], "properties": {"environment": {
          "type": "object", "required": ["vocabulary"], "properties": {"vocabulary": {
            "type": "object", "required": ["predicates"], "properties": {"predicates": {
              "type": "object", "not": {"additionalProperties": {"not": {"type": "object", "required": ["regulated"]}}}}}}}}}},
        {"required": ["document"], "properties": {"document": {
          "type": "object", "required": ["units"], "properties": {"units": {
            "type": "array", "contains": {"type": "object", "required": ["content"], "properties": {"content": {
              "type": "object", "required": ["norm"]}}}}}}}}]},
    "kind": {
      "admission": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "admission"}}},
      "background": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "background"}}},
      "norms-elaborate": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "norms-elaborate"}}},
      "norms-certificate": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "norms-certificate"}}},
      "norms-conflict": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "norms-conflict"}}}},
    "norms-elaborate": {"$comment": "Norms.Wire.regenerated: one layer (order entry, premise) per regulated predicate; Background in generator order; one conflict target per layer, then per profile pair. These lists are the service's (Lean invariants and Python parity in tests/test_lean_service_schema.py).",
      "type": "object", "required": ["id", "status", "order", "background", "premises", "conflict_targets", "fragment"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "x-equals": "/id"},
        "status": {"const": "ok"},
        "order": {"$ref": "common.json#/$defs/strings"},
        "background": {"type": "array", "items": {
          "type": "object", "required": ["generator", "ast"], "additionalProperties": false,
          "properties": {
            "generator": {"enum": ["flags", "definitions", "literals", "profile"]},
            "ast": {"$ref": "common.json#/$defs/generated_formula"}}}},
        "premises": {"type": "array", "items": {
          "type": "object", "required": ["label", "ast"], "additionalProperties": false,
          "properties": {
            "label": {"type": "string", "pattern": "layer:norms:.*"},
            "ast": {"$ref": "common.json#/$defs/generated_formula"}}}},
        "conflict_targets": {"type": "array", "items": {
          "type": "object", "required": ["target", "sorts", "ast"], "additionalProperties": false,
          "properties": {
            "target": {"type": "string"},
            "sorts": {"$ref": "common.json#/$defs/strings"},
            "ast": {"$ref": "common.json#/$defs/generated_formula"}}}},
        "fragment": {"type": "boolean"}}},
    "norms-certificate": {"type": "object", "required": ["id", "status", "valid", "background", "layers"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "x-equals": "/id"},
        "status": {"const": "ok"},
        "valid": {"type": "boolean"},
        "background": {"$ref": "common.json#/$defs/nat"},
        "layers": {"$ref": "common.json#/$defs/nat"}}},
    "norms-witness": {"$comment": "Norms.Flagged.witnessFrom (norms_flagged_witness_sound): the requested target; the regenerated targets are the service's.",
      "type": "object", "required": ["id", "status", "verdict", "target", "targets"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "x-equals": "/id"},
        "status": {"const": "ok"},
        "verdict": {"enum": ["CONFLICT", "UNKNOWN"]},
        "target": {"type": "string", "x-equals": "/witness/target"},
        "targets": {"$ref": "common.json#/$defs/strings"}}},
    "norms-conflict": {"$comment": "Norms.Flagged.replayConflict (norms_flagged_conflict_free; the verdict, its detail and the targets are the service's).",
      "type": "object", "required": ["id", "status", "verdict", "targets"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "x-equals": "/id"},
        "status": {"const": "ok"},
        "verdict": {"enum": ["CONFLICT-FREE", "UNKNOWN"]},
        "targets": {"$ref": "common.json#/$defs/strings"},
        "detail": {"type": "string"}}}
  }
}
