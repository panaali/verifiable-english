{
  "$id": "scope.json",
  "$comment": "Mode scope: VE.Scope.Run.runCaseReported. Each governed unit's governors and provenance sentences.",
  "row": {
    "anyOf": [
      {"$ref": "common.json#/$defs/case_error"},
      {
        "additionalProperties": false,
        "properties": {"error": {"$ref": "common.json#/$defs/text"}, "id": {"x-echo": "/id"}, "status": {"const": "error"}},
        "required": ["id", "status", "error"],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "governed": {"items": {"$ref": "#/$defs/governed"}, "type": "array"},
          "id": {"type": "string", "x-equals": "/id"},
          "rows": {"items": {"$ref": "#/$defs/unit_row"}, "type": "array"},
          "status": {"const": "ok"}
        },
        "required": ["id", "status", "rows", "governed"],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "choices": {"items": {"$ref": "#/$defs/choice_group"}, "minItems": 1, "type": "array"},
          "id": {"type": "string", "x-equals": "/id"},
          "status": {"const": "ok"}
        },
        "required": ["id", "status", "choices"],
        "type": "object"
      }
    ]
  },
  "$defs": {
    "choice_group": {
      "$comment": "VE.Scope.Run.explainCase: the rows under one joint choice of the governed sets, labelled by the choice.",
      "additionalProperties": false,
      "properties": {
        "choice": {"items": {"$ref": "#/$defs/pick"}, "minItems": 1, "type": "array"},
        "governed": {"items": {"$ref": "#/$defs/governed"}, "type": "array"},
        "rows": {"items": {"$ref": "#/$defs/unit_row"}, "type": "array"}
      },
      "required": ["choice", "rows", "governed"],
      "type": "object"
    },
    "governed": {
      "$comment": "VE.Scope.Run.governedJson: a governor of the block, in its order, and the units whose rows list it.",
      "additionalProperties": false,
      "properties": {"id": {"type": "string"}, "units": {"items": {"type": "string"}, "type": "array"}},
      "required": ["id", "units"],
      "type": "object"
    },
    "governor": {
      "$comment": "VE.Scope.Run.govJson: a contributing governor's id, unit, effect word, reach and provenance sentence.",
      "additionalProperties": false,
      "properties": {
        "effect": {"enum": ["frame", "reguard", "carve-out", "precedes", "yields", "title"]},
        "id": {"type": "string"},
        "provenance": {"type": "string"},
        "reach": {"items": {"type": "string"}, "type": "array"},
        "unit": {"type": "string"}
      },
      "required": ["id", "unit", "effect", "reach", "provenance"],
      "type": "object"
    },
    "pick": {
      "$comment": "VE.Scope.Run.choiceJson: a governed set's unit, id and version and the reading a choice takes from it.",
      "additionalProperties": false,
      "properties": {
        "reading": {"type": "string"},
        "set": {"type": "string"},
        "unit": {"type": "string"},
        "version": {"$ref": "common.json#/$defs/nat"}
      },
      "required": ["unit", "set", "version", "reading"],
      "type": "object"
    },
    "unit_row": {
      "$comment": "VE.Scope.Run.rowJson: a governed unit and its contributing governors.",
      "additionalProperties": false,
      "properties": {
        "governors": {"items": {"$ref": "#/$defs/governor"}, "minItems": 1, "type": "array"},
        "unit": {"type": "string"}
      },
      "required": ["unit", "governors"],
      "type": "object"
    }
  }
}
