{
  "$id": "risk-eval.json",
  "$comment": "Mode risk-eval: Risk.Eval.runCaseReported, the test-only differential harness of docs/spec/risk.md 8.3 (ve_risk_eval). Its rows carry no id; the binding is the case digest.",
  "row": {
    "anyOf": [
      {"$ref": "common.json#/$defs/case_error"},
      {
        "additionalProperties": false,
        "properties": {"error": {"$ref": "common.json#/$defs/text"}, "status": {"const": "error"}},
        "required": ["status", "error"],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "results": {"items": {"$ref": "#/$defs/result"}, "type": "array", "x-length": "/conditions"},
          "status": {"const": "ok"}
        },
        "required": ["status", "results"],
        "type": "object"
      }
    ]
  },
  "$defs": {
    "result": {
      "$comment": "Risk.Eval.evalCondition: the condition's diagnostic, or whether it is possible and certain over the quantities' box with a witness valuation (an integer per quantity) exactly when possible.",
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {"error": {"$ref": "common.json#/$defs/text"}},
          "required": ["error"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "else": {"properties": {"witness": {"const": null}}},
          "if": {"properties": {"possible": {"const": true}}},
          "properties": {
            "certain": {"type": "boolean"},
            "possible": {"type": "boolean"},
            "witness": {"anyOf": [{"const": null}, {"additionalProperties": {"type": "integer"}, "type": "object"}]}
          },
          "required": ["possible", "certain", "witness"],
          "then": {"properties": {"witness": {"type": "object"}}},
          "type": "object"
        }
      ]
    }
  }
}
