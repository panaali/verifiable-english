{
  "$id": "parse.json",
  "$comment": "Standalone parse (Standalone.parseCase): the family's surface parser accepted and typed the source; the document on the wire and, where the family has a printer, its canonical text.",
  "row": {
    "anyOf": [
      {"$ref": "common.json#/$defs/case_error"},
      {"$ref": "common.json#/$defs/error"},
      {"$ref": "#/$defs/parse_error"},
      {
        "additionalProperties": false,
        "properties": {
          "ast": {"items": {"minItems": 1, "type": "array"}, "minItems": 1, "type": "array"},
          "canonical": {"type": "string"},
          "id": {"type": "string", "x-equals": "/id"},
          "status": {"const": "ok"}
        },
        "required": ["id", "status", "ast"],
        "type": "object"
      }
    ]
  },
  "$defs": {
    "parse_error": {
      "additionalProperties": false,
      "properties": {
        "error": {"type": "string"},
        "id": {"type": "string", "x-equals": "/id"},
        "span": {
          "additionalProperties": false,
          "properties": {
            "column": {"$ref": "common.json#/$defs/nat"},
            "end": {"$ref": "common.json#/$defs/nat"},
            "line": {"$ref": "common.json#/$defs/nat"},
            "start": {"$ref": "common.json#/$defs/nat"}
          },
          "required": ["start", "end", "line", "column"],
          "type": "object"
        },
        "status": {"const": "error"}
      },
      "required": ["id", "status", "error", "span"],
      "type": "object"
    }
  }
}
