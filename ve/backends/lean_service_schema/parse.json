{
  "$id": "parse.json",
  "$comment": "Standalone parse (Standalone.parseCase): the family's surface parser accepted and typed the source; the document on the wire and, where the family has a printer, its canonical text.",
  "row": {
    "anyOf": [
      {"$ref": "common.json#/$defs/case_error"},
      {"$ref": "common.json#/$defs/error"},
      {"$ref": "#/$defs/parse_error"},
      {
        "additionalProperties": false,
        "properties": {
          "ast": {"items": {"$ref": "#/$defs/formula"}, "minItems": 1, "type": "array"},
          "canonical": {"type": "string"},
          "id": {"type": "string", "x-equals": "/id"},
          "status": {"const": "ok"}
        },
        "required": ["id", "status", "ast"],
        "type": "object"
      }
    ]
  },
  "$defs": {
    "edge": {"x-tagged": {"body": [{"type": "string"}, {"$ref": "#/$defs/formula"}], "named": [{"type": "string"}]}},
    "formula": {
      "x-tagged": {
        "and": [{"$ref": "#/$defs/formula"}, {"$ref": "#/$defs/formula"}],
        "atom": [{"type": "string"}, {"items": {"$ref": "#/$defs/term"}, "maxItems": 6, "minItems": 3, "type": "array"}],
        "binary": [{"type": "string"}, {"$ref": "#/$defs/term"}, {"$ref": "#/$defs/term"}],
        "bottom": [],
        "eq": [{"$ref": "#/$defs/term"}, {"$ref": "#/$defs/term"}],
        "exists": [{"type": "string"}, {"$ref": "#/$defs/formula"}],
        "forall": [{"type": "string"}, {"$ref": "#/$defs/formula"}],
        "implies": [{"$ref": "#/$defs/formula"}, {"$ref": "#/$defs/formula"}],
        "le": [{"$ref": "#/$defs/term"}, {"$ref": "#/$defs/term"}],
        "lt": [{"$ref": "#/$defs/term"}, {"$ref": "#/$defs/term"}],
        "not": [{"$ref": "#/$defs/formula"}],
        "or": [{"$ref": "#/$defs/formula"}, {"$ref": "#/$defs/formula"}],
        "reach": [
          {"enum": ["plus", "star"]},
          {"$ref": "#/$defs/edge"},
          {"$ref": "#/$defs/term"},
          {"$ref": "#/$defs/term"}
        ],
        "top": [],
        "unary": [{"type": "string"}, {"$ref": "#/$defs/term"}]
      }
    },
    "parse_error": {
      "additionalProperties": false,
      "properties": {
        "error": {"$ref": "common.json#/$defs/text"},
        "id": {"type": "string", "x-equals": "/id"},
        "span": {
          "additionalProperties": false,
          "properties": {
            "column": {"$ref": "common.json#/$defs/nat"},
            "end": {"$ref": "common.json#/$defs/nat"},
            "line": {"$ref": "common.json#/$defs/nat"},
            "start": {"$ref": "common.json#/$defs/nat"}
          },
          "required": ["start", "end", "line", "column"],
          "type": "object",
          "x-source-span": "/source"
        },
        "status": {"const": "error"}
      },
      "required": ["id", "status", "error", "span"],
      "type": "object"
    },
    "term": {
      "x-tagged": {
        "add": [{"$ref": "#/$defs/term"}, {"$ref": "#/$defs/term"}],
        "const": [{"type": "string"}],
        "num": [{"$ref": "common.json#/$defs/integer_text"}],
        "scale": [{"$ref": "common.json#/$defs/integer_text"}, {"$ref": "#/$defs/term"}],
        "var": [{"$ref": "common.json#/$defs/nat"}]
      }
    }
  }
}
