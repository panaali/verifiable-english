{
  "$id": "quantity.json",
  "$comment": "Mode quantity: Time.Wire.runCaseReported with Time.Document.extension (formerly ve_quantity). No delegation: the case kind (default admission) selects the answer.",
  "row": {"anyOf": [
    {"$ref": "common.json#/$defs/case_error"},
    {"$ref": "#/$defs/error"},
    {"x-select": [
      {"when": {"$ref": "common.json#/$defs/no_kind"}, "then": {"$ref": "#/$defs/admission"}},
      {"when": {"$ref": "#/$defs/kind/admission"}, "then": {"$ref": "#/$defs/admission"}},
      {"when": {"$ref": "#/$defs/kind/countermodel"}, "then": {"$ref": "#/$defs/countermodel"}},
      {"when": {"$ref": "#/$defs/kind/certificate"}, "then": {"$ref": "#/$defs/certificate"}},
      {"when": {"$ref": "#/$defs/kind/count"}, "then": {"$ref": "#/$defs/count"}},
      {"when": {"$ref": "#/$defs/kind/day"}, "then": {"$ref": "#/$defs/day"}},
      {"when": {"$ref": "#/$defs/kind/civil"}, "then": {"$ref": "#/$defs/civil"}},
      {"when": {"$ref": "#/$defs/kind/lower"}, "then": {"$ref": "#/$defs/lower"}},
      {"when": {"$ref": "#/$defs/kind/render"}, "then": {"$ref": "#/$defs/render"}},
      {"when": {"$ref": "#/$defs/kind/document"}, "then": {"$ref": "#/$defs/document"}}]}]},
  "$defs": {
    "kind": {
      "admission": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "admission"}}},
      "countermodel": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "countermodel"}}},
      "certificate": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "certificate"}}},
      "count": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "count"}}},
      "day": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "day"}}},
      "civil": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "civil"}}},
      "lower": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "lower"}}},
      "render": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "render"}}},
      "document": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "document"}}}},
    "error": {"$comment": "Time.Wire.runCaseReported: the request's id (null if absent) and the message, with valid: false exactly for a certificate case.",
      "type": "object", "required": ["id", "status", "error"], "additionalProperties": false,
      "properties": {
        "id": {"x-echo": "/id"},
        "status": {"const": "error"},
        "error": {"$ref": "common.json#/$defs/text"},
        "valid": {"const": false}},
      "if": {"x-case": {"$ref": "#/$defs/kind/certificate"}},
      "then": {"required": ["valid"]},
      "else": {"not": {"required": ["valid"]}}},
    "q_term": {"$comment": "Time.Wire.encTerm: an object constant is [const, name], a quantity constant [const, tag, name].",
      "anyOf": [
        {"x-tagged": {
          "var": [{"$ref": "common.json#/$defs/nat"}],
          "const": [{"type": "string"}],
          "num": [{"type": "string"}, {"$ref": "common.json#/$defs/integer_text"}],
          "add": [{"type": "string"}, {"$ref": "#/$defs/q_term"}, {"$ref": "#/$defs/q_term"}],
          "scale": [{"type": "string"}, {"$ref": "common.json#/$defs/integer_text"}, {"$ref": "#/$defs/q_term"}]}},
        {"x-tagged": {
          "const": [{"type": "string"}, {"type": "string"}]}}]},
    "q_formula": {"$comment": "Time.Wire.encQ: the order formulas with quantity terms and the date and day predicates.",
      "x-tagged": {
        "top": [],
        "bottom": [],
        "unary": [{"type": "string"}, {"$ref": "#/$defs/q_term"}],
        "binary": [{"type": "string"}, {"$ref": "#/$defs/q_term"}, {"$ref": "#/$defs/q_term"}],
        "eq": [{"$ref": "#/$defs/q_term"}, {"$ref": "#/$defs/q_term"}],
        "lt": [{"$ref": "#/$defs/q_term"}, {"$ref": "#/$defs/q_term"}],
        "le": [{"$ref": "#/$defs/q_term"}, {"$ref": "#/$defs/q_term"}],
        "not": [{"$ref": "#/$defs/q_formula"}],
        "and": [{"$ref": "#/$defs/q_formula"}, {"$ref": "#/$defs/q_formula"}],
        "or": [{"$ref": "#/$defs/q_formula"}, {"$ref": "#/$defs/q_formula"}],
        "implies": [{"$ref": "#/$defs/q_formula"}, {"$ref": "#/$defs/q_formula"}],
        "forall": [{"type": "string"}, {"$ref": "#/$defs/q_formula"}],
        "exists": [{"type": "string"}, {"$ref": "#/$defs/q_formula"}],
        "date_on": [{"$ref": "#/$defs/q_term"}, {"$ref": "#/$defs/q_term"}],
        "date_before": [{"$ref": "#/$defs/q_term"}, {"$ref": "#/$defs/q_term"}],
        "date_after": [{"$ref": "#/$defs/q_term"}, {"$ref": "#/$defs/q_term"}],
        "date_no_later": [{"$ref": "#/$defs/q_term"}, {"$ref": "#/$defs/q_term"}],
        "within_days": [{"$ref": "#/$defs/q_term"}, {"$ref": "#/$defs/q_term"}, {"$ref": "common.json#/$defs/integer_text"}],
        "shift_days": [{"$ref": "#/$defs/q_term"}, {"$ref": "#/$defs/q_term"}, {"$ref": "common.json#/$defs/integer_text"}],
        "elapsed_days": [{"$ref": "#/$defs/q_term"}, {"$ref": "#/$defs/q_term"}, {"$ref": "#/$defs/q_term"}]}},
    "core_term": {"$comment": "Time.Wire.encCoreTerm: Order.Wire.decodeTerm's grammar at any depth.",
      "x-tagged": {
        "var": [{"$ref": "common.json#/$defs/nat"}],
        "const": [{"type": "string"}],
        "num": [{"$ref": "common.json#/$defs/integer_text"}],
        "add": [{"$ref": "#/$defs/core_term"}, {"$ref": "#/$defs/core_term"}],
        "scale": [{"$ref": "common.json#/$defs/integer_text"}, {"$ref": "#/$defs/core_term"}]}},
    "core_formula": {"$comment": "Time.Wire.encCore of an erased or generated formula: Order.Wire.decodeFormula's grammar at any depth (a count expansion is generated).",
      "x-tagged": {
        "top": [],
        "bottom": [],
        "unary": [{"type": "string"}, {"$ref": "#/$defs/core_term"}],
        "binary": [{"type": "string"}, {"$ref": "#/$defs/core_term"}, {"$ref": "#/$defs/core_term"}],
        "eq": [{"$ref": "#/$defs/core_term"}, {"$ref": "#/$defs/core_term"}],
        "lt": [{"$ref": "#/$defs/core_term"}, {"$ref": "#/$defs/core_term"}],
        "le": [{"$ref": "#/$defs/core_term"}, {"$ref": "#/$defs/core_term"}],
        "not": [{"$ref": "#/$defs/core_formula"}],
        "and": [{"$ref": "#/$defs/core_formula"}, {"$ref": "#/$defs/core_formula"}],
        "or": [{"$ref": "#/$defs/core_formula"}, {"$ref": "#/$defs/core_formula"}],
        "implies": [{"$ref": "#/$defs/core_formula"}, {"$ref": "#/$defs/core_formula"}],
        "forall": [{"type": "string"}, {"$ref": "#/$defs/core_formula"}],
        "exists": [{"type": "string"}, {"$ref": "#/$defs/core_formula"}]}},
    "admission": {"$comment": "Time.Wire.runCase admission: the quantity's encodings and identities, and its value and evaluation count exactly when the case supplies a model.",
      "type": "object", "required": ["id", "status", "assurance", "Q", "core", "meaning_id", "core_meaning_id",
        "environment_id", "target_environment_id"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "status": {"const": "ok"},
        "assurance": {"const": "lean-admitted"},
        "Q": {"$ref": "#/$defs/q_formula"},
        "core": {"$ref": "#/$defs/core_formula"},
        "meaning_id": {"$ref": "common.json#/$defs/hex64"},
        "core_meaning_id": {"$ref": "common.json#/$defs/hex64"},
        "environment_id": {"$ref": "common.json#/$defs/hex64"},
        "target_environment_id": {"$ref": "common.json#/$defs/hex64"},
        "value": {"type": "boolean"},
        "evaluations": {"$ref": "common.json#/$defs/nat"}},
      "if": {"x-case": {"required": ["model"]}},
      "then": {"required": ["value", "evaluations"]},
      "else": {"not": {"anyOf": [{"required": ["value"]}, {"required": ["evaluations"]}]}}},
    "identities": {"$comment": "The premises' and conclusion's identities, quantity and core, one per requested premise.",
      "premise_meaning_ids": {"type": "array", "items": {"$ref": "common.json#/$defs/hex64"}, "x-length": "/premises"},
      "core_premise_meaning_ids": {"type": "array", "items": {"$ref": "common.json#/$defs/hex64"}, "x-length": "/premises"}},
    "countermodel": {"$comment": "Time.Wire.runCase countermodel.",
      "type": "object", "required": ["id", "status", "refutes", "premise_meaning_ids", "conclusion_meaning_id",
        "core_premise_meaning_ids", "core_conclusion_meaning_id", "environment_id", "target_environment_id"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "status": {"const": "ok"},
        "refutes": {"type": "boolean"},
        "premise_meaning_ids": {"$ref": "#/$defs/identities/premise_meaning_ids"},
        "conclusion_meaning_id": {"$ref": "common.json#/$defs/hex64"},
        "core_premise_meaning_ids": {"$ref": "#/$defs/identities/core_premise_meaning_ids"},
        "core_conclusion_meaning_id": {"$ref": "common.json#/$defs/hex64"},
        "environment_id": {"$ref": "common.json#/$defs/hex64"},
        "target_environment_id": {"$ref": "common.json#/$defs/hex64"}}},
    "certificate": {"$comment": "Time.Wire.runCase certificate.",
      "type": "object", "required": ["id", "status", "valid", "premise_meaning_ids", "conclusion_meaning_id",
        "core_premise_meaning_ids", "core_conclusion_meaning_id", "environment_id", "target_environment_id"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "status": {"const": "ok"},
        "valid": {"type": "boolean"},
        "premise_meaning_ids": {"$ref": "#/$defs/identities/premise_meaning_ids"},
        "conclusion_meaning_id": {"$ref": "common.json#/$defs/hex64"},
        "core_premise_meaning_ids": {"$ref": "#/$defs/identities/core_premise_meaning_ids"},
        "core_conclusion_meaning_id": {"$ref": "common.json#/$defs/hex64"},
        "environment_id": {"$ref": "common.json#/$defs/hex64"},
        "target_environment_id": {"$ref": "common.json#/$defs/hex64"}}},
    "count": {"$comment": "Time.Wire.runCount: the counting quantifier's expansion.",
      "type": "object", "required": ["id", "status", "expansion"], "additionalProperties": false,
      "properties": {"id": {"$ref": "common.json#/$defs/id_ok"}, "status": {"const": "ok"},
                     "expansion": {"$ref": "#/$defs/core_formula"}}},
    "day": {"type": "object", "required": ["id", "status", "day"], "additionalProperties": false,
      "properties": {"id": {"$ref": "common.json#/$defs/id_ok"}, "status": {"const": "ok"},
                     "day": {"$ref": "common.json#/$defs/nat"}}},
    "civil": {"type": "object", "required": ["id", "status", "date"], "additionalProperties": false,
      "properties": {"id": {"$ref": "common.json#/$defs/id_ok"}, "status": {"const": "ok"},
                     "date": {"type": "string", "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}"}}},
    "lower": {"type": "object", "required": ["id", "status", "coordinate"], "additionalProperties": false,
      "properties": {"id": {"$ref": "common.json#/$defs/id_ok"}, "status": {"const": "ok"},
                     "coordinate": {"$ref": "common.json#/$defs/integer_text"}}},
    "render": {"type": "object", "required": ["id", "status", "amount"], "additionalProperties": false,
      "properties": {"id": {"$ref": "common.json#/$defs/id_ok"}, "status": {"const": "ok"},
                     "amount": {"type": "string", "pattern": "-?[0-9]+(\\.[0-9]+)?"}}},
    "claim": {"$comment": "Time.Document.claimJson: a node of the request's graph with its quantity and meaning identity; the default label is omitted.",
      "type": "object", "required": ["name", "quantity", "meaning_id"], "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "quantity": {"type": "object", "required": ["format", "formula", "traces"], "additionalProperties": false,
          "properties": {"format": {"const": "ve-quantity@1"}, "formula": {"$ref": "#/$defs/q_formula"},
                         "traces": {"type": "array", "maxItems": 0}}},
        "meaning_id": {"$ref": "common.json#/$defs/hex64"},
        "label": {"type": "string", "not": {"const": "asserted"}}}},
    "document": {"$comment": "Time.Document.runDocument: the admitted quantity document's report and identities.",
      "type": "object", "required": ["id", "status", "admitted", "assurance", "report", "report_id", "environment_id", "kinds"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "status": {"const": "ok"},
        "admitted": {"const": true},
        "assurance": {"const": "lean-admitted"},
        "report": {"type": "object", "required": ["root", "assumptions"], "additionalProperties": false,
          "properties": {
            "root": {"$ref": "#/$defs/claim", "properties": {"name": {"x-equals": "/document/graph/root"}}},
            "assumptions": {"type": "array", "items": {"$ref": "#/$defs/claim"}}}},
        "report_id": {"$ref": "common.json#/$defs/hex64"},
        "environment_id": {"$ref": "common.json#/$defs/hex64"},
        "kinds": {"type": "array", "items": {"$ref": "common.json#/$defs/kind"}, "x-equals": "/document/units/*/kind"}}}
  }
}
