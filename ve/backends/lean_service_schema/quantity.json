{
  "$id": "quantity.json",
  "$comment": "Mode quantity: Time.Wire.runCaseReported with Time.Document.extension (formerly ve_quantity). No delegation: the case kind (default admission) selects the answer.",
  "row": {
    "anyOf": [
      {"$ref": "common.json#/$defs/case_error"},
      {"$ref": "#/$defs/error"},
      {
        "x-select": [
          {"then": {"$ref": "#/$defs/admission"}, "when": {"$ref": "common.json#/$defs/no_kind"}},
          {"then": {"$ref": "#/$defs/admission"}, "when": {"$ref": "#/$defs/kind/admission"}},
          {"then": {"$ref": "#/$defs/countermodel"}, "when": {"$ref": "#/$defs/kind/countermodel"}},
          {"then": {"$ref": "#/$defs/certificate"}, "when": {"$ref": "#/$defs/kind/certificate"}},
          {"then": {"$ref": "#/$defs/count"}, "when": {"$ref": "#/$defs/kind/count"}},
          {"then": {"$ref": "#/$defs/day"}, "when": {"$ref": "#/$defs/kind/day"}},
          {"then": {"$ref": "#/$defs/civil"}, "when": {"$ref": "#/$defs/kind/civil"}},
          {"then": {"$ref": "#/$defs/lower"}, "when": {"$ref": "#/$defs/kind/lower"}},
          {"then": {"$ref": "#/$defs/render"}, "when": {"$ref": "#/$defs/kind/render"}},
          {"then": {"$ref": "#/$defs/document"}, "when": {"$ref": "#/$defs/kind/document"}}
        ]
      }
    ]
  },
  "$defs": {
    "admission": {
      "$comment": "Time.Wire.runCase admission: the quantity's encodings and identities, and its value and evaluation count exactly when the case supplies a model.",
      "additionalProperties": false,
      "else": {"not": {"anyOf": [{"required": ["value"]}, {"required": ["evaluations"]}]}},
      "if": {"x-case": {"required": ["model"]}},
      "properties": {
        "Q": {"$ref": "#/$defs/q_formula"},
        "assurance": {"const": "lean-admitted"},
        "core": {"$ref": "#/$defs/core_formula"},
        "core_meaning_id": {"$ref": "common.json#/$defs/hex64"},
        "environment_id": {"$ref": "common.json#/$defs/hex64"},
        "evaluations": {"$ref": "common.json#/$defs/nat"},
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "meaning_id": {"$ref": "common.json#/$defs/hex64"},
        "status": {"const": "ok"},
        "target_environment_id": {"$ref": "common.json#/$defs/hex64"},
        "value": {"type": "boolean"}
      },
      "required": [
        "id",
        "status",
        "assurance",
        "Q",
        "core",
        "meaning_id",
        "core_meaning_id",
        "environment_id",
        "target_environment_id"
      ],
      "then": {"required": ["value", "evaluations"]},
      "type": "object"
    },
    "certificate": {
      "$comment": "Time.Wire.runCase certificate.",
      "additionalProperties": false,
      "properties": {
        "conclusion_meaning_id": {"$ref": "common.json#/$defs/hex64"},
        "core_conclusion_meaning_id": {"$ref": "common.json#/$defs/hex64"},
        "core_premise_meaning_ids": {"$ref": "#/$defs/identities/core_premise_meaning_ids"},
        "environment_id": {"$ref": "common.json#/$defs/hex64"},
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "premise_meaning_ids": {"$ref": "#/$defs/identities/premise_meaning_ids"},
        "status": {"const": "ok"},
        "target_environment_id": {"$ref": "common.json#/$defs/hex64"},
        "valid": {"type": "boolean"}
      },
      "required": [
        "id",
        "status",
        "valid",
        "premise_meaning_ids",
        "conclusion_meaning_id",
        "core_premise_meaning_ids",
        "core_conclusion_meaning_id",
        "environment_id",
        "target_environment_id"
      ],
      "type": "object"
    },
    "civil": {
      "additionalProperties": false,
      "properties": {
        "date": {"pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}", "type": "string"},
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "status": {"const": "ok"}
      },
      "required": ["id", "status", "date"],
      "type": "object"
    },
    "claim": {
      "$comment": "Time.Document.claimJson: a node of the request's graph with its quantity and meaning identity; the default label is omitted.",
      "additionalProperties": false,
      "properties": {
        "label": {"not": {"const": "asserted"}, "type": "string"},
        "meaning_id": {"$ref": "common.json#/$defs/hex64"},
        "name": {"type": "string"},
        "quantity": {
          "additionalProperties": false,
          "properties": {
            "format": {"const": "ve-quantity@1"},
            "formula": {"$ref": "#/$defs/q_formula"},
            "traces": {"maxItems": 0, "type": "array"}
          },
          "required": ["format", "formula", "traces"],
          "type": "object"
        }
      },
      "required": ["name", "quantity", "meaning_id"],
      "type": "object"
    },
    "core_formula": {
      "$comment": "Time.Wire.encCore of an erased or generated formula: Order.Wire.decodeFormula's grammar at any depth (a count expansion is generated).",
      "x-tagged": {
        "and": [{"$ref": "#/$defs/core_formula"}, {"$ref": "#/$defs/core_formula"}],
        "binary": [{"type": "string"}, {"$ref": "#/$defs/core_term"}, {"$ref": "#/$defs/core_term"}],
        "bottom": [],
        "eq": [{"$ref": "#/$defs/core_term"}, {"$ref": "#/$defs/core_term"}],
        "exists": [{"type": "string"}, {"$ref": "#/$defs/core_formula"}],
        "forall": [{"type": "string"}, {"$ref": "#/$defs/core_formula"}],
        "implies": [{"$ref": "#/$defs/core_formula"}, {"$ref": "#/$defs/core_formula"}],
        "le": [{"$ref": "#/$defs/core_term"}, {"$ref": "#/$defs/core_term"}],
        "lt": [{"$ref": "#/$defs/core_term"}, {"$ref": "#/$defs/core_term"}],
        "not": [{"$ref": "#/$defs/core_formula"}],
        "or": [{"$ref": "#/$defs/core_formula"}, {"$ref": "#/$defs/core_formula"}],
        "top": [],
        "unary": [{"type": "string"}, {"$ref": "#/$defs/core_term"}]
      }
    },
    "core_term": {
      "$comment": "Time.Wire.encCoreTerm: Order.Wire.decodeTerm's grammar at any depth.",
      "x-tagged": {
        "add": [{"$ref": "#/$defs/core_term"}, {"$ref": "#/$defs/core_term"}],
        "const": [{"type": "string"}],
        "num": [{"$ref": "common.json#/$defs/integer_text"}],
        "scale": [{"$ref": "common.json#/$defs/integer_text"}, {"$ref": "#/$defs/core_term"}],
        "var": [{"$ref": "common.json#/$defs/nat"}]
      }
    },
    "count": {
      "$comment": "Time.Wire.runCount: the counting quantifier's expansion.",
      "additionalProperties": false,
      "properties": {
        "expansion": {"$ref": "#/$defs/core_formula"},
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "status": {"const": "ok"}
      },
      "required": ["id", "status", "expansion"],
      "type": "object"
    },
    "countermodel": {
      "$comment": "Time.Wire.runCase countermodel.",
      "additionalProperties": false,
      "properties": {
        "conclusion_meaning_id": {"$ref": "common.json#/$defs/hex64"},
        "core_conclusion_meaning_id": {"$ref": "common.json#/$defs/hex64"},
        "core_premise_meaning_ids": {"$ref": "#/$defs/identities/core_premise_meaning_ids"},
        "environment_id": {"$ref": "common.json#/$defs/hex64"},
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "premise_meaning_ids": {"$ref": "#/$defs/identities/premise_meaning_ids"},
        "refutes": {"type": "boolean"},
        "status": {"const": "ok"},
        "target_environment_id": {"$ref": "common.json#/$defs/hex64"}
      },
      "required": [
        "id",
        "status",
        "refutes",
        "premise_meaning_ids",
        "conclusion_meaning_id",
        "core_premise_meaning_ids",
        "core_conclusion_meaning_id",
        "environment_id",
        "target_environment_id"
      ],
      "type": "object"
    },
    "day": {
      "additionalProperties": false,
      "properties": {
        "day": {"$ref": "common.json#/$defs/nat"},
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "status": {"const": "ok"}
      },
      "required": ["id", "status", "day"],
      "type": "object"
    },
    "document": {
      "$comment": "Time.Document.runDocument: the admitted quantity document's report and identities.",
      "additionalProperties": false,
      "properties": {
        "admitted": {"const": true},
        "assurance": {"const": "lean-admitted"},
        "environment_id": {"$ref": "common.json#/$defs/hex64"},
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "kinds": {"items": {"$ref": "common.json#/$defs/kind"}, "type": "array", "x-equals": "/document/units/*/kind"},
        "report": {
          "additionalProperties": false,
          "properties": {
            "assumptions": {"items": {"$ref": "#/$defs/claim"}, "type": "array"},
            "root": {"$ref": "#/$defs/claim", "properties": {"name": {"x-equals": "/document/graph/root"}}}
          },
          "required": ["root", "assumptions"],
          "type": "object"
        },
        "report_id": {"$ref": "common.json#/$defs/hex64"},
        "status": {"const": "ok"}
      },
      "required": ["id", "status", "admitted", "assurance", "report", "report_id", "environment_id", "kinds"],
      "type": "object"
    },
    "error": {
      "$comment": "Time.Wire.runCaseReported: the request's id (null if absent) and the message, with valid: false exactly for a certificate case.",
      "additionalProperties": false,
      "else": {"not": {"required": ["valid"]}},
      "if": {"x-case": {"$ref": "#/$defs/kind/certificate"}},
      "properties": {
        "error": {"$ref": "common.json#/$defs/text"},
        "id": {"x-echo": "/id"},
        "status": {"const": "error"},
        "valid": {"const": false}
      },
      "required": ["id", "status", "error"],
      "then": {"required": ["valid"]},
      "type": "object"
    },
    "identities": {
      "$comment": "The premises' and conclusion's identities, quantity and core, one per requested premise.",
      "core_premise_meaning_ids": {"items": {"$ref": "common.json#/$defs/hex64"}, "type": "array", "x-length": "/premises"},
      "premise_meaning_ids": {"items": {"$ref": "common.json#/$defs/hex64"}, "type": "array", "x-length": "/premises"}
    },
    "kind": {
      "admission": {"properties": {"kind": {"const": "admission"}}, "required": ["kind"], "type": "object"},
      "certificate": {"properties": {"kind": {"const": "certificate"}}, "required": ["kind"], "type": "object"},
      "civil": {"properties": {"kind": {"const": "civil"}}, "required": ["kind"], "type": "object"},
      "count": {"properties": {"kind": {"const": "count"}}, "required": ["kind"], "type": "object"},
      "countermodel": {"properties": {"kind": {"const": "countermodel"}}, "required": ["kind"], "type": "object"},
      "day": {"properties": {"kind": {"const": "day"}}, "required": ["kind"], "type": "object"},
      "document": {"properties": {"kind": {"const": "document"}}, "required": ["kind"], "type": "object"},
      "lower": {"properties": {"kind": {"const": "lower"}}, "required": ["kind"], "type": "object"},
      "render": {"properties": {"kind": {"const": "render"}}, "required": ["kind"], "type": "object"}
    },
    "lower": {
      "additionalProperties": false,
      "properties": {
        "coordinate": {"$ref": "common.json#/$defs/integer_text"},
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "status": {"const": "ok"}
      },
      "required": ["id", "status", "coordinate"],
      "type": "object"
    },
    "q_formula": {
      "$comment": "Time.Wire.encQ: the order formulas with quantity terms and the date and day predicates.",
      "x-tagged": {
        "and": [{"$ref": "#/$defs/q_formula"}, {"$ref": "#/$defs/q_formula"}],
        "binary": [{"type": "string"}, {"$ref": "#/$defs/q_term"}, {"$ref": "#/$defs/q_term"}],
        "bottom": [],
        "date_after": [{"$ref": "#/$defs/q_term"}, {"$ref": "#/$defs/q_term"}],
        "date_before": [{"$ref": "#/$defs/q_term"}, {"$ref": "#/$defs/q_term"}],
        "date_no_later": [{"$ref": "#/$defs/q_term"}, {"$ref": "#/$defs/q_term"}],
        "date_on": [{"$ref": "#/$defs/q_term"}, {"$ref": "#/$defs/q_term"}],
        "elapsed_days": [{"$ref": "#/$defs/q_term"}, {"$ref": "#/$defs/q_term"}, {"$ref": "#/$defs/q_term"}],
        "eq": [{"$ref": "#/$defs/q_term"}, {"$ref": "#/$defs/q_term"}],
        "exists": [{"type": "string"}, {"$ref": "#/$defs/q_formula"}],
        "forall": [{"type": "string"}, {"$ref": "#/$defs/q_formula"}],
        "implies": [{"$ref": "#/$defs/q_formula"}, {"$ref": "#/$defs/q_formula"}],
        "le": [{"$ref": "#/$defs/q_term"}, {"$ref": "#/$defs/q_term"}],
        "lt": [{"$ref": "#/$defs/q_term"}, {"$ref": "#/$defs/q_term"}],
        "not": [{"$ref": "#/$defs/q_formula"}],
        "or": [{"$ref": "#/$defs/q_formula"}, {"$ref": "#/$defs/q_formula"}],
        "shift_days": [{"$ref": "#/$defs/q_term"}, {"$ref": "#/$defs/q_term"}, {"$ref": "common.json#/$defs/integer_text"}],
        "top": [],
        "unary": [{"type": "string"}, {"$ref": "#/$defs/q_term"}],
        "within_days": [{"$ref": "#/$defs/q_term"}, {"$ref": "#/$defs/q_term"}, {"$ref": "common.json#/$defs/integer_text"}]
      }
    },
    "q_term": {
      "$comment": "Time.Wire.encTerm: an object constant is [const, name], a quantity constant [const, tag, name].",
      "anyOf": [
        {
          "x-tagged": {
            "add": [{"type": "string"}, {"$ref": "#/$defs/q_term"}, {"$ref": "#/$defs/q_term"}],
            "const": [{"type": "string"}],
            "num": [{"type": "string"}, {"$ref": "common.json#/$defs/integer_text"}],
            "scale": [{"type": "string"}, {"$ref": "common.json#/$defs/integer_text"}, {"$ref": "#/$defs/q_term"}],
            "var": [{"$ref": "common.json#/$defs/nat"}]
          }
        },
        {"x-tagged": {"const": [{"type": "string"}, {"type": "string"}]}}
      ]
    },
    "render": {
      "additionalProperties": false,
      "properties": {
        "amount": {"pattern": "-?[0-9][0-9]*(\\.[0-9][0-9]*)?", "type": "string"},
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "status": {"const": "ok"}
      },
      "required": ["id", "status", "amount"],
      "type": "object"
    }
  }
}
