{
  "$id": "graph.json",
  "$comment": "Graph composition (Service.Graph.graphCase): the checked report of the root's dependency cone by claim name, the compatibility projection (named leaves and supporting deductions in declaration order) and the regenerated Background leaves.",
  "row": {
    "anyOf": [
      {"$ref": "common.json#/$defs/case_error"},
      {"$ref": "common.json#/$defs/error"},
      {
        "additionalProperties": false,
        "properties": {
          "assumptions": {"$ref": "common.json#/$defs/strings"},
          "background": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "ast": {"$ref": "common.json#/$defs/generated_formula"},
                "label": {"pattern": "background:(flags|definitions|literals|profile)", "type": "string"}
              },
              "required": ["label", "ast"],
              "type": "object"
            },
            "type": "array"
          },
          "id": {"type": "string", "x-equals": "/id"},
          "report": {
            "additionalProperties": false,
            "properties": {"assumptions": {"$ref": "common.json#/$defs/strings"}, "root": {"type": "string"}},
            "required": ["root", "assumptions"],
            "type": "object"
          },
          "status": {"const": "ok"},
          "supporting_edges": {"$ref": "common.json#/$defs/strings"}
        },
        "required": ["id", "status", "report", "assumptions", "supporting_edges", "background"],
        "type": "object"
      }
    ]
  }
}
