{
  "$id": "speech-acts.json",
  "$comment": "Mode speech-acts: SpeechActs.Run.runCaseReported (formerly ve_speech_acts_route). A case on the speech path (SpeechActs.Run.usesSpeechPath) is answered by the speech runner; every other case is delegated unchanged to the norms mode's runner.",
  "row": {
    "x-select": [
      {
        "then": {
          "anyOf": [
            {"$ref": "common.json#/$defs/case_error"},
            {"$ref": "common.json#/$defs/route_path_error"},
            {
              "x-select": [
                {"then": {"$ref": "#/$defs/elaborate"}, "when": {"$ref": "#/$defs/kind/speech-elaborate"}},
                {"then": {"$ref": "#/$defs/answer"}, "when": {"$ref": "#/$defs/kind/speech-answer"}},
                {"then": {"$ref": "#/$defs/consequence"}, "when": {"$ref": "#/$defs/kind/speech-consequence"}},
                {
                  "then": {"$ref": "common.json#/$defs/witness_conflict"},
                  "when": {"allOf": [{"$ref": "#/$defs/kind/speech-conflict"}, {"required": ["witness"]}]}
                },
                {
                  "then": {"$ref": "common.json#/$defs/packages_conflict"},
                  "when": {"$ref": "#/$defs/kind/speech-conflict"}
                }
              ]
            }
          ]
        },
        "when": {"$ref": "#/$defs/speech_path"}
      },
      {"then": {"$ref": "norms.json#/row"}, "when": true}
    ]
  },
  "$defs": {
    "answer": {
      "$comment": "SpeechActs.Run speech-answer: the requested question and its answer line (AnswerReplay.line).",
      "additionalProperties": false,
      "properties": {
        "answer": {"$ref": "common.json#/$defs/text"},
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "question": {"type": "string", "x-equals": "/question"},
        "status": {"const": "ok"}
      },
      "required": ["id", "status", "question", "answer"],
      "type": "object"
    },
    "consequence": {
      "$comment": "SpeechActs.Run speech-consequence: the requested query and its judgment.",
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "judgment": {"pattern": "(follows \\(|gap \\(|unresolved \\().*", "type": "string"},
        "query": {"type": "string", "x-equals": "/query"},
        "status": {"const": "ok"}
      },
      "required": ["id", "status", "query", "judgment"],
      "type": "object"
    },
    "elaborate": {
      "$comment": "SpeechActs.Run.elaborated: the environment id, the effective scope (Wire.encodeScope), its legend, the premises, the policy (Norms.Wire.regenerated of the command tree), the active commands, the dormant ones, the questions and the queries.",
      "additionalProperties": false,
      "properties": {
        "commands": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "demand": {"$ref": "common.json#/$defs/norm_node"},
              "force": {"enum": ["require", "forbid"]},
              "meaning_id": {"$ref": "common.json#/$defs/hex64_or_empty"},
              "paraphrase": {
                "pattern": "(In this task, you are required to |In this task, you are not permitted to ).*",
                "type": "string"
              },
              "unit": {"type": "string"}
            },
            "required": ["unit", "force", "demand", "paraphrase", "meaning_id"],
            "type": "object"
          },
          "type": "array"
        },
        "dormant": {"$ref": "common.json#/$defs/strings"},
        "environment_id": {"$ref": "common.json#/$defs/hex64_or_empty"},
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "legend": {"$ref": "common.json#/$defs/nonempty_strings"},
        "policy": {
          "additionalProperties": false,
          "properties": {
            "background": {"$ref": "common.json#/$defs/norms_background"},
            "conflict_targets": {"$ref": "common.json#/$defs/conflict_targets"},
            "fragment": {"type": "boolean"},
            "order": {"$ref": "common.json#/$defs/strings"},
            "premises": {"$ref": "common.json#/$defs/layer_premises"}
          },
          "required": ["order", "background", "premises", "conflict_targets", "fragment"],
          "type": "object"
        },
        "premises": {"$ref": "common.json#/$defs/generated_formulas"},
        "queries": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string"},
              "premises": {"$ref": "common.json#/$defs/generated_formulas"},
              "target": {"$ref": "common.json#/$defs/generated_formula"},
              "warning": {"pattern": "TrivialQuery: .*", "type": "string"}
            },
            "required": ["id", "premises", "target"],
            "type": "object"
          },
          "type": "array"
        },
        "questions": {"items": {"$ref": "#/$defs/question"}, "type": "array"},
        "scope": {
          "additionalProperties": false,
          "properties": {
            "addressee": {
              "additionalProperties": false,
              "properties": {"constant": {"type": "string"}, "sort": {"type": "string"}},
              "required": ["sort", "constant"],
              "type": "object"
            },
            "definites": {"$ref": "common.json#/$defs/string_map"},
            "task": {"type": "string"}
          },
          "required": ["task"],
          "type": "object"
        },
        "status": {"const": "ok"}
      },
      "required": [
        "id",
        "status",
        "environment_id",
        "scope",
        "legend",
        "premises",
        "policy",
        "commands",
        "dormant",
        "questions",
        "queries"
      ],
      "type": "object"
    },
    "kind": {
      "speech-answer": {"properties": {"kind": {"const": "speech-answer"}}, "required": ["kind"], "type": "object"},
      "speech-conflict": {"properties": {"kind": {"const": "speech-conflict"}}, "required": ["kind"], "type": "object"},
      "speech-consequence": {"properties": {"kind": {"const": "speech-consequence"}}, "required": ["kind"], "type": "object"},
      "speech-elaborate": {"properties": {"kind": {"const": "speech-elaborate"}}, "required": ["kind"], "type": "object"}
    },
    "question": {
      "$comment": "SpeechActs.Run.questionJson with its meaning id: unit, mode, presupposition and meaning_id, then the mode's fields.",
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "body": {"$ref": "common.json#/$defs/generated_formula"},
            "meaning_id": true,
            "mode": {"const": "polar"},
            "presupposition": true,
            "tokens": {"const": ["yes", "no"]},
            "unit": true
          },
          "required": ["tokens", "body"]
        },
        {
          "additionalProperties": false,
          "properties": {
            "body": {"$ref": "common.json#/$defs/generated_formula"},
            "meaning_id": true,
            "mode": {"const": "which_one"},
            "presupposition": true,
            "tokens": {"$ref": "common.json#/$defs/strings"},
            "unit": true
          },
          "required": ["tokens", "body"]
        },
        {
          "additionalProperties": false,
          "properties": {
            "body": {"$ref": "common.json#/$defs/generated_formula"},
            "domain": {"$ref": "common.json#/$defs/strings"},
            "meaning_id": true,
            "mode": {"const": "which_all"},
            "presupposition": true,
            "unit": true
          },
          "required": ["domain", "body"]
        },
        {
          "additionalProperties": false,
          "properties": {
            "meaning_id": true,
            "mode": {"const": "follows"},
            "presupposition": true,
            "query": {"type": "string"},
            "unit": true
          },
          "required": ["query"]
        },
        {
          "additionalProperties": false,
          "properties": {
            "meaning_id": true,
            "mode": {"const": "reading"},
            "presupposition": true,
            "set": {"type": "string"},
            "unit": true,
            "version": {"$ref": "common.json#/$defs/nat"}
          },
          "required": ["set", "version"]
        }
      ],
      "properties": {
        "meaning_id": {"$ref": "common.json#/$defs/hex64_or_empty"},
        "mode": {"enum": ["polar", "which_one", "which_all", "follows", "reading"]},
        "presupposition": {"$ref": "common.json#/$defs/generated_formula"},
        "unit": {"type": "string"}
      },
      "required": ["unit", "mode", "presupposition", "meaning_id"],
      "type": "object"
    },
    "speech_path": {
      "$comment": "SpeechActs.Run.usesSpeechPath: the speech-acts@0 profile, the environment's speech_acts block, a speech-* kind, or a unit of kind binding or with command or question content.",
      "anyOf": [
        {
          "properties": {
            "environment": {
              "properties": {"profiles": {"contains": {"const": "speech-acts@0"}, "type": "array"}},
              "required": ["profiles"],
              "type": "object"
            }
          },
          "required": ["environment"]
        },
        {
          "properties": {"environment": {"required": ["speech_acts"], "type": "object"}},
          "required": ["environment"]
        },
        {"properties": {"kind": {"pattern": "speech-.*", "type": "string"}}, "required": ["kind"]},
        {
          "properties": {
            "document": {
              "properties": {
                "units": {
                  "contains": {
                    "anyOf": [
                      {"properties": {"kind": {"const": "binding"}}, "required": ["kind"]},
                      {
                        "properties": {"content": {"required": ["command"], "type": "object"}},
                        "required": ["content"]
                      },
                      {
                        "properties": {"content": {"required": ["question"], "type": "object"}},
                        "required": ["content"]
                      }
                    ],
                    "type": "object"
                  },
                  "type": "array"
                }
              },
              "required": ["units"],
              "type": "object"
            }
          },
          "required": ["document"]
        }
      ],
      "type": "object"
    }
  }
}
