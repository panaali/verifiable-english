{
  "$id": "judgment-line.json",
  "$comment": "Lean's reading of a judgment declaration line.",
  "row": {
    "anyOf": [
      {"$ref": "common.json#/$defs/case_error"},
      {
        "additionalProperties": false,
        "properties": {"error": {"$ref": "common.json#/$defs/text"}, "id": {"x-echo": "/id"}, "status": {"const": "error"}},
        "required": ["id", "status", "error"],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "x-equals": "/id"},
          "line": {"type": "string", "x-equals": "/line"},
          "predicate": {"$ref": "#/$defs/predicate"},
          "record": {"$ref": "#/$defs/record"},
          "status": {"const": "ok"}
        },
        "required": ["id", "status", "line", "record", "predicate"],
        "type": "object"
      }
    ]
  },
  "$defs": {
    "predicate": {
      "$comment": "The predicate a declaration line declares: its name and its sorts.",
      "additionalProperties": false,
      "properties": {"arguments": {"$ref": "common.json#/$defs/strings"}, "name": {"type": "string"}},
      "required": ["name", "arguments"],
      "type": "object"
    },
    "record": {
      "$comment": "VE.EnglishGrammar.JudgmentLines.recordJson: the W2 record of a parsed line, with no criteria, factors or precedents.",
      "additionalProperties": false,
      "properties": {
        "arguments": {"$ref": "common.json#/$defs/strings"},
        "decided_by": {"type": "string"},
        "factors": {"maxItems": 0, "type": "array"},
        "jurisdiction": {"type": "string", "x-equals": "/jurisdiction"},
        "name": {"type": "string"},
        "necessary": {"maxItems": 0, "type": "array"},
        "precedents": {"maxItems": 0, "type": "array"},
        "sufficient": {"maxItems": 0, "type": "array"},
        "version": {"const": 1}
      },
      "required": [
        "name",
        "arguments",
        "decided_by",
        "necessary",
        "sufficient",
        "factors",
        "precedents",
        "jurisdiction",
        "version"
      ],
      "type": "object"
    }
  }
}
