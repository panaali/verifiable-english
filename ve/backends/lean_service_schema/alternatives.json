{
  "$id": "alternatives.json",
  "$comment": "Mode alternatives: Alternatives.Run.runCaseReported (formerly ve_alternatives_route). A case on the alternatives path (usesAltPath) is answered by the alternatives runner; every other case is delegated unchanged to the norms mode's runner.",
  "row": {
    "x-select": [
      {
        "then": {
          "anyOf": [
            {"$ref": "common.json#/$defs/case_error"},
            {"$ref": "common.json#/$defs/route_path_error"},
            {
              "x-select": [
                {"then": {"$ref": "#/$defs/admission"}, "when": {"$ref": "#/$defs/kind/admission"}},
                {"then": {"$ref": "#/$defs/elaborate"}, "when": {"$ref": "#/$defs/kind/alt-elaborate"}},
                {"then": {"$ref": "#/$defs/validate"}, "when": {"$ref": "#/$defs/kind/alt-validate"}},
                {
                  "then": {"$ref": "#/$defs/conflict_witness"},
                  "when": {"allOf": [{"$ref": "#/$defs/kind/alt-conflict"}, {"required": ["witness"]}]}
                },
                {
                  "then": {"$ref": "common.json#/$defs/packages_conflict"},
                  "when": {"$ref": "#/$defs/kind/alt-conflict"}
                },
                {
                  "then": {"$ref": "#/$defs/followable_witness"},
                  "when": {"allOf": [{"$ref": "#/$defs/kind/alt-followable"}, {"required": ["witness"]}]}
                },
                {"then": {"$ref": "#/$defs/followable"}, "when": {"$ref": "#/$defs/kind/alt-followable"}},
                {"then": {"$ref": "#/$defs/certificate"}, "when": {"$ref": "#/$defs/kind/alt-certificate"}}
              ]
            }
          ]
        },
        "when": {"$ref": "#/$defs/alt_path"}
      },
      {"then": {"$ref": "norms.json#/row"}, "when": true}
    ]
  },
  "$defs": {
    "admission": {
      "$comment": "Alternatives.Run.encodeAdmitted: W2's admission answer and the source labels it is conditional on.",
      "additionalProperties": false,
      "properties": {
        "admitted": {"const": true},
        "conditional_on": {"$ref": "common.json#/$defs/strings"},
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "kinds": {"items": {"$ref": "common.json#/$defs/kind"}, "type": "array", "x-equals": "/document/units/*/kind"},
        "report": {"$ref": "common.json#/$defs/bound_report"},
        "report_id": {"$ref": "common.json#/$defs/hex64"},
        "status": {"const": "ok"}
      },
      "required": ["id", "status", "admitted", "report", "report_id", "kinds", "conditional_on"],
      "type": "object"
    },
    "alt_labels": {
      "$comment": "Alternatives.Background.altPremiseLabels.",
      "items": {
        "enum": ["alternatives:own", "alternatives:one_taken", "alternatives:one_inaction", "alternatives:proximate"]
      },
      "type": "array"
    },
    "alt_path": {
      "$comment": "Alternatives.Run.usesAltPath: the alternatives@0 profile, the environment's alternatives block or an alt-* kind.",
      "anyOf": [
        {
          "properties": {
            "environment": {
              "properties": {"profiles": {"contains": {"const": "alternatives@0"}, "type": "array"}},
              "required": ["profiles"],
              "type": "object"
            }
          },
          "required": ["environment"]
        },
        {
          "properties": {"environment": {"required": ["alternatives"], "type": "object"}},
          "required": ["environment"]
        },
        {"properties": {"kind": {"pattern": "alt-.*", "type": "string"}}, "required": ["kind"]}
      ],
      "type": "object"
    },
    "certificate": {
      "$comment": "Alternatives.Run.runCase alt-certificate.",
      "additionalProperties": false,
      "properties": {
        "background": {"$ref": "common.json#/$defs/nat"},
        "conditional_on": {"$ref": "#/$defs/alt_labels"},
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "layers": {"$ref": "common.json#/$defs/nat"},
        "status": {"const": "ok"},
        "valid": {"type": "boolean"}
      },
      "required": ["id", "status", "valid", "background", "layers", "conditional_on"],
      "type": "object"
    },
    "chooser": {
      "$comment": "Alternatives.Run.chooserReport: violations and breaches exactly when the block names a taken predicate.",
      "additionalProperties": false,
      "else": {"not": {"anyOf": [{"required": ["violations"]}, {"required": ["breaches"]}]}},
      "if": {
        "x-case": {
          "properties": {
            "environment": {
              "properties": {"alternatives": {"required": ["taken"], "type": "object"}},
              "required": ["alternatives"],
              "type": "object"
            }
          },
          "required": ["environment"]
        }
      },
      "properties": {
        "allows": {"items": {"$ref": "common.json#/$defs/string_pair"}, "type": "array"},
        "alternatives": {"$ref": "common.json#/$defs/strings"},
        "avoidable": {"$ref": "common.json#/$defs/strings"},
        "breaches": {"$ref": "common.json#/$defs/strings"},
        "chooser": {"type": "string"},
        "clear": {"$ref": "common.json#/$defs/strings"},
        "inaction": {"$ref": "common.json#/$defs/strings"},
        "permitted": {"$ref": "common.json#/$defs/strings"},
        "prevents": {"items": {"$ref": "common.json#/$defs/string_pair"}, "type": "array"},
        "required": {"$ref": "common.json#/$defs/strings"},
        "text": {"$ref": "common.json#/$defs/text"},
        "unavoidable": {"$ref": "common.json#/$defs/strings"},
        "violations": {
          "items": {
            "anyOf": [
              {"type": "string"},
              {
                "additionalProperties": false,
                "properties": {"arguments": {"$ref": "common.json#/$defs/strings"}, "obligation": {"type": "string"}},
                "required": ["obligation", "arguments"],
                "type": "object"
              }
            ]
          },
          "type": "array"
        }
      },
      "required": [
        "chooser",
        "alternatives",
        "inaction",
        "permitted",
        "required",
        "avoidable",
        "unavoidable",
        "allows",
        "prevents",
        "clear",
        "text"
      ],
      "then": {"required": ["violations", "breaches"]},
      "type": "object"
    },
    "conflict_witness": {
      "$comment": "Alternatives.Run.runConflictWitness: the requested target (no target list).",
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "status": {"const": "ok"},
        "target": {"type": "string", "x-equals": "/witness/target"},
        "verdict": {"enum": ["CONFLICT", "UNKNOWN"]}
      },
      "required": ["id", "status", "verdict", "target"],
      "type": "object"
    },
    "coverage": {
      "$comment": "Alternatives.Wire.coverage: accepted unit cells and their Lean-owned residual fold.",
      "additionalProperties": false,
      "allOf": [
        {
          "x-count-where": {
            "array": "/alternatives/alternatives_declared",
            "equals": "/residual/alternatives_declared",
            "where": true
          }
        },
        {
          "x-count-where": {
            "array": "/alternatives/counterfactual_leaves",
            "equals": "/residual/counterfactual_leaves",
            "where": true
          }
        },
        {
          "x-count-where": {"array": "/alternatives/assumed_harm_free", "equals": "/residual/assumed_harm_free", "where": true}
        },
        {
          "x-count-where": {
            "array": "/alternatives/proximate_judgments",
            "equals": "/residual/proximate_judgments",
            "where": true
          }
        },
        {
          "x-count-where": {
            "array": "/alternatives/unmapped_obligations",
            "equals": "/residual/unmapped_obligations",
            "where": true
          }
        },
        {"x-count-where": {"array": "/alternatives/dilemmas", "equals": "/residual/dilemmas", "where": true}},
        {
          "x-count-where": {"array": "/alternatives/narrowings", "equals": "/residual/narrowings", "where": true}
        },
        {
          "x-references": {"array": "/alternatives/alternatives_declared", "field": "unit", "in": "/coverage_units/*/id"}
        },
        {
          "x-references": {"array": "/alternatives/counterfactual_leaves", "field": "unit", "in": "/coverage_units/*/id"}
        },
        {
          "x-references": {"array": "/alternatives/proximate_judgments", "field": "unit", "in": "/coverage_units/*/id"}
        },
        {"x-count-presence": {"equals": "/residual/table_complete", "value": "/alternatives/table_complete"}}
      ],
      "properties": {
        "alternatives": {
          "additionalProperties": false,
          "properties": {
            "alternatives_declared": {"type": "array"},
            "assumed_harm_free": {"type": "array"},
            "counterfactual_leaves": {"type": "array"},
            "dilemmas": {"maxItems": 0, "type": "array"},
            "narrowings": {"type": "array"},
            "proximate_judgments": {"type": "array"},
            "table_complete": {
              "anyOf": [
                {"type": "null"},
                {
                  "additionalProperties": false,
                  "properties": {"decider": {"type": "string"}, "premise": {"type": "string"}},
                  "required": ["decider", "premise"],
                  "type": "object"
                }
              ]
            },
            "unmapped_obligations": {"$ref": "common.json#/$defs/strings"}
          },
          "required": [
            "alternatives_declared",
            "counterfactual_leaves",
            "assumed_harm_free",
            "table_complete",
            "proximate_judgments",
            "unmapped_obligations",
            "dilemmas",
            "narrowings"
          ],
          "type": "object"
        },
        "residual": {
          "additionalProperties": false,
          "properties": {
            "alternatives_declared": {"$ref": "common.json#/$defs/nat"},
            "assumed_harm_free": {"$ref": "common.json#/$defs/nat"},
            "counterfactual_leaves": {"$ref": "common.json#/$defs/nat"},
            "dilemmas": {"$ref": "common.json#/$defs/nat"},
            "narrowings": {"$ref": "common.json#/$defs/nat"},
            "proximate_judgments": {"$ref": "common.json#/$defs/nat"},
            "table_complete": {"$ref": "common.json#/$defs/nat"},
            "unmapped_obligations": {"$ref": "common.json#/$defs/nat"}
          },
          "required": [
            "alternatives_declared",
            "counterfactual_leaves",
            "assumed_harm_free",
            "table_complete",
            "proximate_judgments",
            "unmapped_obligations",
            "dilemmas",
            "narrowings"
          ],
          "type": "object"
        }
      },
      "required": ["alternatives", "residual"],
      "type": "object"
    },
    "elaborate": {
      "$comment": "Alternatives.Wire.regenerated: the legend, the inlined tree, the alternatives premises, the base premises, the followability formulas, the profile words' existential probes, the unmapped obligations, then Norms.Wire.regenerated of the inlined tree.",
      "additionalProperties": false,
      "properties": {
        "alternatives": {"$ref": "#/$defs/regenerated/alternatives"},
        "background": {"$ref": "common.json#/$defs/norms_background"},
        "base_premises": {"$ref": "common.json#/$defs/labelled_list"},
        "conflict_targets": {"$ref": "common.json#/$defs/conflict_targets"},
        "coverage": {"$ref": "#/$defs/coverage"},
        "followable": {"$ref": "#/$defs/regenerated/followable"},
        "fragment": {"type": "boolean"},
        "id": {"$ref": "common.json#/$defs/id_ok"},
        "inlined": {"$ref": "#/$defs/regenerated/inlined"},
        "legend": {"$ref": "common.json#/$defs/nonempty_strings"},
        "order": {"$ref": "common.json#/$defs/strings"},
        "premises": {"$ref": "common.json#/$defs/layer_premises"},
        "profile_exists": {
          "additionalProperties": false,
          "properties": {
            "allows": {"$ref": "common.json#/$defs/generated_formula"},
            "avoidable": {"$ref": "common.json#/$defs/generated_formula"},
            "prevents": {"$ref": "common.json#/$defs/generated_formula"},
            "unavoidable": {"$ref": "common.json#/$defs/generated_formula"}
          },
          "required": ["avoidable", "unavoidable", "allows", "prevents"],
          "type": "object"
        },
        "status": {"const": "ok"},
        "unmapped_obligations": {"$ref": "#/$defs/regenerated/unmapped_obligations"}
      },
      "required": [
        "id",
        "status",
        "legend",
        "inlined",
        "alternatives",
        "base_premises",
        "followable",
        "profile_exists",
        "unmapped_obligations",
        "order",
        "background",
        "premises",
        "conflict_targets",
        "fragment"
      ],
      "type": "object"
    },
    "followable": {
      "$comment": "Alternatives.Run.runFollowable over a certificate package.",
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "id": {"$ref": "common.json#/$defs/id_ok"},
            "status": {"const": "ok"},
            "text": {"$ref": "common.json#/$defs/text"},
            "verdict": {"enum": ["not computed", "UNKNOWN"]}
          },
          "required": ["id", "status", "verdict", "text"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "conditional_on": {"$ref": "common.json#/$defs/strings"},
            "id": {"$ref": "common.json#/$defs/id_ok"},
            "status": {"const": "ok"},
            "text": {"pattern": "FOLLOWABLE: .*", "type": "string"},
            "verdict": {"const": "FOLLOWABLE"}
          },
          "required": ["id", "status", "verdict", "conditional_on", "text"],
          "type": "object"
        }
      ]
    },
    "followable_witness": {
      "$comment": "Alternatives.Run.runFollowable with a dilemma witness.",
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "id": {"$ref": "common.json#/$defs/id_ok"},
            "status": {"const": "ok"},
            "text": {"$ref": "common.json#/$defs/text"},
            "verdict": {"enum": ["not computed", "UNKNOWN"]}
          },
          "required": ["id", "status", "verdict", "text"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "chooser": {"type": "string", "x-equals": "/witness/chooser"},
            "diagnosis": {"$ref": "common.json#/$defs/text"},
            "id": {"$ref": "common.json#/$defs/id_ok"},
            "status": {"const": "ok"},
            "text": {"$ref": "common.json#/$defs/text"},
            "verdict": {"const": "DILEMMA"}
          },
          "required": ["id", "status", "verdict", "chooser", "diagnosis", "text"],
          "type": "object"
        }
      ]
    },
    "kind": {
      "admission": {"properties": {"kind": {"const": "admission"}}, "required": ["kind"], "type": "object"},
      "alt-certificate": {"properties": {"kind": {"const": "alt-certificate"}}, "required": ["kind"], "type": "object"},
      "alt-conflict": {"properties": {"kind": {"const": "alt-conflict"}}, "required": ["kind"], "type": "object"},
      "alt-elaborate": {"properties": {"kind": {"const": "alt-elaborate"}}, "required": ["kind"], "type": "object"},
      "alt-followable": {"properties": {"kind": {"const": "alt-followable"}}, "required": ["kind"], "type": "object"},
      "alt-validate": {"properties": {"kind": {"const": "alt-validate"}}, "required": ["kind"], "type": "object"}
    },
    "regenerated": {
      "$comment": "Alternatives.Wire.regenerated before the norms fields: the fields risk-elaborate repeats.",
      "alternatives": {
        "items": {
          "$ref": "common.json#/$defs/labelled",
          "properties": {
            "label": {
              "enum": [
                "alternatives:own",
                "alternatives:one_taken",
                "alternatives:one_inaction",
                "alternatives:proximate"
              ]
            }
          }
        },
        "type": "array"
      },
      "followable": {
        "additionalProperties": false,
        "properties": {
          "ast": {"$ref": "common.json#/$defs/generated_formula"},
          "clear": {"$ref": "common.json#/$defs/generated_formula"},
          "followable": {"$ref": "common.json#/$defs/generated_formula"}
        },
        "required": ["ast", "followable", "clear"],
        "type": "object"
      },
      "inlined": {
        "items": {
          "additionalProperties": false,
          "properties": {"norm": {"$ref": "common.json#/$defs/norm_node"}},
          "required": ["norm"],
          "type": "object"
        },
        "type": "array"
      },
      "unmapped_obligations": {
        "items": {
          "additionalProperties": false,
          "properties": {"act": {"type": "string"}, "obligation": {"type": "string"}},
          "required": ["obligation", "act"],
          "type": "object"
        },
        "type": "array"
      }
    },
    "validate": {
      "$comment": "Alternatives.Run.runValidate: a CONFLICT on the scenario, or the per-chooser evaluation.",
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "document_hash": {"$ref": "common.json#/$defs/hex64"},
            "environment_id": {"$ref": "common.json#/$defs/hex64"},
            "id": {"$ref": "common.json#/$defs/id_ok"},
            "model_id": {"$ref": "common.json#/$defs/hex64_or_empty"},
            "status": {"const": "ok"},
            "target": {"type": "string"},
            "text": {"$ref": "common.json#/$defs/text"},
            "tuple": {"$ref": "common.json#/$defs/strings"},
            "verdict": {"const": "CONFLICT"}
          },
          "required": ["id", "status", "verdict", "target", "tuple", "model_id", "environment_id", "document_hash", "text"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "assumed_harm_free": {"$ref": "common.json#/$defs/strings"},
            "choosers": {"items": {"$ref": "#/$defs/chooser"}, "type": "array"},
            "conditional_on": {"items": {"const": "alternatives:table_complete"}, "maxItems": 1, "type": "array"},
            "document_hash": {"$ref": "common.json#/$defs/hex64"},
            "environment_id": {"$ref": "common.json#/$defs/hex64"},
            "id": {"$ref": "common.json#/$defs/id_ok"},
            "model_id": {"$ref": "common.json#/$defs/hex64_or_empty"},
            "status": {"const": "ok"},
            "text": {"$ref": "common.json#/$defs/text"},
            "unmapped_obligations": {"$ref": "common.json#/$defs/text"}
          },
          "required": [
            "id",
            "status",
            "model_id",
            "environment_id",
            "document_hash",
            "choosers",
            "assumed_harm_free",
            "unmapped_obligations",
            "conditional_on",
            "text"
          ],
          "type": "object"
        }
      ]
    }
  }
}
