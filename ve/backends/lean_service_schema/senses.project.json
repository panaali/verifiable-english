{
  "$id": "senses.project.json",
  "$comment": "Mode senses.project: VE.Senses.Run.projectCaseReported. A projection with its identities, or its fault.",
  "row": {
    "anyOf": [
      {"$ref": "common.json#/$defs/case_error"},
      {
        "additionalProperties": false,
        "properties": {"error": {"$ref": "common.json#/$defs/text"}, "id": {"x-echo": "/id"}, "status": {"const": "error"}},
        "required": ["id", "status", "error"],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "x-equals": "/id"},
          "result": {
            "additionalProperties": false,
            "properties": {
              "dictionary_id": {"$ref": "common.json#/$defs/hex64"},
              "projection": {"$ref": "#/$defs/projection"},
              "senses_version": {"$ref": "common.json#/$defs/text"}
            },
            "required": ["dictionary_id", "senses_version", "projection"],
            "type": "object"
          },
          "status": {"const": "ok"}
        },
        "required": ["id", "status", "result"],
        "type": "object"
      }
    ]
  },
  "$defs": {
    "environment": {
      "$comment": "VE.Senses.projectedJson: the request's environment with the projection's sorts and predicates added (2.5), its profile list as written (VE.Senses.Projection.written); every other member is the request's (profileMembers), equal to it and present when it is; the relay binds the whole by environment_id.",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "x-case": {
              "properties": {"environment": {"required": ["language"], "type": "object"}},
              "required": ["environment"],
              "type": "object"
            }
          },
          "then": {"required": ["language"]}
        },
        {
          "if": {
            "x-case": {
              "properties": {"environment": {"required": ["profile"], "type": "object"}},
              "required": ["environment"],
              "type": "object"
            }
          },
          "then": {"required": ["profile"]}
        },
        {
          "if": {
            "x-case": {
              "properties": {"environment": {"required": ["profiles"], "type": "object"}},
              "required": ["environment"],
              "type": "object"
            }
          },
          "then": {"required": ["profiles"]}
        },
        {
          "if": {
            "x-case": {
              "properties": {"environment": {"required": ["spec_revision"], "type": "object"}},
              "required": ["environment"],
              "type": "object"
            }
          },
          "then": {"required": ["spec_revision"]}
        },
        {
          "if": {
            "x-case": {
              "properties": {"environment": {"required": ["alternatives"], "type": "object"}},
              "required": ["environment"],
              "type": "object"
            }
          },
          "then": {"required": ["alternatives"]}
        },
        {
          "if": {
            "x-case": {
              "properties": {"environment": {"required": ["cardinality"], "type": "object"}},
              "required": ["environment"],
              "type": "object"
            }
          },
          "then": {"required": ["cardinality"]}
        },
        {
          "if": {
            "x-case": {
              "properties": {"environment": {"required": ["cardinality_schema"], "type": "object"}},
              "required": ["environment"],
              "type": "object"
            }
          },
          "then": {"required": ["cardinality_schema"]}
        },
        {
          "if": {
            "x-case": {
              "properties": {"environment": {"required": ["unit_schema"], "type": "object"}},
              "required": ["environment"],
              "type": "object"
            }
          },
          "then": {"required": ["unit_schema"]}
        },
        {
          "if": {
            "x-case": {
              "properties": {"environment": {"required": ["units"], "type": "object"}},
              "required": ["environment"],
              "type": "object"
            }
          },
          "then": {"required": ["units"]}
        },
        {
          "if": {
            "x-case": {
              "properties": {"environment": {"required": ["events"], "type": "object"}},
              "required": ["environment"],
              "type": "object"
            }
          },
          "then": {"required": ["events"]}
        },
        {
          "if": {
            "x-case": {
              "properties": {"environment": {"required": ["risk"], "type": "object"}},
              "required": ["environment"],
              "type": "object"
            }
          },
          "then": {"required": ["risk"]}
        },
        {
          "if": {
            "x-case": {
              "properties": {"environment": {"required": ["speech_acts"], "type": "object"}},
              "required": ["environment"],
              "type": "object"
            }
          },
          "then": {"required": ["speech_acts"]}
        }
      ],
      "properties": {
        "alternatives": {"x-equals": "/environment/alternatives"},
        "cardinality": {"x-equals": "/environment/cardinality"},
        "cardinality_schema": {"x-equals": "/environment/cardinality_schema"},
        "events": {"x-equals": "/environment/events"},
        "language": {"x-equals": "/environment/language"},
        "profile": {"x-equals": "/environment/profile"},
        "profiles": {"x-equals": "/environment/profiles"},
        "risk": {"x-equals": "/environment/risk"},
        "spec_revision": {"x-equals": "/environment/spec_revision"},
        "speech_acts": {"x-equals": "/environment/speech_acts"},
        "unit_schema": {"x-equals": "/environment/unit_schema"},
        "units": {"x-equals": "/environment/units"},
        "vocabulary": {
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "x-case": {
                  "properties": {
                    "environment": {
                      "properties": {"vocabulary": {"required": ["constants"], "type": "object"}},
                      "required": ["vocabulary"],
                      "type": "object"
                    }
                  },
                  "required": ["environment"],
                  "type": "object"
                }
              },
              "then": {"required": ["constants"]}
            },
            {
              "if": {
                "x-case": {
                  "properties": {
                    "environment": {
                      "properties": {"vocabulary": {"required": ["acts"], "type": "object"}},
                      "required": ["vocabulary"],
                      "type": "object"
                    }
                  },
                  "required": ["environment"],
                  "type": "object"
                }
              },
              "then": {"required": ["acts"]}
            },
            {
              "if": {
                "x-case": {
                  "properties": {
                    "environment": {
                      "properties": {"vocabulary": {"required": ["reports"], "type": "object"}},
                      "required": ["vocabulary"],
                      "type": "object"
                    }
                  },
                  "required": ["environment"],
                  "type": "object"
                }
              },
              "then": {"required": ["reports"]}
            },
            {
              "if": {
                "x-case": {
                  "properties": {
                    "environment": {
                      "properties": {"vocabulary": {"required": ["rights"], "type": "object"}},
                      "required": ["vocabulary"],
                      "type": "object"
                    }
                  },
                  "required": ["environment"],
                  "type": "object"
                }
              },
              "then": {"required": ["rights"]}
            },
            {
              "if": {
                "x-case": {
                  "properties": {
                    "environment": {
                      "properties": {"vocabulary": {"required": ["soft"], "type": "object"}},
                      "required": ["vocabulary"],
                      "type": "object"
                    }
                  },
                  "required": ["environment"],
                  "type": "object"
                }
              },
              "then": {"required": ["soft"]}
            }
          ],
          "properties": {
            "acts": {"x-equals": "/environment/vocabulary/acts"},
            "constants": {"x-equals": "/environment/vocabulary/constants"},
            "predicates": {"additionalProperties": {"$ref": "common.json#/$defs/environment_predicate"}, "type": "object"},
            "reports": {"x-equals": "/environment/vocabulary/reports"},
            "rights": {"x-equals": "/environment/vocabulary/rights"},
            "soft": {"x-equals": "/environment/vocabulary/soft"},
            "sorts": {"additionalProperties": {"$ref": "#/$defs/sort"}, "type": "object"}
          },
          "required": ["sorts", "predicates", "constants"],
          "type": "object"
        }
      },
      "required": ["language", "spec_revision", "vocabulary"],
      "type": "object"
    },
    "identities": {
      "$comment": "VE.Senses.Run.projectionIds with S2's actions version: the projection's environment, lexicon and grammar.",
      "additionalProperties": false,
      "properties": {
        "actions_version": {"$ref": "common.json#/$defs/text"},
        "environment_id": {"$ref": "common.json#/$defs/hex64"},
        "grammar_id": {"$ref": "common.json#/$defs/hex64"},
        "lexicon_id": {"$ref": "common.json#/$defs/hex64"}
      },
      "required": ["environment_id", "lexicon_id", "grammar_id", "actions_version"],
      "type": "object"
    },
    "lexicon": {
      "$comment": "VE.Senses.Run.lexiconJson: the projected lexicon as english.read receives one, naming the projected environment.",
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "items": {
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [{"type": "string"}, {"type": "string"}, {"type": "boolean"}],
            "type": "array"
          },
          "type": "array"
        },
        "environment_id": {"$ref": "common.json#/$defs/hex64"},
        "format": {"const": "ve.english-lexicon@1"},
        "letters": {"items": {"$ref": "#/$defs/pair"}, "type": "array"},
        "negatives": {"items": {"$ref": "#/$defs/pair"}, "type": "array"},
        "nouns": {"items": {"$ref": "#/$defs/pair"}, "type": "array"},
        "spellings": {"items": {"$ref": "#/$defs/pair"}, "type": "array"},
        "wordings": {"items": {"$ref": "#/$defs/pair"}, "type": "array"}
      },
      "required": ["format", "environment_id", "nouns", "letters", "wordings", "negatives", "aliases", "spellings"],
      "type": "object"
    },
    "pair": {"maxItems": 2, "minItems": 2, "prefixItems": [{"type": "string"}, {"type": "string"}], "type": "array"},
    "projection": {
      "anyOf": [
        {
          "$comment": "The projection: its environment, its lexicon and their identities.",
          "additionalProperties": false,
          "properties": {
            "environment": {"$ref": "#/$defs/environment"},
            "identities": {"$ref": "#/$defs/identities"},
            "lexicon": {"$ref": "#/$defs/lexicon"},
            "status": {"const": "ok"}
          },
          "required": ["status", "environment", "lexicon", "identities"],
          "type": "object"
        },
        {
          "$comment": "VE.Senses.Run.faultJson of a dictionary failure: its check, name and reason.",
          "additionalProperties": false,
          "properties": {
            "code": {"const": "InvalidDictionary"},
            "failure": {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [{"type": "string"}, {"type": "string"}, {"type": "string"}],
              "type": "array"
            },
            "status": {"const": "rejected"}
          },
          "required": ["status", "code", "failure"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "code": {"const": "UnknownWord"},
            "details": {
              "additionalProperties": false,
              "properties": {"line": {"$ref": "common.json#/$defs/nat"}, "word": {"type": "string"}},
              "required": ["line", "word"],
              "type": "object"
            },
            "status": {"const": "rejected"}
          },
          "required": ["status", "code", "details"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "code": {"const": "UnknownGloss"},
            "details": {
              "additionalProperties": false,
              "properties": {
                "gloss": {"type": "string"},
                "line": {"$ref": "common.json#/$defs/nat"},
                "word": {"type": "string"}
              },
              "required": ["line", "word", "gloss"],
              "type": "object"
            },
            "status": {"const": "rejected"}
          },
          "required": ["status", "code", "details"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "code": {"const": "MalformedPreamble"},
            "details": {
              "additionalProperties": false,
              "properties": {"line": {"$ref": "common.json#/$defs/nat"}},
              "required": ["line"],
              "type": "object"
            },
            "status": {"const": "rejected"}
          },
          "required": ["status", "code", "details"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "code": {"const": "PreambleBudget"},
            "details": {
              "additionalProperties": false,
              "properties": {"line": {"$ref": "common.json#/$defs/nat"}},
              "required": ["line"],
              "type": "object"
            },
            "status": {"const": "budget"}
          },
          "required": ["status", "code", "details"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "code": {"const": "RepeatedDefault"},
            "details": {
              "additionalProperties": false,
              "properties": {"line": {"$ref": "common.json#/$defs/nat"}, "word": {"type": "string"}},
              "required": ["line", "word"],
              "type": "object"
            },
            "status": {"const": "rejected"}
          },
          "required": ["status", "code", "details"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "code": {"const": "PreambleLate"},
            "details": {
              "additionalProperties": false,
              "properties": {"sentence": {"$ref": "common.json#/$defs/nat"}},
              "required": ["sentence"],
              "type": "object"
            },
            "status": {"const": "rejected"}
          },
          "required": ["status", "code", "details"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "code": {"const": "Collision"},
            "details": {
              "additionalProperties": false,
              "properties": {"kind": {"type": "string"}, "name": {"type": "string"}, "sense": {"type": "string"}},
              "required": ["kind", "name", "sense"],
              "type": "object"
            },
            "status": {"const": "rejected"}
          },
          "required": ["status", "code", "details"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "code": {"const": "VocabularyLimit"},
            "details": {
              "additionalProperties": false,
              "properties": {"what": {"type": "string"}},
              "required": ["what"],
              "type": "object"
            },
            "status": {"const": "rejected"}
          },
          "required": ["status", "code", "details"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "code": {"const": "TooManyCandidates"},
            "details": {
              "additionalProperties": false,
              "properties": {"sentence": {"$ref": "common.json#/$defs/nat"}, "words": {"$ref": "common.json#/$defs/strings"}},
              "required": ["sentence", "words"],
              "type": "object"
            },
            "status": {"const": "rejected"}
          },
          "required": ["status", "code", "details"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "code": {"const": "CandidatesDiverge"},
            "details": {
              "additionalProperties": false,
              "properties": {
                "sentence": {"$ref": "common.json#/$defs/nat"},
                "why": {
                  "anyOf": [
                    {"const": "binder"},
                    {
                      "additionalProperties": false,
                      "properties": {"referent": {"type": "string"}},
                      "required": ["referent"],
                      "type": "object"
                    }
                  ]
                },
                "words": {"$ref": "common.json#/$defs/strings"}
              },
              "required": ["sentence", "words", "why"],
              "type": "object"
            },
            "status": {"const": "rejected"}
          },
          "required": ["status", "code", "details"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "code": {"const": "QuotedSense"},
            "details": {
              "additionalProperties": false,
              "properties": {"sentence": {"$ref": "common.json#/$defs/nat"}, "word": {"type": "string"}},
              "required": ["sentence", "word"],
              "type": "object"
            },
            "status": {"const": "rejected"}
          },
          "required": ["status", "code", "details"],
          "type": "object"
        }
      ]
    },
    "sort": {
      "$comment": "A sort of the projected environment, the request's or a fresh sort of the dictionary's (VE.Senses.projectedJson): its description and its nouns.",
      "additionalProperties": false,
      "properties": {
        "description": {"type": "string"},
        "verbalisation": {
          "additionalProperties": false,
          "properties": {"plural": {"type": "string"}, "singular": {"type": "string"}},
          "required": ["singular", "plural"],
          "type": "object"
        }
      },
      "required": ["description"],
      "type": "object"
    }
  }
}
