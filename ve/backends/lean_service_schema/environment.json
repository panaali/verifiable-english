{
  "$id": "environment.json",
  "$comment": "Standalone Route.Gate and vocabulary validation.",
  "row": {"anyOf": [
    {"$ref": "common.json#/$defs/case_error"},
    {"$ref": "common.json#/$defs/error"},
    {"type": "object", "required": ["id", "status", "environment_id", "profiles", "family"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "x-equals": "/id"},
        "status": {"const": "ok"},
        "environment_id": {"$ref": "common.json#/$defs/hex64"},
        "profiles": {"$ref": "common.json#/$defs/strings", "x-equals": "/environment/profiles"},
        "family": {"enum": ["fol", "closure", "closure+n-ary", "order"]}}}]}
}
