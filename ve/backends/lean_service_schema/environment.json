{
  "$id": "environment.json",
  "$comment": "Standalone Route.Gate and vocabulary validation, or a frozen pre-route envelope's decoder (Standalone.decodeLegacy).",
  "row": {
    "anyOf": [
      {"$ref": "common.json#/$defs/case_error"},
      {"$ref": "common.json#/$defs/error"},
      {
        "additionalProperties": false,
        "properties": {
          "acts": {
            "$comment": "Norms.Wire.canonicalActs: the canonical act of each regulated predicate with an act, by its name, as the identity hashes it; Python stores it and binds the names to the request.",
            "$ref": "common.json#/$defs/string_map"
          },
          "environment_id": {"$ref": "common.json#/$defs/hex64"},
          "family": {"enum": ["fol", "closure", "closure+n-ary", "order"]},
          "id": {"type": "string", "x-equals": "/id"},
          "profiles": {"$ref": "common.json#/$defs/strings", "x-equals": "/environment/profiles"},
          "status": {"const": "ok"}
        },
        "required": ["id", "status", "environment_id", "profiles", "family", "acts"],
        "type": "object"
      },
      {
        "$comment": "The frozen v0 envelope (ve.core@0) names its one profile in `profile`.",
        "additionalProperties": false,
        "properties": {
          "environment_id": {"$ref": "common.json#/$defs/hex64"},
          "family": {"const": "fol"},
          "id": {"type": "string", "x-equals": "/id"},
          "profile": {"type": "string", "x-equals": "/environment/profile"},
          "status": {"const": "ok"}
        },
        "required": ["id", "status", "environment_id", "profile", "family"],
        "type": "object"
      }
    ]
  }
}
