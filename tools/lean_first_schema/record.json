{
  "$id": "record.json",
  "$comment": "The records `tools/lean_first_diff.py record` writes, one per line, in the dialect of ve/backends/lean_service_schema/README.md. `compare` checks every line against `record` before it uses any (`record_problem`); a line no branch admits is unusable evidence (exit 2), never an acceptance, a rejection or a missing operation. Each branch names the code that writes it.",
  "record": {
    "type": "object", "required": ["corpus", "authority", "case", "op", "source_sha256", "outcome"],
    "additionalProperties": false,
    "properties": {
      "corpus": {"enum": ["probe", "conformance", "pilots", "readings", "discourse", "rights"]},
      "authority": {"$ref": "#/$defs/text"},
      "case": {"$ref": "#/$defs/text"},
      "op": {"$ref": "#/$defs/text"},
      "source_sha256": {"$ref": "#/$defs/text"},
      "outcome": {"type": "object"}},
    "allOf": [
      {"if": {"properties": {"corpus": {"const": "conformance"}}}, "then": {"$ref": "#/$defs/conformance"}},
      {"if": {"properties": {"corpus": {"const": "probe"}}}, "then": {"$ref": "#/$defs/probe"}},
      {"if": {"properties": {"corpus": {"const": "pilots"}}}, "then": {"$ref": "#/$defs/pilots"}},
      {"if": {"properties": {"corpus": {"const": "readings"}}}, "then": {"$ref": "#/$defs/readings"}},
      {"if": {"properties": {"corpus": {"const": "discourse"}}}, "then": {"$ref": "#/$defs/discourse"}},
      {"if": {"properties": {"corpus": {"const": "rights"}}}, "then": {"$ref": "#/$defs/discourse"}}]
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "nat": {"type": "integer", "minimum": 0},
    "digest": {"$comment": "A SHA-256 in lower-case hex: a corpus file's (`digest`), or an identity.",
      "type": "string", "pattern": "[0-9a-f]{64}"},
    "authority": {"enum": ["python", "lean"]},

    "conformance": {"$comment": "`conformance_records`: one record per operation of `CONFORMANCE_OPS` a case runs, `outcome` (mig3 2.4) of its call.",
      "properties": {
        "authority": {"$ref": "#/$defs/authority"},
        "source_sha256": {"$ref": "#/$defs/digest"},
        "op": {"enum": ["environment", "model", "parse", "canonicalize", "source_id", "typing", "meaning_id",
                        "evaluate", "countermodel_check"]},
        "outcome": {"anyOf": [
          {"type": "object", "required": ["returned"], "additionalProperties": false, "properties": {"returned": true}},
          {"type": "object", "required": ["raised"], "additionalProperties": false,
           "properties": {"raised": {"$ref": "#/$defs/error"}}}]}},
      "allOf": [
        {"if": {"properties": {"op": {"const": "environment"}}},
         "then": {"properties": {"outcome": {"properties": {"returned": {"$ref": "#/$defs/returned/environment"}}}}}},
        {"if": {"properties": {"op": {"const": "model"}}},
         "then": {"properties": {"outcome": {"properties": {"returned": {"$ref": "#/$defs/returned/model"}}}}}},
        {"if": {"properties": {"op": {"enum": ["parse", "typing"]}}},
         "then": {"properties": {"outcome": {"properties": {"returned": {"$ref": "#/$defs/returned/document"}}}}}},
        {"if": {"properties": {"op": {"const": "canonicalize"}}},
         "then": {"properties": {"outcome": {"properties": {"returned": {"$ref": "#/$defs/text"}}}}}},
        {"if": {"properties": {"op": {"enum": ["source_id", "meaning_id"]}}},
         "then": {"properties": {"outcome": {"properties": {"returned": {"$ref": "#/$defs/digest"}}}}}},
        {"if": {"properties": {"op": {"const": "evaluate"}}},
         "then": {"properties": {"outcome": {"properties": {"returned": {"$ref": "#/$defs/returned/evaluate"}}}}}},
        {"if": {"properties": {"op": {"const": "countermodel_check"}}},
         "then": {"properties": {"outcome": {"properties": {"returned": {"$ref": "#/$defs/returned/countermodel_check"}}}}}}]},

    "error": {"$comment": "mig3 2.4 `error_record`: `VEError.to_dict` (ve/errors.py: code, message, and path, span, diagnostic or generator when set), `CheckerUnavailable.to_dict` (operation, backend when set), or `{code, message}` of another exception. A complete diagnostic: a code and a message.",
      "type": "object", "required": ["code", "message"], "additionalProperties": false,
      "properties": {
        "code": {"$comment": "A code, or the class name of another exception (a Python identifier).", "type": "string", "pattern": "[A-Za-z_][A-Za-z0-9_]*"},
        "message": {"$comment": "`str(exc)`: empty for an exception raised without text (the probe matrix's `_Budget`).", "type": "string"},
        "path": {"$ref": "#/$defs/text"},
        "span": {"type": "object", "required": ["start", "end", "line", "column"], "additionalProperties": false,
                 "properties": {"start": {"$ref": "#/$defs/nat"}, "end": {"$ref": "#/$defs/nat"},
                                "line": {"$ref": "#/$defs/nat"}, "column": {"$ref": "#/$defs/nat"}}},
        "diagnostic": {"type": "object"},
        "generator": {"$ref": "#/$defs/text"},
        "operation": {"$ref": "#/$defs/text"},
        "backend": {"$ref": "#/$defs/text"}}},

    "returned": {
      "environment": {"$comment": "`identified(Environment, \"environment_id\")`.",
        "type": "object", "required": ["environment_id", "record"], "additionalProperties": false,
        "properties": {"environment_id": {"$ref": "#/$defs/digest"}, "record": {"type": "object"}}},
      "model": {"$comment": "`identified(FiniteModel, \"model_id\")`.",
        "type": "object", "required": ["model_id", "record"], "additionalProperties": false,
        "properties": {"model_id": {"$ref": "#/$defs/digest"}, "record": {"type": "object"}}},
      "document": {"$comment": "`public(Document)` (ve/ast.py): its formulas, at least one.",
        "type": "object", "required": ["formulas"], "additionalProperties": false,
        "properties": {"formulas": {"type": "array", "minItems": 1, "items": {"type": "object"}}}},
      "evaluate": {"$comment": "`EvaluationResult.to_dict` (ve/evaluate.py): the status names the value.",
        "type": "object", "required": ["status", "value", "evaluations", "explanation"], "additionalProperties": false,
        "properties": {
          "status": {"enum": ["Satisfied", "Violated", "ResourceLimit"]},
          "value": {"type": ["boolean", "null"]},
          "evaluations": {"$ref": "#/$defs/nat"},
          "explanation": {"type": ["object", "null"]}},
        "anyOf": [
          {"properties": {"status": {"const": "Satisfied"}, "value": {"const": true}}},
          {"properties": {"status": {"const": "Violated"}, "value": {"const": false}}},
          {"properties": {"status": {"const": "ResourceLimit"}, "value": {"const": null}}}]},
      "countermodel_check": {"$comment": "`public(CountermodelCheck)` (ve/search.py): `valid` is `status == Valid`.",
        "type": "object", "additionalProperties": false,
        "required": ["valid", "premise_values", "conclusion_value", "evaluations", "environment_id", "model_id",
                     "status", "premise_meaning_ids", "conclusion_meaning_id"],
        "properties": {
          "valid": {"type": "boolean"},
          "premise_values": {"type": "array", "items": {"type": "boolean"}},
          "conclusion_value": {"type": ["boolean", "null"]},
          "evaluations": {"$ref": "#/$defs/nat"},
          "environment_id": {"$ref": "#/$defs/digest"},
          "model_id": {"$ref": "#/$defs/digest"},
          "status": {"enum": ["Valid", "NotCountermodel", "ResourceLimit"]},
          "premise_meaning_ids": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
          "conclusion_meaning_id": {"$ref": "#/$defs/digest"}},
        "anyOf": [
          {"properties": {"status": {"const": "Valid"}, "valid": {"const": true}, "conclusion_value": {"const": false}}},
          {"properties": {"status": {"const": "NotCountermodel"}, "valid": {"const": false}}},
          {"properties": {"status": {"const": "ResourceLimit"}, "valid": {"const": false}, "conclusion_value": {"const": null}}}]}
    },

    "probe": {"$comment": "`probe_rows`: a cell of the probe matrix through its operation, or a named probe of a section.",
      "properties": {
        "authority": {"$ref": "#/$defs/authority"},
        "source_sha256": {"$ref": "#/$defs/digest"}},
      "allOf": [
        {"if": {"properties": {"op": {"const": "graph_probes"}}},
         "then": {"properties": {"outcome": {"$ref": "#/$defs/graph_probe"}}}},
        {"if": {"properties": {"op": {"const": "budget_boundaries"}}},
         "then": {"properties": {"outcome": {"$ref": "#/$defs/boundary"}}}},
        {"if": {"properties": {"op": {"const": "feature_probes"}}},
         "then": {"properties": {"outcome": {"$ref": "#/$defs/probed"}}}},
        {"if": {"properties": {"op": {"not": {"enum": ["graph_probes", "budget_boundaries", "feature_probes"]}}}},
         "then": {"properties": {"outcome": {"$ref": "#/$defs/cell"}}}}]},
    "verdict": {"$comment": "tests/probe_matrix.py `outcome` (tools/stage2_parity.py `_outcome` on a backend): a success S with its result, or a rejection R, U or X with the error record whose code is its status.",
      "properties": {
        "cell": {"enum": ["S", "R", "U", "X"]},
        "status": {"$ref": "#/$defs/text"}},
      "anyOf": [
        {"properties": {"cell": {"const": "S"}}},
        {"properties": {"cell": {"enum": ["R", "U", "X"]}, "output": {"$ref": "#/$defs/error"}}}]},
    "cell": {"$comment": "A matrix cell as `probe_rows` writes it: cell, status, output.",
      "$ref": "#/$defs/verdict",
      "type": "object", "required": ["cell", "status", "output"], "additionalProperties": false,
      "properties": {"cell": true, "status": true, "output": true}},
    "probed": {"$comment": "A probe outcome inside a section, with the operations it routed (`routed`, dropped at a section row's top) and the backend mark (`backend_rejection`).",
      "$ref": "#/$defs/verdict",
      "type": "object", "required": ["cell", "status", "output"], "additionalProperties": false,
      "properties": {"cell": true, "status": true, "output": true,
                     "routed": {"type": "array", "items": {"$ref": "#/$defs/text"}},
                     "backend_rejection": {"const": true}}},
    "boundary": {"$comment": "tests/probe_matrix.py `boundary_baselines`: a cap with the outcomes at it and one over it (`pair`) or one under it (`work_pair`).",
      "type": "object", "required": ["cap", "at"], "additionalProperties": false,
      "properties": {"cap": {"$ref": "#/$defs/nat"}, "at": {"$ref": "#/$defs/probed"},
                     "over": {"$ref": "#/$defs/probed"}, "under": {"$ref": "#/$defs/probed"}},
      "anyOf": [{"required": ["over"], "not": {"required": ["under"]}},
                {"required": ["under"], "not": {"required": ["over"]}}]},
    "graph_probe": {"$comment": "tests/probe_matrix.py `graph_baselines`: the package and `check_argument`'s report.",
      "type": "object", "required": ["package", "output"], "additionalProperties": false,
      "properties": {"package": {"type": "object"}, "output": {"type": "object"}}},

    "pilots": {"$comment": "`pilot_check`: `ve document check` of one pilot document, its blob id the source; a report that is a JSON object is recorded parsed.",
      "properties": {
        "authority": {"const": "default"},
        "op": {"const": "document_check"},
        "source_sha256": {"type": "string", "pattern": "[0-9a-f]{40}|[0-9a-f]{64}"},
        "outcome": {"anyOf": [
          {"type": "object", "required": ["exit", "stdout", "stderr"], "additionalProperties": false,
           "properties": {"exit": {"type": "integer"}, "stdout": {"type": ["string", "object"]},
                          "stderr": {"type": "array", "maxItems": 1, "items": {"type": "string"}}},
           "if": {"properties": {"exit": {"const": 0}}}, "then": {"properties": {"stdout": {"minLength": 1}}}},
          {"type": "object", "required": ["timeout"], "additionalProperties": false,
           "properties": {"timeout": {"$ref": "#/$defs/nat"}}}]}}},

    "readings": {"$comment": "`readings_records`: `ve.readings_route.validate` on one case of the readings corpus file, its digest the source; Lean's relayed row, or the route's diagnostic.",
      "properties": {
        "authority": {"const": "default"},
        "op": {"const": "readings_validate"},
        "source_sha256": {"$ref": "#/$defs/digest"},
        "outcome": {"anyOf": [
          {"type": "object", "required": ["returned"], "additionalProperties": false,
           "properties": {"returned": {"type": "object", "required": ["status", "content_bearing"],
                                       "properties": {"status": {"const": "ok"}, "content_bearing": {"type": "boolean"}}}}},
          {"type": "object", "required": ["raised"], "additionalProperties": false,
           "properties": {"raised": {"$ref": "#/$defs/error"}}}]}}},

    "discourse": {"$comment": "`_discourse_case`: `check_document` or `render_document` of one discourse corpus entry, the digest of the entry the source, `outcome` (mig3 2.4) of the call. `_rights_case` writes the same records for one rights corpus document, the digest of the rights corpus file the source.",
      "properties": {
        "authority": {"const": "default"},
        "op": {"enum": ["document_check", "document_render"]},
        "source_sha256": {"$ref": "#/$defs/digest"},
        "outcome": {"anyOf": [
          {"type": "object", "required": ["returned"], "additionalProperties": false,
           "properties": {"returned": {"type": ["object", "string"]}}},
          {"type": "object", "required": ["raised"], "additionalProperties": false,
           "properties": {"raised": {"$ref": "#/$defs/error"}}}]}}}
  }
}
