 {
  "id": "M2-proved-unchecked",
  "behaviour": "M2: proved is admitted only with a certificate that checks against premisesBefore",
  "definition": "provedOk",
  "file": "lean/VE/Presupposition/Admit.lean",
  "find": "  | some cert => VE.Tableau.checkCertificate (env D) (premisesBefore D c.ob.unit) c.goal cert",
  "replace": "  | some _ => true",
  "test": "Examples.lean A7 (#guard ... [pP \"u1\"] ... == \"PresuppositionCertificate: p1\")"
 },
