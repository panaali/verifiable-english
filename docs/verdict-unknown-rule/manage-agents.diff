+import json, sys
+path, raw, st, after, counts = sys.argv[1:6]
+def mut(i, raw, st, after):
+    m = {"id": i, "file": "VE/A.lean", "line": 1, "definition": "a", "operator": "lit", "lines": [1, 1], "before": "1",
+         "after": after, "trust_class": "trusted", "trusted": True, "status": st, "raw_status": raw,
