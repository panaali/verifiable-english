+                    "INVALID": "VE/A.lean:1: unknown identifier"}.get(raw, "")}
+    if raw in ("KILLED", "INVALID"):
+        m["reads"] = "digest-" + raw
+    if raw == "KILLED":
+        m["killed_at"] = [9, 9]
+    return m
+ms = [mut("m1", raw, st, after), mut("m2", "KILLED", "KILLED", "3")]
+c = {k: 0 for k in ("KILLED", "SURVIVOR", "UNKNOWN", "INVALID", "ALLOWED", "NOT RUN")}
