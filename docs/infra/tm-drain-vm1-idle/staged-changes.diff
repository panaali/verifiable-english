+    def test_gate_boundaries(self):
+        cases = [  # (load, MemAvailable GiB, env, local?, CPUQuota, --jobs)
+            ("19.90", 64, {}, True, "400%", "2"),  # 32 - 8 - 19.9 = 4.1: 4 whole cores
+            ("20.10", 64, {}, False, None, None),  # 3.9: 3 whole cores < TM_IDLE_MIN 4
+            ("0.50", 64, {}, True, "1600%", "8"),  # 23.5 cores, capped at TM_IDLE_CORES 16
+            ("12.00", 64, {"TM_IDLE_RESERVE": "16"}, True, "400%", "2"),  # the reserve is env
+            ("10.00", 64, {"TM_IDLE_CORES_PER_JOB": "4"}, True, "1400%", "3"),  # so is the cores a job
+            ("10.00", 31, {}, False, None, None),  # 31 GiB < 24 + 8
+            ("10.00", 64, {"OFF": "1"}, False, None, None),  # TM_IDLE.off
+        ]
+        for load, mem, env, local, quota, jobs in cases:
+            with self.subTest(load=load, mem=mem, env=env):
+                self.fresh()
+                if env.pop("OFF", None):
+                    base.wr(f"{self.tmp}/TM_IDLE.off", "")
+                r = self.idle(4, load=load, mem_gib=mem, **env)
+                self.assertEqual(len(r["local"]), int(local), r["log"])
+                self.assertEqual(len(r["remote"]), int(not local), r["log"])
+                if local:
+                    sc, la = " ".join(r["scope"][-1]["argv"]), r["local"][0]["argv"]
+                    self.assertIn(f"-p CPUQuota={quota}", sc)
+                    self.assertEqual(la[la.index("--jobs") + 1], jobs, r["log"])
+                else:
+                    self.assertEqual(r["remote"][0]["pools"], "remote", r["log"])
+                    self.assertRegex(r["log"], r"vm1-idle: no local part now \((5-min load|MemAvailable|TM_IDLE\.off)")
+
+    def test_load_rises_later_parts_go_remote_or_wait(self):
+        r = self.idle(12, TM_NIGHTLY_MAX="4", TM_NIGHTLY_CONC="1", STUB_RAISE_LOAD="30.00", STUB_SLEEP="2")
+        log = r["log"]
+        self.assertEqual(len(r["local"]), 1, log)  # only the first part: the gate is re-read before each part
+        rm = sorted(r["remote"], key=lambda x: x["t0"])
+        self.assertEqual([x["pools"] for x in rm], ["remote", "remote"], log)
+        self.assertGreaterEqual(rm[1]["t0"], rm[0]["t1"] - 0.5, log)  # one remote slot: the third part waited for it
+        self.assertIn("vm1-idle: no local part now (5-min load 30.00, nproc 32 - reserve 8 leaves 0 whole cores (< 4))", log)
+        self.assertEqual((r["rows"][-1]["complete"], r["base"]), (True, self.main), log)
