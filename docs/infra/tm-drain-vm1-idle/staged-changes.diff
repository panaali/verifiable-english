+#!/usr/bin/env python3
+"""Tests for tm-drain-vm1-idle (reviews/dri-decisions-20261116-coord-budget.md item 4): TM_NIGHTLY_POOLS=remote+idle.
+  (1) VM1 idle (5-min load < nproc - reserve, >= TM_IDLE_MIN whole cores, MemAvailable >= cap + spare): a part runs LOCALLY
+      in worktree <wt>-l1, in its own scope (CPUWeight 10, CPUQuota cores x 100%, MemoryMax, no swap) under nice 19 and
+      ionice -c 2 -n 7, with the trust_mutants arguments a remote host gets (same --base/--max-mutants/--test/--budget/
+      --deadline; --jobs from the cores), and its record says "where": "vm1-idle"; the other parts go remote at once.
+  (2) VM1 busy (load, memory, TM_IDLE.off): no local part; every part goes remote, and the log says why.
+  (3) the load rises after a local part started: later parts go remote, or wait for a remote slot; never local.
+  (4) the local setup (lake build) fails: no record, the part's ids stay unjudged (resumed), the base stays.
+  (5) TM_NIGHTLY_POOLS=remote (no +idle) at the same idle load: no local part (as before).
+Stub harness: test_tm_nightly_split.py's (synthetic repository, stub plan); stub remote runner, stub scope launcher, stub
+setup and stub trust_mutants (TM_IDLE_SCOPE, TM_IDLE_SETUP, TM_IDLE_TM, TM_IDLE_STOP); fake /proc/loadavg and /proc/meminfo
+(TM_IDLE_LOADAVG, TM_IDLE_MEMINFO, TM_IDLE_NPROC). No Lean, no systemd, no network.
+Run: python3 -I tools-local/test_tm_drain_vm1_idle.py   Staged copy: TMN_SH=<tm-nightly.sh.new-tmidle> (default: the live file)."""
+import json, os, sys, unittest
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import test_tm_nightly_split as base  # noqa: E402  (reads TMN_PY / TMN_SH)
+
+REMOTE = r'''import json, os, subprocess, sys, time
+a = sys.argv[1:]; t0 = time.time()
+time.sleep(float(os.environ.get("STUB_SLEEP", "0")))
+rc = subprocess.run([sys.executable, "-I", os.environ["STUB_INNER"]] + a).returncode
+open(os.environ["STUB_CALLS"] + ".remote", "a").write(json.dumps({"pools": os.environ.get("MAC_PYTEST_POOLS"), "argv": a,
+    "wt": a[a.index("--worktree") + 1], "t0": t0, "t1": time.time()}) + "\n")
+sys.exit(rc)
+'''
+SCOPE = r'''import json, os, sys
+a = sys.argv[1:]; i = 0
+while i < len(a) and a[i].startswith("-"):
+    i += 2 if a[i] == "-p" else 1
+open(os.environ["STUB_CALLS"] + ".scope", "a").write(json.dumps({"argv": a, "cwd": os.getcwd()}) + "\n")
+os.execvp(a[i], a[i:])
+'''
+SETUP = r'''import json, os, sys
+open(os.environ["STUB_CALLS"] + ".setup", "a").write(json.dumps({"cwd": os.getcwd(), "nice": os.nice(0)}) + "\n")
+sys.exit(int(os.environ.get("STUB_SETUP_RC", "0")))
+'''
+LOCAL = r'''import json, os, subprocess, sys, time
+a = sys.argv[1:]; w = os.getcwd(); out = a[a.index("--json") + 1]
+head = subprocess.run(["git", "-C", w, "rev-parse", "HEAD"], capture_output=True, text=True).stdout.strip()
+open(os.environ["STUB_CALLS"] + ".local", "a").write(json.dumps({"argv": a, "cwd": w, "head": head, "nice": os.nice(0),
+                                                                 "t0": time.time()}) + "\n")
+if os.environ.get("STUB_RAISE_LOAD"):  # the load rises once this part runs
+    open(os.environ["TM_IDLE_LOADAVG"], "w").write(f"{os.environ['STUB_RAISE_LOAD']} {os.environ['STUB_RAISE_LOAD']} 1.00 1/9 9\n")
