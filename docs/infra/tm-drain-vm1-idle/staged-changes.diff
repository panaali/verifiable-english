+
+
+def lines(p):
+    return [json.loads(x) for x in base.rd(p).splitlines()] if os.path.exists(p) else []
+
+
+def tm_args(argv):
+    """trust_mutants' args with the per-part values blanked: what must be the same on a remote host and on VM1."""
+    a = argv[argv.index("--") + 1:] if "--" in argv else list(argv)
+    out, i = [], 0
+    while i < len(a):
+        if a[i] == "--jobs":
+            i += 2; continue
+        out += [a[i], "<v>"] if a[i] in ("--only", "--json", "--budget", "--deadline") else [a[i]]
+        i += 2 if a[i] in ("--only", "--json", "--budget", "--deadline") else 1
+    return out
+
+
+class DrainIdle(base.TmNightlySplit):
+    locals().update({n: None for n in dir(base.TmNightlySplit) if n.startswith("test_")})  # only this file's tests
+
+    def idle(self, total, load="10.00", mem_gib=64, **extra):
+        t = self.tmp
+        for f, s in (("stub.py", REMOTE), ("inner.py", base.STUB), ("scope.py", SCOPE), ("setup.py", SETUP), ("local.py", LOCAL)):
+            base.wr(f"{t}/{f}", s)
+        base.wr(f"{t}/loadavg", f"{load} {load} 1.00 1/9 9\n")
+        base.wr(f"{t}/meminfo", f"MemTotal: 131072000 kB\nMemAvailable: {mem_gib * 1048576} kB\n")
+        env = dict(STUB_INNER=f"{t}/inner.py", TM_NIGHTLY_POOLS="remote+idle",
+                   TM_NIGHTLY_POLL="1", TM_IDLE_LOADAVG=f"{t}/loadavg", TM_IDLE_MEMINFO=f"{t}/meminfo", TM_IDLE_NPROC="32",
+                   TM_IDLE_SCOPE=f"python3 -I {t}/scope.py", TM_IDLE_SETUP=f"python3 -I {t}/setup.py",
+                   TM_IDLE_TM=f"python3 -I {t}/local.py", TM_IDLE_STOP="true", TM_IDLE_OFF_FLAG=f"{t}/TM_IDLE.off")
+        env.update(extra)
+        p, calls, rows, b, log = self.nightly(total, **env)
+        c = f"{t}/calls"
+        return dict(p=p, rows=rows, base=b, log=log, remote=lines(c + ".remote"), local=lines(c + ".local"),
+                    scope=lines(c + ".scope"), setup=lines(c + ".setup"))
+
+    def fresh(self):
+        self.tearDown(); self.setUp()
+
+    def test_idle_part_runs_locally_same_args_in_a_capped_scope(self):
+        r = self.idle(12, TM_NIGHTLY_MAX="4", STUB_WAIT_REMOTE="2")
+        wt, log = os.path.join(self.tmp, "wt"), r["log"]
+        self.assertEqual([(x["cwd"], x["head"]) for x in r["local"]], [(wt + "-l1", self.main)], log)
+        self.assertEqual(sorted(x["pools"] for x in r["remote"]), ["remote", "remote"], log)
+        self.assertEqual(sorted(x["argv"][x["argv"].index("--only") + 1] for x in r["remote"]) +
+                         [r["local"][0]["argv"][r["local"][0]["argv"].index("--only") + 1]],
+                         ["M005,M006,M007,M008", "M009,M010,M011,M012", "M001,M002,M003,M004"], log)
+        la = r["local"][0]["argv"]  # the same trust_mutants args as the remote parts' (after mac-pytest's `--`)
+        self.assertEqual({tuple(tm_args(x["argv"])) for x in r["remote"]}, {tuple(tm_args(la))}, log)
+        self.assertEqual(la[la.index("--jobs") + 1], "7", log)  # 32 - 8 - 10 = 14 cores / 2 a job
+        self.assertEqual(la[la.index("--json") + 1].rsplit("/", 1)[1], "part-1.json", log)
+        self.assertEqual((r["local"][0]["nice"], r["setup"][0]["nice"], r["setup"][0]["cwd"]), (19, 19, wt + "-l1/lean"), log)
+        sc = r["scope"][0]["argv"]
+        for want in ("-p CPUWeight=10", "-p CPUQuota=1400%", "-p MemoryMax=24G", "-p MemorySwapMax=0", "nice -n 19",
+                     "ionice -c 2 -n 7"):
+            self.assertIn(want, " ".join(sc), sc)
+        self.assertTrue(all(any(a.startswith("--unit=ve-tmidle-") for a in x["argv"]) for x in r["scope"]), r["scope"])
+        rec = json.load(open(la[la.index("--json") + 1]))
+        self.assertEqual((rec["where"], rec["jobs"]), ("vm1-idle", 7), log)
+        self.assertEqual((r["rows"][-1]["parts"], r["rows"][-1]["complete"], r["rows"][-1]["mutants"], r["base"]),
+                         (3, True, 12, self.main), log)
+        self.assertIn("vm1-idle (TM_NIGHTLY_POOLS=remote+idle, tm-drain-vm1-idle): plus 1 local slot(s)", log)
+        self.assertRegex(log, r"part 1 \(slot 4, wt-l1, vm1-idle: 5-min load 10.00 < nproc 32 - reserve 8: 14 cores, --jobs 7")
+        self.assertIn("part 1: vm1-idle trust_mutants exit 0 in wt-l1 (14 cores, --jobs 7, setup ", log)
