+    # review F2 (fix 2): a rank-1 row often runs two sessions (feature-pipeline.sh:110-112, infra-item.sh:331,335). Every session
+    # of the row that is granted main is listed in the marker, so the marker stays live while ANY of them lives, and a give-back
+    # takes back only its own grant. hold() starts a caller that picks and stays alive (on main) until release() is called.
+    def hold(self, name, **extra):  # (Popen of the caller, its pick result); the caller lives until self.release(name)
+        g, f = f"{self.h}/{name}.g", f"{self.h}/{name}.f"
+        os.mkfifo(g); os.mkfifo(f)
+        open(f"{self.h}/{name}.sh", "w").write(f'exec 3<> {f}; a=$(zsh {self.p} 2>/dev/null); print -r -- "$a" > {g}; read -t 120 x <&3\n')
+        pr = subprocess.Popen(["zsh", f"{self.h}/{name}.sh"], env=self.env([main_line(47)], **extra),
+                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+        self.addCleanup(lambda: pr.poll() is None and (pr.kill(), pr.wait()))  # a failed assertion leaves no caller behind
+        with open(g) as fh:
+            return pr, fh.read().strip()
+
+    def go(self, fifo):  # wakes the one reader of fifo (it holds it open read-write, so this write never blocks)
+        fd = os.open(fifo, os.O_WRONLY | os.O_NONBLOCK)
+        try:
+            os.write(fd, b"go\n")
+        finally:
+            os.close(fd)
+
+    def release(self, name, pr):
+        self.go(f"{self.h}/{name}.f")
+        self.assertEqual(pr.wait(timeout=120), 0)
+
