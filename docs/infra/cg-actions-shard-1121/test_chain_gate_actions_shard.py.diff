+        rc, out, _ = run({"rc": 4, "record": miss, "say": ["merged: failed of 3 shards, MISSING: s1: no result by the deadline; s2: run 7 failure, wait ended at 30; wall 9 s"]})
+        failed("(ii) one failed + one deadline shard (exit 4)", rc)
