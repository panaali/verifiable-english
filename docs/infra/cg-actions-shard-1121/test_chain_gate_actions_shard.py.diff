+def helper_tests():
+    """(h) gha/cancel-leg-runs.py (HELPER=, else the staged .new-cgshard while it exists, else the live one) against a
+    local HTTP server standing in for the GitHub REST API (127.0.0.1, no network): runs read via shard-run-status.py,
+    only the running ones cancelled, the token only in the Authorization header, exit 1 on a refused cancel or a failed
+    lookup, 0 when every cancel is accepted or nothing runs; no run.json shards -> 1..20, r1 and lean branches read."""
+    import http.server, threading, datetime, urllib.parse
+    staged = f"{M}/gha/cancel-leg-runs.py.new-cgshard"
+    hp = os.environ.get("HELPER") or (staged if os.path.exists(staged) else f"{M}/gha/cancel-leg-runs.py")
+    print(f"cancel-leg-runs.py under test: {hp}")
+    now = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
+    st = {"runs": {}, "gets": [], "posts": [], "auth": set(), "post_code": 202, "get_code": 200}
+
+    class H(http.server.BaseHTTPRequestHandler):
+        def log_message(self, *a):
+            pass
+
+        def _send(self, code, body=b"{}"):
+            self.send_response(code); self.send_header("Content-Type", "application/json")
+            self.send_header("Content-Length", str(len(body))); self.end_headers(); self.wfile.write(body)
+
+        def do_GET(self):
+            st["auth"].add(self.headers.get("Authorization"))
+            u = urllib.parse.urlparse(self.path); b = urllib.parse.parse_qs(u.query).get("branch", [""])[0]
+            st["gets"].append(b)
+            if st["get_code"] != 200:
+                return self._send(st["get_code"])
+            r = st["runs"].get(b)
+            w = [{"id": r[0], "status": r[1], "conclusion": None, "head_branch": b, "event": "push", "created_at": now,
+                  "updated_at": now}] if r else []
+            self._send(200, json.dumps({"workflow_runs": w}).encode())
+
+        def do_POST(self):
+            st["auth"].add(self.headers.get("Authorization"))
+            st["posts"].append(self.path)
+            code = st["post_code"](self.path) if callable(st["post_code"]) else st["post_code"]
+            self._send(code)
+
+    srv = http.server.ThreadingHTTPServer(("127.0.0.1", 0), H)
+    threading.Thread(target=srv.serve_forever, daemon=True).start()
+    try:
+        with tempfile.TemporaryDirectory() as d:
+            g = os.path.join(d, "gha"); os.makedirs(g)
+            shutil.copy(hp, os.path.join(g, "cancel-leg-runs.py"))
+            shutil.copy(f"{M}/gha/shard-run-status.py", os.path.join(g, "shard-run-status.py"))
+            tf = os.path.join(d, "tok"); open(tf, "w").write("tok_secret123\n")
+            job = "armsh-chain-t-0123abcd-t1"; jd = os.path.join(d, job); os.makedirs(jd)
+            env = {"PATH": "/usr/bin:/bin", "HOME": d, "ARM_SHARD_RS_API": f"http://127.0.0.1:{srv.server_address[1]}",
+                   "ARM_SHARD_RS_SLUG": "o/r", "ARM_SHARD_RS_TOKEN_FILE": tf}
+
+            def run(shards=3):
+                st["gets"].clear(); st["posts"].clear(); st["auth"].clear()
+                json.dump({"job": job, **({"shards": shards} if shards else {})}, open(os.path.join(jd, "run.json"), "w"))
+                p = subprocess.run([sys.executable, "-I", os.path.join(g, "cancel-leg-runs.py"), jd, str(int(time.time()) - 60)],
+                                   env=env, capture_output=True, text=True, timeout=600)
+                return p.returncode, p.stdout, p.stderr
+
+            st["runs"] = {f"ci-job/{job}-s1": (11, "in_progress"), f"ci-job/{job}-s2": (12, "completed"),
+                          f"ci-job/{job}-s3": (13, "queued"), f"ci-job/{job}-lean": (14, "in_progress"),
+                          f"ci-job/{job}-s2r1": (15, "in_progress")}
+            st["post_code"] = 202
+            rc, out, err = run()
+            check("(h) running runs cancelled, the completed one not",
+                  sorted(st["posts"]) == sorted(f"/repos/o/r/actions/runs/{i}/cancel" for i in (11, 13, 14, 15)), st["posts"])
+            check("(h) all accepted: exit 0, 'cancelled 4 of 4'", rc == 0 and out.strip().endswith("cancelled 4 of 4"), (rc, out, err))
+            check("(h) branches read: s1..s3, s1r1..s3r1, lean", sorted(st["gets"]) == sorted(
+                [f"ci-job/{job}-s{k}" for k in (1, 2, 3)] + [f"ci-job/{job}-s{k}r1" for k in (1, 2, 3)] + [f"ci-job/{job}-lean"]), st["gets"])
+            check("(h) the token only in the Authorization header", st["auth"] == {"Bearer tok_secret123"}
+                  and "tok_secret123" not in out + err, (st["auth"], out, err))
+            st["post_code"] = lambda path: 403 if "/13/" in path else 202
+            rc, out, err = run()
