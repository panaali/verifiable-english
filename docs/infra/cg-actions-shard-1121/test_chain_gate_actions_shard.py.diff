+            check(f"{name}: no VM gate", not rows("vm"), rows("vm"))
+            check(f"{name}: no Mac gate", not rows("mac"))
+            check(f"{name}: gate-end actions-arm rc", any(n.startswith("actions-arm rc=") for n in notes("gate-end")), events())
+
+        # ---- (i) Actions available: the shard step before the VM step, one merged record
+        rc, out, _ = run()
+        g = rows("gh"); r = res_json() or {}
+        check("(i) exit 0", rc == 0, out[-800:])
