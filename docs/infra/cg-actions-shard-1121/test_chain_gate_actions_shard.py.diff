+        check("(i) ARM_SHARD_MODE=blocking, deadline 75 min", g and g[0].get("mode") == "blocking" and g[0].get("deadline") == "75", g[:1])
+        check("(i) ARM_SHARD_JOBFILE given", g and bool(g[0].get("jobfile")), g[:1])
