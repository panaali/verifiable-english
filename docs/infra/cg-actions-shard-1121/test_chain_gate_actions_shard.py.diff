+            check(f"{name}: exit 1", rc == 1, rc)
+            check(f"{name}: gate-result.json FAILED, of HEAD, where=actions-arm",
+                  r.get("status") == "failed" and r.get("commit_sha") == head and r.get("where") == "actions-arm", r)
+            if reason_part:
