+        c2 = next((i for i, x in enumerate(events()) if "ve-cloud-2 not usable" in x["note"]), -1)
+        check("(i) the ve-cloud-2 step came first", 0 <= c2 < idx("gate-start", "actions-arm"), events())
+        check("(i) no VM gate, no Mac gate", not rows("vm") and not rows("mac"), (rows("vm"), rows("mac")))
+        check("(i) gate-result.json: passed, HEAD, tree, where=actions-arm, export_commit",
+              r.get("status") == "passed" and r.get("commit_sha") == head and r.get("tree_sha") == tree
+              and r.get("where") == "actions-arm" and r.get("export_commit") == exp and r.get("dirty") is False
+              and r.get("mode") == "full" and "pytest" in r.get("stages", []), r)
+        check("(i) the job named in the record", (r.get("actions_job") or "").startswith("armsh-chain-t-"), r.get("actions_job"))
+        # review-ready.py reads it unchanged: its own gate_candidates finds it, and main()'s filter (status passed or
+        # rerun-passed, not dirty, commit_sha HEAD) keeps it
+        import importlib.util, pathlib
+        sp = importlib.util.spec_from_file_location("review_ready", f"{M}/review-ready.py"); rr = importlib.util.module_from_spec(sp)
+        sp.loader.exec_module(rr)
+        cand = [(n, x) for n, x in rr.gate_candidates(pathlib.Path(w), []) if n == "gate-result.json (worktree)"]
+        check("(i) review-ready.py's gate_candidates: a usable passing gate of HEAD", len(cand) == 1
