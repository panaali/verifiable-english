+        rc, out, _ = run(env={"GH_ROOM": "4 30 1 1", "CHAIN_GATE_ACTIONS_MIN_ROOM": "4"})
+        check("(iii) room 4 = CHAIN_GATE_ACTIONS_MIN_ROOM 4: the Actions step", rc == 0 and len(rows("gh")) == 2 and not rows("vm"), (rc, out[-400:]))
+        rc, out, _ = run(fl=("MAC_LAST_RESORT", "MAC_GATE"))
+        vm_path("(iii) ARM_SHARD_BLOCKING off"); went_vm("(iii) ARM_SHARD_BLOCKING off", rc)
