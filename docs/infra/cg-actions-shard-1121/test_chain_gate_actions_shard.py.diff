+
+        # (ix) the x86 leg
+        rc, out, _ = run(env={"CHAIN_GATE_ACTIONS_LEG": "x86"}, fl=("MAC_LAST_RESORT", "MAC_GATE", "X86_SHARD_BLOCKING"))
