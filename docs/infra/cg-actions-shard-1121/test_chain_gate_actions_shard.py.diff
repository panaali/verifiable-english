+                  and "cancelled 3 of 4" in out, (rc, out))
+            st["post_code"] = 202; st["get_code"] = 500
+            rc, out, err = run()
+            check("(h) lookup failed: exit 1, nothing cancelled", rc == 1 and not st["posts"], (rc, st["posts"], err[-200:]))
+            st["get_code"] = 200; st["runs"] = {}
+            rc, out, err = run()
+            check("(h) nothing running: exit 0, 'cancelled 0 of 0'", rc == 0 and "cancelled 0 of 0" in out and not st["posts"], (rc, out))
+            rc, out, err = run(shards=None)
+            check("(h) no shards in run.json: 20 + 20 + lean branches read", len(st["gets"]) == 41 and rc == 0, len(st["gets"]))
+            p = subprocess.run([sys.executable, "-I", os.path.join(g, "cancel-leg-runs.py"), jd], env=env, capture_output=True, text=True)
+            check("(h) usage: exit 2", p.returncode == 2, p.returncode)
+    finally:
+        srv.shutdown()
+
