+
+        # ---- (ii) failed or missing shard -> FAIL, never a pass, no VM gate
+        fr = merged("failed", failures=[{"stage": "pytest", "nodeid": "tests/test_a.py::test_x"}])
+        rc, out, _ = run({"rc": 1, "record": fr, "say": ["merged: failed of 3 shards; wall 100 s"]})
+        failed("(ii) merged FAIL", rc, "tests/test_a.py::test_x")
