+#!/usr/bin/env python3
+"""Tests of the Actions shard step of chain-gate.sh (2026-11-21 cg-actions-shard-1121; reviews/chain-gate-20-20261121.md
+sections 6-7, Fix 1; DRI ruling gha-gate-shard item 2, reviews/dri-decisions-20261028-gha-gate-shard.md).
+
+A copy of chain-gate.sh with M = a scratch dir holding MAC_LAST_RESORT, MAC_GATE and ARM_SHARD_BLOCKING (no CLOUD2_RUNNER:
+ve-cloud-2 is "not usable"), MAC_LAST_CHAINGATE_SAT=0 unless a case says otherwise, MAC_LAST_VM_LOAD huge (the VM step is
+always chosen after the Actions step). Stubs in the scratch M: gha-arm-shard.sh (logs argv, mode, deadline and process
+group, writes ARM_SHARD_JOBFILE, a job dir with run.json and the configured gate-record.json, prints the configured log
+lines, sleeps, exits with the configured rc), shard-room.py (prints GH_ROOM), gha/cancel-leg-runs.py (logs its argv),
+mac-gate.sh (logs "mac"). Live copies: gha/arm-leg-record.py and mismatch-scope.sh (respected as live). The worktree's
+committed tools/gate.py is the VM gate's stub (logs "vm", writes a passing record). Nothing touches the live cloud-jobs/,
+flags, GitHub or a remote.
+  (i)   Actions available: the shard step runs after the ve-cloud-2 step and before the VM step (gate-start actions-arm,
+        ARM_SHARD_MODE=blocking, label chain-<label>, HEAD, deadline 75), ONE gate-result.json where=actions-arm,
+        commit_sha HEAD, export_commit kept, status passed, exit 0, no VM gate; chain-gate's own prior check then skips
+        the same HEAD; (ix) CHAIN_GATE_ACTIONS_LEG=x86: --x86, leg-blocking, needs X86_SHARD_BLOCKING, where=actions-x86;
+  (ii)  a failed shard (merged FAIL, exit 1), a missing shard (exit 4, not the deadline), no record, an unparseable record,
+        a record of another tree, exit 0 with a failed record, exit 1 with a passed record: gate-result.json FAILED, exit 1,
+        no VM gate (never a pass);
+  (iii) ACTIONS_SUSPENDED, a blocking ACTIONS_MISMATCH (select-* line), CLOUD_PUSH_HOLD, ARM_SHARD_BLOCKING off,
+        CHAIN_GATE_ACTIONS_OFF, room under CHAIN_GATE_ACTIONS_MIN_ROOM, unreadable room, gha-arm-shard.sh "not sent" (exit 3):
+        the VM step as today (shard stub never started for the pre-checks); a tm-* verdict-sample-only ACTIONS_MISMATCH
+        does not block (mismatch-scope.sh live);
+  (iv)  the leg's deadline passed (exit 4, every MISSING shard "no result by the deadline"): runs cancelled, the VM step;
+        the chain's hard limit (CHAIN_GATE_ACTIONS_HARD_S) passed: the leg stopped, runs cancelled, the VM step;
+  (v)   CHAIN_GATE_CANCEL file made while the leg runs: the leg's process group gone, the runs cancelled (helper called with
+        the job dir), event gate-cancelled, exit 4, no gate-result.json, no VM gate; the file present before: exit 4,
+        the leg never started;
+  (vi)  MAC_LAST_RESORT absent: no Actions step (the VM gate as before);
+  (vii) cloud saturated: the Actions step before the Mac's one slot (no Mac gate on a verdict);
+        CHAIN_GATE_ACTIONS_SAT=0: the Mac gate as before, no Actions step; no verdict: the Mac gate as before.
+
+usage: python3 -I tools-local/test_chain_gate_actions_shard.py     (CG=<chain-gate.sh copy>, e.g. chain-gate.sh.new-cgshard)
+"""
+import json, os, shutil, subprocess, sys, tempfile, time
+
+M = "/home/seyran/code/manage-agents"
+CG = os.path.abspath(os.environ.get("CG", f"{M}/chain-gate.sh"))
+fails = 0
+
+GHSTUB = r'''import json, os, subprocess, sys, time
+cfg = json.load(open(os.environ["GH_CFG"]))
+args = sys.argv[1:]
+x86 = "--x86" in args
+pos = [a for a in args if not a.startswith("--")]
+label, sha = pos[0], pos[1]
+job = ("x86sh-" if x86 else "armsh-") + label + "-" + sha[:8] + "-t1"
+D = os.path.join(os.environ["GH_M"], "gha-arm", job)
+os.makedirs(D, exist_ok=True)
+jf = os.environ.get("ARM_SHARD_JOBFILE")
+def row(d):
+    with open(os.environ["GH_LOG"], "a") as f:
+        f.write(json.dumps(d) + "\n")
+row({"argv": args, "mode": os.environ.get("ARM_SHARD_MODE"), "deadline": os.environ.get("ARM_SHARD_DEADLINE_MIN"),
+     "jobfile": jf, "pid": os.getpid(), "pgid": os.getpgid(0), "job_dir": D})
+if jf:
+    open(jf, "w").write(D + "\n")
+json.dump({"job": job, "shards": 3, "status": "dispatched", "created": int(time.time())}, open(os.path.join(D, "run.json"), "w"))
+if cfg.get("sleep"):
+    child = subprocess.Popen(["sleep", str(cfg["sleep"])])
+    end = time.time() + cfg["sleep"]
+    while time.time() < end:
+        time.sleep(0.2)
+    child.wait()
+rec = cfg.get("record")
+if rec == "garbage":
+    open(os.path.join(D, "gate-record.json"), "w").write("{not json")
+elif isinstance(rec, dict):
+    json.dump(rec, open(os.path.join(D, "gate-record.json"), "w"))
+for l in cfg.get("say", []):
+    print(l, flush=True)
+row({"done": cfg.get("rc", 0)})
+sys.exit(cfg.get("rc", 0))
+'''
+
+VMSTUB = r'''import json, os, subprocess, sys
+head = subprocess.check_output(["git", "rev-parse", "HEAD"], text=True).strip()
+with open(os.environ["VM_LOG"], "a") as f:
+    f.write(json.dumps({"vm": sys.argv[1:]}) + "\n")
+json.dump({"commit_sha": head, "dirty": False, "mode": "full", "stages": ["pytest"], "failures": [], "status": "passed",
+           "where": "vm-stub"}, open("gate-result.json", "w"))
+'''
+
+
+def check(name, cond, extra=""):
+    global fails
+    print(("  ok   " if cond else "  FAIL ") + name + ("" if cond else f"  {extra}"))
+    fails += 0 if cond else 1
+
+
+def alive(pgid):
+    try:
+        os.killpg(pgid, 0)
+        return True
+    except ProcessLookupError:
+        return False
+    except PermissionError:
+        return True
+
+
+def setup(d):
+    m = os.path.join(d, "M"); os.makedirs(os.path.join(m, "gha")); os.makedirs(os.path.join(m, "cloud-jobs"))
+    src = open(CG).read().replace("M=/home/seyran/code/manage-agents;", f"M={m};", 1)
+    assert f"M={m};" in src
+    cg = os.path.join(d, "chain-gate.sh"); open(cg, "w").write(src)
+    shutil.copy(f"{M}/gha/arm-leg-record.py", os.path.join(m, "gha", "arm-leg-record.py"))
+    shutil.copy(f"{M}/mismatch-scope.sh", os.path.join(m, "mismatch-scope.sh"))
+    open(os.path.join(d, "ghstub.py"), "w").write(GHSTUB)
+    open(os.path.join(m, "gha-arm-shard.sh"), "w").write(f'#!/bin/zsh\nexec python3 -I {d}/ghstub.py "$@"\n')
+    open(os.path.join(m, "shard-room.py"), "w").write('import os\nprint(os.environ.get("GH_ROOM", "33 5 2 2"))\n')
+    open(os.path.join(m, "gha", "cancel-leg-runs.py"), "w").write(
+        'import json, os, sys\nopen(os.environ["GH_CANCEL_LOG"], "a").write(json.dumps(sys.argv[1:]) + "\\n")\n')
+    open(os.path.join(m, "mac-gate.sh"), "w").write('#!/bin/zsh\necho mac "$@" >> $MAC_LOG\nexit 0\n')
+    home = os.path.join(d, "home"); os.makedirs(home)
+    fb = os.path.join(d, "bin"); os.makedirs(fb)
+    uv = os.path.join(fb, "uv")
+    open(uv, "w").write('#!/bin/sh\n[ "$1" = run ] && [ "$2" = python ] || { echo "stub uv: $*" >&2; exit 97; }\nshift 2\nexec python3 "$@"\n')
+    os.chmod(uv, 0o755)
+    w = os.path.join(d, "wt"); subprocess.run(["git", "init", "-q", "-b", "main", w], check=True)
+    os.makedirs(os.path.join(w, "tools"))
+    open(os.path.join(w, "tools", "gate.py"), "w").write(VMSTUB)
+    open(os.path.join(w, ".gitignore"), "w").write("gate-result.json\ngate-result.json.tmp\n")
+    subprocess.run(["git", "-C", w, "add", "-A"], check=True)
+    subprocess.run(["git", "-C", w, "-c", "user.name=t", "-c", "user.email=t@t", "commit", "-qm", "a"], check=True)
+    subprocess.run(["git", "-C", w, "checkout", "-qb", "infra/t"], check=True)
+    subprocess.run(["git", "-C", w, "-c", "user.name=t", "-c", "user.email=t@t", "commit", "--allow-empty", "-qm", "work"], check=True)
+    return m, cg, home, fb, w
+
+
+def main():
+    print(f"chain-gate.sh under test: {CG}")
+    with tempfile.TemporaryDirectory() as d:
+        m, cg, home, fb, w = setup(d)
+        head = subprocess.check_output(["git", "-C", w, "rev-parse", "HEAD"], text=True).strip()
+        tree = subprocess.check_output(["git", "-C", w, "rev-parse", "HEAD^{tree}"], text=True).strip()
+        L = {k: os.path.join(d, k + ".log") for k in ("gh", "cancel", "vm", "mac")}
+        cfgf, cf = os.path.join(d, "gh.json"), os.path.join(d, "item-gate.cancel")
+        evf, res = os.path.join(m, "stage-events.jsonl"), os.path.join(w, "gate-result.json")
+        exp = "e" * 40
+
+        def merged(status="passed", t=tree, stages=("toolchains", "pytest"), failures=()):
+            return {"commit_sha": exp, "tree_sha": t, "dirty": False, "mode": "full", "stages": list(stages),
+                    "failures": list(failures), "status": status, "schema_version": 1, "shards": {"n": 3}}
+
+        def rows(k):
+            if not os.path.exists(L[k]):
+                return []
+            return [x.strip() if k == "mac" else json.loads(x) for x in open(L[k])]
+
+        def events():
+            return [json.loads(x) for x in open(evf)] if os.path.exists(evf) else []
+
+        def flags(*names, clear=True):
+            if clear:
+                for f in ("MAC_LAST_RESORT", "MAC_GATE", "ARM_SHARD_BLOCKING", "X86_SHARD_BLOCKING", "ACTIONS_SUSPENDED",
+                          "CLOUD_PUSH_HOLD", "CHAIN_GATE_ACTIONS_OFF", "cloud-jobs/ACTIONS_MISMATCH"):
+                    p = os.path.join(m, f)
+                    if os.path.exists(p):
+                        os.remove(p)
+            for f in names:
+                open(os.path.join(m, f), "w").close()
+
+        def run(gh=None, env=None, pre=False, cancel_after=None, fl=("MAC_LAST_RESORT", "MAC_GATE", "ARM_SHARD_BLOCKING"),
+                keep_res=False):
+            for f in [evf, cf, cfgf, *L.values()] + ([] if keep_res else [res]):
+                if os.path.exists(f):
+                    os.remove(f)
+            shutil.rmtree(os.path.join(m, "gha-arm"), ignore_errors=True)
+            flags(*fl)
+            json.dump(gh or {"rc": 0, "record": merged()}, open(cfgf, "w"))
+            if pre:
+                open(cf, "w").close()
+            e = {"PATH": fb + ":/usr/bin:/bin", "HOME": home, "LANG": "C.UTF-8", "GH_CFG": cfgf, "GH_LOG": L["gh"],
+                 "GH_M": m, "GH_CANCEL_LOG": L["cancel"], "VM_LOG": L["vm"], "MAC_LOG": L["mac"],
+                 "MAC_LAST_CHAINGATE_SAT": "0", "MAC_LAST_VM_LOAD": "100000", "CHAIN_GATE_ACTIONS_POLL": "1"}
+            if pre or cancel_after is not None:
+                e["CHAIN_GATE_CANCEL"] = cf
+            e.update(env or {})
+            t0 = time.time()
+            p = subprocess.Popen(["zsh", cg, w, "t"], env=e, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
+            made = None
+            if cancel_after is not None:
+                while time.time() - t0 < 60 and not rows("gh"):
+                    time.sleep(0.2)
+                time.sleep(cancel_after)
+                open(cf, "w").close()
+                made = time.time()
+            out, _ = p.communicate(timeout=600)
+            return p.returncode, out, (time.time() - made if made else None)
+
+        def res_json():
+            try:
+                return json.load(open(res))
+            except (OSError, ValueError):
+                return None
+
+        def notes(stage):
+            return [x["note"] for x in events() if x["stage"] == stage]
+
+        def idx(stage, prefix):
+            ev = events()
+            return next((i for i, x in enumerate(ev) if x["stage"] == stage and x["note"].startswith(prefix)), -1)
+
+        def vm_path(name):
+            check(f"{name}: shard stub not started", not rows("gh"), rows("gh"))
+
+        def went_vm(name, rc):
+            check(f"{name}: exit 0 from the VM gate", rc == 0, rc)
+            check(f"{name}: the VM gate ran", len(rows("vm")) == 1, rows("vm"))
+            check(f"{name}: gate-start vm", idx("gate-start", "vm ") >= 0, events())
+            r = res_json() or {}
+            check(f"{name}: gate-result.json is the VM's", r.get("where") == "vm-stub", r)
+            check(f"{name}: no Mac gate", not rows("mac"))
+
+        def failed(name, rc, reason_part=None):
