+def final_rows(name, rows):
+    """Every row a challenge final belongs to (see the docstring): links.final / links.delegate first, then the row id from
+    the file's stem, with or without "dri-", alone or followed by a date / stopped-date suffix."""
+    stem = name[:-len(".final.md")]
+    out = [r for r in rows if isinstance(r.get("links"), dict)
+           and (r["links"].get("final") == name or r["links"].get("delegate") == stem)]
+    by = {r.get("id"): r for r in rows if r.get("id")}
+    for s in [stem] + ([stem[4:]] if stem.startswith("dri-") else []):
+        p = s.split("-")
+        for k in range(len(p), 0, -1):
+            r = by.get("-".join(p[:k]))
+            if r is not None and (k == len(p) or CF_SUFFIX.fullmatch("-".join(p[k:]))) and r not in out:
+                out.append(r)
+    return out
+
+
+def addressee(r, name):
+    a = str(r.get("addressee") or "").strip().lower()
+    if a in CF_TO:
+        return a
+    return "orchestrator" if ASTRA.search(f"{r.get('id', '')} {name}") else "dri"
+
+
+def challenge_finals(rows, now):
+    """[(row, ("cf:<id>", "<final>@<status_t>"), final name, final mtime, addressee)]: challenge finals newer than their
+    in-flight row's status_t, >= 30 min old, row still in flight."""
+    out = []
+    for f in sorted(glob.glob(os.path.join(M, CF_GLOB))):
+        try:
+            st = os.stat(f)
+        except OSError:
+            continue
+        name = os.path.basename(f)
+        if st.st_size == 0 or now - st.st_mtime < CF_AFTER:
+            continue
+        for r in final_rows(name, rows):
+            t = parse_t(r.get("status_t")) if r.get("status") == "in-flight" else None
+            if t is None or st.st_mtime <= t:
+                continue
+            out.append((r, ("cf:" + r["id"], f"{name}@{r['status_t']}"), name, st.st_mtime, addressee(r, name)))
+    return out
+
+
