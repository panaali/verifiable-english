+#!/usr/bin/env python3
+"""allowances_merge.py: docs/kernel/ALLOWANCES.md as a rebase-second file with a resolver (row lw-allowances-shared;
+DRI decider reviews/dri-decisions-20261115-lw-allowances.md item 1).
+
+Every kernel row makes the same edit to VE's docs/kernel/ALLOWANCES.md: it appends a row to a table and raises the line
+"signed total: N lines". Two such branches conflict on that line by construction, so path_overlap.py held them serial
+(kb-9 waited 13.3 wall h in 24 h). This module is the one owner of the shape rule and of the resolution:
+
+  shape (base -> branch), APPEND-ONLY when, and only when:
+    - exactly one "signed total: N lines" line on each side;
+    - every other line outside the tables is unchanged, and the branch adds or removes no table;
+    - each table keeps every row of the base, unchanged and in order, as a prefix (rows are appended at its end only);
+    - the kernel table (the one whose header has the columns "Lines" and "Total after"): each appended row's
+      "Total after" equals the previous total plus its "Lines" (starting at the base's signed total), and the branch's
+      signed total equals the last of them, i.e. branch total - base total = the sum of the appended rows' Lines.
+      With no kernel row appended the signed total must not change.
+  Anything else (an edited, deleted or inserted row, other text, a total that does not follow the rows) is refused
+  with the reason, and the file stays serial (path_overlap) / conflicted (the merge goes to the agent sync as before).
+
+  resolve (base, branch = ours, main = theirs) -> main's file with the branch's appended rows added at the end of the
+  same table (matched by its header line, which must occur once on main), where a row that main added since the base
+  is not added again (kernel table: every cell but "Total after" equal; other tables: the whole row); the appended
+  kernel rows' "Total after" cells are renumbered from main's total, and
+    signed total = main total + (branch total - base total) - (Lines of the branch rows main already has).
+
+CLI (merge-train.sh / presync-watch-job.sh regen_merge call `resolve`, with a merge in progress, HEAD = the branch):
+  resolve --repo W [--commit]  exit 0: resolved and, with --commit, nothing else conflicted: merge committed
+                               exit 2: resolved and staged; other files still conflict (the caller goes on)
+                               exit 3: ALLOWANCES.md is not conflicted (nothing printed)
+                               exit 1: refused (one line: why); the file is left as git left it
+  check --repo R --branch B [--main main]   exit 0 "append-only ..." / 1 "not append-only: why" (path_overlap.py)
+"""
+import argparse, os, re, subprocess, sys
+
+PATH = "docs/kernel/ALLOWANCES.md"
+SIGNED = re.compile(r"^signed total: ([0-9][0-9,]*) lines$")
+SEP = re.compile(r"^\|(?:\s*:?-+:?\s*\|)+\s*$")
+CELL_SPLIT = re.compile(r"(?<!\\)\|")
+NUM = re.compile(r"^\s*([+-]?)([0-9]{1,3}(?:,[0-9]{3})*|[0-9]+)\s*$")
+
+
+class Refused(Exception):
+    pass
+
+
+def num(cell, what):
+    m = NUM.match(cell)
+    if not m:
+        raise Refused(f"{what} {cell.strip()!r} is not a number")
+    n = int(m.group(2).replace(",", ""))
+    return -n if m.group(1) == "-" else n
+
+
+def cells(row):
+    """The cells of a table row '| a | b |' (escaped pipes stay inside a cell)."""
+    parts = CELL_SPLIT.split(row)
+    return parts[1:-1] if len(parts) >= 3 and parts[0].strip() == "" and parts[-1].strip() == "" else None
+
+
+def parse(text, side):
+    """(skeleton, tables, total): skeleton = the lines with each table's rows removed (header and separator kept) and the
+    signed total line replaced by a marker; tables = [(header, [rows])] in file order; total = the signed total."""
+    lines = text.split("\n")
+    totals = [i for i, ln in enumerate(lines) if SIGNED.match(ln)]
+    if len(totals) != 1:
+        raise Refused(f"{side} has {len(totals)} 'signed total: N lines' lines, not one")
+    total = int(SIGNED.match(lines[totals[0]]).group(1).replace(",", ""))
+    skel, tables, i = [], [], 0
+    while i < len(lines):
+        ln = lines[i]
+        if ln.startswith("|"):
+            j = i
+            while j < len(lines) and lines[j].startswith("|"):
+                j += 1
+            block = lines[i:j]
+            if len(block) < 2 or not SEP.match(block[1]):
+                raise Refused(f"{side}: a table at line {i + 1} has no header and separator")
+            skel += [("table", block[0]), block[1]]
+            tables.append((block[0], block[2:]))
+            i = j
+            continue
+        skel.append("<signed total>" if i == totals[0] else ln)
+        i += 1
+    heads = [h for h, _ in tables]
+    for h in heads:
+        if heads.count(h) > 1:
+            raise Refused(f"{side}: two tables have the header {h.strip()[:60]!r}")
+    return skel, tables, total
+
+
+def kernel_cols(header):
+    """(index of Lines, index of Total after) when this is the kernel table, else None."""
+    hc = [c.strip() for c in (cells(header) or [])]
+    if "Lines" in hc and "Total after" in hc:
+        return hc.index("Lines"), hc.index("Total after")
+    return None
+
+
+def analyse(base, ours, side="the branch"):
+    """The branch's change to the file as {header: [appended rows]} with the totals, or Refused(why)."""
+    bskel, btabs, btot = parse(base, "the merge base")
+    oskel, otabs, otot = parse(ours, side)
+    if [h for h, _ in btabs] != [h for h, _ in otabs]:
+        raise Refused(f"{side} adds, removes or renames a table")
+    if bskel != oskel:
+        k = next((k for k, (x, y) in enumerate(zip(bskel, oskel)) if x != y), min(len(bskel), len(oskel)))
+        y = oskel[k] if k < len(oskel) else "(end of file)"
+        raise Refused(f"{side} changes text outside the tables' ends (first at {str(y)[:70]!r})")
+    appended, running = {}, btot
+    for (h, brows), (_, orows) in zip(btabs, otabs):
+        if orows[:len(brows)] != brows:
+            k = next((k for k, (x, y) in enumerate(zip(brows, orows)) if x != y), len(orows))
+            raise Refused(f"{side} edits, deletes or inserts before an existing row of the table {h.strip()[:40]!r} "
+                          f"(row {k + 1}: {(brows[k] if k < len(brows) else '')[:60]!r})")
+        new = orows[len(brows):]
+        if not new:
+            continue
+        appended[h] = new
+        kc = kernel_cols(h)
+        if kc is None:
+            continue
+        for r in new:
+            c = cells(r)
+            if c is None or len(c) <= max(kc):
+                raise Refused(f"{side}: appended kernel row is not a full table row: {r[:60]!r}")
+            running += num(c[kc[0]], "its Lines")
+            if num(c[kc[1]], "its Total after") != running:
+                raise Refused(f"{side}: appended row's Total after {c[kc[1]].strip()} is not the previous total plus its "
+                              f"Lines ({running:,}): {r[:60]!r}")
+    if otot != running:
+        raise Refused(f"{side}'s signed total {otot:,} does not match the merge base's {btot:,} plus its appended rows' "
+                      f"Lines ({running - btot:+,})")
+    return appended, btot, otot
+
+
+def resolve(base, ours, theirs):
+    """The resolved file text (see the module docstring), or Refused(why)."""
+    appended, btot, otot = analyse(base, ours)
+    _, btabs, _ = parse(base, "the merge base")
+    lines = theirs.split("\n")
+    parse(theirs, "main")   # one signed total line, unique table headers
+    based = {h: list(rows) for h, rows in btabs}
+    total = next(int(SIGNED.match(ln).group(1).replace(",", "")) for ln in lines if SIGNED.match(ln))
+    running, dup_lines = total, 0
+    for h, new in appended.items():
+        starts = [i for i, ln in enumerate(lines) if ln == h and (i == 0 or not lines[i - 1].startswith("|"))]
+        if len(starts) != 1 or starts[0] + 1 >= len(lines) or not SEP.match(lines[starts[0] + 1]):
+            raise Refused(f"main has no single table with the header {h.strip()[:60]!r}")
+        end = starts[0] + 2
+        while end < len(lines) and lines[end].startswith("|"):
+            end += 1
+        mrows = lines[starts[0] + 2:end]
+        added = list(mrows)             # rows main added since the base (a multiset difference)
+        for r in based.get(h, []):
+            if r in added:
+                added.remove(r)
+        kc = kernel_cols(h)
+        key = (lambda r: r) if kc is None else (lambda r: tuple(x.strip() for k, x in enumerate(cells(r) or [r]) if k != kc[1]))
+        have = [key(r) for r in added]
+        out = []
+        for r in new:
+            if key(r) in have:
+                have.remove(key(r))
+                if kc is not None:
+                    dup_lines += num(cells(r)[kc[0]], "its Lines")
+                continue
+            if kc is not None:
+                c = cells(r)
+                running += num(c[kc[0]], "its Lines")
+                c[kc[1]] = f" {running:,} "
+                r = "|" + "|".join(c) + "|"
+            out.append(r)
+        lines[end:end] = out
+    want = total + (otot - btot) - dup_lines
+    if running != want:   # the same figure two ways; a mismatch is a bug here, never a guess
+        raise Refused(f"internal: renumbered total {running:,} is not main {total:,} + branch delta {otot - btot:+,} - "
+                      f"rows main has {dup_lines:+,}")
+    lines = [f"signed total: {want:,} lines" if SIGNED.match(ln) else ln for ln in lines]
+    return "\n".join(lines), want, total, otot - btot
+
+
+def git(repo, *a, check=False):
+    r = subprocess.run(["git", "-C", repo, *a], capture_output=True, text=True, timeout=120)
+    if check and r.returncode:
+        raise Refused(f"git {' '.join(a[:2])} failed: {r.stderr.strip()[:120]}")
+    return r
+
+
+def branch_shape(repo, branch, main="main"):
+    """(True, why) when the branch's diff to ALLOWANCES.md since its merge base with main is append-only, else (False, why)."""
+    mb = git(repo, "merge-base", main, branch).stdout.strip()
+    if not mb:
+        return False, "no merge base with main"
+    b, o = git(repo, "show", f"{mb}:{PATH}"), git(repo, "show", f"{branch}:{PATH}")
+    if b.returncode or o.returncode:
+        return False, "the file is missing at the merge base or on the branch"
+    try:
+        app, bt, ot = analyse(b.stdout, o.stdout)
+    except Refused as e:
+        return False, str(e)
+    n = sum(len(v) for v in app.values())
+    return True, f"append-only: {n} appended row(s), signed total {bt:,} -> {ot:,} ({ot - bt:+,})"
+
+
+def cmd_resolve(a):
+    w = a.repo
+    if git(w, "rev-parse", "-q", "--verify", "MERGE_HEAD").returncode:
+        return 3
+    if not git(w, "ls-files", "-u", "--", PATH).stdout.strip():
+        return 3
+    try:
+        st = {}
+        for k in (1, 2, 3):
+            r = git(w, "show", f":{k}:{PATH}")
+            if r.returncode:
+                raise Refused(f"stage {k} of {PATH} is missing (a side deleted or added the file)")
+            st[k] = r.stdout
+        text, want, mt, delta = resolve(st[1], st[2], st[3])
+    except Refused as e:
+        print(f"refused: {e}; {PATH} left conflicted (serial path: agent sync)")
+        return 1
+    with open(os.path.join(w, PATH), "w") as fh:
+        fh.write(text)
+    git(w, "add", "--", PATH, check=True)
+    msg = f"{PATH} resolved: main's rows + the branch's appended rows, signed total {mt:,} {delta:+,} = {want:,}"
+    rest = git(w, "diff", "--name-only", "--diff-filter=U").stdout.split()
+    if rest:
+        print(f"{msg}; other files still conflict: {' '.join(rest)}")
+        return 2
+    if a.commit:
+        r = git(w, "commit", "-q", "--no-edit")
+        if r.returncode:
+            print(f"{msg}; the merge commit failed: {r.stderr.strip()[:120]}")
+            return 2
+        print(f"{msg}; merge committed")
+        return 0
+    print(f"{msg}; staged (no other conflicts)")
+    return 0
+
+
+def cmd_check(a):
+    ok, why = branch_shape(a.repo, a.branch, a.main)
+    print(why if ok else f"not append-only: {why}")
+    return 0 if ok else 1
+
+
+def main(argv):
+    ap = argparse.ArgumentParser()
+    sub = ap.add_subparsers(dest="cmd")
+    r = sub.add_parser("resolve")
+    r.add_argument("--repo", required=True)
+    r.add_argument("--commit", action="store_true")
+    c = sub.add_parser("check")
+    c.add_argument("--repo", required=True)
+    c.add_argument("--branch", required=True)
+    c.add_argument("--main", default="main")
+    a = ap.parse_args(argv)
+    if a.cmd == "resolve":
+        return cmd_resolve(a)
+    if a.cmd == "check":
+        return cmd_check(a)
+    print(__doc__)
+    return 2
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
