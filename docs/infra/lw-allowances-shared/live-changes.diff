+class Shapes(Base):
+    """allowances_merge.analyse / resolve on texts (no git)."""
+    def am(self):
+        p = os.path.join(self.M, "tools-local", "allowances_merge.py")
+        self.assertTrue(os.path.exists(p), "tools-local/allowances_merge.py is not installed")
+        spec = importlib.util.spec_from_file_location("am_" + str(id(self)), p)
+        mod = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(mod)
+        return mod
+
+    def refused(self, ours, needle, base=BASE):
+        am = self.am()
+        with self.assertRaises(am.Refused) as c:
+            am.analyse(base, ours)
+        self.assertIn(needle, str(c.exception))
+
+    def test_deleted_row_refused(self):
+        self.refused(BASE.replace(ROWS[1] + "\n", ""), "existing row")
+
+    def test_row_inserted_before_the_end_refused(self):
+        self.refused(doc(9976).replace(ROWS[2], RX + "\n" + ROWS[2].replace("9,966", "9,976")), "existing row")
+
+    def test_pre_signed_row_removed_refused(self):
+        self.refused(BASE.replace("| KB-1: Carry.lean | C | 80 |\n", ""), "existing row")
