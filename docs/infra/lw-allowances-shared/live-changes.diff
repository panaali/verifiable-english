+#!/usr/bin/env python3
+"""Tests for row lw-allowances-shared (reviews/dri-decisions-20261115-lw-allowances.md item 1): docs/kernel/ALLOWANCES.md is
+rebase-second (path_overlap.py rule 3a) with a resolver (tools-local/allowances_merge.py) run by merge-train.sh and
+presync-watch-job.sh regen_merge.
+
+Run: python3 -I tools-local/test_allowances_shared.py
+Each script is taken as <file>$LWAS_SFX where that file exists, else <file> (default LWAS_SFX=.new-lwas: the staged copies
+before the install, the live ones after it); LWAS_SFX= (empty) tests the live scripts. The scripts are copied under their
+installed names into a temp manage-agents tree (HOME=<tmp>/home, so merge-train.sh's M=~/code/manage-agents is that tree);
+the VE repos are temp git repos. Nothing outside the temp dir is read or written."""
+import importlib.util, os, re, shutil, subprocess, sys, tempfile, unittest
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+MA = os.path.dirname(HERE)
+SFX = os.environ.get("LWAS_SFX", ".new-lwas")
+FILES = ["merge-train.sh", "presync-watch-job.sh", "tools-local/path_overlap.py", "tools-local/allowances_merge.py"]
+AP = "docs/kernel/ALLOWANCES.md"
+
+
+def pick(rel):
+    p = os.path.join(MA, rel)
+    return p + SFX if SFX and os.path.exists(p + SFX) else p
+
+
+def row(change, lines, total, date="2026-11-16"):
+    return f"| {date} | {change} | C | {lines:+,} | {total:,} | architect seat |"
+
+
+ROWS = [row("first measurement", 9565, 9565).replace("+9,565", "9,565"),
+        "| 2026-11-11 | Review kb-0 F1: `certificate` re-measured | none | -609 | 8,956 | not needed (a fall) |",
+        row("kb-x old", 1010, 9966)]
+OWN = ["| 2026-11-15 | `anthropic-rsp` | - | 100 | kb-10d: the first measurement | not needed |"]
+
+
+def doc(total, rows=(), own=()):
+    return ("# Kernel allowances\n\nIt may rise only with a line in the table below.\n"
+            '`tests/test_kernel_closure.py` reads the figure after the words "signed total:".\n\n'
+            f"signed total: {total:,} lines\n\n"
+            "| Date | Change | Door | Lines | Total after | Signed |\n|---|---|---|---:|---:|---|\n"
+            + "\n".join(ROWS + list(rows)) + "\n\nPre-signed, to be entered by the change that uses it:\n\n"
+            "| Change | Door | At most |\n|---|---|---:|\n| KB-1: Carry.lean | C | 80 |\n\n## Ownership floor\n\n"
+            "| Date | Key | Floor before | Floor after | Change | Signed |\n|---|---|---:|---:|---|---|\n"
+            + "\n".join(OWN + list(own)) + "\n")
+
+
+BASE = doc(9966)
+RX = row("kb-x: a kernel rise", 10, 9976)
+RY = row("kb-y: another kernel rise", 5, 9971)
+RO = "| 2026-11-16 | `eligibility` | - | 269 | kb-y: the first measurement | not needed |"
+
+
+def run(*a, cwd=None, env=None, check=True):
+    r = subprocess.run(a, cwd=cwd, env=env, capture_output=True, text=True, timeout=300)
+    if check and r.returncode:
+        raise AssertionError(f"{a} -> {r.returncode}\n{r.stdout}\n{r.stderr}")
+    return r
+
+
+class Base(unittest.TestCase):
+    def setUp(self):
+        self.d = tempfile.mkdtemp(prefix="lwas-")
+        self.home = os.path.join(self.d, "home")
+        self.M = os.path.join(self.home, "code", "manage-agents")
+        os.makedirs(os.path.join(self.M, "tools-local"))
+        os.makedirs(os.path.join(self.M, "prompts"))
+        for rel in FILES:
+            if os.path.exists(pick(rel)):
+                shutil.copy(pick(rel), os.path.join(self.M, rel))
+        self.env = dict(os.environ, HOME=self.home, GIT_AUTHOR_NAME="t", GIT_AUTHOR_EMAIL="t@t", GIT_COMMITTER_NAME="t",
+                        GIT_COMMITTER_EMAIL="t@t", GIT_CONFIG_NOSYSTEM="1", GIT_CONFIG_GLOBAL="/dev/null", FEED_DIR=self.M)
+        self.R = os.path.join(self.d, "repo")
+        self.git("init", "-q", "-b", "main", self.R, cwd=self.d)
+        self.write(self.R, BASE)
+        self.git("add", "-A")
+        self.git("commit", "-qm", "base")
+
+    def tearDown(self):
+        shutil.rmtree(self.d, ignore_errors=True)
+
+    def git(self, *a, cwd=None, check=True):
+        return run("git", *a, cwd=cwd or self.R, env=self.env, check=check)
+
+    def read(self, *rel):
+        with open(os.path.join(self.M, *rel)) as fh:
+            return fh.read()
+
+    def write(self, w, text):
+        os.makedirs(os.path.join(w, "docs", "kernel"), exist_ok=True)
+        with open(os.path.join(w, AP), "w") as fh:
+            fh.write(text)
+
+    def branch(self, name, text, start="main"):
+        """Branch <name> from <start> with ALLOWANCES.md = text (made in the main checkout, which returns to main)."""
+        self.git("checkout", "-q", "-b", name, start)
+        self.write(self.R, text)
+        self.git("commit", "-qam", name)
+        self.git("checkout", "-q", "main")
+
+    def publish(self, name):
+        self.git("merge", "-q", "--no-ff", "--no-edit", name)
+
+    def conflicted(self, name):
+        """A worktree of <name> with a merge of main in progress that conflicts on ALLOWANCES.md."""
+        w = os.path.join(self.d, "ve-" + name)
+        self.git("worktree", "add", "-q", w, name)
+        r = self.git("merge", "--no-edit", "main", cwd=w, check=False)
+        self.assertNotEqual(r.returncode, 0, "the fixture should conflict")
+        self.assertIn(AP, self.git("diff", "--name-only", "--diff-filter=U", cwd=w).stdout)
+        return w
+
+    def resolver(self, w):
+        p = os.path.join(self.M, "tools-local", "allowances_merge.py")
+        self.assertTrue(os.path.exists(p), "tools-local/allowances_merge.py is not installed")
+        return run(sys.executable, "-I", p, "resolve", "--repo", w, "--commit", env=self.env, check=False)
+
+    def train_regen_merge(self, w):
+        """merge-train.sh's own regen_merge in library mode (presync-lean-regen.zsh's way of sourcing it)."""
+        return run("zsh", "-c", 'MT_LIB=1; source $1 || exit 9; MT_LIB=""; regen_merge $2', "x",
+                   os.path.join(self.M, "merge-train.sh"), w, env=self.env, check=False)
+
+    def overlap(self):
+        spec = importlib.util.spec_from_file_location("po_" + str(id(self)), os.path.join(self.M, "tools-local", "path_overlap.py"))
+        mod = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(mod)
+        return mod
+
+    def text(self, w, rev="HEAD"):
+        return self.git("show", f"{rev}:{AP}", cwd=w).stdout
+
+    def total(self, text):
+        return int(re.search(r"^signed total: ([0-9,]+) lines$", text, re.M).group(1).replace(",", ""))
+
+
+class Behaviour(Base):
+    def test_two_append_only_branches_rebase_second_with_both_rows_and_summed_total(self):
+        self.branch("kb-x", doc(9976, [RX]))
+        self.branch("kb-y", doc(9971, [RY]))
+        po = self.overlap()
+        self.assertEqual(po.classify(self.R, "kb-x", AP, "", set())[0], "rebase-second")
+        self.assertEqual(po.classify(self.R, "kb-y", AP, "", set())[0], "rebase-second")
+        self.publish("kb-x")
+        w = self.conflicted("kb-y")
+        r = self.train_regen_merge(w)
+        self.assertEqual(r.returncode, 0, r.stdout + r.stderr)
+        self.assertNotEqual(self.git("rev-parse", "-q", "--verify", "MERGE_HEAD", cwd=w, check=False).returncode, 0)
+        self.assertEqual(len(self.git("rev-list", "--parents", "-1", "HEAD", cwd=w).stdout.split()), 3)
+        t = self.text(w)
+        self.assertEqual(self.total(t), 9966 + 10 + 5)
+        self.assertEqual(t, doc(9981, [RX, row("kb-y: another kernel rise", 5, 9981)]))
+        self.assertIn("merge committed", self.read("merge-train.log"))
+
+    def test_presync_job_resolves_the_same_conflict(self):
+        self.branch("kb-x", doc(9976, [RX]))
+        self.branch("kb-y", doc(9971, [RY]))
+        self.publish("kb-x")
+        self.git("checkout", "-q", "--detach")
+        integ = os.path.join(self.d, "integ")
+        self.git("worktree", "add", "-q", integ, "main")
+        self.git("worktree", "add", "-q", os.path.join(self.d, "ve-kb-y"), "kb-y")
+        env = dict(self.env, PW_M=self.M, PW_R=self.R, PW_I=integ, PW_SLOT_BASE=os.path.join(self.d, "ve-presync"),
+                   PW_MLOG=os.path.join(self.M, "merge-train.log"))
+        r = run("zsh", os.path.join(self.M, "presync-watch-job.sh"), "label=kb-y", "branch=kb-y", "noagent", env=env, check=False)
+        log = self.read("presync-watch", "presync-watch.log")
+        self.assertEqual(r.returncode, 0, r.stdout + r.stderr + log)
+        s = self.git("rev-parse", "-q", "--verify", "refs/ve-presync/kb-y", check=False).stdout.strip()
+        self.assertTrue(s, log)
+        self.assertEqual(self.git("show", f"{s}:{AP}").stdout, doc(9981, [RX, row("kb-y: another kernel rise", 5, 9981)]))
+        self.assertIn("allowances resolve", log)
+
+    def test_branch_editing_an_existing_row_is_serial_and_refused(self):
+        rows = list(ROWS)
+        edited = doc(9971, [RY]).replace(ROWS[1], ROWS[1].replace("re-measured", "measured again"))
+        self.branch("kb-x", doc(9976, [RX]))
+        self.branch("kb-e", edited)
+        v, why = self.overlap().classify(self.R, "kb-e", AP, "", set())
+        self.assertEqual(v, "serial")
+        self.assertIn("existing row", why)
+        self.publish("kb-x")
+        w = self.conflicted("kb-e")
+        r = self.resolver(w)
+        self.assertEqual(r.returncode, 1, r.stdout)
+        self.assertIn("refused", r.stdout)
+        self.assertIn("existing row", r.stdout)
+        self.assertIn(AP, self.git("diff", "--name-only", "--diff-filter=U", cwd=w).stdout)  # left as git left it
+        self.assertEqual(rows, ROWS)
+        r = self.train_regen_merge(w)   # the train: refused, logged, the merge restored for the agent sync
+        self.assertNotEqual(r.returncode, 0)
+        self.assertIn("refused", self.read("merge-train.log"))
+
+    def test_duplicate_appended_row_is_not_doubled(self):
+        self.branch("kb-x", doc(9976, [RX], [RO]))                 # main gets the row RX (and RO) first
+        self.branch("kb-y", doc(9981, [RX, row("kb-y: another kernel rise", 5, 9981)], [RO]), start="main~0")
+        self.publish("kb-x")
+        w = self.conflicted("kb-y")
+        r = self.resolver(w)
+        self.assertEqual(r.returncode, 0, r.stdout)
+        t = self.text(w)
+        self.assertEqual(t.count(RX), 1)
+        self.assertEqual(t.count(RO), 1)
+        self.assertEqual(self.total(t), 9976 + 5)                  # main 9,976 + branch delta 15 - RX's 10
+        self.assertEqual(t, doc(9981, [RX, row("kb-y: another kernel rise", 5, 9981)], [RO]))
+
+    def test_total_not_matching_branch_delta_is_refused(self):
+        self.branch("kb-x", doc(9976, [RX]))
+        self.branch("kb-b", doc(9978, [row("kb-b: a rise", 10, 9976)]))   # rows say +10, the total says +12
+        v, why = self.overlap().classify(self.R, "kb-b", AP, "", set())
+        self.assertEqual(v, "serial")
+        self.assertIn("does not match", why)
+        self.publish("kb-x")
+        w = self.conflicted("kb-b")
+        r = self.resolver(w)
+        self.assertEqual(r.returncode, 1, r.stdout)
+        self.assertIn("does not match", r.stdout)
+        self.assertIn(AP, self.git("diff", "--name-only", "--diff-filter=U", cwd=w).stdout)
+
+    def test_path_overlap_check_no_longer_reports_append_only_branches(self):
+        self.branch("kb-x", doc(9976, [RX]))
+        task = os.path.join(self.d, "task-kb-y.txt")
+        with open(task, "w") as fh:
+            fh.write("kb-y: append a kernel row to docs/kernel/ALLOWANCES.md\n")
+        r = run(sys.executable, "-I", os.path.join(self.M, "tools-local", "path_overlap.py"), "check", "--repo", self.R,
+                "--branch", "kb-x", "--task", task, "--paths", "docs/kernel/", env=self.env)
+        out = r.stdout.strip().split("\n")
+        self.assertEqual(out[-1], "rebase-second", r.stdout)
+        self.assertTrue(out[0].startswith(f"rebase-second {AP}: kernel allowances, append-only"), r.stdout)
+        with open(os.path.join(self.M, "REBASE-SECOND-SERIAL"), "w") as fh:
+            fh.write(f"{AP}\t2026-11-16T00:00Z\tpair a/b\n")
+        r = run(sys.executable, "-I", os.path.join(self.M, "tools-local", "path_overlap.py"), "check", "--repo", self.R,
+                "--branch", "kb-x", "--task", task, "--paths", "docs/kernel/", env=self.env)
+        self.assertTrue(r.stdout.startswith(f"serial {AP}: REBASE-SECOND-SERIAL"), r.stdout)   # the guard still wins
+
