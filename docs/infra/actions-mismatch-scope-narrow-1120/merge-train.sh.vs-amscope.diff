--- merge-train.sh.new-amscope	2026-11-20 06:38:58.314340442 +0000
+++ merge-train.sh.new-amscope2	2026-11-20 08:39:12.259403380 +0000
@@ -7,7 +7,8 @@
 M=~/code/manage-agents; P=$M/prompts; I=~/code/ve-integration; R=~/code/verifiable-english; log=$M/merge-train.log
 # 2026-11-20 actions-mismatch-scope-1120 (reviews/dri-decisions-20261120-actions-mismatch-scope.md item 1): cloud-jobs/ACTIONS_MISMATCH
 # switches off the Actions gate legs (armavail/shavail/x86shavail, via actoff) only as mismatch_blocks_gate says (mismatch-scope.sh:
-# a tm-*/testmap-*/select-* line does not; empty, unparseable or any other line does). Helper not sourceable: the old rule.
+# only a tm-*/testmap-* "verdict sample differs" line does not; select-*, provenance/digest, empty, unparseable or any other
+# line does). Narrowed by actions-mismatch-scope-narrow-1120 (dri-decisions-20261120-adv0757.md item 1). Helper not sourceable: the old rule.
 source $M/mismatch-scope.sh 2>/dev/null || mismatch_blocks_gate(){ [[ -e $1 ]]; }
 # actoff <flag under $M>: the flag switches the Actions gate legs off now (ACTIONS_MISMATCH: every rc of the helper but 1 blocks)
 actoff(){ if [ $1 = cloud-jobs/ACTIONS_MISMATCH ]; then mismatch_blocks_gate $M/$1; [ $? != 1 ]; else [ -f $M/$1 ]; fi; }
