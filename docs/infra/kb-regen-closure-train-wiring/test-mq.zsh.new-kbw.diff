+# 2026-11-17 kb-regen-closure-train-wiring: the kernel closure baseline after a merge of main (cases K1-K9; `zsh test-mq.zsh kc`
+# runs only these). The stub tree has the regen entry kernel-closure: docs/kernel/closure-baseline.json, measured from
+# lean/*.lean (one row per file with its line count; kernel_lines = their sum). The baseline has a "keeps ours" merge driver
+# (as regen_generated's json driver can keep one side), so the train's sync merge keeps the branch's per-path rows: equal totals.
+KB=docs/kernel/closure-baseline.json
+kenv(){ qenv $1; touch $M/CAND_REGEN_LEAN; XENV="STUB_PY_C=1"; mkdir -p $S/kcxs
+  printf '[merge "kcours"]\n\tname = stub: keeps ours\n\tdriver = true\n' >> $H/.gitconfig
+  printf 'def scan_tree():\n    return (None, None, None, [])\n' > $I/tools/trust_map.py
+  cat > $I/tools/regen_generated.py <<'PY'
+"""stub regen_generated.py (test-mq.zsh K cases): the entry "kernel-closure" = docs/kernel/closure-baseline.json, measured from
+lean/*.lean. Scenario files in $SCEN: kc-limit (the check also prints a FAIL line), kc-broken (the check fails with no STALE
+line), kc-wfail (the write leaves an untracked file and fails), kc-nofix (the write writes nothing), kc-extra (the write also
+changes docs/notes.txt), kc-slow (the check outlasts the train's timeout). Every check and write of the entry appends
+"<worktree> check|write" to $SCEN/kc-calls."""
+import glob, json, os, sys, time
+a = sys.argv[1:]; scen = os.environ.get("SCEN", "/nonexistent"); here = os.path.basename(os.getcwd())
+B = "docs/kernel/closure-baseline.json"
+def has(f): return os.path.exists(os.path.join(scen, f))
+def rows(): return [{"name": os.path.basename(f), "lines": len(open(f).read().splitlines())} for f in sorted(glob.glob("lean/*.lean"))]
+def render(r): return json.dumps({"kernel_lines": sum(x["lines"] for x in r), "paths": r}, indent=1) + "\n"
+if "--owner" in a:
+    print("kernel-closure" if a[a.index("--owner") + 1] == B else "extra"); sys.exit(0)
+only = [a[i + 1] for i, x in enumerate(a) if x == "--only"]
+if "--names" in a or "kernel-closure" not in only:
+    sys.exit(0)
+mode = "check" if "--check" in a else "write"
+open(os.path.join(scen, "kc-calls"), "a").write(f"{here} {mode}\n")
+if mode == "check":
+    print("== check kernel-closure", flush=True)
+    if has("kc-slow"):
+        time.sleep(60)
+    if has("kc-broken"):
+        print("lake build VE failed (1): stub"); print("regen_generated: failed: kernel-closure", file=sys.stderr); sys.exit(1)
+    bad = False
+    if has("kc-limit"):
+        print("FAIL: the kernel grew from 5 to 6 lines; a rise needs a signed line in docs/kernel/ALLOWANCES.md"); bad = True
+    try:
+        saved = open(B).read()
+    except OSError:
+        saved = ""
+    if saved == render(rows()):
+        print(f"PASS: {B} is what --out writes now")
+    else:
+        old = {r["name"]: r for r in json.loads(saved or "{}").get("paths", [])}; new = {r["name"]: r for r in rows()}
+        d = sorted(n for n in old.keys() | new.keys() if old.get(n) != new.get(n))
+        print(f"STALE: {B} is not what --out writes now (path rows {', '.join(d)}); regenerate it: "
+              "uv run python tools/regen_generated.py --write --only kernel-closure"); bad = True
+    if bad:
+        print("regen_generated: failed: kernel-closure", file=sys.stderr); sys.exit(1)
+    print("regen_generated: checked 1 entries"); sys.exit(0)
+if has("kc-wfail"):
+    open("docs/kernel/out.tmp", "w").write("partial\n"); print("REFUSED: stub writer failure"); sys.exit(1)
+if not has("kc-nofix"):
+    open(B, "w").write(render(rows()))
+if has("kc-extra"):
+    open("docs/notes.txt", "a").write("extra\n")
+PY
+  (cd $I && mkdir -p docs/kernel && echo notes > docs/notes.txt && printf 'theorem p : True :=\n  trivial\n' > lean/P.lean \
+    && printf 'theorem q : True :=\n  trivial\n' > lean/Q.lean && echo "$KB merge=kcours" > .gitattributes && kcw \
+    && g add -A && g commit -qm "stub kernel closure: P, Q, the baseline and its regen entry")
+  PRE=$(g -C $I rev-parse HEAD); }
+kcw(){ SCEN=$S/kcxs python3 tools/regen_generated.py --write --only kernel-closure; }
+# brk <label> stale|fresh: fix/<label>. stale: the branch adds lean/B.lean (1 line, its baseline rewritten), then main moves a
+# line from P to Q (main's baseline rewritten): the train's sync merge keeps the branch's baseline, total 6 = the fresh total
+# 6, rows P.lean and Q.lean stale. fresh: the branch adds a test only, main does not move.
+brk(){ local w=$H/code/ve-$1; g -C $REPO worktree add -q -b fix/$1 $w main; mkdir -p $SCEN/mac/cand-$1
+  if [ "$2" = stale ]; then
+    (cd $w && echo 'theorem b : True := trivial' > lean/B.lean && kcw && g add -A && g commit -qm "change $1: lean/B.lean")
+    (cd $I && echo 'theorem p : True := trivial' > lean/P.lean && printf 'theorem q : True :=\n  trivial\n-- q\n' > lean/Q.lean \
+      && kcw && g add -A && g commit -qm "main moves a line from P to Q"); PRE=$(g -C $I rev-parse HEAD)
+  else (cd $w && echo "def test_$1(): pass" > tests/test_$1.py && g add -A && g commit -qm "change $1"); fi; }
+# kcx <commit>: its tree in $S/kcx; kcfresh <commit>: its baseline passes the stub check; kcnow <commit>: the total --write makes
+kcx(){ rm -rf $S/kcx; mkdir -p $S/kcx; g -C $I archive $1 | tar -x -C $S/kcx; }
+kcfresh(){ kcx $1 && (cd $S/kcx && SCEN=$S/kcxs python3 tools/regen_generated.py --check --only kernel-closure > /dev/null 2>&1); }
+kcnow(){ kcx $1 && (cd $S/kcx && kcw && python3 -c 'import json; print(json.load(open("'$KB'"))["kernel_lines"])'); }
+kctot(){ g -C $I show $1:$KB | python3 -c 'import json, sys; print(json.load(sys.stdin)["kernel_lines"])'; }
+kcalls(){ cat $SCEN/kc-calls 2>/dev/null | tr '\n' ';'; }
+smof(){ g -C $H/code/ve-$1 rev-list --merges -1 HEAD; }  # the branch's sync merge of main
+kskip(){ grep -qF "kernel closure regen of $1 skipped ($2" $M/merge-train.log; }
+kcsec(){
+echo "== merge-train.sh: the kernel closure baseline after a merge of main (2026-11-17 kb-regen-closure-train-wiring)"
+echo "K1 the train's sync merge keeps a per-path stale baseline with equal totals -> rewritten, one commit, published fresh"
+kenv k1; brk k1 stale; mrec k1 -; start k1; finish k1
+SM=$(smof k1); HB=$(g -C $H/code/ve-k1 rev-parse HEAD); HM=$(g -C $I rev-parse HEAD)
+ok "premise: the sync merge kept the branch's baseline: total $(kctot $SM) = the fresh total, rows P and Q stale" '[ -n "$SM" ] && [ "$(kctot $SM)" = 6 ] && [ "$(kcnow $SM)" = 6 ] && ! kcfresh $SM && [ "$(g -C $I rev-parse $SM^2)" = "$PRE" ]'
+ok "one regen commit on the sync merge, changing only the baseline" '[ "$(g -C $I rev-parse $HB^)" = "$SM" ] && [ "$(g -C $I log -1 --format=%s $HB)" = "Regenerate the kernel closure baseline after the merge of main (merge train, R12)" ] && [ "$(g -C $I diff-tree --no-commit-id --name-only -r $HB)" = "$KB" ] && g -C $I log -1 --format=%B $HB | grep -qF "(path rows P.lean, Q.lean)"'
+ok "published: main = the one gated candidate, its baseline fresh, its second parent the regen commit" '[ $(rcof k1) = 0 ] && [ $(gstarts k1) = 1 ] && [ "$HM" = "$(gsha k1 1)" ] && [ "$(g -C $I rev-parse $HM^2)" = "$HB" ] && kcfresh $HM && [ "$(kctot $HM)" = 6 ]'
+ok "the log line names the rows; check, write, check on k1's worktree only, once (not again on the new head)" 'grep -qF "kernel closure regen of k1: ${SM[1,8]} -> ${HB[1,8]} refreshed $KB ($KB is not what --out writes now (path rows P.lean, Q.lean); regen_generated --write --only kernel-closure) in " $M/merge-train.log && [ "$(kcalls)" = "ve-k1 check;ve-k1 write;ve-k1 check;" ]'
+echo "K2 a fresh tree -> checked once, logged fresh, no commit"
+kenv k2; brk k2 fresh; H0=$(g -C $H/code/ve-k2 rev-parse HEAD); mrec k2 -; start k2; finish k2
+ok "published the branch head as it was; one check; fresh line in merge-train.log.candregen" '[ $(rcof k2) = 0 ] && [ "$(g -C $I rev-parse HEAD^2)" = "$H0" ] && [ "$(kcalls)" = "ve-k2 check;" ] && grep -qE " k2 branch ${H0[1,8]} kernel closure fresh [0-9]+ s$" $M/merge-train.log.candregen && ! grep -q "kernel closure regen of k2" $M/merge-train.log'
+echo "K3 STALE and a FAIL line (a limit) -> never rewritten here: no write, gated as is"
+kenv k3; brk k3 stale; touch $SCEN/kc-limit; mrec k3 -; start k3; finish k3; SM=$(smof k3)
+ok "skipped (a limit), no write, the branch head is the sync merge" 'kskip k3 "the check also failed a limit: FAIL: the kernel grew from 5 to 6 lines" && [ "$(kcalls)" = "ve-k3 check;" ] && [ "$(g -C $H/code/ve-k3 rev-parse HEAD)" = "$SM" ]'
+echo "K4 the check fails with no STALE line (a broken build) -> no write"
+kenv k4; brk k4 stale; touch $SCEN/kc-broken; mrec k4 -; start k4; finish k4; SM=$(smof k4)
+ok "skipped (no STALE line, the failure quoted), no write, head unchanged" 'kskip k4 "the check failed without a STALE line: lake build VE failed (1): stub)" && [ "$(kcalls)" = "ve-k4 check;" ] && [ "$(g -C $H/code/ve-k4 rev-parse HEAD)" = "$SM" ]'
+echo "K5 the write changes a file of another entry -> refused, the branch reset to its head"
+kenv k5; brk k5 stale; touch $SCEN/kc-extra; mrec k5 -; start k5; finish k5; SM=$(smof k5)
+ok "skipped (owner extra), head unchanged, worktree clean, notes untouched, published stale as before" 'kskip k5 "the write changed docs/notes.txt (owner extra), not a file of kernel-closure)" && [ "$(g -C $H/code/ve-k5 rev-parse HEAD)" = "$SM" ] && [ -z "$(g -C $H/code/ve-k5 status --porcelain --untracked-files=no)" ] && [ "$(cat $H/code/ve-k5/docs/notes.txt)" = notes ] && [ $(rcof k5) = 0 ] && ! kcfresh $(g -C $I rev-parse HEAD)'
+echo "K6 the write leaves it stale -> refused, reset"
+kenv k6; brk k6 stale; touch $SCEN/kc-nofix; mrec k6 -; start k6; finish k6; SM=$(smof k6)
+ok "skipped (still STALE after the write), head unchanged, check write check" 'kskip k6 "still failing after the write: STALE: $KB is not what --out writes now" && [ "$(g -C $H/code/ve-k6 rev-parse HEAD)" = "$SM" ] && [ "$(kcalls)" = "ve-k6 check;ve-k6 write;ve-k6 check;" ]'
+echo "K7 the writer fails after leaving an untracked file -> that file removed, the builder's own untracked file kept"
+kenv k7; brk k7 stale; touch $SCEN/kc-wfail; echo mine > $H/code/ve-k7/mine.txt; mrec k7 -; start k7; finish k7; SM=$(smof k7)
+ok "skipped (writer failed), out.tmp removed, mine.txt kept, head unchanged" 'kskip k7 "the writer failed or timed out (2700 s): REFUSED: stub writer failure)" && [ ! -e $H/code/ve-k7/docs/kernel/out.tmp ] && [ "$(cat $H/code/ve-k7/mine.txt)" = mine ] && [ "$(g -C $H/code/ve-k7 rev-parse HEAD)" = "$SM" ]'
+echo "K8 off switch KERNEL_CLOSURE_REGEN.off -> no check; the stale baseline is gated as before"
+kenv k8; brk k8 stale; touch $M/KERNEL_CLOSURE_REGEN.off; mrec k8 -; start k8; finish k8
+ok "no check or write, no kernel closure line; published stale" '[ -z "$(kcalls)" ] && ! grep -q "kernel closure" $M/merge-train.log && [ $(rcof k8) = 0 ] && ! kcfresh $(g -C $I rev-parse HEAD)'
+echo "K9 library mode (presync-lean-regen.zsh run, MT_LIB): branchregen never runs the kernel closure step"
+kenv k9; brk k9 stale; g -C $H/code/ve-k9 merge -q --no-edit main > /dev/null 2>&1; SM=$(g -C $H/code/ve-k9 rev-parse HEAD)
+P9=$(runenv env STUB_PY_C=1 zsh $R0/presync-lean-regen.zsh run $H/code/ve-k9 k9 $M/merge-train.sh $M $S/pslr.log 2>&1 | tail -1)
+ok "the tree is stale, yet no check ran; PSLR fresh, head unchanged" '! kcfresh $SM && [ -z "$(kcalls)" ] && [[ "$P9" == "PSLR result=fresh h0=$SM h1=$SM "* ]]'
+echo "K10 the check outlasts KERNEL_CLOSURE_TIMEOUT (1 s here) -> killed, no write, the timeout named; gated as is"
+kenv k10; brk k10 stale; touch $SCEN/kc-slow; XENV="STUB_PY_C=1 KERNEL_CLOSURE_TIMEOUT=1"; mrec k10 -; start k10; finish k10; SM=$(smof k10)
+ok "skipped (no failure line, killed at the 1 s timeout), no write, head unchanged, published" 'kskip k10 "the check failed without a STALE line: no failure line (killed at the 1 s timeout, or a crash); last line: == check kernel-closure)" && [ "$(kcalls)" = "ve-k10 check;" ] && [ "$(g -C $H/code/ve-k10 rev-parse HEAD)" = "$SM" ] && [ $(rcof k10) = 0 ]'
+}
+[ "$1" = kc ] && { kcsec; echo "== merge queue (kernel closure cases): $pass passed, $failn failed"; exit $(( failn > 0 )); }
 
 echo "== merge-train.sh MERGE QUEUE (2026-10-16): stacked candidates, own full gate each, publication in queue order"
 echo "Q1 queue of 3, all pass; released in reverse order -> published a, b, c in order, each gated once"
@@ -228,4 +346,5 @@
 ok "held: main unchanged, no tag" '[ "$(g -C $I rev-parse HEAD)" = "$PRE" ] && [ -z "$(tagof a)" ] && [ -e /proc/$(cat $S/pid-a) ]'
 rm -f $M/MQ_PUBLISH_HOLD.$HS; finish a
 ok "published after the hold, no queue" '[ $(rcof a) = 0 ] && [ -n "$(tagof a)" ] && [ ! -d $M/mq ] && grep -q "^publish hold of a cleared" $M/merge-train.log'
+kcsec  # 2026-11-17 kb-regen-closure-train-wiring
 echo "== merge queue: $pass passed, $failn failed"
