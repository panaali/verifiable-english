+# 2026-11-17 pick-main-slot-mark (reviews/dri-decisions-20261117-pf16-main-slot.md item 3; the MEASURED case: pf-f16-without-fix,
+# rank 1, waited with main in its run-codex.sh PICK_AVOID; only its critical-fallback pick (cffall) was refused by the main worker cap,
+# no pick-waiting-main/ marker was written, and a rank-4 launch took the slot freed at 03:32Z).
+# (A) cffall marks pick-waiting-main/<row> when its PICK_CRIT_MAIN pick is refused by the main worker cap.
+# (B) a rank-1 critical fallback may take ONE main slot over the cap (mcap + 1) while main week <= PICK_MAIN_PACE line - 4 (with the
+#     rank-1 rule's 300-min rise < 5), one row at a time through PICK_R1_MARKER ($PCF/pick-main-rank1).
+PACE = "2026-10-01T00:00Z 60 2026-12-31T00:00Z 60\n"  # a flat PICK_MAIN_PACE line at 60: the rank-1 bound is week <= 56
+
+
+def flat_log(week):  # usage-watch.log lines: main flat at week over 4 h (rise 0)
+    return "header line dropped by the reader\n" + "".join(f"{h:02d}:00Z main 5h=45 week={week} allowed\n" for h in range(15, 20))
+
+
+class CritFallbackSlot(RankBase):
+    def setUp(self):
+        super().setUp()
+        self.r1 = f"{self.m}/pick-main-rank1"
+
+    def crit(self, item, busy, f=45, w=47, flat=False, pace=True, **extra):
+        """the picker as run-codex.sh's critical caller held 20 min: main only in PICK_AVOID (PICK_AVOID_RCX), cffall due"""
+        if pace:
+            open(f"{self.h}/flag-PICK_MAIN_PACE", "w").write(PACE)
+        elif os.path.exists(f"{self.h}/flag-PICK_MAIN_PACE"):
+            os.remove(f"{self.h}/flag-PICK_MAIN_PACE")
+        ul = f"{self.h}/none"
+        if flat:  # a fresh usage-watch.log with main flat at week w
+            ul = f"{self.h}/usage-watch.log"; open(ul, "w").write(flat_log(w))
+            os.utime(ul, (te.NOW.timestamp() - 60, te.NOW.timestamp() - 60))
+        return self.pick([self.acct("main", f, w)], item=item, busy=busy, PICK_AVOID="main", PICK_AVOID_RCX="main",
+                         PICK_CRIT_T0=str(int(time.time()) - 20 * 60), PICK_USAGE_LOG=ul, **extra)
+
+    def holder(self):
+        return open(self.r1).read().split() if os.path.exists(self.r1) else None
+
+    # (A) the MEASURED case: first pick "held out (PICK_AVOID)", the fallback pick refused by the cap (5-h 45: cap 3 -> 2) -> marker.
+    # No PICK_MAIN_PACE line in (A): the run-codex main lift (pace line - 4, installed after 03:28Z) is off, so the first pick holds
+    # main out as it did for pf-f16 (it also does whenever main week is over the line - 4 and under the critical bound 60)
+    def test_crit_fallback_cap_refusal_marks(self):
+        out, err = self.crit("rsp-x", "/x/claude-main=2", pace=False)
+        self.assertIsNone(out)
+        self.assertIn("main: held out (PICK_AVOID", err)
+        self.assertIn("critical fallback to main (held 20 min): main: main worker cap 2/2", err)
+        self.assertTrue(os.path.exists(self.marker("rsp-x")))
+        self.assertEqual(open(self.marker("rsp-x")).read().split()[0], "1")
+        # and the marker does what it is for: the rank-4 launch of 03:32Z is held off the freed slot
+        out, err = self.pick([self.acct("main", 45, 47)], item="kb-4b", busy="/x/claude-main=1")
+        self.assertIsNone(out)
+        self.assertIn("held for a waiting higher-ranked row rsp-x", err)
+
+    def test_crit_fallback_cap_refusal_marks_rank3(self):  # rank 2-3 rows mark too (a pinned bottleneck row is critical)
+        self.assertIsNone(self.crit("cg-fix", "/x/claude-main=2", pace=False)[0])
+        self.assertIn("main: held out (PICK_AVOID", self.crit("cg-fix", "/x/claude-main=2", pace=False)[1])
+        self.assertEqual(open(self.marker("cg-fix")).read().split()[0], "3")
+
+    def test_crit_fallback_other_refusal_or_rank4_no_mark(self):
+        out, err = self.crit("rsp-x", "/x/claude-main=1", f=52, pace=False)  # refused by the critical 5-h bound, not by the cap: no marker
+        self.assertIsNone(out)
+        self.assertIn("critical fallback needs main week < 60 and 5-h < 50", err)
+        self.assertFalse(os.path.exists(self.marker("rsp-x")))
+        self.assertIsNone(self.crit("kb-4b", "/x/claude-main=2", pace=False)[0])  # rank 4 (critical as kb-*): refused, never marks
+        self.assertFalse(os.path.exists(self.marker("kb-4b")))
+
+    # (B) rank-1, week 47 <= 60 - 4, flat week: the 3rd main slot (cap 2 at 5-h 45), this caller holds PICK_R1_MARKER
+    def test_rank1_crit_fallback_third_slot(self):
+        out, err = self.crit("rsp-x", "/x/claude-main=2", flat=True)
+        self.assertEqual(out, "/x/claude-main", err)
+        self.assertEqual(self.holder(), ["rsp-x", str(os.getpid())])
+        self.assertIn("item=rsp-x", open(f"{self.m}/pick-fallback.log").read())
+        self.assertFalse(os.path.exists(self.marker("rsp-x")))
+        self.assertEqual(self.crit("rsp-x", "/x/claude-main=2", flat=True, w=56)[0], "/x/claude-main")  # bound: week = line - 4
+
+    def test_rank1_slot_only_one_over_the_cap(self):  # mcap + 1 is the limit: a 4th session is refused and waits (marker)
+        out, err = self.crit("rsp-x", "/x/claude-main=3", flat=True)
+        self.assertIsNone(out)
+        self.assertTrue(os.path.exists(self.marker("rsp-x")))
+        self.assertIsNone(self.holder())
+        # under the 3rd-session bound too: cap 1 (PICK_MAIN_WORKERS 2 at 5-h 45) with 2 running is 2 over the cap, refused
+        out, err = self.crit("rsp-x", "/x/claude-main=2", flat=True, PICK_MAIN_WORKERS="2")
+        self.assertIsNone(out, err)
+        self.assertIn("main worker cap 2/1", err)
+        self.assertIsNone(self.holder())
+
+    # review F1 (PROBE F1): at 5-h 30 the cap is 3, and mcap + 1 gave a 4th main session; the rank-1 slot is the 3rd main slot at most
+    def test_rank1_slot_never_a_fourth_main_session(self):
+        out, err = self.crit("rsp-x", "/x/claude-main=3", f=30, flat=True)
+        self.assertIsNone(out, err)
+        self.assertIn("critical fallback to main (held 20 min): main: main worker cap 3/3", err)
+        self.assertNotIn("rank-1 critical slot", err)  # the rule is not asked: there is no slot over a cap of 3
+        self.assertTrue(os.path.exists(self.marker("rsp-x")))  # it waits for a freed slot like any cap refusal
+        self.assertIsNone(self.holder())
+
+    # the class of F1: over PICK_MAIN_WORKERS 1-6 and both taper steps under the critical 5-h bound, the rank-1 slot is granted
+    # exactly when main runs at its cap and the cap is under 3 (the grant is at most the 3rd main session); never at cap + 1
+    def test_rank1_slot_sweep_never_past_the_third_main_session(self):
+        seen = set()
+        for workers in (1, 2, 3, 4, 6):
+            for f in (30, 45):
+                mcap = workers if f < 40 else (workers + 1) // 2
+                for running in (mcap, mcap + 1):
+                    for path in (self.r1, self.marker("rsp-x")):
+                        if os.path.exists(path):
+                            os.remove(path)
+                    out, err = self.crit("rsp-x", f"/x/claude-main={running}", f=f, flat=True, PICK_MAIN_WORKERS=str(workers))
+                    case = f"workers={workers} 5-h={f} mcap={mcap} running={running}: {err[-400:]}"
+                    granted = running == mcap and 0 < mcap and running < 3
+                    seen.add(granted)
+                    self.assertEqual(out, "/x/claude-main" if granted else None, case)
+                    if granted:
+                        self.assertLessEqual(running + 1, 3, case)
+                        self.assertEqual(self.holder(), ["rsp-x", str(os.getpid())], case)
+                    else:
+                        self.assertIn(f"main worker cap {running}/{mcap}", err, case)
+                        self.assertIsNone(self.holder(), case)
+                        self.assertTrue(os.path.exists(self.marker("rsp-x")), case)
+        self.assertEqual(seen, {True, False})  # both outcomes are exercised
+
+    def test_rank1_slot_refused_over_pace_minus_4(self):  # week 57 > 60 - 4: refused with the cap reason, so it waits (marker)
+        out, err = self.crit("rsp-x", "/x/claude-main=2", flat=True, w=57)
+        self.assertIsNone(out)
+        self.assertIn("main worker cap 2/2", err)
+        self.assertIn("rank-1 main rule: week 57 > PICK_MAIN_PACE line 60.0 - 4", err)
+        self.assertTrue(os.path.exists(self.marker("rsp-x")))
+        self.assertIsNone(self.holder())
+        self.assertIsNone(self.crit("rsp-x", "/x/claude-main=2", flat=True, pace=False)[0])  # no PICK_MAIN_PACE line: refused
+
+    def test_rank1_slot_one_row_at_a_time(self):  # another rank-1 row holds the marker (live pid): refused, marker unchanged
+        open(self.r1, "w").write(f"rsp-y {os.getpid()}\n")
