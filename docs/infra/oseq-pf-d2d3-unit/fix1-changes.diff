+class NoInline(ast.NodeTransformer):
+    """A list / set / dict comprehension as the generator expression with the same scopes. CPython 3.12 inlines the
+    former into the enclosing symbol table (PEP 709), where symtable lists their targets as module-level names and does
+    not mark an enclosing function's local as referenced from inside them; a genexp keeps its own table."""
+    def visit_ListComp(self, n):
+        self.generic_visit(n)
+        return ast.GeneratorExp(n.elt, n.generators)
+
+    visit_SetComp = visit_ListComp
+
+    def visit_DictComp(self, n):
+        self.generic_visit(n)
+        return ast.GeneratorExp(ast.Tuple([n.key, n.value], ast.Load()), n.generators)
+
