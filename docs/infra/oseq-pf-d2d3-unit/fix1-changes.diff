+def oracle_reads(src):
+    """CPython's own reading (symtable), independent of the counter: (module-level names read, names an import inside a
+    function binds and some scope reads). Module level: every referenced name; a function: referenced globals and declared
+    globals; a class body: referenced globals and its own referenced locals (the globals are the fallback)."""
+    glob, imp = set(), set()
+    src = ast.unparse(ast.fix_missing_locations(NoInline().visit(ast.parse(src))))
+
+    def walk(t, chain):
+        kind = t.get_type()
+        for s in t.get_symbols():
+            n = s.get_name()
+            if n.startswith('.'):
+                continue
+            if kind == 'module':
+                if s.is_referenced():
+                    glob.add(n)
+                continue
+            if s.is_declared_global() or (s.is_global() and s.is_referenced()):
+                glob.add(n)
+            if kind == 'class' and s.is_local() and s.is_referenced():
+                glob.add(n)
+            if s.is_imported() and s.is_local() and s.is_referenced():
+                imp.add(n)
+            if s.is_free() and s.is_referenced():
