+def parser_lines(t):
+    """The test's own line cut, as CPython's tokenizer counts lines: only \\r\\n, \\r and \\n end a line."""
+    out, i = [], 0
+    while i < len(t):
+        j = i
+        while j < len(t) and t[j] not in '\r\n':
+            j += 1
+        j += 2 if t[j:j + 2] == '\r\n' else (1 if j < len(t) else 0)
+        out.append(t[i:j])
+        i = j
+    return out
