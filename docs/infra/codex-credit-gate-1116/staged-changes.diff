+#!/bin/bash
+# c2b-codex-shim.sh: the `codex` command of a remote builder host (ve-cloud-2; 2026-11-17 codex-credit-gate-1116,
+# reviews/dri-decisions-20261116-targets.md, orchestrator 191811Z (b): "ve-cloud-2 /usr/local/bin/codex has no shim").
+# Installed on the host as ~/c2b/codex-shim.sh, linked from ~/.local/bin/codex (first in c2b-job.sh's PATH, so a session in a
+# c2b scope that types `codex` gets it); cloud2-codex.sh starts it by that full path instead of /usr/local/bin/codex.
+# Every run that spends (the same subcommand list as the VM's codex-shim.sh) first asks the VM's LIVE gate over ssh:
+#   ssh ve-cloud-1 'CODEX_CALLER=<c> PICK_ITEM=<i> zsh <manage-agents>/codex-allowed.sh --ceiling'
+# (CODEX_OFF, CODEX_WEEK_CEILING and the credit stop, on the VM's live reading: this host's read-only mirror of
+# manage-agents can be days old, so its copy of the gate is never asked). Only CODEX_CALLER and PICK_ITEM go to the gate
+# (each refused unless it matches [A-Za-z0-9._:*-]{0,80}); no env of this host names a ceiling, clock or limit there.
+# Refused, gate unreachable or failing: one line on stderr, one in ~/c2b/logs/codex-shim.log, exit 75, the real binary is
+# not started (never open). Commands that do not spend pass. Test seams (tools-local/test_codex_credit_gate.sh only):
+# CODEX_SHIM_SSH (the ssh command word list), CODEX_SHIM_GATE (the gate path on the VM), CODEX_SHIM_REAL, CODEX_SHIM_LOG.
+real=${CODEX_SHIM_REAL:-/usr/local/bin/codex}
+gate=${CODEX_SHIM_GATE:-/home/seyran/code/manage-agents/codex-allowed.sh}
+log=${CODEX_SHIM_LOG:-$HOME/c2b/logs/codex-shim.log}
+read -r -a sshc <<< "${CODEX_SHIM_SSH:-ssh -F $HOME/.ssh/config -o BatchMode=yes -o ConnectTimeout=8 ve-cloud-1}"
+spend=1
+case ${1:-} in
+  (login|logout|mcp|plugin|app-server|remote-control|completion|update|doctor|sandbox|debug|apply|a|archive|delete|migrate-rollouts|unarchive|features|help|agents|exec-server|--version|-V|--help|-h) spend="";;
+  (cloud) [ "${2:-}" = exec ] || spend="";;
+esac
+if [ -n "$spend" ]; then
+  rc=0; why=""
+  for v in CODEX_CALLER PICK_ITEM; do
+    [[ ${!v:-} =~ ^[A-Za-z0-9._:*-]{0,80}$ ]] || { rc=2; why="$v is not a plain name"; }
+  done
+  if [ $rc = 0 ]; then
+    why=$(timeout 120 "${sshc[@]}" "CODEX_CALLER='${CODEX_CALLER:-}' PICK_ITEM='${PICK_ITEM:-}' zsh $gate --ceiling" < /dev/null 2>&1); rc=$?
+    why=${why##*$'\n'}; why=${why:0:300}
+  fi
+  if [ $rc != 0 ]; then
+    [ $rc = 1 ] || why="the gate on the VM could not be asked (exit $rc): $why"
+    case ${1:-} in (exec|e|review|resume|fork|queue|cloud) a=$1;; (*) a="(no subcommand)";; esac
+    args=("$@"); for (( i = 1; i < ${#args[@]} - 1; i++ )); do [ "${args[i]}" = -m ] && a="$a -m ${args[i+1]}"; done   # the subcommand and model only, never the prompt
+    printf '%s\n' "$(date -u +%FT%TZ) $(hostname) refused: $why | parent: $(tr '\0\n' '  ' < /proc/$PPID/cmdline 2>/dev/null | cut -c1-160) | codex ${a:0:80}" >> "$log" 2> /dev/null
+    printf '%s\n' "[codex-shim $(hostname)] Codex run refused: $why" >&2
+    exit 75
+  fi
+fi
+exec "$real" "$@"
