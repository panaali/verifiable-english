+#!/bin/zsh
+# Test of codex-credit-gate-1116 (2026-11-17; reviews/dri-decisions-20261116-targets.md, orchestrator 191811Z (b)): no caller
+# of ours spends Codex credits.
+#   A. codex-allowed.sh: a positive balance / has_credits never opens the gate (the credit branch is gone), and the credit
+#      stop (a fresh reading and week + seats <= 100) holds in every mode, with or without a CODEX_WEEK_CEILING line.
+#   B. c2b-codex-shim.sh (ve-cloud-2's `codex`): every spending call on the host goes through the VM's gate (fake ssh here),
+#      refuses when the gate refuses or cannot be asked, and forwards only CODEX_CALLER and PICK_ITEM.
+#   C. cloud2-codex.sh: the run on the host starts that shim, never /usr/local/bin/codex, and forwards the caller.
+# usage: zsh tools-local/test_codex_credit_gate.sh [codex-allowed.sh] [c2b-codex-shim.sh] [cloud2-codex.sh]
+#   no arguments = the installed files, plus a read of what is installed on ve-cloud-2 (ssh; C2B_LIVE=0 skips it).
+# Nothing here calls Codex: readings come from session files in a temp HOME or from a stub `codex app-server`.
+M=/home/seyran/code/manage-agents; S=${1:-$M/codex-allowed.sh}; RS=${2:-$M/c2b-codex-shim.sh}; CX=${3:-$M/cloud2-codex.sh}
+live=""; [ $# = 0 ] && live=1
+[ -f $M/CODEX_OFF ] && { echo "SKIP: CODEX_OFF set"; exit 0; }
+T=$(mktemp -d); trap 'rm -rf $T' EXIT; D=$T/.agent-accounts/codex/sessions/2026/11/17; mkdir -p $D
+now=$(date -u -d 2026-12-17T12:00:00Z +%s); fail=0
+FUT="2027-01-01T00:00:00Z"; OVER="75 2026-11-10T00:00:00Z"   # a ceiling line in force / one that is over at $now
+reset(){ rm -rf $T/.cache $D/*(N); }
+# mk <percent> [balance|-] [age s]: one session file with a reading (and a credit balance, has_credits true), <age> s old
+mk(){ local cr=""; [ "${2:--}" != - ] && cr=",\"credits\":{\"has_credits\":true,\"unlimited\":false,\"balance\":\"$2\"}"
+  echo "{\"payload\":{\"rate_limits\":{\"primary\":{\"used_percent\":$1}$cr}}}" > $D/rollout-x.jsonl; touch -d @$(( now - ${3:-0} )) $D/rollout-x.jsonl; }
+ok(){ [ "$1" = "$2" ] && echo "ok   $3: $4" || { echo "FAIL $3: want $2 got $1: $4"; fail=1; }; }
+# g <want rc> <label> <ceiling content> [VAR=value ...] -- [gate args]: the gate on the reading in $D now
