+class Logs:
+    """usage-watch.log and pick.log fixtures: series(acct, start_min_ago, [values every step min]), busy(t_min_ago, {dir: n})."""
+    def __init__(self, d, end_min_ago=31):
+        self.u, self.p, self.end = f"{d}/usage-watch.log", f"{d}/pick.log", NOW - end_min_ago * 60
+        self.rows, self.picks = [], []
+
+    def series(self, acct, start_min_ago, vals, step=5):
+        for i, v in enumerate(vals):
+            self.rows.append((NOW - start_min_ago * 60 + i * step * 60, f"{acct} 5h={v} week=20 allowed"))
+
+    def busy(self, min_ago, counts, until_min_ago=None):  # one pick.log sample, or one every 20 min down to until_min_ago
+        for m in range(min_ago, (until_min_ago if until_min_ago is not None else min_ago) - 1, -20):
+            self.picks.append((NOW - m * 60, counts))
+
+    def write(self):
+        rows = sorted(r for r in self.rows if r[0] <= self.end)
+        with open(self.u, "w") as fh:
+            fh.write("first line skipped by the tail reader\n")
+            for t, x in rows: fh.write(f"{hm(t)} {x}\n")
+        os.utime(self.u, (self.end, self.end))
+        with open(self.p, "w") as fh:
+            fh.write("first line skipped by the tail reader\n")
+            for t, c in sorted(self.picks, key=lambda q: q[0]):
+                fh.write(f"{iso(t)} picked claude-x busy: " + "".join(f"{k}={v} " for k, v in c.items()) + "fast=0 light=0 (caller pid 1)\n")
+        return self.u, self.p
