+"""2026-11-20 fm-move-5h-room (orchestrator ruling 222127Z item 2; reviews/dri-decisions-20261113-thresholds.md item 4): the MEASURED
+5-h points per session-hour of an account, read by pick-claude-account.sh's PICK_LONG_ROOM projection instead of one modelled rate
+(11-13: a 5x account rose about 8 points a session-hour under Fable seats against 6 modelled; main about 0.45 against 0.77).
+
+  rise         = the sum of the account's 5-h meter rises between consecutive usage-watch.log readings in the last `hours`
+  session-hours = the same intervals x the account's running claude -p sessions then (the busy counts pick.log records at each pick;
+                  the newest sample at or before the interval start, at most STALE_MIN old; an account a sample omits has 0)
+An interval counts only when both readings are known (>= 0), at most GAP_MIN apart, the earlier one is under `hold` (a window at
+its freeze level has stopped sessions that do not burn) and the meter did not fall (a fall is the window's reset). An interval with
+no busy sample is left out of both sums. Meter rises with no counted session (interactive use, the orchestrator on main) are kept:
+the rate errs high. The rate is rise / session-hours, None below `min_sh` session-hours (too little to measure).
+pick_rate(): the account's own rate, else the pooled rate of the accounts of its plan size, else None (the caller's modelled default).
+CLI (read-only): python3 -I tools-local/session_rate.py [hours]  prints each account's and each plan size's measurement.
+Tests: python3 -I tools-local/test_session_rate.py; tools-local/test_pick_srate.py (the picker with it)."""
+import datetime, os, sys
+
+M = os.path.expanduser("~/code/manage-agents")
+GAP_MIN, STALE_MIN, TAIL = 15, 30, 200000  # TAIL bytes: about 18 h of usage-watch.log
+
+
+def _tail(path):
+    with open(path, "rb") as fh:
+        fh.seek(max(os.stat(path).st_size - TAIL, 0))
+        return fh.read().decode(errors="replace").splitlines()[1:]
+
+
+def readings(path, now):
+    """{account: [(epoch, 5-h %)]} from usage-watch.log ("HH:MMZ <account> 5h=<v> week=<w> ..."); the newest line is dated by the
+    file's mtime (the newest earlier time of day), earlier lines walk back across midnight."""
+    try:
+        rows, mt = _tail(path), min(os.stat(path).st_mtime, now)
+    except OSError:
+        return {}
+    parsed = []
+    for r in rows:
+        x = r.split()
+        if len(x) < 4 or not x[0].endswith("Z") or len(x[0]) != 6 or not x[2].startswith("5h="):
+            continue
+        try:
+            parsed.append((int(x[0][:2]) * 60 + int(x[0][3:5]), x[1], int(x[2][3:])))
+        except ValueError:
+            continue
+    if not parsed:
+        return {}
+    d = datetime.datetime.fromtimestamp(mt, datetime.timezone.utc)
+    m0 = parsed[-1][0]
+    t = d.replace(hour=m0 // 60, minute=m0 % 60, second=0, microsecond=0).timestamp()
+    if t > mt + 120:
+        t -= 86400
+    out, prev = {}, m0
+    for m, a, v in reversed(parsed):
+        back = (prev - m) % 1440
+        if back > 720:
+            back -= 1440  # a line a minute or two out of order, not a day back
+        t -= back * 60; prev = m
+        out.setdefault(a, []).append((t, v))
+    for a in out:
+        out[a].reverse()
+    return out
+
+
+def busy(path, since):
+    """[(epoch, {config dir basename: running sessions})] from pick.log lines "<ISO>Z picked <dir> busy: <dir>=<n> ... (caller ...)"."""
+    out = []
+    try:
+        rows = _tail(path)
+    except OSError:
+        return out
+    for r in rows:
+        x = r.split()
+        if len(x) < 4 or x[1] != "picked" or "busy:" not in x:
+            continue
+        try:
+            t = datetime.datetime.strptime(x[0], "%Y-%m-%dT%H:%MZ").replace(tzinfo=datetime.timezone.utc).timestamp()
+        except ValueError:
+            continue
+        if t < since - STALE_MIN * 60:
+            continue
+        c = {}
+        for f in x[x.index("busy:") + 1:]:
+            k, _, n = f.partition("=")
+            if not n or k in ("fast", "light", "crit-fallback"):
+                continue
+            try:
+                c[os.path.basename(k)] = int(n)
+            except ValueError:
+                pass
+        out.append((t, c))
+    out.sort(key=lambda s: s[0])
+    return out
+
+
+def measure(pairs, now=None, hours=6.0, hold=88, ulog=None, plog=None):
+    """(rise, session-hours) summed over pairs [(account, config dir basename)]."""
+    now = now if now is not None else datetime.datetime.now(datetime.timezone.utc).timestamp()
+    since = now - hours * 3600
+    rd = readings(ulog or os.path.join(M, "usage-watch.log"), now)
+    bs = busy(plog or os.path.join(M, "pick.log"), since)
+    rise = sh = 0.0
+    for a, cb in pairs:
+        pts = [p for p in rd.get(a, []) if p[0] <= now]
+        j = 0
+        for (t0, v0), (t1, v1) in zip(pts, pts[1:]):
+            if t0 < since or v0 < 0 or v1 < 0 or v0 >= hold or v1 < v0 or not 0 < t1 - t0 <= GAP_MIN * 60:
+                continue
+            while j + 1 < len(bs) and bs[j + 1][0] <= t0:
+                j += 1
+            if not bs or bs[j][0] > t0 or t0 - bs[j][0] > STALE_MIN * 60:
+                continue
+            rise += v1 - v0
+            sh += bs[j][1].get(cb, 0) * (t1 - t0) / 3600
+    return rise, sh
+
