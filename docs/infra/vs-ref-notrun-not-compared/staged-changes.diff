+    def setUp(self):
+        super().setUp()
+        loader = importlib.machinery.SourceFileLoader("cloud_late_under_test", f"{self.md}/cloud-late.py")
+        self.c = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
+        loader.exec_module(self.c)
+        self.c.M = self.md  # its comparator: the copy under test
+        self.c.FLAG = f"{self.T}/CLOUD_LATE_APPLY"
+        open(self.c.FLAG, "w").close()
+        self.told = []
+        self.c.tell = self.told.append
+        self.LJ = f"{self.T}/late"
+        os.makedirs(f"{self.LJ}/by-tree")
+        env = mock.patch.dict(os.environ, {"ACTIONS_POOL_FLAG": self.pool, "CLOUD_TRIAL_FLAG": f"{self.T}/CLOUD_TRIAL"})
+        env.start()
+        self.addCleanup(env.stop)
+
+    def entry(self, edit=None):
+        """by-tree/k.json: p9's cloud record (edited), stored for the VM head and base of p9's cloud-verdicts.json."""
+        cl = rj(self.cj)
+        rec = json.loads(json.dumps(cl))
+        if edit:
+            edit(rec["mutants"])
+            rec["counts"] = counts(rec["mutants"])
+        wj(f"{self.LJ}/by-tree/k.json", dict(key={"head_tree": "0" * 40}, job="j", pool="actions", vm_head=cl["head"],
+                                             vm_base=cl["base"], tm_rc=1, record=rec))
+
+    def local_done(self, local=None):
+        out = io.StringIO()
+        with redirect_stdout(out):
+            rc = self.c.cmd_local_done(self.LJ, "k", local or self.cj, "1", "VM", "/wt")
+        return rc, out.getvalue()
+
+    def assertNothingOff(self, out):
+        self.assertTrue(os.path.exists(self.c.FLAG), f"CLOUD_LATE_APPLY turned off: {out}")
+        self.assertTrue(os.path.exists(self.pool), f"ACTIONS_POOL removed: {out}")
+        self.assertTrue(os.path.exists(f"{self.LJ}/by-tree/k.json"), "the stored entry was deleted")
+        self.assertFalse(os.path.exists(f"{self.LJ}/CLOUD_MISMATCH"))
+        self.assertEqual(self.told, [])
