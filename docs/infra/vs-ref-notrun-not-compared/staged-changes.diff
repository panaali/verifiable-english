+    def test_outcome_line_and_exit_code_fuzz(self):
+        """Every (verdict line, exit code) pair: the outcome is the line's only when the exit code agrees; no line, two
+        lines, a traceback or any other exit code is "failed" (not made)."""
+        names = {n for _, n, _ in self.c.OUTCOMES}
+        self.assertEqual(names, {"equal", "differ", "invalid", "not compared", "failed"})
+        for pre, name, want in self.c.OUTCOMES:
+            for rc in range(-1, 7):
