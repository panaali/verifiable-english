+class BucketKeys(unittest.TestCase):
+    """notask-wait-alert review F1: the rename "task file" -> NO_TASK left the literal "task file" in stage_details' capacity
+    exclusion, so no-task row-hours showed as "feed capacity waits (row-h): no task file 169.0". The class: a reader that names
+    a bucket by a string literal drifts from the table. Every reader goes through the bucket constants and NOT_CAPACITY."""
+    RES = {"Mac": {"avg": 1, "cores": 18}}
+
+    def hint(self, fw):
+        return bn.stage_details({}, [(0.0, 1.0)], Counter(fw), self.RES, []).get("launch-wait", "")
+
+    def test_f1_no_task_hours_not_a_capacity_hint(self):  # PROBE F1
+        self.assertNotIn("no task file", self.hint({bn.NO_TASK: 169.0}))
+        self.assertEqual(self.hint({bn.NO_TASK: 169.0, "prerequisites": 40.0}), "")
+        self.assertEqual(self.hint({bn.NO_TASK: 169.0, "Mac load": 2.0}), "feed capacity waits (row-h): Mac load 2.0")
+
+    def test_every_bucket_capacity_or_not(self):
+        names = [n for n, _ in bn.FEED_BUCKETS]
+        self.assertEqual(bn.NOT_CAPACITY, {"no task file", "prerequisites"})
+        self.assertLessEqual(bn.NOT_CAPACITY, set(names))
+        for n in names + ["other: something new"]:
+            with self.subTest(bucket=n):
+                self.assertEqual(n in self.hint({n: 3.0}), n not in bn.NOT_CAPACITY)
+
+    def test_no_bucket_literal_outside_the_table(self):
+        """Lint: no `x in (...)` / `x not in (...)` over a literal collection, and no fw.get(...) / fw[...], names a bucket (or
+        the old name "task file") by a string; FEED_BUCKETS, the constants and NOT_CAPACITY are the only place."""
+        import ast
+        names = {n for n, _ in bn.FEED_BUCKETS} | {"task file"}
+        bad = []
+        for node in ast.walk(ast.parse(open(SCRIPT).read())):
+            if isinstance(node, ast.Compare):
+                for op, rhs in zip(node.ops, node.comparators):
+                    if isinstance(op, (ast.In, ast.NotIn)) and isinstance(rhs, (ast.Tuple, ast.List, ast.Set)):
+                        bad += [(node.lineno, e.value) for e in rhs.elts if isinstance(e, ast.Constant) and e.value in names]
+            if (isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute) and node.func.attr == "get"
+                    and isinstance(node.func.value, ast.Name) and node.func.value.id == "fw" and node.args
+                    and isinstance(node.args[0], ast.Constant)):
+                bad.append((node.lineno, node.args[0].value))
+            if (isinstance(node, ast.Subscript) and isinstance(node.value, ast.Name) and node.value.id == "fw"
+                    and isinstance(node.slice, ast.Constant)):
+                bad.append((node.lineno, node.slice.value))
+        self.assertEqual(bad, [])
