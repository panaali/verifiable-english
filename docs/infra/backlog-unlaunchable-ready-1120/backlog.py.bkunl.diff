+# ---------------------------------------------------------------- ready with nobody to start it (2026-11-20 backlog-unlaunchable-ready)
+# lint: the rows ready_refusal would refuse today (rows already ready are never rewritten; this lists them) and blocked rows the
+# seed did not unblock for that reason. unlaunched: the orchestrator's hourly digest (tools-local/coord_diet.py digest-take) lists
+# every ready row older than UNL_MIN minutes (since ready_t, else status_t, else created) with no live launch: no running job of
+# its links.job / links.delegate / launch spec (a chain, a delegate, a ve-<name>-<n>.scope) and not in FEATURE-QUEUE.tsv or
+# started by the feature feed (feed-state/<id>.launched).
+UNL_MIN = 60
+BL_HELD = "blockers merged; not set ready: "
+
+
+def lint_lines(rows):
+    out = []
+    for r in sorted(rows.values(), key=lambda r: (r.get("priority", 500) if isinstance(r.get("priority"), (int, float)) else 500, r["id"])):
+        if r.get("status") == "ready":
+            why = ready_refusal(r)
+            if why:
+                out.append(f"{r['id']}\tready\t{r.get('kind')}\t{r.get('owner') or '-'}\t{why}")
+        elif r.get("status") == "blocked" and (r.get("state") or "").startswith(BL_HELD):
+            out.append(f"{r['id']}\tblocked\t{r.get('kind')}\t{r.get('owner') or '-'}\t{r['state'][len(BL_HELD):]}")
+    return out
+
+
+def live_scopes():
+    """Names <x> of active ve-<x>-<n>.scope units (iso.sh), as infra_feed.py reads them; empty when systemctl cannot answer."""
+    try:
+        out = subprocess.run(["systemctl", "--user", "list-units", "--type=scope", "--state=active", "--no-legend"],
+                             capture_output=True, text=True, timeout=60).stdout
+    except Exception:
+        return set()
+    return {m.group(1) for m in (re.match(r"ve-(.+)-\d{9,}\.scope$", (l.split() or [""])[0]) for l in out.splitlines()) if m}
+
+
+def live_launch(r, chains, delegates, scopes, queued):
+    """The live launch of a ready row ("" = none): its job running, or the feature feed holding it."""
+    L = r.get("links") or {}
+    s, _ = launch_spec(r)
+    for j in (L.get("job"), L.get("delegate"), (s or {}).get("iso"), r["id"]):
+        if j and (j in chains or j in delegates or j in scopes):
+            return f"job {j} running"
+    if r["id"] in queued:
+        return "in FEATURE-QUEUE.tsv"
+    if os.path.exists(f"{M}/feed-state/{r['id']}.launched"):
+        return "started by the feature feed"
+    return ""
+
+
+def unlaunched_lines(rows, T, chains, delegates, scopes, min_age=UNL_MIN):
+    """One line per ready row older than min_age minutes with no live launch: id, age, owner, why not launched."""
+    queued = queue_names()
+    out = []
+    for r in sorted(rows.values(), key=lambda r: (r.get("priority", 500) if isinstance(r.get("priority"), (int, float)) else 500, r["id"])):
+        if r.get("status") != "ready":
+            continue
+        t = parse_t(r.get("ready_t") or "") or parse_ts(r.get("status_t") or "") or parse_t(r.get("created") or "")
+        if not t or NOW_T - t < min_age * 60 or live_launch(r, chains, delegates, scopes, queued):
