+            st = (r.get("state") or "").strip()
+            why = (f"{who}: not started" + (f" (state: {short(st, 80)})" if st else "")) if ok else who
+        out.append(f"{r['id']}, {age(t)}, {r.get('owner') or '-'}: {short(why, 200)}")
+    return out
