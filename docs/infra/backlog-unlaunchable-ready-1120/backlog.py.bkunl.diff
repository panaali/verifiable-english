+        why = ready_refusal(r)
+        if r.get("kind") in NOT_LAUNCHED_KINDS or r.get("origin") in NOT_LAUNCHED_ORIGINS:
+            why = f"{r.get('kind')} row ({r.get('origin')}): not launched, its owner answers or closes it"
+        elif not why:
