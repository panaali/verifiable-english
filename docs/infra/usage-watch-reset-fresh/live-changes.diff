+class UsageWatch(Sandbox):
+    """usage-watch.sh (sandbox copy) on a stub accounts.sh that serves acc.<n> to call n and records ACCOUNTS_CAP_TTL; a stub sleep
+    records each sleep and ends the loop after self.polls sleeps. No real worker matches the sandbox config dirs."""
+    def setUp(self):
+        super().setUp()
+        self.d = f"{self.h}/.agent-accounts/claude-panaali2"
+        self.exe(f"{self.m}/accounts.sh", f'n=$(( $(cat {self.m}/ncalls 2>/dev/null || echo 0) + 1 )); echo $n > {self.m}/ncalls\n'
+                 f'echo "${{ACCOUNTS_CAP_TTL-unset}}" >> {self.m}/capttl\n'
+                 f'[ -f {self.m}/acc.$n ] && cat {self.m}/acc.$n || cat {self.m}/acc.last\n')
+        self.exe(f"{self.h}/bin/sleep", f'#!/bin/sh\necho "$1" >> {self.m}/sleeps\n'
+                 f'[ "$(wc -l < {self.m}/sleeps)" -ge "$(cat {self.m}/polls)" ] && kill -TERM $PPID\nexit 0\n')
+        src = open(UW).read().replace(LIVE, self.m)
+        self.uw = f"{self.h}/usage-watch.sh"
+        with open(self.uw, "w") as fh: fh.write(src)
+
+    def serve(self, *polls):  # polls[i]: the main week and weekly reset epoch served to accounts.sh call i+1
+        for i, (week, r2) in enumerate(polls, 1):
+            with open(f"{self.m}/acc.{i}", "w") as fh: fh.write(f"main {self.d} -2 {week} allowed ? {fld(r2)}\n")
+        shutil.copy(f"{self.m}/acc.{len(polls)}", f"{self.m}/acc.last")
+        with open(f"{self.m}/polls", "w") as fh: fh.write(str(len(polls)))
+
+    def run_uw(self):
+        env = {k: v for k, v in os.environ.items() if not k.startswith(("ACCOUNTS_", "ENDGAME_", "CODEX_"))}
+        env.update(HOME=self.h, ENDGAME_NOW=str(self.T), PATH=f"{self.h}/bin:" + os.environ.get("PATH", "/usr/bin:/bin"))
+        r = subprocess.run(["zsh", self.uw, "300"], env=env, capture_output=True, text=True, timeout=600)
+        rd = lambda n: open(f"{self.m}/{n}").read().split("\n")[:-1] if os.path.exists(f"{self.m}/{n}") else []
+        capttl = ["" if x == "unset" else x for x in rd("capttl")]  # unset and empty both mean accounts.sh's default (1800)
+        return r.stdout, [int(x) for x in rd("sleeps")], capttl, rd("usage-watch.log")
+
+    def test_old_window_97_after_reset_not_paused(self):  # the incident replay: weekly reset passed < 1 min ago, reading 97
+        R = floor_min(self.T); self.serve((97, R), (0, R + 7 * 86400))
+        out, sleeps, capttl, log = self.run_uw()
+        self.assertNotIn("PAUSED main", out)
+        self.assertIn("RESET-FRESH main", out)
+        self.assertEqual(sleeps[0], 60, sleeps)        # the next poll comes after 60 s
+        self.assertEqual(capttl[1], "0", capttl)       # and runs accounts.sh with ACCOUNTS_CAP_TTL=0
+        self.assertIn("main 5h=-2 week=97 allowed", log[0])  # usage-watch.log keeps the raw reading
+
+    def test_paused_before_reset_resumes_on_old_window_reading(self):  # paused on 96; then a lagging 97 that names a passed reset
+        R = floor_min(self.T); self.serve((96, self.T + 3 * 86400), (97, R))
+        out, _, _, _ = self.run_uw()
+        self.assertIn("PAUSED main", out)
+        self.assertIn("RESUMED main", out.split("PAUSED main", 1)[1])
+
+    def test_wakes_at_the_next_reset_with_cap_ttl_0(self):
+        # reset 2-3 min ahead; 50 is outside endgame.py's 60-s fast band, so the poll would come after 300 s (live: past the reset)
+        R = floor_min(self.T) + 180; self.serve((50, R), (0, R + 7 * 86400))
+        out, sleeps, capttl, _ = self.run_uw()
+        self.assertEqual(sleeps[0], R - self.T + 5, sleeps)
+        self.assertEqual(capttl, ["", "0"])
+
+    def test_control_after_grace_old_reading_acts(self):  # the reset passed 11 min ago: the reading is acted on as before
+        R = floor_min(self.T - 660); self.serve((97, R))
+        out, sleeps, capttl, _ = self.run_uw()
+        self.assertIn("PAUSED main", out); self.assertNotIn("RESET-FRESH", out)
+        self.assertEqual((sleeps, capttl), ([300], [""]))
+
+    def test_control_no_reset_near(self):
+        self.serve((50, self.T + 3 * 86400))
+        out, sleeps, capttl, _ = self.run_uw()
+        self.assertEqual((sleeps, capttl), ([300], [""]))
+        self.assertNotIn("PAUSED", out)
