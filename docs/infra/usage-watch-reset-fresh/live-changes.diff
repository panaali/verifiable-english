+    def test_failed_probe_gives_unknown_not_the_old_97(self):
+        R = floor_min(self.T); self.cache("main", self.main_line(97, fld(R)), R - 300)
+        os.remove(self.reply)  # the probe prints no rate_limit_info: "-1 -1 unknown"
