+class WeeklyPace(pm.PickCase):
+    """PICK_MAIN_PACE "weekly 97 4 90"; the main weekly reset comes from accounts-cache/main.line (fake clock te.NOW)."""
+    def setUp(self):
+        super().setUp()
+        self.cache = f"{self.h}/main.line"
+        src = open(self.p).read().replace(LIVE + "/accounts-cache/main.line", self.cache)
+        with open(self.p, "w") as fh: fh.write(src)
+        with open(f"{self.h}/flag-PICK_MAIN_PACE", "w") as fh: fh.write("weekly 97 4 90\n")
+
+    def reset_in(self, hours):
+        with open(self.cache, "w") as fh: fh.write(f"main /x/claude-main -2 50 allowed ? {te.field(hours)}\n")
+
+    def at(self, week, hours):
+        return self.pick([f"main /x/claude-main -2 {week} allowed ? " + te.field(hours)], log=flat_log(week))
+
+    def test_six_days_out_line_73(self):  # 97 - 4 x 6 = 73
+        self.reset_in(144)
+        got, err = self.at(74, 144); self.assertIsNone(got, err); self.assertIn("PICK_MAIN_PACE line 73.0% now", err)
+        self.assertEqual(self.at(72, 144)[0], MAIN)
+
+    def test_two_days_out_line_89_then_flat_90(self):
+        self.reset_in(48)
+        got, err = self.at(89, 48); self.assertIsNone(got, err); self.assertIn("PICK_MAIN_PACE line 89.0% now", err)
+        self.reset_in(24)  # 97 - 4 = 93 > 90: flat 90
+        self.assertEqual(self.at(89, 24)[0], MAIN)
+
+    def test_fresh_week_after_reset_low_line(self):  # cache still names the reset that passed 1 h ago: the next one is 7 d on
+        self.reset_in(-1)
+        got, err = self.at(70, -1); self.assertIsNone(got, err); self.assertIn("PICK_MAIN_PACE line 69.2% now", err)
+
+    def test_no_cache_start_of_week_value(self):
+        got, err = self.at(70, 100); self.assertIsNone(got, err); self.assertIn("PICK_MAIN_PACE line 69.0% now", err)
+        self.assertEqual(self.at(68, 100)[0], MAIN)
+
+    def test_dated_form_unchanged(self):  # 66 at 09:00Z 10-28 to 86 at 05:00Z 10-29: 76.0 at te.NOW
+        with open(f"{self.h}/flag-PICK_MAIN_PACE", "w") as fh: fh.write("2026-10-28T09:00Z 66 2026-10-29T05:00Z 86\n")
+        self.reset_in(144)
+        got, err = self.at(77, 144); self.assertIsNone(got, err); self.assertIn("PICK_MAIN_PACE line 76.0% now", err)
+
+    def test_inbox_wait_reader_gets_the_weekly_line(self):  # inbox-wait.sh execs `def pace_line` alone (ast: exactly one def)
+        self.reset_in(144)
+        pk = re.search(r"^def pace_line\(\):.*?\n(?=\S)", open(self.p).read(), re.S | re.M)
+        tree = ast.parse(pk.group(0))
+        self.assertEqual([type(n).__name__ + ":" + getattr(n, "name", "") for n in tree.body], ["FunctionDef:pace_line"])
+        sys.path.insert(0, f"{self.m}/tools-local")
+        ns = {"datetime": datetime, "os": os, "now": te.NOW}
+        exec(compile(tree, "pace_line", "exec"), ns)
+        self.assertEqual(ns["pace_line"](), 73.0)
+        # the flat F in the last days: 97 - 4 x 1 = 93 is capped at 90 (in a pick the 90 worker ceiling hides this cap)
+        self.reset_in(24); self.assertEqual(ns["pace_line"](), 90.0)
+        self.reset_in(42); self.assertEqual(ns["pace_line"](), 90.0)  # 97 - 4 x 1.75 = 90: the flat part starts here
