+#!/usr/bin/env python3
+"""usage-watch-reset-fresh (reviews/dri-decisions-20261113-thresholds.md; orchestrator thresholds ruling 230624Z item 4 and its
+23:09Z note): a reading that names a reset time that has already passed describes the OLD window of that pool. At 23:00:06Z
+11-13 usage-watch paused main's 6 sessions on a cached weekly 97 (accounts.sh reused a >= 88 line for 1800 s past main's
+weekly reset) until a forced probe at 23:09Z read 0. One owner of the "has this reading's reset passed" rule for accounts.sh
+(the cache) and usage-watch.sh (the pause); the reset fields are parsed by endgame.py's parser (one owner of that format).
+
+CLI (accounts.sh fields, e.g. Fri_Nov20_15:00 in America/Los_Angeles; "?" = no such window):
+  reset_fresh.py line <taken epoch s> <5hReset> <weekReset>
+      "pre"  a reset named in the line has passed and the line was taken before it: drop it, probe at once;
+      "post" a reset named in the line has passed but the line was taken after it (the service still reports the old window):
+             the line may be reused for ACCOUNTS_TTL only, never for the >= 88 ACCOUNTS_CAP_TTL;
+      "none" no reset named in the line has passed.
+  reset_fresh.py watch <5hReset> <weekReset>
+      "<old5> <oldW> <next>": oldX = 1 while that pool's named reset passed less than GRACE (600 s) ago (usage-watch ignores that
+      pool's % for pausing: it is a pre-reset reading); next = whole seconds until the nearest named reset still ahead, -1 none.
+Fake clock for tests: ENDGAME_NOW=<epoch s> (as endgame.py). Never fails a caller: any error prints the neutral answer
+("none" / "0 0 -1") and exits 0."""
+import datetime, os, sys
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import endgame  # noqa: E402  (hours_to: the accounts.sh reset field parser; now: the shared fake clock)
+
+GRACE = 600  # s after a reset during which usage-watch does not act on a reading that still names that reset
+
+
+def reset_epoch(r, at):
+    """Epoch s of an accounts.sh reset field, None if unknown. The field has no year: the year of `at` is tried and the
+    result moved by one year when it lands more than 183 days away (a Dec 31 reset read on Jan 1)."""
+    h = endgame.hours_to(r, at)
+    if h is None: return None
+    t = at.timestamp(); e = t + h * 3600
+    if abs(h) > 183 * 24:
+        for y in (at.year - 1, at.year + 1):
+            try: ay = at.replace(year=y)
+            except ValueError: continue  # Feb 29
+            hy = endgame.hours_to(r, ay)
+            if hy is not None and abs(ay.timestamp() + hy * 3600 - t) < abs(e - t): e = ay.timestamp() + hy * 3600
+    return e
+
+
+def line_state(taken, r1, r2, at=None):
+    at = at or endgame.now(); t = at.timestamp(); state = "none"
+    for r in (r1, r2):
+        e = reset_epoch(r, at)
+        if e is None or e > t: continue
+        if taken < e: return "pre"
+        state = "post"
+    return state
+
+
+def watch(r1, r2, at=None):
+    at = at or endgame.now(); t = at.timestamp(); old = []; nxt = None
+    for r in (r1, r2):
+        e = reset_epoch(r, at)
+        old.append(1 if e is not None and t - GRACE < e <= t else 0)
+        if e is not None and e > t: nxt = e - t if nxt is None else min(nxt, e - t)
+    return old[0], old[1], (-1 if nxt is None else int(nxt + 0.999))
+
+
+if __name__ == "__main__":
+    a = sys.argv[1:]
+    try:
+        if a[:1] == ["line"]: print(line_state(float(a[1]), a[2], a[3]))
+        elif a[:1] == ["watch"]: print(*watch(a[1], a[2]))
+        else: sys.exit("usage: reset_fresh.py line <taken epoch s> <5hReset> <weekReset> | watch <5hReset> <weekReset>")
+    except (IndexError, ValueError, OverflowError):
+        print("none" if a[:1] == ["line"] else "0 0 -1")
