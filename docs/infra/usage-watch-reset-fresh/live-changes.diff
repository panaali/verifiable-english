+#!/usr/bin/env python3
+"""usage-watch-reset-fresh (reviews/dri-decisions-20261113-thresholds.md; thresholds ruling 230624Z item 4 and its 23:09Z note;
+challenge NOTE 5). At 23:00:06Z 11-13 usage-watch paused main's 6 sessions on a weekly 97 read before main's weekly reset
+(accounts.sh reused a >= 88 line for 1800 s) until a forced probe at 23:09Z read 0.
+  Accounts:   a cached line taken before a reset it names that has passed is never reused: a fresh probe runs at once; a line
+              taken after that reset that still names it is not reused for the >= 88 ACCOUNTS_CAP_TTL.
+  UsageWatch: a pool whose named reset passed < 10 min ago is not acted on (no PAUSE; a paused account RESUMES); the loop wakes at
+              the next reset and that poll runs accounts.sh with ACCOUNTS_CAP_TTL=0.
+  Pace:       PICK_MAIN_PACE "weekly A S F" = min(A - S x days to the main weekly reset in accounts-cache/main.line, F).
+  Helper:     tools-local/reset_fresh.py (line / watch).
+usage: python3 -I tools-local/test_usage_reset_fresh.py      (tests the INSTALLED files: they fail before the install)
+  ACCOUNTS_SCRIPT=accounts.sh.new-usagew USAGE_WATCH_SCRIPT=usage-watch.sh.new-usagew PICK_SCRIPT=pick-claude-account.sh.new-usagew
+  RESET_FRESH_SCRIPT=tools-local/reset_fresh.py.new-usagew python3 -I tools-local/test_usage_reset_fresh.py   (the staged copies)
+Sandbox: temp HOME with code/manage-agents (copies of the scripts under test, endgame.py, reset_fresh.py), a stub claude (records
+each probe), a stub accounts.sh for usage-watch (records ACCOUNTS_CAP_TTL), a stub sleep first on PATH (records the sleep and ends
+the loop after N polls). Fake clock: ENDGAME_NOW = the test's T (read by endgame.py, reset_fresh.py and the new accounts.sh), taken
+from the wall clock at the start of each test so the installed accounts.sh (wall clock ages) sees the same ages. No live file read
+or written, no account probe, no model call."""
+import datetime, importlib.machinery, importlib.util, json, os, re, ast, shutil, stat, subprocess, sys, tempfile, time, unittest, zoneinfo
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, HERE)
+LIVE = "/home/seyran/code/manage-agents"
+ACC = os.environ.get("ACCOUNTS_SCRIPT", os.path.join(LIVE, "accounts.sh"))
+UW = os.environ.get("USAGE_WATCH_SCRIPT", os.path.join(LIVE, "usage-watch.sh"))
+RF = os.environ.get("RESET_FRESH_SCRIPT", os.path.join(HERE, "reset_fresh.py"))
+os.environ.setdefault("PICK_SCRIPT", os.path.join(LIVE, "pick-claude-account.sh"))
+import test_endgame as te  # noqa: E402
+import test_pick_main5h_unknown as pm  # noqa: E402
+
+pm.PICK = os.environ["PICK_SCRIPT"]
+TZ = zoneinfo.ZoneInfo("America/Los_Angeles")
+OTHERS = ("danielsaeedi37", "saeedi.danial")
