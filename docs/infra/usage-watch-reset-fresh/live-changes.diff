+
+class Sandbox(unittest.TestCase):
+    def setUp(self):
+        self.h = tempfile.mkdtemp(prefix="usagew-")
+        self.m = f"{self.h}/code/manage-agents"
+        os.makedirs(f"{self.m}/tools-local"); os.makedirs(f"{self.h}/bin")
