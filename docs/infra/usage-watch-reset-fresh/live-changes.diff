+class Accounts(Sandbox):
+    """accounts.sh with a stub claude; the two 5x accounts have fresh cached lines, only main is in question."""
+    def setUp(self):
+        super().setUp()
+        self.c = f"{self.m}/accounts-cache"; os.makedirs(self.c)
+        self.calls = f"{self.h}/calls"; self.reply = f"{self.h}/reply"
+        self.exe(f"{self.h}/claude", f'#!/bin/sh\necho "$CLAUDE_CONFIG_DIR" >> {self.calls}\ncat {self.reply} 2>/dev/null\nexit 0\n')
+        for a in OTHERS:
+            self.cache(a, f"{a} {self.h}/.agent-accounts/{DIRNAME[a]} 10 40 allowed {fld(self.T + 7200)} {fld(self.T + 3 * 86400)}", self.T - 10)
+        self.probe_reply(0, self.T + 7 * 86400)
+
+    def cache(self, a, line, mtime, kind="line"):
+        p = f"{self.c}/{a}.{kind}"
+        with open(p, "w") as fh: fh.write(line + "\n")
+        os.utime(p, (mtime, mtime))
+
+    def probe_reply(self, week, reset):
+        with open(self.reply, "w") as fh:
+            fh.write(json.dumps({"type": "system", "rate_limit_info": {"status": "allowed", "unifiedWindows": {
+                "seven_day": {"utilization": week / 100, "resetsAt": reset}}}}) + "\n")
+
+    def main_line(self, week, r2):
+        return f"main {self.h}/.agent-accounts/claude-panaali2 -2 {week} allowed ? {r2}"
+
+    def run_acc(self):
+        env = {k: v for k, v in os.environ.items() if not k.startswith(("ACCOUNTS_", "ENDGAME_"))}
+        env.update(HOME=self.h, ACCOUNTS_DIR=self.m, CLAUDE_BIN=f"{self.h}/claude", ENDGAME_NOW=str(self.T))
+        r = subprocess.run(["zsh", ACC], env=env, capture_output=True, text=True, timeout=300)
+        main = [x for x in r.stdout.splitlines() if x.startswith("main ")]
+        probed = open(self.calls).read().split() if os.path.exists(self.calls) else []
+        return main, [p for p in probed if p.endswith("claude-panaali2")], r
+
+    # The incident: a weekly 97 cached 5 min before main's weekly reset; the reset passed (< 1 min ago). Live: reused (1800 s).
+    def test_pre_reset_cap_line_not_reused_probe_at_once(self):
+        R = floor_min(self.T); self.cache("main", self.main_line(97, fld(R)), R - 300)
+        main, probed, r = self.run_acc()
+        self.assertEqual(len(probed), 1, f"no fresh probe of main after its reset: {main} {r.stderr[-400:]}")
+        self.assertEqual(len(main), 1); self.assertEqual(main[0].split()[3], "0", main)
+        self.assertEqual(open(f"{self.c}/main.line").read().split()[3], "0")
+
+    def test_pre_reset_line_inside_ttl_not_reused(self):  # taken 30 s before the reset, read < 1 min after: age < ACCOUNTS_TTL
+        R = floor_min(self.T); self.cache("main", self.main_line(60, fld(R)), R - 30)
+        main, probed, _ = self.run_acc()
+        self.assertEqual(len(probed), 1, main); self.assertEqual(main[0].split()[3], "0")
+
+    def test_lagging_post_reset_line_no_cap_reuse(self):  # taken after the reset but still naming it (service lag), 300 s old
+        R = floor_min(self.T - 400); self.cache("main", self.main_line(97, fld(R)), self.T - 300)
+        main, probed, _ = self.run_acc()
+        self.assertEqual(len(probed), 1, main)
