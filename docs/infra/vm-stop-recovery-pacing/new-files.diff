+train df-5 gt-df-5-081108 32G -- zsh $M/gate-train.sh df-5 $HOME/code/ve-df-5 feature/df-5 df-5-c050431 --need-merge
+train ps-e1 gt-ps-e1-081108 32G -- zsh $M/gate-train.sh ps-e1 $HOME/code/ve-ps-e1 feature/ps-e1 ps-e1
