+class RealRun(Base):
+    """Real mode (stub iso.sh, virtual clock): pause, paced launches, CURRENT-STATE lines, restore."""
+
+    def test_pause_launch_record_restore(self):
+        r = self.run_script("--date", D, jobs_text=jobs(
+            row("job", "b1"), row("train", "t1", "gt-t1", "32G", "zsh $M/gate-train.sh t1 $HOME/code/ve-t1 feature/t1 tag1"),
+            row("job", "b2", mem="8G", cmd="nice -n 10 zsh ${M}/infra-item.sh b2 'two words' x")))
+        self.assertEqual(r.returncode, 0, self.out)
+        calls = self.iso_calls(3)
+        home = self.env()["HOME"]
+        self.assertEqual(calls, [
+            f"gt-t1 32G | none | lock:no | -- zsh {self.m}/gate-train.sh t1 {home}/code/ve-t1 feature/t1 tag1",
+            f"b1 1G | none | lock:no | -- zsh {self.m}/infra-item.sh b1 feature/b1 {self.m}/prompts/task-b1.txt",
+            f"b2 8G | none | lock:no | -- nice -n 10 zsh {self.m}/infra-item.sh b2 two words x"])
+        self.flags_untouched()  # restored with their own contents, no paused copy left
+        st = self.state_tail().splitlines()
+        self.assertEqual(len(st), 5, st)
+        self.assertRegex(st[0], rf"\(vm-stop-recover {D}\): recovery start: paused CHAIN_WATCH, FEATURE_FEED, INFRA_FEED")
+        for line, s in zip(st[1:4], ["gt-t1", "b1", "b2"]):
+            self.assertRegex(line, rf"^- \d{{4}}-\d\d-\d\d \d\d:\d\dZ \(vm-stop-recover {D}\): recovery: relaunched \w+ {s} ")
+        self.assertIn("recovery end: restored CHAIN_WATCH, FEATURE_FEED, INFRA_FEED; relaunched 3, skipped 0.", st[4])
+        log = self.read(f"vm-stop-recover-{D}.log")
+        self.assertEqual(len(re.findall(r"(?m)^\S+ launch ", log)), 3)
+        t = [secs(s) for s, _ in self.launches()]
+        rs = re.findall(r"^(\S+) restore: ", self.out, re.M)
+        self.assertEqual(secs(rs[0]) - t[-1], 600)
