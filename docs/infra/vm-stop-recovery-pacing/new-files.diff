--- /dev/null
+++ tools-local/vm-stop-recover.sh
@@ -0,0 +1,242 @@
+#!/bin/zsh
+# vm-stop-recover.sh: relaunch the jobs a VM stop killed, with the feeds held and each start paced on load.
+# 2026-11-17 row vm-stop-recovery-pacing (L178, DRI improvement review 2026-11-08; decision reviews/recover-20261108.md).
+# After the Nov 5-8 billing stop, recover-20261108.sh relaunched 15 jobs 2 min apart while FEATURE_FEED and INFRA_FEED kept
+# launching (the 5-min load lags relaunches): load 214 on 32 vCPU at 06:16Z. Lesson of 2026-10-11 too: stagger, at most 6
+# at once. A dated recover-<date>.sh does its own per-incident cleanup (empty finals, interrupted merges, dated wakes) and
+# then runs this with its job list. Nothing calls it yet.
+#
+# usage: zsh tools-local/vm-stop-recover.sh [--dry-run [--dry-loads "L1 L2 ..."]] [--date YYYYMMDD] <jobs-file>
+#        zsh tools-local/vm-stop-recover.sh [--dry-run] --restore --date YYYYMMDD    (put this date's paused flags back now)
+#   Run the real one once, in its own iso scope (zsh iso.sh recover-<date>-jobs 1G -- zsh tools-local/vm-stop-recover.sh ...).
+#
+# 1. Pause: CHAIN_WATCH, FEATURE_FEED and INFRA_FEED move to <flag>.paused-recovery-<date> (mv -n), all checked before any
+#    moves. A flag that is absent stays absent (it was off: not turned on at the end). A flag already paused under this date
+#    (an interrupted earlier run) stays paused and is restored at the end. A flag present AND paused refuses the run.
+# 2. Order: the `train` rows of the jobs file first (merge trains, gate-trains), then the `job` rows, each in file order.
+# 3. Pace: a relaunch starts only when the 1-min load (/proc/loadavg) is under 48, fewer than 6 of this run's relaunches
+#    are in their first 15 min, and 60 s have passed since the previous relaunch (so the 1-min load shows it). Holds are
+#    checked every 30 s, logged when they start and change, and again every 10 min while they last.
+# 4. Skip: a job whose key already runs (a process with argv <launcher> <key>, launcher one of infra-item.sh gate-train.sh
+#    continue-item.sh dri-delegate.sh; or merge-train.sh <...>:<key>; key train:<k> means <k> there) or whose ve-<scope>-*
+#    scope is live; checked before its hold and again right before its launch. An unreadable scope list skips the job.
+# 5. Restore: once the last relaunch has run 10 min (at once if nothing was relaunched), each paused flag moves back
+#    (mv -n). A flag someone re-created meanwhile wins (its paused copy is kept, logged); a paused copy someone removed
+#    (a veto) stays removed. Interrupted (INT/TERM/HUP): the flags stay paused; restore with --restore --date <date>.
+# 6. Record: one CURRENT-STATE.md line for the pause, each relaunch, each skip and the restore; every step also goes to
+#    vm-stop-recover-<date>.log.
+# --dry-run: the same steps on a virtual clock (no waiting). It moves no flag, launches nothing and writes no file; the
+#    process and scope checks only read. Load: --dry-loads gives the 1-min loads read one per check (the last repeats),
+#    else the live load read once. A load hold on a load that no longer changes is shown, then released with a note.
+#
+# jobs file: one job per line, `#` comments:   <train|job> <key>[,<key>...] <scope> <mem> -- <command...>
+#   In the command, $M (${M}) and $HOME (${HOME}) are replaced by the manage-agents path and the home directory; the words
+#   split as the shell would (quotes keep a word together). No other $, backtick or shell operator is allowed. Any bad
+#   line refuses the whole file before step 1.
+# Test hooks (tools-local/test_vm_stop_recover.py): VMSR_M (manage-agents dir), VMSR_LOADAVG (load file),
+#   VMSR_SYSTEMCTL (systemctl command), VMSR_VIRTUAL_CLOCK=1 (no real waiting).
+zmodload zsh/datetime || exit 2
+setopt extended_glob
+M=${VMSR_M:-/home/seyran/code/manage-agents}
+LOADAVG=${VMSR_LOADAVG:-/proc/loadavg}
+SYSTEMCTL=${VMSR_SYSTEMCTL:-systemctl}
+LOAD_MAX=48 YOUNG_MAX=6 YOUNG_SEC=900 GAP_SEC=60 POLL_SEC=30 RESTORE_SEC=600 REMIND_SEC=600
+FLAGS=(CHAIN_WATCH FEATURE_FEED INFRA_FEED)
+
+die(){ print -r -- "vm-stop-recover: $*" >&2; exit 2; }
+dry=0 restore_only=0 D="" jobsf="" loads=() li=1 fixed_load=0
+while (( $# )); do
+  case $1 in
+    (--dry-run) dry=1;;
+    (--restore) restore_only=1;;
+    (--date) (( $# > 1 )) || die "--date needs YYYYMMDD"; D=$2; shift;;
+    (--dry-loads) (( $# > 1 )) || die "--dry-loads needs a list"; loads=(${=2}); shift
+      (( $#loads )) || die "--dry-loads: empty list";;
+    (-h|--help) sed -n '2,/^zmodload/p' $0 | sed '$d'; exit 0;;
+    (-*) die "unknown option $1 (see --help)";;
+    (*) [[ -z $jobsf ]] || die "one jobs file only"; jobsf=$1;;
+  esac; shift
+done
+(( $#loads && ! dry )) && die "--dry-loads needs --dry-run"
+for l in $loads; do [[ $l =~ '^[0-9]+(\.[0-9]+)?$' ]] || die "--dry-loads: '$l' is not a load"; done
+if (( restore_only )); then
+  [[ -n $D ]] || die "--restore needs --date YYYYMMDD (the date the flags were paused under)"
+  [[ -z $jobsf ]] || die "--restore takes no jobs file"
+else
+  [[ -n $jobsf ]] || die "usage: vm-stop-recover.sh [--dry-run] [--date YYYYMMDD] <jobs-file> (see --help)"
+  [[ -r $jobsf ]] || die "cannot read jobs file $jobsf"
+  [[ -n $D ]] || D=$(TZ=UTC strftime %Y%m%d $EPOCHSECONDS)
+fi
+[[ $D =~ '^[0-9]{8}$' ]] || die "--date: '$D' is not YYYYMMDD"
+[[ -d $M ]] || die "no manage-agents dir $M"
+LOG=$M/vm-stop-recover-$D.log
+
+# clock: real, or virtual (dry run and the test hook) where a wait only moves NOW
+virt=0; (( dry )) && virt=1; [[ ${VMSR_VIRTUAL_CLOCK:-} = 1 ]] && virt=1
+NOW=$EPOCHSECONDS; T0=$NOW
+pause_s(){ if (( virt )); then (( NOW += $1 )); else sleep $1; NOW=$EPOCHSECONDS; fi; }
+tick(){ (( virt )) || NOW=$EPOCHSECONDS; }
+stamp(){ if (( dry )); then printf '+%dm%02ds' $(( (NOW - T0) / 60 )) $(( (NOW - T0) % 60 )); else TZ=UTC strftime '%H:%M:%SZ' $NOW; fi; }
+say(){ local l="$(stamp) $*"; print -r -- "$l"; (( dry )) || print -r -- "$l" >> $LOG; }
+state(){ if (( dry )); then print -r -- "$(stamp)   CURRENT-STATE.md line (dry run: not written): $*"
+  else print -r -- "- $(TZ=UTC strftime '%Y-%m-%d %H:%MZ' $NOW) (vm-stop-recover $D): $*" >> $M/CURRENT-STATE.md; fi; }
+
+# ---- jobs file ----
+CLS=() KEYS=() SCOPE=() MEM=() CMD=()
+parse(){
+  local n=0 line raw w t k1
+  local -a tok bad mains
+  while IFS= read -r raw || [[ -n $raw ]]; do
+    (( n++ ))
+    [[ $raw =~ '^[[:space:]]*(#|$)' ]] && continue
+    line=${raw//'${HOME}'/$HOME}; line=${line//'$HOME'/$HOME}; line=${line//'${M}'/$M}
+    line=${line//(#b)'$M'([^A-Za-z0-9_]|(#e))/$M${match[1]}}
+    if [[ $line == *'$'* || $line == *'`'* ]]; then bad+="line $n: only \$M and \$HOME are expanded"; continue; fi
+    tok=(${(z)line})
+    for t in $tok; do case $t in (';'|'&'|'|'|'&&'|'||'|'<'|'>'|'>>'|'<<'|'('|')'|'&!'|'&|'|'|&'|'>&'|'<&')
+      bad+="line $n: shell operator '$t'"; continue 2;; esac; done
+    w=(${(Q)tok})
+    if (( $#w < 6 )) || [[ $w[5] != -- ]]; then bad+="line $n: want <train|job> <key>[,<key>...] <scope> <mem> -- <command...>"; continue; fi
+    [[ $w[1] = (train|job) ]] || { bad+="line $n: class '$w[1]' is not train or job"; continue; }
+    [[ $w[2] =~ '^[A-Za-z0-9._:-]+(,[A-Za-z0-9._:-]+)*$' ]] || { bad+="line $n: bad key list '$w[2]'"; continue; }
+    [[ $w[3] =~ '^[A-Za-z0-9][A-Za-z0-9._-]*$' ]] || { bad+="line $n: bad scope '$w[3]'"; continue; }
+    [[ $w[4] =~ '^[0-9]+[KMG]$' ]] || { bad+="line $n: bad memory cap '$w[4]'"; continue; }
+    (( ${SCOPE[(Ie)$w[3]]} )) && { bad+="line $n: scope $w[3] twice"; continue; }
+    k1=${w[2]%%,*}; mains=(${KEYS%%,*})
+    (( ${mains[(Ie)$k1]} )) && { bad+="line $n: key $k1 twice"; continue; }
+    CLS+=$w[1] KEYS+=$w[2] SCOPE+=$w[3] MEM+=$w[4] CMD+="${(j: :)${(qq)w[6,-1]}}"
+  done < $jobsf
+  (( $#bad )) && { print -rl -- "vm-stop-recover: refused $jobsf (nothing paused, nothing launched):" $bad >&2; return 1; }
+  (( $#SCOPE )) || { print -r -- "vm-stop-recover: refused $jobsf: no jobs" >&2; return 1; }
+}
+
+# ---- checks ----
+busy(){ python3 -I - "$1" <<'EOF'
+import os, sys
+keys = sys.argv[1].split(",")
+launchers = ("infra-item.sh", "gate-train.sh", "continue-item.sh", "dri-delegate.sh")
+for p in os.listdir("/proc"):
+    if not p.isdigit() or int(p) == os.getpid():
+        continue
+    try:
+        a = [x.decode(errors="ignore") for x in open(f"/proc/{p}/cmdline", "rb").read().split(b"\0")]
+    except OSError:
+        continue
+    for i, x in enumerate(a[:-1]):
+        for k in keys:
+            if x.endswith(launchers) and a[i + 1] == k:
+                print(f"{k} runs (pid {p})"); sys.exit(0)
+            if x.endswith("merge-train.sh") and a[i + 1].endswith(":" + k.removeprefix("train:")):
+                print(f"{k}: its merge train runs (pid {p})"); sys.exit(0)
+sys.exit(1)
+EOF
+}
+# why_skip <i>: prints the reason and returns 0 when job i must not start
+why_skip(){ local out r
+  if out=$(busy $KEYS[$1]); then print -r -- "$out"; return 0; fi
+  out=$($=SYSTEMCTL --user list-units --type=scope --no-legend "ve-$SCOPE[$1]-*" 2>&1); r=$?
+  (( r )) && { print -r -- "scope list unreadable (systemctl rc $r): skipped, not guessed"; return 0; }
+  [[ -n ${out//[[:space:]]/} ]] && { print -r -- "a ve-$SCOPE[$1]-* scope is live"; return 0; }
+  return 1; }
+L1=""
+load1(){
+  if (( $#loads )); then L1=$loads[li]; (( li < $#loads )) && (( li++ )) || fixed_load=1
+  elif (( dry )) && [[ -n $L1 ]]; then fixed_load=1
+  else L1=""; read -r L1 _ < $LOADAVG 2>/dev/null; (( dry )) && fixed_load=1; fi
+  [[ $L1 =~ '^[0-9]+(\.[0-9]+)?$' ]]; }
+
+# ---- flags ----
+PAUSED=()
+pause_flags(){ local f p moved=()
+  for f in $FLAGS; do p=$M/$f.paused-recovery-$D
+    [[ -e $M/$f && -e $p ]] && die "$f and ${p:t} both exist (a run of this date was interrupted and $f was turned on since): refused, nothing paused, nothing launched"
+  done
+  for f in $FLAGS; do p=$M/$f.paused-recovery-$D
+    if [[ -e $M/$f ]]; then
+      if (( dry )); then say "pause: would move $f -> ${p:t}"
+      else mv -n -- $M/$f $p && [[ -e $p && ! -e $M/$f ]] || { say "pause FAILED on $f; already paused: ${moved:-none} (restore with --restore --date $D); nothing launched"; exit 1; }
+        say "pause: $f -> ${p:t}"; moved+=$f; fi
+      PAUSED+=$f
+    elif [[ -e $p ]]; then say "pause: $f already paused as ${p:t} (an earlier run of this date): kept, restored at the end"; PAUSED+=$f
+    else say "pause: $f is off (absent): stays off, not restored"; fi
+  done
+  state "recovery start: paused ${${(j:, :)PAUSED}:-nothing} (as <flag>.paused-recovery-$D); $#ORDER jobs, trains first; a relaunch waits for 1-min load < $LOAD_MAX, < $YOUNG_MAX relaunches in their first $(( YOUNG_SEC / 60 )) min and $GAP_SEC s since the last."
+}
+restore_flags(){ local f p done_=() kept=()
+  for f in $PAUSED; do p=$M/$f.paused-recovery-$D
+    if (( dry )); then say "restore: would move ${p:t} -> $f (only if $f is still absent and ${p:t} still there)"; done_+=$f
+    elif [[ -e $M/$f ]]; then say "restore: $f exists again (re-created during the recovery): it wins; ${p:t} kept for a human"; kept+="$f (re-created)"
+    elif [[ ! -e $p ]]; then say "restore: ${p:t} is gone (removed during the recovery: a veto): $f stays off"; kept+="$f (vetoed)"
+    elif mv -n -- $p $M/$f && [[ -e $M/$f ]]; then say "restore: ${p:t} -> $f"; done_+=$f
+    else say "restore FAILED on $f: ${p:t} left in place"; kept+="$f (mv failed)"; fi
+  done
+  state "recovery end: restored ${${(j:, :)done_}:-nothing}${kept:+; not restored: ${(j:, :)kept}}${1:+; $1}."
+}
+
+# ---- run ----
+if (( ! dry )); then
+  exec {lockfd}>>$M/vm-stop-recover.lock || die "cannot open $M/vm-stop-recover.lock"
+  flock -n $lockfd || die "another vm-stop-recover.sh runs (lock $M/vm-stop-recover.lock)"
+fi
+if (( restore_only )); then
+  for f in $FLAGS; do [[ -e $M/$f.paused-recovery-$D ]] && PAUSED+=$f; done
+  say "restore only (--restore --date $D): paused flags ${${(j:, :)PAUSED}:-none}"
+  restore_flags "--restore by hand"; exit 0
+fi
+parse || exit 2
+ORDER=(); for i in {1..$#CLS}; do [[ $CLS[i] = train ]] && ORDER+=$i; done; for i in {1..$#CLS}; do [[ $CLS[i] = job ]] && ORDER+=$i; done
+(( dry )) && say "DRY RUN ($jobsf, date $D): virtual clock, no flag moved, nothing launched, no file written"
+say "order (trains first): $#ORDER jobs"
+n=0; for i in $ORDER; do (( n++ )); say "  $n. $CLS[i] ${KEYS[i]%%,*} -> scope $SCOPE[i] ($MEM[i]): ${(Q)${(z)CMD[i]}}"; done
+pause_flags
+# a signal only sets stop (a long trap body crashed zsh 5.9 mid-loop); it is acted on at the next check, within POLL_SEC
+stop=0; trap 'stop=1' INT TERM HUP
+stopped(){ (( stop )) || return 0; trap - INT TERM HUP; tick
+  say "INTERRUPTED: flags stay paused (${(j:, :)PAUSED}); restore: zsh $M/tools-local/vm-stop-recover.sh --restore --date $D"
+  state "recovery INTERRUPTED after $nl relaunches; flags stay paused (${(j:, :)PAUSED}): restore with tools-local/vm-stop-recover.sh --restore --date $D."
+  exit 130; }
+LT=() nl=0 ns=0 last=0 lastscope=""
+for i in $ORDER; do
+  stopped; k=${KEYS[i]%%,*}; s=$SCOPE[i]
+  if why=$(why_skip $i); then tick; say "SKIP $s ($k): $why"; state "recovery: skipped $s ($k): $why."; (( ns++ )); continue; fi
+  tick; held=0 hs=$NOW prev="" lastsaid=0
+  while true; do
+    stopped; young=0; for t in $LT; do (( NOW - t < YOUNG_SEC )) && (( young++ )); done
+    why=()
+    load1 || why+="1-min load unreadable ($LOADAVG)"
+    [[ -n $L1 ]] && (( L1 >= LOAD_MAX )) && why+="1-min load $L1 >= $LOAD_MAX"
+    (( young >= YOUNG_MAX )) && why+="$young relaunches in their first $(( YOUNG_SEC / 60 )) min (max $YOUNG_MAX)"
+    (( nl && NOW - last < GAP_SEC )) && why+="$(( NOW - last )) s since the last relaunch (min $GAP_SEC)"
+    (( $#why )) || break
+    cur=${(j:; :)why}
+    if [[ $cur != $prev ]] || (( NOW - lastsaid >= REMIND_SEC )); then
+      [[ $cur == *(in their first|1-min load)* ]] && say "HOLD $s: $cur"; prev=$cur lastsaid=$NOW; fi
+    [[ $cur == *(in their first|1-min load)* ]] && held=1
+    if (( dry && fixed_load )) && [[ $cur == *'1-min load'* ]]; then
+      say "  dry run: the load no longer changes here; a real run waits until it is under $LOAD_MAX; continuing"; break; fi
+    if (( virt )) && [[ $cur != *load* ]]; then   # only time-based holds: jump to the earliest release
+      nxt=$(( nl ? last + GAP_SEC : NOW ))
+      (( young >= YOUNG_MAX )) && for t in $LT; do (( NOW - t < YOUNG_SEC )) || continue
+        (( t + YOUNG_SEC > nxt )) && nxt=$(( t + YOUNG_SEC )); break; done
+      (( nxt > NOW )) && { pause_s $(( nxt - NOW )); continue; }
+    fi
+    pause_s $POLL_SEC
+  done
+  if why=$(why_skip $i); then say "SKIP $s ($k) after its hold: $why"; state "recovery: skipped $s ($k): $why."; (( ns++ )); continue; fi
+  stopped; young=0; for t in $LT; do (( NOW - t < YOUNG_SEC )) && (( young++ )); done
+  if (( dry )); then say "launch (dry run: not started) $CLS[i] $s ($k): 1-min load ${L1:-?}, $(( young + 1 ))/$YOUNG_MAX in their first $(( YOUNG_SEC / 60 )) min$( (( held )) && print -n ", held $(( (NOW - hs) / 60 ))m$(( (NOW - hs) % 60 ))s")"
+  else
+    cmd=(${(Q)${(z)CMD[i]}})
+    setsid nohup zsh $M/iso.sh $s $MEM[i] -- $cmd >> $M/$s.recover.log 2>&1 < /dev/null {lockfd}>&- &!   # the job must not hold the lock
+    say "launch $CLS[i] $s ($k): 1-min load $L1, $(( young + 1 ))/$YOUNG_MAX in their first $(( YOUNG_SEC / 60 )) min, held $(( NOW - hs )) s (log $s.recover.log)"
+  fi
+  state "recovery: relaunched $CLS[i] $s ($k; 1-min load ${L1:-?}, $(( young + 1 ))/$YOUNG_MAX in their first $(( YOUNG_SEC / 60 )) min, held $(( NOW - hs )) s)."
+  LT+=$NOW last=$NOW lastscope=$s; (( nl++ ))
+done
+if (( nl )); then
+  tick; (( NOW < last + RESTORE_SEC )) && say "restore waits until the last relaunch ($lastscope) has run $(( RESTORE_SEC / 60 )) min"
+  while stopped; (( NOW < last + RESTORE_SEC )); do pause_s $(( last + RESTORE_SEC - NOW < POLL_SEC ? last + RESTORE_SEC - NOW : POLL_SEC )); done
+else say "nothing relaunched: restore now"; fi
+stopped; trap - INT TERM HUP
+restore_flags "relaunched $nl, skipped $ns"
+say "done: relaunched $nl, skipped $ns"
--- /dev/null
