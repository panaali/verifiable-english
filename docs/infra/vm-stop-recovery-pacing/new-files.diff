+job jt-3b jt-3b 32G -- zsh $M/infra-item.sh jt-3b feature/jt-3b $M/prompts/task-jt-3b.txt
+job ap-3dc ap-3dc 32G -- zsh $M/infra-item.sh ap-3dc feature/ap-3dc $M/prompts/task-ap-3dc.txt
+job ci-5 ci-5 32G -- zsh $M/infra-item.sh ci-5 feature/ci-5 $M/prompts/task-ci-5.txt
+job eff-20261104-1 cont-eff-20261104-1-081108 32G -- zsh $M/continue-item.sh eff-20261104-1 $HOME/code/ve-eff-20261104-1 infra/eff-20261104-1 $M/eff-20261104-1-looprecheck1.final.md $M/reviews/eff-20261104-1-dri-note-20261105.md
+job arch-20261105-1 arch-20261105-1 32G -- nice -n 10 zsh $M/infra-item.sh arch-20261105-1 infra/arch-20261105-1 $M/prompts/arch-20261105-1-task.txt
+job arch-20261105-2 arch-20261105-2 32G -- nice -n 10 zsh $M/infra-item.sh arch-20261105-2 infra/arch-20261105-2 $M/prompts/arch-20261105-2-task.txt
+job dri-cm-pilot3-fix dri-cm-pilot3-fix 8G -- zsh $M/dri-delegate.sh dri-cm-pilot3-fix $M/prompts/dri-task-cm-pilot3-fix.txt
