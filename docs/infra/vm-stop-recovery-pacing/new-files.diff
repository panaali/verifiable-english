+"""Tests for tools-local/vm-stop-recover.sh (2026-11-17 row vm-stop-recovery-pacing, L178; reviews/recover-20261108.md).
+usage: python3 -I tools-local/test_vm_stop_recover.py   (VMSR_SCRIPT = another copy of the script)
+Every run uses a temporary manage-agents dir (VMSR_M) with a stub iso.sh that records its argv and the flag files it sees,
+a stub systemctl (VMSR_SYSTEMCTL) and a load file (VMSR_LOADAVG); real-mode runs use the virtual clock (VMSR_VIRTUAL_CLOCK=1),
+so nothing waits for real time."""
+import fcntl, os, re, shutil, signal, subprocess, sys, tempfile, time, unittest
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+SCRIPT = os.environ.get("VMSR_SCRIPT", os.path.join(HERE, "vm-stop-recover.sh"))
+JOBS_1108 = os.path.join(HERE, "vm-stop-recover-jobs-20261108.txt")
+D = "20261108"
+FLAGS = ("CHAIN_WATCH", "FEATURE_FEED", "INFRA_FEED")
+TRAINS_1108 = ["gt-pc-1g-081108", "ps-1c-train", "gt-et-4b-081108", "gt-df-5-081108", "gt-ps-e1-081108"]
+JOBS_1108_SCOPES = ["at-1b", "cmp-s4a-nested", "qt-a4b", "jt-3b", "ap-3dc", "ci-5", "cont-eff-20261104-1-081108",
+                    "arch-20261105-1", "arch-20261105-2", "dri-cm-pilot3-fix"]
+WAIT = 120  # seconds: upper bound for a run or a stub to finish (never reached when the script works)
+
+ISO_STUB = """#!/bin/zsh
+# stub iso.sh: one line per call: <scope> <mem> | flags seen | lock fd held? | argv
+M=${0:h}; s=$1
+seen=(); for f in CHAIN_WATCH FEATURE_FEED INFRA_FEED; do [ -e $M/$f ] && seen+=$f; done
+lk=no; ls -l /proc/$$/fd 2>/dev/null | grep -q vm-stop-recover.lock && lk=yes
+print -r -- "$1 $2 | ${seen:-none} | lock:$lk | ${(j: :)@[3,-1]}" >> $M/iso-calls
+[ -f $M/hook-$s ] && zsh $M/hook-$s
+exit 0
+"""
+SYSTEMCTL_STUB = """#!/bin/sh
+# stub systemctl: rc from $M/systemctl-rc; prints a unit when the pattern names a scope listed in $M/live-scopes
+M=$(dirname "$0"); [ -f "$M/systemctl-rc" ] && exit "$(cat "$M/systemctl-rc")"
+for a in "$@"; do case $a in ve-*-\\*) s=${a#ve-}; s=${s%-\\*}
+  grep -qxF -- "$s" "$M/live-scopes" 2>/dev/null && echo "ve-$s-123.scope loaded active running $s"; esac; done
+exit 0
+"""
+
+
+def jobs(*rows):
+    return "".join(r + "\n" for r in rows)
+
+
+def row(cls, key, scope=None, mem="1G", cmd=None):
+    return f"{cls} {key} {scope or key} {mem} -- {cmd or f'zsh $M/infra-item.sh {key} feature/{key} $M/prompts/task-{key}.txt'}"
+
+
+class Base(unittest.TestCase):
+    def setUp(self):
+        self.h = tempfile.mkdtemp(prefix="vmsr-")
+        self.m = os.path.join(self.h, "manage-agents")
+        os.makedirs(self.m)
+        for f in FLAGS:
+            self.write(f, f"{f} on (test original)\nmax: 7\n")
+        self.write("CURRENT-STATE.md", "# state\n- old line\n")
+        self.write("iso.sh", ISO_STUB)
+        self.write("systemctl", SYSTEMCTL_STUB)
+        os.chmod(self.p("systemctl"), 0o755)
+        self.write("loadavg", "12.50 10.00 9.00 3/900 12345\n")
+        self.procs = []
+
+    def tearDown(self):
+        for pr in self.procs:
+            pr.kill(); pr.wait()
+        shutil.rmtree(self.h, ignore_errors=True)
+
+    def p(self, name):
+        return os.path.join(self.m, name)
+
+    def write(self, name, text):
+        with open(self.p(name), "w") as f:
+            f.write(text)
+
+    def read(self, name):
+        with open(self.p(name)) as f:
+            return f.read()
+
+    def env(self, virtual=True):
+        e = {"PATH": os.environ.get("PATH", "/usr/bin:/bin"), "HOME": os.environ.get("HOME", self.h),
+             "VMSR_M": self.m, "VMSR_LOADAVG": self.p("loadavg"), "VMSR_SYSTEMCTL": self.p("systemctl")}
+        if virtual:
+            e["VMSR_VIRTUAL_CLOCK"] = "1"
+        return e
+
+    def run_script(self, *args, jobs_text=None, virtual=True):
+        argv = ["zsh", SCRIPT, *args]
+        if jobs_text is not None:
+            self.write("jobs.txt", jobs_text)
+            argv.append(self.p("jobs.txt"))
+        r = subprocess.run(argv, env=self.env(virtual), capture_output=True, text=True, timeout=WAIT)
+        self.out = r.stdout + r.stderr
+        return r
+
+    def iso_calls(self, n=None):
+        """Lines of the stub iso.sh; waits (bounded) until n lines exist (the launches are detached)."""
+        deadline = time.monotonic() + WAIT
+        while True:
+            lines = self.read("iso-calls").splitlines() if os.path.exists(self.p("iso-calls")) else []
+            if n is None or len(lines) >= n or time.monotonic() > deadline:
+                return lines
+            time.sleep(0.05)
+
+    def launches(self):
+        """(stamp, scope) of the launch lines of a run's output."""
+        return re.findall(r"^(\S+) launch (?:\(dry run: not started\) )?\w+ (\S+) \(", self.out, re.M)
+
+    def state_tail(self):
+        return self.read("CURRENT-STATE.md").split("- old line\n", 1)[1]
+
+    def flags_untouched(self):
+        for f in FLAGS:
+            self.assertEqual(self.read(f), f"{f} on (test original)\nmax: 7\n", f)
+            self.assertFalse(os.path.exists(self.p(f"{f}.paused-recovery-{D}")), f)
+
+
+def secs(stamp):
+    """+12m05s (dry run) or HH:MM:SSZ (real run) -> seconds."""
+    m = re.fullmatch(r"\+(\d+)m(\d\d)s", stamp)
+    if m:
+        return int(m[1]) * 60 + int(m[2])
+    h, mi, s = stamp.rstrip("Z").split(":")
+    return int(h) * 3600 + int(mi) * 60 + int(s)
+
+
+class DryRun(Base):
+    """The task's test: a dry run on the recover-20261108 job list prints the order (trains first), the holds and the
+    feed pause/restore steps, and launches nothing."""
+
+    def dry_1108(self, *extra):
+        r = subprocess.run(["zsh", SCRIPT, "--dry-run", "--date", D, *extra, JOBS_1108], env=self.env(virtual=False),
+                           capture_output=True, text=True, timeout=WAIT)
+        self.out = r.stdout + r.stderr
+        self.assertEqual(r.returncode, 0, self.out)
+        return r
+
+    def test_1108_order_trains_first(self):
+        self.dry_1108()
+        order = re.findall(r"^\+0m00s +\d+\. (train|job) \S+ -> scope (\S+)", self.out, re.M)
+        self.assertEqual([s for _, s in order], TRAINS_1108 + JOBS_1108_SCOPES)
+        self.assertEqual([c for c, _ in order], ["train"] * 5 + ["job"] * 10)
+        self.assertEqual([s for _, s in self.launches()], TRAINS_1108 + JOBS_1108_SCOPES)
+
+    def test_trains_first_whatever_the_file_order(self):
+        r = self.run_script("--dry-run", "--date", D, jobs_text=jobs(
+            row("job", "b1"), row("train", "t1", cmd="zsh $M/gate-train.sh t1 x y z"), row("job", "b2"),
+            row("train", "train:t2", "t2-train", cmd="zsh $M/merge-train.sh feature/t2:x:t2")))
+        self.assertEqual(r.returncode, 0, self.out)
+        self.assertEqual([s for _, s in self.launches()], ["t1", "t2-train", "b1", "b2"])
+
+    def test_1108_moves_no_flag_launches_nothing_writes_nothing(self):
+        before = sorted(os.listdir(self.m))
+        self.dry_1108()
+        self.flags_untouched()
+        self.assertEqual(sorted(os.listdir(self.m)), before)  # no iso-calls, log, lock or paused file
+        self.assertEqual(self.read("CURRENT-STATE.md"), "# state\n- old line\n")
+        for f in FLAGS:
+            self.assertIn(f"pause: would move {f} -> {f}.paused-recovery-{D}", self.out)
+            self.assertIn(f"restore: would move {f}.paused-recovery-{D} -> {f}", self.out)
+        self.assertEqual(len(self.launches()), 15)
+
+    def test_1108_six_in_fifteen_minutes_and_restore_ten_minutes_after_the_last(self):
+        self.dry_1108()
+        t = [secs(s) for s, _ in self.launches()]
+        self.assertEqual(len(t), 15)
+        for i, ti in enumerate(t):  # never a 7th relaunch while 6 are in their first 15 min
+            self.assertLessEqual(sum(1 for tj in t[:i + 1] if ti - tj < 900), 6, (i, t))
+        self.assertEqual(t[6] - t[0], 900, t)  # the 7th waits exactly until the 1st has run 15 min
+        self.assertTrue(all(b - a >= 60 for a, b in zip(t, t[1:])), t)
+        self.assertRegex(self.out, r"(?m)^\+5m00s HOLD cmp-s4a-nested: 6 relaunches in their first 15 min \(max 6\)")
+        rs = re.findall(r"^(\S+) restore: would move", self.out, re.M)
+        self.assertEqual(len(rs), 3)
+        self.assertEqual(secs(rs[0]) - t[-1], 600)
+        # the restore comes after every launch, the pause before the first
+        self.assertLess(self.out.index("pause: would move"), self.out.index("launch (dry run"))
+
+    def test_load_hold_at_48_and_release_under_it(self):
+        # one load per check (every 30 s): 48 holds (>=), 47.99 releases; the load hold outlasts the 60 s gap
+        self.dry_1108("--dry-loads", "10 48 60.5 60.5 50 47.99 10")
+        self.assertRegex(self.out, r"(?m)^\+0m00s HOLD ps-1c-train: 1-min load 48 >= 48; 0 s since the last relaunch")
+        self.assertRegex(self.out, r"(?m)^\+0m30s HOLD ps-1c-train: 1-min load 60.5 >= 48; 30 s since the last relaunch")
+        self.assertRegex(self.out, r"(?m)^\+1m00s HOLD ps-1c-train: 1-min load 60.5 >= 48$")
+        self.assertRegex(self.out, r"(?m)^\+1m30s HOLD ps-1c-train: 1-min load 50 >= 48$")
+        self.assertRegex(self.out, r"(?m)^\+2m00s launch \(dry run: not started\) train ps-1c-train \(train:ps-1c\): "
+                                   r"1-min load 47.99, 2/6 in their first 15 min, held 2m0s$")
+        self.assertRegex(self.out, r"(?m)^\+3m00s launch \(dry run: not started\) train gt-et-4b-081108 ")
