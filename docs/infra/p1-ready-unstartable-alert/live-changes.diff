+#!/usr/bin/env python3
+"""Tests for the p1 not-startable alert (tools-local/decider-ready-alert.py) and the p1 filing warning (backlog.py `add` /
+`update`); item p1-ready-unstartable-alert, reviews/dri-decisions-20261116-adv0244.md item 2.
+Run: python3 -I tools-local/test_p1_ready_alert.py
+Code under test: P1RUA_ALERT / P1RUA_BACKLOG name the files; default the staged .new-p1rua copy when present, else the live file
+(the live files before the install fail these tests)."""
+import json, os, subprocess, sys, tempfile, unittest
+from datetime import datetime, timezone
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+M = os.path.dirname(HERE)
+
+
+def pick(env, live):
+    staged = live + ".new-p1rua"
+    return os.environ.get(env) or (staged if os.path.exists(staged) else live)
+
+
+ALERT = pick("P1RUA_ALERT", os.path.join(HERE, "decider-ready-alert.py"))
+BACKLOG = pick("P1RUA_BACKLOG", os.path.join(M, "backlog.py"))
+READY = "2026-11-16T02:00Z"
+T0 = datetime(2026, 11, 16, 2, 0, tzinfo=timezone.utc).timestamp()
+MIN, HOUR = 60, 3600
+
+
+def row(i, **kw):
+    r = {"id": i, "kind": "infra", "title": f"title {i}", "owner": "infra feed", "priority": 1, "status": "ready",
+         "ready_t": READY, "links": {}}
+    r.update(kw)
+    return r
+
+
+class Alert(unittest.TestCase):
+    def setUp(self):
+        self.d = tempfile.mkdtemp()
+        os.makedirs(os.path.join(self.d, "prompts"))
+        self.log = os.path.join(self.d, "msgs.log")
+        fake = os.path.join(self.d, "fake-msg.sh")
+        with open(fake, "w") as f:
+            f.write('#!/bin/sh\nprintf "%s|%s|%s\\n" "$1" "$2" "$3" >> ' + self.log + "\nexit ${FAKE_RC:-0}\n")
+        self.env = dict(os.environ, DRA_M=self.d, DRA_MSG=f"sh {fake}")
+
+    def write(self, rows):
+        with open(os.path.join(self.d, "BACKLOG.jsonl"), "w") as f:
+            for r in rows:
+                f.write(json.dumps(r) + "\n")
+
+    def touch(self, rel):
+        open(os.path.join(self.d, rel), "w").close()
+
+    def run_at(self, after, **env):
