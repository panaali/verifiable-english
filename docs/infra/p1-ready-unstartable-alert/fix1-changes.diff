+class LaunchSpecAgreement(Base):
+    """The class behind F1: for every launch link, the alert's verdict equals backlog.py launch_spec's (the infra feed's).
+    The launchers are enumerated from backlog.LAUNCH_HOW, so a launcher added there is covered without editing this test."""
+
+    def test_alert_agrees_with_launch_spec(self):
+        bl = load_backlog(self.d)
+        self.touch("prompts/t-ok.txt")
+        words = sorted(bl.LAUNCH_HOW) + ["iso", "continue-item", "Delegate"]
+        tails = ["", " a", " a b c"]
+        tasks = [None, "prompts/t-ok.txt", "prompts/t-gone.txt"]
+        rows, want = [], {}
+        for w in words:
+            for t in tails:
+                for k in tasks:
+                    i = f"r{len(rows)}"
+                    links = {"launch": w + t}
+                    if k:
+                        links["task"] = k
+                    r = row(i, links=links)
+                    rows.append(r)
+                    want[i] = bl.launch_spec(r)[0] is None
+        self.assertTrue(any(want.values()) and not all(want.values()))
+        self.write(rows)
+        self.run_at(31 * MIN)
+        m = self.msgs()
+        named = set()
+        if m:
+            part = m[0].split("p1 ready but not startable: ", 1)[1].split(". Not startable", 1)[0]
+            named = {x.split(",")[0] for x in part.split("; ")}
+        self.assertEqual(named, {i for i, nope in want.items() if nope})
