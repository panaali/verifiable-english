+# (vi) released rows take main one at a time, in rank order (2026-11-17 released-main-1117; reviews/dri-decisions-20261117-
+#     released-main.md item 2): pick-claude-account.sh admits main for a released row with links.avoid main only under its
+#     released-row main rule (pace line - 4, 5-h rise < 5, one holder marker pick-main-released). A released row whose pick is
+#     refused and that main refused by a gate every released row shares (the rule's own pace and rise gates, the stand-in guard,
+#     that marker, a better-ranked waiter, the caps, a rank hold, the Nov 23 path yield; review F1: not only when main is
+#     "taken") touches pick-waiting-relmain/<row> (mtime = last refusal, dead after PCF_TTL_S) and removes it on any pick; only
+#     the caller's own refusals (its own PICK_AVOID names main, an unreadable marker) write none; a free marker goes to
+#     the best live waiter first: relmain_key (rank() above, then the FEATURE-QUEUE.tsv rank column, unqueued last, then the id).
+def queue_rank(item):
+    """the FEATURE-QUEUE.tsv rank (column 1) of item's base row; 1e9 when not queued or unreadable."""
+    item, best = base(item), 1e9
+    try:
+        for ln in open(os.path.join(M, "FEATURE-QUEUE.tsv"), errors="replace"):
+            x = ln.split("\t")
+            if not ln.startswith("#") and len(x) >= 2 and x[1] == item:
+                try:
+                    best = min(best, float(x[0]))
+                except ValueError:
+                    pass
+    except OSError:
+        pass
+    return best
+
+
+def relmain_key(item):
+    return (rank(item), queue_rank(item), base(item))
+
+
+def rmwdir():
+    return os.path.join(M, "pick-waiting-relmain")
+
+
+def relmain_mark(item):
+    if not released(item):
+        return False
+    os.makedirs(rmwdir(), exist_ok=True)
+    with open(os.path.join(rmwdir(), base(item)), "w") as f:
+        f.write(f"{now().strftime('%Y-%m-%dT%H:%MZ')} {item}\n")
+    return True
+
+
+def relmain_unmark(item):
+    try:
+        os.remove(os.path.join(rmwdir(), base(item)))
+        return True
+    except OSError:
+        return False
+
+
+def relmain_ahead(item):
+    """the live released-row main waiter that ranks before item (another row), or None."""
+    me, t, best = base(item), now().timestamp(), None
+    try:
+        names = sorted(os.listdir(rmwdir()))
+    except OSError:
+        return None
+    mk = relmain_key(item)
+    for n in names:
+        try:
+            if n == me or t - os.path.getmtime(os.path.join(rmwdir(), n)) > TTL or not released(n):
+                continue
+        except OSError:
+            continue
+        k = relmain_key(n)
+        if k < mk and (best is None or k < best):
+            best = k
+    return best[2] if best else None
+
