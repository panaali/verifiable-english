+def pytest_verdict(control: tuple[str, list[str], str], mutant: tuple[str, list[str], str]
+                   ) -> tuple[str, str]:
+    """The second kill rule. Neither an invalid control nor an abnormal mutant run is a kill."""
+    if control[0] != "PASS":
+        return "UNKNOWN", f"pytest control: {control[2] or ', '.join(control[1]) or control[0]}"
