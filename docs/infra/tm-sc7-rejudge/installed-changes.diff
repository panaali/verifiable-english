+def is_ancestor(w, a, b):
+    return subprocess.run(["git", "-C", w, "merge-base", "--is-ancestor", a, b], capture_output=True).returncode == 0
+
+
+def forward_kills(w, head):
+    """tm-sc7-rejudge: {text key: {"record", "head", "sha256"}} of the texts a ledgered later record holds as KILLED only
+    (header). A ledger row that fails any condition resolves nothing: never a guess, never an id match."""
+    out = {}
+    for r in jl(f"{D}/forward-kills.jsonl"):
+        p, h2, sha = (r.get(k) if isinstance(r, dict) else None for k in ("record", "head", "sha256"))
+        if not (isinstance(p, str) and isinstance(h2, str) and re.fullmatch(r"[0-9a-f]{40}", h2) and isinstance(sha, str)):
+            continue
+        p = os.path.join(D, p)  # a relative path is under test-skip/
+        try:
+            raw = open(p, "rb").read()
+            d = json.loads(raw)
+        except (OSError, ValueError):
+            continue
+        if (hashlib.sha256(raw).hexdigest() != sha or not isinstance(d, dict) or d.get("head") != h2 or h2 == head
+                or not is_ancestor(w, head, h2) or not is_ancestor(w, h2, "main")):
+            continue
+        st, ms = {}, d.get("mutants")
+        for m in ms if isinstance(ms, list) else []:
+            st.setdefault(text_key(m) if isinstance(m, dict) else None, set()).add(m.get("status") if isinstance(m, dict) else None)
+        st.pop(None, None)
+        for k, s in st.items():
+            if s == {"KILLED"}:
+                out.setdefault(k, {"record": p, "head": h2, "sha256": sha})
+    return out
+
