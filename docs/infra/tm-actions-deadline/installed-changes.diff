-  if [ "$1" = --budget ] && [ $# -ge 2 ] && [[ $2 =~ ^[0-9]+$ ]]; then targs+=(--deadline $(( T0 + $2 ))); shift 2
-  else targs+=("$1"); shift; fi; done
 step trust_mutants uv run --frozen python tools/trust_mutants.py --base "$BASE" ${targs[@]+"${targs[@]}"} --json "$O/trust-mutants.json"
 echo $? > "$O/tm.rc"
 finish 0
