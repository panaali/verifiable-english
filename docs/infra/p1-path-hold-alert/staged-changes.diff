+# a feed path hold as feed-features.sh / queue-runner.sh / infra_feed.py write it: "path <p> in flight on <branch>". The
+# capacity hold "queue items in flight on <host>" has no "path <p>" and is not a path hold (item 3: other holds unchanged).
+PATH_HOLD = re.compile(r"\bpath (\S+) in flight on ([^\s;()]+)")
+
+
+def path_held(r):
+    """True when the row's backlog state is a feed path/serial hold: it starts "feed: path" or names "path <p> in flight on"."""
+    s = str(r.get("state") or "")
+    return s.startswith("feed: path") or PATH_HOLD.search(s) is not None
+
+
+def holder_stage(rows, branch, held_id):
+    """The holding branch's backlog row state ("chain stage ...", "merge train since ..."), else "stage unknown". The holder
+    is the row whose links.branch is the branch, else the row whose id is the branch without its "<kind>/" prefix."""
+    tail = branch.split("/", 1)[1] if "/" in branch else branch
+    cands = [x for x in rows if x.get("id") != held_id and isinstance(x.get("links"), dict) and x["links"].get("branch") == branch]
+    cands += [x for x in rows if x.get("id") == tail and x.get("id") != held_id and x not in cands]
+    states = [str(x.get("state") or "").strip() for x in cands]
+    best = [s for s in states if re.match(r"chain stage |merge train", s)] or [s for s in states if s]
+    return best[0][:100] if best else "stage unknown"
+
+
+def hold_text(rows, r):
+    """"path <p> in flight on <branch> (<stage>)"; a state that does not parse is named raw (never silence)."""
+    s = str(r.get("state") or "")
+    m = PATH_HOLD.search(s)
+    if not m:
+        return s[:200]
+    return f"path {m.group(1)} in flight on {m.group(2)} ({holder_stage(rows, m.group(2), r.get('id'))})"
+
+
