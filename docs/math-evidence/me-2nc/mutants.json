    {"id": "S9", "file": "lean/VE/Calc/Lower.lean", "definition": "VE.Calc.Work.binL", "bug": "an operand beyond the limit makes the node tooLarge whatever the other side", "test": ["lean/VE/Calc/WorkExamples.lean:73", "lean/VE/Calc/WorkExamples.lean:74", "lean/VE/Calc/WorkExamples.lean:75", "lean/VE/Calc/WorkExamples.lean:76", "lean/VE/Calc/WorkExamples.lean:77", "lean/VE/Calc/WorkExamples.lean:83", "lean/VE/Calc/WorkExamples.lean:179", "lean/VE/Calc/WorkExamples.lean:215", "lean/VE/Calc/WorkExamples.lean:218"]},
