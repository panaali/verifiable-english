    {"id": "S7", "file": "lean/VE/Calc/Lower.lean", "definition": "VE.Calc.Work.chargeL", "bug": "lowered forms are not held to the digit limit", "test": ["lean/VE/Calc/WorkExamples.lean:28", "lean/VE/Calc/WorkExamples.lean:29", "lean/VE/Calc/WorkExamples.lean:32", "lean/VE/Calc/WorkExamples.lean:33", "lean/VE/Calc/WorkExamples.lean:34"]},
