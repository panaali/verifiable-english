@@ -0,0 +1,82 @@
+import VE.Acts.Nary
+
+/-! AP-6 route (a), scratch only: the three fixtures (docs/act-phrases/ap-6/fixtures/) as n-ary acts documents. Each
+reified document passes today's binary norms check (`VE.Norms.WellFormed`), and the reified guards have the shape
+`reifyFormula` promises. -/
+namespace VE.Acts.NaryExamples
+open VE.Acts.Nary VE.Norms
+
+def env (sorts : List String) (ps : List (String × List String)) : VE.Environment :=
+  { sorts, predicates := fun q => ps.lookup q, constants := fun _ => none }
+def ev (sorts : List String) : VE.Events.EventsEnv :=
+  ⟨"day", "before", sorts.map (fun s => ⟨s, s ++ "_on"⟩), [], [], none, []⟩
+def nd (n p : String) (sign : Bool) (guard : VE.Formula := .top) (over : List String := [])
+    (carveOuts : List VE.Formula := []) : Node := ⟨n, p, sign, guard, carveOuts, over⟩
+
+/-! ### u019: no distinction by a bearer against a person on a ground (UDHR Article 2) -/
+
+def u019a : NaryReg := ⟨"distinguish_permitted", "bearer", ["person", "ground"], true, .permission,
+  some "{0} make a distinction against {1} on the ground of {2}", none, "distinction",
+  ["distinction_against", "distinction_ground"]⟩
+def u019E : VE.Environment := env ["bearer", "person", "ground", "distinction", "day"]
+  [("distinguish_permitted", ["bearer", "distinction"]), ("listed_ground", ["ground"]),
+   ("distinction_against", ["distinction", "person"]), ("distinction_ground", ["distinction", "ground"]),
+   ("distinction_on", ["distinction", "day"]), ("before", ["day", "day"])]
+-- guard over (bearer, person, ground): de Bruijn 2, 1, 0
+def u019 : ActsDoc := ⟨u019E, ev ["distinction"], [], [u019a], [],
+  [nd "r019" "distinguish_permitted" false (.unary "listed_ground" (.var 0))], by decide⟩
+
+/-! ### u057 (reworded): the right to found a family and to marry, without any limitation due to a ground -/
+
+def u057a : NaryReg := ⟨"limit_permitted", "bearer", ["person", "ground"], true, .permission,
+  some "{0} limit the right of {1} to marry on the ground of {2}", none, "limitation",
+  ["limitation_of", "limitation_ground"]⟩
+def u057E : VE.Environment := env ["bearer", "person", "ground", "limitation", "day"]
+  [("limit_permitted", ["bearer", "limitation"]), ("found_a_family_entitled", ["person"]),
+   ("marry_entitled", ["person"]), ("of_full_age", ["person"]), ("marriage_ground", ["ground"]),
+   ("limitation_of", ["limitation", "person"]), ("limitation_ground", ["limitation", "ground"]),
+   ("limitation_on", ["limitation", "day"]), ("before", ["day", "day"])]
+def u057bin : List Regulated :=
+  [⟨"found_a_family_entitled", ["person"], false, .plain, some "{0} to found a family", none⟩,
+   ⟨"marry_entitled", ["person"], false, .plain, some "{0} to marry", none⟩]
+def u057 : ActsDoc := ⟨u057E, ev ["limitation"], u057bin, [u057a], [],
+  [nd "r057-a1" "found_a_family_entitled" true (.unary "of_full_age" (.var 0)),
+   nd "r057-a2" "marry_entitled" true (.unary "of_full_age" (.var 0)),
+   nd "r057-l" "limit_permitted" false (.and (.unary "of_full_age" (.var 1)) (.unary "marriage_ground" (.var 0)))],
+  by decide⟩
+
+/-! ### rights.md (μ): `publish_about(person, item, person)`, liberty of right 19 and claim of right 12 -/
+
+def muA : NaryReg := ⟨"publish_about_permitted", "person", ["item", "person"], false, .permission,
+  some "{0} publish {1} about {2}", none, "publication", ["publication_of", "publication_about"]⟩
+def muE : VE.Environment := env ["person", "item", "publication", "day"]
+  [("publish_about_permitted", ["person", "publication"]), ("attacks_honour", ["item", "person"]),
+   ("publication_of", ["publication", "item"]), ("publication_about", ["publication", "person"]),
+   ("publication_on", ["publication", "day"]), ("before", ["day", "day"])]
+-- guard over (person, item, person): de Bruijn 2, 1, 0
+def mu : ActsDoc := ⟨muE, ev ["publication"], [], [muA], [],
+  [nd "r19" "publish_about_permitted" true,
+   nd "r12" "publish_about_permitted" false (.binary "attacks_honour" (.var 1) (.var 0))], by decide⟩
+
+def fixtures : List ActsDoc := [u019, u057, mu]
+
+-- Each reified fixture is a well-formed binary norms document today.
+#guard fixtures.all (fun D => WellFormed (reify D))
+-- The reified guard of r019: `∃p:person. distinction_against(e, p) ∧ ∃g:ground. distinction_ground(e, g) ∧ listed_ground(g)` (the bearer is `var 1` at the top, the event `var 0`).
+#guard (reify u019).T.nodes.map (·.guard) ==
+  [.ex "person" (.and (.binary "distinction_against" (.var 1) (.var 0))
+    (.ex "ground" (.and (.binary "distinction_ground" (.var 2) (.var 0)) (.unary "listed_ground" (.var 0)))))]
+def roles (body : VE.Formula) : VE.Formula :=
+  .ex "item" (.and (.binary "publication_of" (.var 1) (.var 0))
+    (.ex "person" (.and (.binary "publication_about" (.var 2) (.var 0)) body)))
+-- r19's guard `top` becomes the roles alone; r12's guard reads the item and the second person through the roles, not the holder.
+#guard (reify mu).T.nodes.map (·.guard) ==
+  [roles .top, .ex "item" (.and (.binary "publication_of" (.var 1) (.var 0))
+    (.ex "person" (.and (.binary "publication_about" (.var 2) (.var 0)) (.binary "attacks_honour" (.var 1) (.var 0)))))]
+-- The binary parts of u057 are untouched.
+#guard ((reify u057).T.nodes.take 2).map (·.guard) == [.unary "of_full_age" (.var 0), .unary "of_full_age" (.var 0)]
+-- The reified predicates are binary over the holder and the event; the source ones keep their arity.
+#guard fixtures.map (fun D => ((reify D).T.regulated.map (·.sorts.length), (source D).regulated.map (·.sorts.length)))
+  == [([2], [3]), ([1, 1, 2], [1, 1, 3]), ([2], [3])]
+
+end VE.Acts.NaryExamples
