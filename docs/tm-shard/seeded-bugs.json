{"item": "tm-shard", "language": "Python", "how": "each planted in tools/trust_mutants.py, its test run (uv run pytest -q tests/test_trust_mutants.py -k <test>), the file restored",
 "mutants": [
  {"id": "S1", "file": "tools/trust_mutants.py", "behaviour": "--shard ownership: (i) % N instead of (i - 1) % N in owns", "test": "tests/test_trust_mutants.py::test_a_shard_owns_a_disjoint_stable_part_of_the_mutants_that_run", "caught": true},
  {"id": "S2", "file": "tools/trust_mutants.py", "behaviour": "--merge: every row taken from part 1, not from its owner", "test": "tests/test_trust_mutants.py::test_the_parts_merged_are_the_one_runs_record[2-6]", "caught": true},
  {"id": "S3", "file": "tools/trust_mutants.py", "behaviour": "--merge: the owned-twice refusal dropped", "test": "tests/test_trust_mutants.py::test_merge_refuses_parts_that_are_not_one_runs[owned-twice]", "caught": true},
  {"id": "S4", "file": "tools/trust_mutants.py", "behaviour": "--plan: to_run counts the part's mutants, not the run's", "test": "tests/test_trust_mutants.py::test_plan_prints_the_counts_and_builds_nothing", "caught": true},
  {"id": "S5", "file": "tools/trust_mutants.py", "behaviour": "--shard with --rescore: verdicts reused for mutants other parts own", "test": "tests/test_trust_mutants.py::test_rescored_parts_merge_to_the_rescored_run", "caught": true},
  {"id": "S6", "file": "tools/trust_mutants.py", "behaviour": "--merge: seconds summed instead of the longest part's", "test": "tests/test_trust_mutants.py::test_the_parts_merged_are_the_one_runs_record[2-6]", "caught": true},
  {"id": "S7", "file": "tools/trust_mutants.py", "behaviour": "row typing: a bool taken for an int (isinstance in typed)", "test": "tests/test_trust_mutants.py::test_merge_refuses_a_part_this_tool_does_not_write[row-line-True]", "caught": true, "round": "fix1"},
  {"id": "S8", "file": "tools/trust_mutants.py", "behaviour": "row typing: the status not checked against STATUSES and OTHER", "test": "tests/test_trust_mutants.py::test_merge_refuses_a_part_this_tool_does_not_write[row-status-raw-PASSED]", "caught": true, "round": "fix1"},
  {"id": "S9", "file": "tools/trust_mutants.py", "behaviour": "part check: counts, counts by class and definitions not compared with what its rows give", "test": "tests/test_trust_mutants.py::test_merge_refuses_a_part_this_tool_does_not_write[derived-counts]", "caught": true, "round": "fix1"},
  {"id": "S10", "file": "tools/trust_mutants.py", "behaviour": "--merge: a row a part does not run checked by its status only, not as the plan's idle row", "test": "tests/test_trust_mutants.py::test_merge_refuses_a_verdict_on_a_row_a_part_does_not_run[M007-detail]", "caught": true, "round": "fix1"},
  {"id": "S11", "file": "tools/trust_mutants.py", "behaviour": "--merge: options compared with ==, so true agrees with 1", "test": "tests/test_trust_mutants.py::test_merge_refuses_parts_that_are_not_one_runs[inputs-bool-for-int]", "caught": true, "round": "fix1"},
  {"id": "S12", "file": "tools/trust_mutants.py", "behaviour": "row typing: an ALLOWED raw_status accepted", "test": "tests/test_trust_mutants.py::test_merge_refuses_a_part_this_tool_does_not_write[row-allowed-raw-allowed]", "caught": true, "round": "fix1"},
  {"id": "S13", "file": "tools/trust_mutants.py", "behaviour": "--rescore PREV: its rows not checked by the shared row check (`unwritten`)", "test": "tests/test_trust_mutants.py::test_rescore_of_evidence_whose_mutants_differ_is_a_full_run", "caught": true, "round": "fix1"}
 ]}
