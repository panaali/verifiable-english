{
  "format": "ve.english-lean-lexer-corpus@1",
  "spec": "docs/spec/english-lean.md, section 8.4 (draft 2), and the S0 choices of docs/spec/english-lean-measured.md",
  "notes": [
    "Expected results are copied from the specification. A token is written as in engine.json: a plain string is a word that is not initial; {\"w\", \"initial\"}, {\"q\"}, {\"label\", \"index\"}, {\"num\"}, {\"p\", \"glued_before\", \"glued_after\"} are the other forms.",
    "`sentences` lists the sentences, each a list of tokens. `reject` is the Reject constructor; `at` its argument (a UTF-8 byte offset, or a sentence index for emptySentence).",
    "`source_repeat` builds a source as `text` repeated `times` times, followed by `tail`."
  ],
  "cases": [
    {"id": "x1", "source": "Every service is reviewed.",
     "sentences": [[{"w": "Every", "initial": true}, "service", "is", "reviewed"]]},
    {"id": "x2", "source": "Legacy is deployed.  It is reviewed.",
     "sentences": [[{"w": "Legacy", "initial": true}, "is", "deployed"],
                   [{"w": "It", "initial": true}, "is", "reviewed"]]},
    {"id": "x3", "source": "Therefore legacy is deployed.",
     "sentences": [[{"w": "Therefore", "initial": true}, {"w": "legacy", "initial": true}, "is", "deployed"]]},
    {"id": "x4", "source": "It follows that Legacy is deployed.",
     "sentences": [[{"w": "It", "initial": true}, "follows", "that", {"w": "Legacy", "initial": true}, "is", "deployed"]]},
    {"id": "x5", "source": "alice is classified as \"has_owner\".",
     "sentences": [[{"w": "alice", "initial": true}, "is", "classified", "as", {"q": "has_owner"}]]},
    {"id": "x6", "source": "\"a. b\" is deployed.",
     "sentences": [[{"q": "a. b"}, "is", "deployed"]]},
    {"id": "x7", "source": "For every service named S1, S1 is reviewed.",
     "sentences": [[{"w": "For", "initial": true}, "every", "service", "named", {"label": "S", "index": 1}, {"p": ",", "glued_before": true, "glued_after": false},
                    {"label": "S", "index": 1}, "is", "reviewed"]]},
    {"id": "x8a", "source": "(a) x; (b) y.",
     "sentences": [[{"p": "(a)", "glued_before": false, "glued_after": false}, "x", {"p": ";", "glued_before": true, "glued_after": false}, {"p": "(b)", "glued_before": false, "glued_after": false}, "y"]]},
    {"id": "x8b", "source": "( a ) x.",
     "sentences": [[{"p": "(", "glued_before": false, "glued_after": false}, "a", {"p": ")", "glued_before": false, "glued_after": false}, "x"]]},
    {"id": "x9", "source": "Every service is reviewed", "reject": "unterminated"},
    {"id": "x10a", "source": "", "reject": "emptyDocument"},
    {"id": "x10b", "source": "   \t \n ", "reject": "emptyDocument"},
    {"id": "x11", "source": "Alice owns legacy..", "reject": "emptySentence", "at": 1},
    {"id": "x12", "source": "alice is classified as \"has_owner.", "reject": "openQuote", "at": 23},
    {"id": "x13", "source": "alice owns 007.", "reject": "badNumeral", "at": 11},
    {"id": "x14", "source": "alice owns #legacy.", "reject": "badCharacter", "at": 11},
    {"id": "x15a", "source_repeat": {"text": "a", "times": 65536, "tail": "."}, "reject": "sourceTooLong"},
    {"id": "x15b", "source_repeat": {"text": "a ", "times": 5000, "tail": "a."}, "reject": "textTooLong"},
    {"id": "x16", "source": "Every \t\n service\r\n\t is  \n\n reviewed.",
     "sentences": [[{"w": "Every", "initial": true}, "service", "is", "reviewed"]]},
    {"id": "x17", "source": "ſervice café.",
     "sentences": [[{"w": "ſervice", "initial": true}, "café"]]}
  ]
}
