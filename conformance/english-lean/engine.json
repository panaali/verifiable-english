{
  "format": "ve.english-lean-engine-corpus@1",
  "spec": "docs/spec/english-lean.md, sections 8.1 to 8.3 and 8.7 (draft 2)",
  "notes": [
    "Expected results are copied from the specification, where they were derived by hand. They are not computed by any implementation.",
    "A grammar lists its nonterminals with their ranks; the first one listed is number 0. A right-hand symbol {\"n\": name} is a nonterminal; a plain string is a kw terminal; {\"c\"}, {\"p\"}, {\"q\"}, {\"w\"} and {\"cls\"} are the other terminals of spec 2.10. A nonterminal name that is not listed is numbered past the end of the rank array (a W1 fault).",
    "A token is a plain string for a word that is not initial, or {\"w\", \"initial\"}, {\"q\"}, {\"label\", \"index\"}, {\"num\"}, {\"p\"}.",
    "A tree is written as in spec section 8: the rule's tag and its children, r0(a, r1(b)); a leaf is its token.",
    "`trees` is the exact set of returned trees; `count` with `among` says that the returned trees are that many distinct members of the listed set; `complete` says whether the list is shorter than the cap (spec 2.6).",
    "Unless a case gives `cap`, the cap is 2 (the verdict). Unless it gives `budget`, the budget is `default_budget`."
  ],
  "default_budget": 10000000,
  "grammars": {
    "G1": {"nonterminals": [["S", 0], ["A", 0]], "start": "S",
           "rules": [{"tag": "r0", "lhs": "S", "rhs": ["a", {"n": "A"}], "act": 0},
                     {"tag": "r1", "lhs": "A", "rhs": ["b"], "act": 1}]},
    "G1c": {"nonterminals": [["S", 0], ["A", 0]], "start": "S",
            "rules": [{"tag": "r0", "lhs": "S", "rhs": ["a", {"n": "A"}], "act": 0},
                      {"tag": "r1", "lhs": "A", "rhs": ["b"], "act": 1},
                      {"tag": "r2", "lhs": "S", "rhs": ["c"], "act": 2}]},
    "G1ab": {"nonterminals": [["S", 0], ["A", 0]], "start": "S",
             "rules": [{"tag": "r0", "lhs": "S", "rhs": ["a", {"n": "A"}], "act": 0},
                       {"tag": "r1", "lhs": "A", "rhs": ["b"], "act": 1},
                       {"tag": "r2", "lhs": "S", "rhs": ["a", "b"], "act": 3}]},
    "G1swap": {"nonterminals": [["S", 0], ["A", 0]], "start": "S",
               "rules": [{"tag": "r0", "lhs": "A", "rhs": ["b"], "act": 1},
                         {"tag": "r1", "lhs": "S", "rhs": ["a", {"n": "A"}], "act": 0}]},
    "G1act": {"nonterminals": [["S", 0], ["A", 0]], "start": "S",
              "rules": [{"tag": "r0", "lhs": "S", "rhs": ["a", {"n": "A"}], "act": 0},
                        {"tag": "r1", "lhs": "A", "rhs": ["b"], "act": 4}]},
    "G2": {"nonterminals": [["S", 0]], "start": "S",
           "rules": [{"tag": "r0", "lhs": "S", "rhs": ["x"]},
                     {"tag": "r1", "lhs": "S", "rhs": ["x"]}]},
    "G3": {"nonterminals": [["S", 1], ["A", 0], ["B", 0]], "start": "S",
           "rules": [{"tag": "r0", "lhs": "S", "rhs": [{"n": "A"}, {"n": "B"}]},
                     {"tag": "r1", "lhs": "A", "rhs": ["a"]},
                     {"tag": "r2", "lhs": "A", "rhs": ["a", "a"]},
                     {"tag": "r3", "lhs": "B", "rhs": ["a"]},
                     {"tag": "r4", "lhs": "B", "rhs": ["a", "a"]}]},
    "G4": {"nonterminals": [["S", 1], ["A", 0], ["B", 0], ["C", 0]], "start": "S",
           "rules": [{"tag": "r0", "lhs": "S", "rhs": [{"n": "A"}, {"n": "B"}, {"n": "C"}]},
                     {"tag": "r1", "lhs": "A", "rhs": ["a"]},
                     {"tag": "r2", "lhs": "A", "rhs": ["a", "a"]},
                     {"tag": "r3", "lhs": "B", "rhs": ["a"]},
                     {"tag": "r4", "lhs": "B", "rhs": ["a", "a"]},
                     {"tag": "r5", "lhs": "C", "rhs": ["a"]},
                     {"tag": "r6", "lhs": "C", "rhs": ["a", "a"]}]},
    "G5": {"nonterminals": [["S", 2], ["A", 1], ["B", 0]], "start": "S",
           "rules": [{"tag": "r0", "lhs": "S", "rhs": [{"n": "A"}]},
                     {"tag": "r1", "lhs": "A", "rhs": [{"n": "B"}]},
                     {"tag": "r2", "lhs": "B", "rhs": ["x"]}]},
    "G6": {"nonterminals": [["S", 0], ["N", 0]], "start": "S",
           "rules": [{"tag": "r0", "lhs": "S", "rhs": ["every", {"n": "N"}]},
                     {"tag": "r1", "lhs": "N", "rhs": [{"c": "service"}]},
                     {"tag": "r2", "lhs": "N", "rhs": [{"q": "svc"}]},
                     {"tag": "r3", "lhs": "N", "rhs": [{"cls": {"label": "S"}}]},
                     {"tag": "r4", "lhs": "N", "rhs": [{"cls": "numeral"}]}]},
    "G15a": {"nonterminals": [["S", 0]], "start": "S",
             "rules": [{"tag": "r0", "lhs": "S", "rhs": [{"n": "S"}, "x"]},
                       {"tag": "r1", "lhs": "S", "rhs": ["x"]}]},
    "G15a2": {"nonterminals": [["S", 5]], "start": "S",
              "rules": [{"tag": "r0", "lhs": "S", "rhs": [{"n": "S"}, "x"]},
                        {"tag": "r1", "lhs": "S", "rhs": ["x"]}]},
    "G15b": {"nonterminals": [["S", 0]], "start": "S",
             "rules": [{"tag": "r0", "lhs": "S", "rhs": []},
                       {"tag": "r1", "lhs": "S", "rhs": ["x"]}]},
    "G15c": {"nonterminals": [["S", 2], ["A", 1], ["B", 0]], "start": "S",
             "rules": [{"tag": "r0", "lhs": "S", "rhs": [{"n": "A"}]},
                       {"tag": "r1", "lhs": "A", "rhs": [{"n": "B"}]},
                       {"tag": "r2", "lhs": "B", "rhs": [{"n": "A"}]},
                       {"tag": "r3", "lhs": "B", "rhs": ["x"]}]},
    "G15d": {"nonterminals": [["S", 0]], "start": "S",
             "rules": [{"tag": "r0", "lhs": "S", "rhs": ["x", {"n": "Z"}]},
                       {"tag": "r1", "lhs": "S", "rhs": ["x"]}]},
    "G15e": {"nonterminals": [["S", 0]], "start": "Z",
             "rules": [{"tag": "r0", "lhs": "S", "rhs": ["x"]}]},
    "G17": {"nonterminals": [["S", 1], ["A", 0]], "start": "S",
            "rules": [{"tag": "r0", "lhs": "S",
                       "rhs": [{"n": "A"}, {"n": "A"}, {"n": "A"}, {"n": "A"}, {"n": "A"}, {"n": "A"}, {"n": "A"}, {"n": "A"}, "z"]},
                      {"tag": "r1", "lhs": "A", "rhs": ["a"]},
                      {"tag": "r2", "lhs": "A", "rhs": ["a", "a"]}]},
    "G20": {"nonterminals": [["S", 2], ["A", 1], ["B", 0]], "start": "S",
            "rules": [{"tag": "r0", "lhs": "S", "rhs": [{"n": "A"}, {"n": "A"}, {"n": "A"}]},
                      {"tag": "r1", "lhs": "S", "rhs": [{"n": "A"}, {"n": "A"}, {"n": "A"}]},
                      {"tag": "r2", "lhs": "A", "rhs": [{"n": "B"}, {"n": "B"}]},
                      {"tag": "r3", "lhs": "B", "rhs": ["a"]},
                      {"tag": "r4", "lhs": "B", "rhs": ["a"]}]},
    "GA": {"nonterminals": [["E", 0]], "start": "E",
           "rules": [{"tag": "e0", "lhs": "E", "rhs": [{"cls": "numeral"}], "act": 0},
                     {"tag": "e1", "lhs": "E", "rhs": [{"p": "("}, {"n": "E"}, {"p": "+"}, {"n": "E"}, {"p": ")"}], "act": 1}]},
    "GA4": {"nonterminals": [["E", 0]], "start": "E",
            "rules": [{"tag": "e0", "lhs": "E", "rhs": [{"cls": "numeral"}], "act": 0},
                      {"tag": "e1", "lhs": "E", "rhs": [{"p": "("}, {"n": "E"}, {"p": "+"}, {"n": "E"}, {"p": ")"}], "act": 7}]}
  },
  "libraries": {
    "GA": "types tok and num (E has num). Action 0: [tok] -> num, the numeral's value. Action 1: [tok, num, tok, num, tok] -> num, the sum of the second and fourth arguments.",
    "GA3": "as GA, but action 1 takes three arguments [tok, num, tok] -> num.",
    "G1": "types tok, sent (S), a (A). Action 0: [tok, a] -> sent, the value of A. Action 1: [tok] -> a, the constant 1. Action 2: [tok] -> sent, the constant 2. Action 3: [tok, tok] -> sent, the constant 3. Action 4: [tok] -> a, the constant 9 (a replaced action of r1).",
    "mu1": "from state k (a number): value k, mark false, successor state k + 1, for every tree.",
    "mu2": "the rejection `no` for every tree.",
    "mu-r9": "from state k: value k, mark false, successor state k + 1 (gives two trees the same value).",
    "mu-r10": "from state k: value k, mark false, successor k + 1 for a tree whose root rule is r0; the rejection `no` for any other tree."
  },
  "cases": [
    {"id": "g1", "kind": "parse", "grammar": "G1", "input": ["a", "b"],
     "expect": {"verdict": "one", "trees": ["r0(a, r1(b))"], "complete": true}},
    {"id": "g2", "kind": "parse-each", "grammar": "G1", "inputs": [["a"], ["a", "b", "b"], ["b", "a"], []],
     "expect": {"verdict": "zero", "trees": [], "complete": true}},
    {"id": "g3", "kind": "parse", "grammar": "G2", "input": ["x"],
     "expect": {"verdict": "many", "trees": ["r0(x)", "r1(x)"], "complete": false}},
    {"id": "g4", "kind": "parse", "grammar": "G3", "input": ["a", "a"],
     "expect": {"verdict": "one", "trees": ["r0(r1(a), r3(a))"], "complete": true}},
    {"id": "g5", "kind": "parse", "grammar": "G3", "input": ["a", "a", "a"],
     "expect": {"verdict": "many", "trees": ["r0(r1(a), r4(a, a))", "r0(r2(a, a), r3(a))"], "complete": false}},
    {"id": "g6", "kind": "parse", "grammar": "G3", "input": ["a", "a", "a", "a"],
     "expect": {"verdict": "one", "trees": ["r0(r2(a, a), r4(a, a))"], "complete": true}},
    {"id": "g7", "kind": "parse", "grammar": "G4", "input": ["a", "a", "a", "a"], "cap": 4,
     "expect": {"trees": ["r0(r1(a), r3(a), r6(a, a))", "r0(r1(a), r4(a, a), r5(a))", "r0(r2(a, a), r3(a), r5(a))"],
                "complete": true}},
    {"id": "g8", "kind": "parse", "grammar": "G4", "input": ["a", "a", "a", "a"], "cap": 2,
     "expect": {"verdict": "many", "count": 2,
                "among": ["r0(r1(a), r3(a), r6(a, a))", "r0(r1(a), r4(a, a), r5(a))", "r0(r2(a, a), r3(a), r5(a))"],
                "complete": false}},
    {"id": "g9", "kind": "parse", "grammar": "G4", "input": ["a", "a", "a", "a"], "cap": 3,
     "expect": {"trees": ["r0(r1(a), r3(a), r6(a, a))", "r0(r1(a), r4(a, a), r5(a))", "r0(r2(a, a), r3(a), r5(a))"],
                "complete": false}},
    {"id": "g10", "kind": "parse", "grammar": "G5", "input": ["x"],
     "expect": {"verdict": "one", "trees": ["r0(r1(r2(x)))"], "complete": true}},
    {"id": "g11", "kind": "parse-each", "grammar": "G6",
     "inputs": [["every", "service"], [{"w": "Every", "initial": true}, "Service"], ["every", "SERVICE"], ["every", "ſervice"]],
     "expect": {"verdict": "one", "rule_of_child": "r1"}},
    {"id": "g12", "kind": "parse-each", "grammar": "G6",
     "inputs": [["Every", "service"], [{"w": "EVERY", "initial": true}, "service"], ["every", "services"]],
     "expect": {"verdict": "zero", "trees": [], "complete": true}},
    {"id": "g13", "kind": "parse-each", "grammar": "G6",
     "inputs": [["every", {"q": "svc"}], ["every", {"label": "S", "index": 3}], ["every", {"num": 7}]],
     "expect": {"verdict": "one", "rules_of_child": ["r2", "r3", "r4"]}},
    {"id": "g14", "kind": "parse-each", "grammar": "G6",
     "inputs": [["every", {"q": "SVC"}], ["every", {"label": "T", "index": 3}], ["every", "svc"]],
     "expect": {"verdict": "zero", "trees": [], "complete": true}},
    {"id": "g15", "kind": "not-wf", "grammars": ["G15a", "G15a2", "G15b", "G15c", "G15d", "G15e"],
     "inputs": [["x"], ["x", "x"], ["x", "x", "x"]],
     "expect": {"wf": false, "returned_trees_derive": true}},
    {"id": "g16", "kind": "budget-sweep", "grammar": "G3", "input": ["a", "a", "a"], "same_as": "g5",
     "expect": {"none_below_threshold": true, "result_from_threshold_on": true}},
    {"id": "g17", "kind": "steps", "grammar": "G17", "input_word": "a", "input_length": 40,
     "expect": {"verdict": "zero", "bound": "steps <= C * |G| * n^3 * cap^2, C measured (spec 2.6)"}},
    {"id": "g18", "kind": "random", "seed": 20261003, "grammars": 200, "max_rules": 6, "max_rhs": 3,
     "nonterminals": 3, "terminals": ["a", "b"], "max_input_length": 6, "cap": 64, "also_caps": [2, 3],
     "expect": {"wf": "distinct derivations; their number is min(64, N); the set equals the enumerated set when N <= 64",
                "not_wf": "every returned tree is a derivation"}},
    {"id": "g19", "kind": "all-returned-derive",
     "expect": "every tree returned in g1 to g18 and g20 derives the start symbol and yields the input"},
    {"id": "g20", "kind": "saturation", "grammar": "G20", "input": ["a", "a", "a", "a", "a", "a"],
     "expect": {"derivations": 128, "cap64": {"count": 64, "complete": false}, "cap129": {"count": 128, "complete": true}}},

    {"id": "m1", "kind": "typed", "grammar": "GA", "library": "GA", "types": {"E": "num"}, "expect": {"typed": true}},
    {"id": "m2", "kind": "value", "grammar": "GA", "library": "GA", "types": {"E": "num"},
     "input": [{"p": "("}, {"num": 1}, {"p": "+"}, {"p": "("}, {"num": 2}, {"p": "+"}, {"num": 3}, {"p": ")"}, {"p": ")"}],
     "expect": {"verdict": "one", "value": 6, "type": "num"}},
    {"id": "m3", "kind": "typed", "grammar": "GA", "library": "GA3", "types": {"E": "num"}, "expect": {"typed": false}},
    {"id": "m4", "kind": "typed", "grammar": "GA4", "library": "GA", "types": {"E": "num"}, "expect": {"typed": false}},
    {"id": "m5", "kind": "value", "grammar": "GA", "library": "GA3", "types": {"E": "num"},
     "input": [{"p": "("}, {"num": 1}, {"p": "+"}, {"p": "("}, {"num": 2}, {"p": "+"}, {"num": 3}, {"p": ")"}, {"p": ")"}],
     "expect": {"verdict": "one", "value": null}},

    {"id": "r1", "kind": "read-sentence", "grammar": "G1", "meaning": "mu1", "state": 5, "input": ["a", "b"],
     "expect": {"outcome": ["ok", 5, false], "state": 6}},
    {"id": "r2", "kind": "read-sentence", "grammar": "G1", "meaning": "mu1", "state": 5, "input": ["a"],
     "expect": {"outcome": ["noDerivation"], "state": 5}},
    {"id": "r3", "kind": "read-sentence", "grammar": "G2", "meaning": "mu1", "state": 5, "input": ["x"],
     "expect": {"outcome": ["ambiguous", "r0(x)", "r1(x)"], "state": 5, "meaning_consulted": false}},
    {"id": "r4", "kind": "read-sentence", "grammar": "G1", "meaning": "mu2", "state": 5, "input": ["a", "b"],
     "expect": {"outcome": ["rejected", "no"], "state": 5}},
    {"id": "r5", "kind": "read-sentence", "grammar": "G3", "meaning": "mu1", "state": 5, "input": ["a", "a", "a"],
     "budget": "below the threshold of g16",
     "expect": {"outcome": ["budget"], "state": 5}},
    {"id": "r6", "kind": "read-document", "grammar": "G1", "meaning": "mu1", "state": 0,
     "inputs": [["a", "b"], ["a", "b"], ["a", "b"]],
     "expect": {"outcome": ["ok", [[0, false], [1, false], [2, false]]], "state": 3}},
    {"id": "r7", "kind": "read-document", "grammar": "G1", "meaning": "mu1", "state": 0,
     "inputs": [["a", "b"], ["a"], ["a", "b"]],
     "expect": {"outcome": ["stopped", 1, ["noDerivation"]], "state": 1}},
    {"id": "r8", "kind": "read-document", "grammar": "G1", "meaning": "mu1", "state": 0, "inputs": [],
     "expect": {"outcome": ["ok", []], "state": 0}},
    {"id": "r9", "kind": "reading-set", "grammar": "G3", "meaning": "mu-r9", "state": 0, "input": ["a", "a", "a"],
     "cap": 2,
     "expect": {"read_outcome": "ambiguous", "readings": [[0, false, 1], [0, false, 1]]}},
    {"id": "r10", "kind": "reading-set", "grammar": "G2", "meaning": "mu-r10", "state": 0, "input": ["x"], "cap": 2,
     "expect": {"trees": ["r0(x)", "r1(x)"], "readings": [[0, false, 1]], "complete": false}},

    {"id": "q1", "kind": "extension", "small": "G1", "large": "G1c", "library": "G1",
     "rule_map": {"rule": [0, 1], "nt": [0, 1]}, "input": ["a", "b"],
     "expect": {"ok": true, "large_verdict": "one", "image": "r0(a, r1(b))", "same_value": true}},
    {"id": "q2", "kind": "extension", "small": "G1", "large": "G1ab", "library": "G1",
     "rule_map": {"rule": [0, 1], "nt": [0, 1]}, "input": ["a", "b"],
     "expect": {"ok": true, "large_verdict": "many", "image": "r0(a, r1(b))"}},
    {"id": "q3", "kind": "extension", "small": "G1", "large": "G1swap", "library": "G1",
     "rule_map": {"rule": [1, 0], "nt": [0, 1]}, "input": ["a", "b"],
     "expect": {"ok": true, "large_verdict": "one", "image": "r1(a, r0(b))", "same_value": true}},
    {"id": "q4", "kind": "extension", "small": "G1", "large": "G1act", "library": "G1",
     "rule_map": {"rule": [0, 1], "nt": [0, 1]}, "input": ["a", "b"],
     "expect": {"ok": false, "failing_clause": "actions"}}
  ]
}
