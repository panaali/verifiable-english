     "block": "r09",
     "asserting": true
    },
    {
     "id": "r03.1",
     "text": "If unit5 is mounted and unit5 is routed and unit5 is rated, then unit3 is ready (packing completed).",
     "role": "given",
     "block": "r03",
     "asserting": true
    },
    {
     "id": "r03.2",
     "text": "If unit5 is tied and unit5 is boxed, then unit3 is ready (packing completed).",
     "role": "given",
     "block": "r03",
     "asserting": true
    },
    {
     "id": "r01.1",
     "text": "If unit5 is weighed-in, then unit3 is sound (casing intact).",
     "role": "given",
     "block": "r01",
     "asserting": true
    },
    {
     "id": "r15.1",
     "text": "If unit3 is stable (shape retained) and unit5 is stacked, then unit1 is stable (temperature constant).",
     "role": "given",
     "block": "r15",
     "asserting": true
    },
    {
     "id": "r15.2",
     "text": "If unit3 is stable (shape retained) and unit5 is checked, then unit1 is stable (shape retained).",
     "role": "given",
     "block": "r15",
     "asserting": true
    },
    {
     "id": "r15.3",
     "text": "If unit3 is stable (shape retained) and unit5 is coded, then unit5 is stable (temperature constant).",
     "role": "given",
     "block": "r15",
     "asserting": true
    },
    {
     "id": "r15.4",
     "text": "If unit3 is stable (shape retained) and unit5 is scanned, then unit5 is stable (shape retained).",
     "role": "given",
     "block": "r15",
     "asserting": true
    },
    {
     "id": "r11.1",
     "text": "If unit3 is stable (temperature constant), then unit3 is stable (shape retained).",
     "role": "given",
     "block": "r11",
     "asserting": true
    },
    {
     "id": "r04.1",
     "text": "If unit5 is logged, then unit3 is cleared (inspection passed).",
     "role": "given",
     "block": "r04",
     "asserting": true
    },
    {
     "id": "r00.1",
     "text": "If unit5 is bundled and unit5 is retained and unit5 is packed, then unit3 is ready (staffing arranged).",
     "role": "given",
     "block": "r00",
     "asserting": true
    },
    {
     "id": "r00.2",
     "text": "If unit5 is tied and unit5 is boxed, then unit3 is ready (staffing arranged).",
     "role": "given",
     "block": "r00",
     "asserting": true
    },
    {
     "id": "r00.3",
     "text": "Lot unit5 supplied sample unit1.",
     "role": "given",
     "block": "r00",
     "asserting": true
    },
    {
     "id": "r12.1",
     "text": "If unit3 is cleared (payment settled), then unit1 is cleared (payment settled).",
     "role": "given",
     "block": "r12",
     "asserting": true
    },
    {
     "id": "r13.1",
     "text": "If unit5 is balanced, then unit3 is stable (temperature constant).",
