     "block": "n21",
     "asserting": true
    },
    {
     "id": "r08.1",
     "text": "If unit1 is cleared (payment settled), then unit5 is balanced.",
     "role": "given",
     "block": "r08",
     "asserting": true
    },
    {
     "id": "r09.1",
     "text": "If unit3 is ready (packing completed) and unit5 is ready (packing completed), then unit5 is weighed-in.",
