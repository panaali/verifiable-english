     "block": "r02",
     "asserting": true
    },
    {
     "id": "r06.1",
     "text": "If unit3 is ready (staffing arranged) and unit3 is ready (packing completed), then unit5 is ready (packing completed).",
     "role": "given",
     "block": "r06",
     "asserting": true
    },
    {
     "id": "r14.1",
     "text": "If unit3 is sound (casing intact), then unit3 is sound (signal audible).",
