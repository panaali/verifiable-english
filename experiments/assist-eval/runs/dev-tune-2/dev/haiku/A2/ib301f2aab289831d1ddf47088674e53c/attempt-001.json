     "block": "r13",
     "asserting": true
    },
    {
     "id": "r07.1",
     "text": "If unit3 is sound (signal audible), then unit5 is sound (signal audible).",
     "role": "given",
     "block": "r07",
     "asserting": true
    },
    {
     "id": "r05.1",
     "text": "If unit5 is stable (shape retained), then unit5 is calibrated.",
     "role": "given",
     "block": "r05",
     "asserting": true
    },
    {
     "id": "r05.2",
     "text": "If unit5 is tied and unit5 is boxed, then unit5 is calibrated.",
     "role": "given",
     "block": "r05",
     "asserting": true
    },
    {
     "id": "r02.1",
     "text": "If unit3 is cleared (inspection passed), then unit3 is cleared (payment settled).",
