     "asserting": true
    },
    {
     "id": "n09.1",
     "text": "unit5 is bundled; unit5 is retained; unit5 is packed; unit5 is mounted; unit5 is routed; unit5 is rated; unit5 is checked.",
     "role": "given",
     "block": "n09",
     "asserting": true
    },
    {
     "id": "n09.2",
     "text": "The checks that unit5 is stacked and unit5 is coded and unit5 is scanned remain unassumed.",
