(for every atom x, (if (x is sig_node), then (not (tc[f_edges](x, x))))) and ((for every atom n, (if (n is sig_node), then (for every atom a, (for every atom b, (if ((a f_edges n) and (b f_edges n)), then (a equals b)))))) and (for every atom x, (for every atom y, (if ((x is sig_node) and ((not (there exists atom w, (w f_edges x))) and ((y is sig_node) and (not (there exists atom w, (w f_edges y)))))), then (x equals y))))).
