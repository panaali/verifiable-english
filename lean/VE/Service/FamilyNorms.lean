import VE.Norms.Flagged
import VE.Service.Standalone
import VE.Order.Conservativity

/-! Norm documents on the closure, core and order families of `ve.core@0.2`
(SEMANTICS-MIGRATION-PLAN.md stage 2c): the service `family-norms` mode,
answering the norms route's `norms-elaborate`, `norms-certificate` and
`norms-conflict` cases.

The norms theory (`VE.Norms`) is first-order. A norm document whose formulas are
first-order is regenerated by the unchanged route over the environment's *FOL
view* (`folView`: the family profiles removed, predicates of arity above two
dropped): its layer premises, Background, conflict targets and witness checks
are the FOL route's (`Flagged.regenerated`, `Flagged.pyTargets`,
`Flagged.replayWitness`), first-order formulas over the view's vocabulary,
which the family's vocabulary extends. A document the view does not decode is
rejected. Certificates are the family's: each is decoded, bound to the
submitted environment (identities over the submitted profiles), and checked by
the family's certificate checker on the embedded regenerated premises:

* `norms-certificate`: `flags ++ Background ++ layer premises ++ Γ` over the
  complete family environment;
* `norms-conflict` with packages: each Python conflict target's
  `Background_base ⊢ ∀x̄. ¬conflict` over the family's base environment (the
  submitted environment without its regulated predicates and `norms@0`,
  `Replay.baseEnvironmentJson`), bound as the FOL route binds it.

`closure_/core_/order_norms_certificate_sound` and `…_conflict_target_sound`
state what an accepted certificate proves at the family's semantics. -/
namespace VE.Service.FamilyNorms
open Lean
open VE.Bridge (fields strings stringField)
universe u

/-- The FOL view of a closure, core or order environment. -/
def folView (environment : Json) : Except String Json := do
  let profiles := (← VE.Route.Gate.profilesOf environment).filter
    (fun p => p != "closure@0" && p != "nary@0" && p != "order@0")
  let vocabulary ← environment.getObjVal? "vocabulary"
  let predicates ← fields (← vocabulary.getObjVal? "predicates")
  let kept := predicates.filter (fun (_, entry) => VE.Core.Layers.arity entry ≤ 2)
  pure ((environment.setObjVal! "profiles" (toJson profiles)).setObjVal! "vocabulary"
    (vocabulary.setObjVal! "predicates" (Json.mkObj kept)))

/-- A model over the view: the relations of the view's predicates only. -/
def viewModel (view model : Json) : Except String Json := do
  let names := (← fields (← (← view.getObjVal? "vocabulary").getObjVal? "predicates")).map Prod.fst
  VE.Core.Layers.folModel names model

/-- What a family contributes to the certificate checks. -/
structure Checker (F C : Type) where
  embed : VE.Formula → F
  formula : Json → Except String F
  certificate : Json → Except String C
  fields : C → String × List String × String
  valid : C → List F → F → Bool
  steps : C → Nat

def closureChecker (E : VE.Environment) : Checker VE.Closure.Formula VE.Closure.Tableau.Certificate where
  embed := VE.Closure.embed
  formula := fun j => do
    let a ← VE.Closure.Bridge.decodeFormula 64 j
    unless a.check E [] do throw "ill-typed or unbound formula"
    pure a
  certificate := VE.CertificateWire.decodeClosureCertificate
  fields := fun c => (c.environment_id, c.premise_meaning_ids, c.conclusion_meaning_id)
  valid := fun c ps r => VE.Closure.Tableau.checkCertificate E ps r c
  steps := fun c => VE.Route.Steps.closure c.trace

def coreChecker (E : VE.Environment) : Checker VE.Core.Formula VE.Core.Tableau.Certificate where
  embed := VE.Core.embed
  formula := fun j => do
    let a ← VE.Core.Bridge.decodeFormula 64 j
    VE.Core.Bridge.checkFormula E a "formula"
    pure a
  certificate := VE.Core.Wire.decodeCertificate
  fields := fun c => (c.environment_id, c.premise_meaning_ids, c.conclusion_meaning_id)
  valid := fun c ps r => VE.Core.Tableau.checkCertificate E ps r c
  steps := fun c => VE.Route.Steps.core c.trace

def orderChecker (E : VE.Order.Environment) : Checker VE.Order.Formula VE.Order.Tableau.Certificate where
  embed := VE.Order.embed
  formula := fun j => do
    let a ← VE.Order.Wire.decodeFormula 64 j
    unless a.check E [] do throw "ill-typed or unbound formula"
    pure a
  certificate := VE.Order.Wire.decodeCertificate
  fields := fun c => (c.environment_id, c.premise_meaning_ids, c.conclusion_meaning_id)
  valid := fun c ps r => VE.Order.Tableau.checkCertificate E ps r c
  steps := fun c => VE.Route.Steps.order c.trace

/-- A family environment decoded by its own route decoder. -/
inductive Family where
  | closure (E : VE.Environment)
  | core (E : VE.Environment)
  | order (E : VE.Order.Environment)

def decodeFamily (environment : Json) : Except String Family := do
  let checked ← Standalone.validated environment
  match checked.envelope.family with
  | .closure => pure (.closure (← VE.Route.Run.decodeRouteVocabulary checked.envelope).environment)
  | .closureNary => pure (.core (← VE.Core.Bridge.decodeEnvironment checked.decodable).environment)
  | .order => pure (.order (← VE.Route.Wire.decodeOrderVocabulary checked.envelope.vocabulary).vocabulary.environment)
  | .fol => throw "the FOL family is answered by the norms route"

/-- `norms-certificate`: the family certificate over the embedded regenerated
`flags ++ Background ++ layer premises`, then `Γ`, bound to the submitted environment. -/
def certificateCase {F C : Type} (k : Checker F C) (profiles : List String) (canonical : Json)
    (regenerated : List VE.Formula) (j : Json) : Except String (Bool × Nat) := do
  let premisesJson ← j.getObjVal? "premises"
  let conclusionJson ← j.getObjVal? "conclusion"
  let asts ← VE.Route.Wire.formulasJson premisesJson (some conclusionJson)
  let ps ← (asts.take (asts.length - 1)).mapM k.formula
  let c ← k.formula conclusionJson
  let cert ← k.certificate (← j.getObjVal? "certificate")
  let (e, pids, q) := k.fields cert
  VE.Route.Wire.bindingOk profiles canonical
    (regenerated.map VE.Route.Wire.encodeFormula ++ (← premisesJson.getArr?).toList) conclusionJson e pids q
  let steps := k.steps cert
  if steps > VE.Route.Steps.limit j then throw VE.Route.Steps.stepLimit
  pure (k.valid cert (regenerated.map k.embed ++ ps) c, steps)

/-- One conflict target's package, as `Flagged.decodePackage` binds it, with the
family's certificate: `none` unless bound. -/
def targetPackage {F C : Type} (k : Checker F C) (profiles : List String) (environment norms packages : Json)
    (baseBg : List VE.Formula) (t : String × List String × VE.Formula) : Option C := Id.run do
  let some baseEnvJson := (VE.Norms.Replay.baseEnvironmentJson environment).toOption | none
  let some baseProfiles := (strings (baseEnvJson.getObjValD "profiles")).toOption | none
  let some canonical := (VE.Norms.Wire.canonicalEnvironmentJson environment).toOption | none
  let some envId := (VE.Route.Wire.environmentId profiles canonical).toOption | none
  let some docHash := (VE.Norms.Replay.documentHash profiles environment norms).toOption | none
  let package := packages.getObjValD t.1
  unless package.getObjValD "environment_id" == .str envId &&
      package.getObjValD "document_hash" == .str docHash &&
      package.getObjValD "target" == .str t.1 do return none
  let some c := (k.certificate (package.getObjValD "certificate")).toOption | none
  let (e, pids, q) := k.fields c
  match VE.Route.Wire.bindingOk baseProfiles baseEnvJson (baseBg.map VE.Route.Wire.encodeFormula)
      (VE.Route.Wire.encodeFormula (VE.Norms.targetConclusion t)) e pids q with
  | .ok () => some c
  | .error _ => none

/-- `norms-conflict` with packages: CONFLICT-FREE when every Python target has a
bound certificate the family checker accepts over the base environment, else
UNKNOWN naming the first target without one (`Flagged.firstFailure`). -/
def conflictCase {F C : Type} (k : Checker F C) (profiles : List String) (environment norms : Json)
    (src : VE.Norms.Wire.Source) (j : Json) : Json × Bool :=
  let packages := j.getObjValD "packages"
  let baseBg := VE.Norms.Flagged.baseBackground src
  let ts := VE.Norms.Flagged.pyTargets src.D
  let accepted := fun (t : String × List String × VE.Formula) =>
    match targetPackage k profiles environment norms packages baseBg t with
    | some c => k.valid c (baseBg.map k.embed) (k.embed (VE.Norms.targetConclusion t))
    | none => false
  let failure := ts.find? (fun t => !accepted t)
  let detail := failure.map fun t =>
    if VE.Norms.Replay.outerBound profiles environment norms packages t.1 then
      s!"invalid certificate for {t.1}" else s!"missing certificate for {t.1}"
  let free := failure.isNone
  (Json.mkObj ([("verdict", .str (if free then "CONFLICT-FREE" else "UNKNOWN")),
    ("targets", toJson (ts.map (·.1)))] ++
    match detail with
    | some d => [("detail", .str d)]
    | none => []), free)

def runCase (j : Json) : Except String Json := do
  let id ← stringField j "id"
  let kind ← VE.Route.Run.caseKind j
  let environment ← j.getObjVal? "environment"
  let norms := j.getObjValD "norms"
  let profiles ← VE.Route.Gate.profilesOf environment
  let view ← folView environment
  if kind == "norms-elaborate" then
    let src ← VE.Norms.Wire.decodeSource view norms (flags := true)
    return VE.Route.Wire.ok id (VE.Norms.Flagged.regenerated src)
  if kind == "norms-conflict" && (j.getObjVal? "witness").toBool then
    let witness ← j.getObjVal? "witness"
    let baseView ← VE.Norms.Replay.baseEnvironmentJson view
    let model ← viewModel baseView (← witness.getObjVal? "model")
    let ⟨src, w⟩ ← VE.Norms.Flagged.replayWitness
      ((j.setObjVal! "environment" view).setObjVal! "witness" (witness.setObjVal! "model" model))
    return VE.Route.Wire.ok id [("verdict", .str (if w.conflict then "CONFLICT" else "UNKNOWN")),
      ("target", .str w.target.1), ("targets", toJson ((VE.Norms.targets src.D).map (·.1)))]
  let src ← VE.Norms.Wire.decodeSource view norms (flags := true)
  if kind == "norms-certificate" then
    let canonical ← VE.Norms.Wire.canonicalEnvironmentJson environment
    let regenerated := VE.Norms.Flagged.flagPremises src ++ VE.Norms.background src.D ++
      VE.Norms.elaborate src.D.T
    let (valid, steps) ← match ← decodeFamily environment with
      | .closure E => certificateCase (closureChecker E) profiles canonical regenerated j
      | .core E => certificateCase (coreChecker E) profiles canonical regenerated j
      | .order E => certificateCase (orderChecker E) profiles canonical regenerated j
    return VE.Route.Wire.ok id [("valid", .bool valid),
      ("background", toJson (VE.Norms.Flagged.flagPremises src ++ VE.Norms.background src.D).length),
      ("layers", toJson (VE.Norms.elaborate src.D.T).length), ("steps", toJson steps)]
  if kind == "norms-conflict" then
    let (answer, _) ← match ← decodeFamily (← VE.Norms.Replay.baseEnvironmentJson environment) with
      | .closure E => pure (conflictCase (closureChecker E) profiles environment norms src j)
      | .core E => pure (conflictCase (coreChecker E) profiles environment norms src j)
      | .order E => pure (conflictCase (orderChecker E) profiles environment norms src j)
    return (answer.setObjVal! "id" (.str id)).setObjVal! "status" (.str "ok")
  throw s!"UnsupportedProfile: case kind {kind} is not available on the family norms route"

/-! ## What an accepted certificate proves -/

theorem closure_norms_certificate_sound (E : VE.Environment) (regenerated : List VE.Formula)
    (ps : List VE.Closure.Formula) (φ : VE.Closure.Formula) (c : VE.Closure.Tableau.Certificate)
    (h : (closureChecker E).valid c (regenerated.map VE.Closure.embed ++ ps) φ = true) :
    VE.Closure.Entails.{u} E (regenerated.map VE.Closure.embed ++ ps) φ :=
  VE.Closure.Tableau.checkCertificate_sound E _ φ c h

theorem core_norms_certificate_sound (E : VE.Environment) (regenerated : List VE.Formula)
    (ps : List VE.Core.Formula) (φ : VE.Core.Formula) (c : VE.Core.Tableau.Certificate)
    (h : (coreChecker E).valid c (regenerated.map VE.Core.embed ++ ps) φ = true) :
    VE.Core.Entails.{u} E (regenerated.map VE.Core.embed ++ ps) φ :=
  VE.Core.Tableau.checkCertificate_sound E _ φ c h

theorem order_norms_certificate_sound (E : VE.Order.Environment) (regenerated : List VE.Formula)
    (ps : List VE.Order.Formula) (φ : VE.Order.Formula) (c : VE.Order.Tableau.Certificate)
    (h : (orderChecker E).valid c (regenerated.map VE.Order.embed ++ ps) φ = true) :
    VE.Order.Entails.{u} E (regenerated.map VE.Order.embed ++ ps) φ :=
  VE.Order.Tableau.checkCertificate_sound E _ φ c h

/-- An accepted conflict-target certificate: over the base environment, the
embedded base Background entails the embedded `∀x̄. ¬conflict`. -/
theorem closure_conflict_target_sound (E : VE.Environment) (baseBg : List VE.Formula)
    (t : String × List String × VE.Formula) (c : VE.Closure.Tableau.Certificate)
    (h : (closureChecker E).valid c (baseBg.map VE.Closure.embed)
      (VE.Closure.embed (VE.Norms.targetConclusion t)) = true) :
    VE.Closure.Entails.{u} E (baseBg.map VE.Closure.embed) (VE.Closure.embed (VE.Norms.targetConclusion t)) :=
  VE.Closure.Tableau.checkCertificate_sound E _ _ c h

theorem core_conflict_target_sound (E : VE.Environment) (baseBg : List VE.Formula)
    (t : String × List String × VE.Formula) (c : VE.Core.Tableau.Certificate)
    (h : (coreChecker E).valid c (baseBg.map VE.Core.embed)
      (VE.Core.embed (VE.Norms.targetConclusion t)) = true) :
    VE.Core.Entails.{u} E (baseBg.map VE.Core.embed) (VE.Core.embed (VE.Norms.targetConclusion t)) :=
  VE.Core.Tableau.checkCertificate_sound E _ _ c h

theorem order_conflict_target_sound (E : VE.Order.Environment) (baseBg : List VE.Formula)
    (t : String × List String × VE.Formula) (c : VE.Order.Tableau.Certificate)
    (h : (orderChecker E).valid c (baseBg.map VE.Order.embed)
      (VE.Order.embed (VE.Norms.targetConclusion t)) = true) :
    VE.Order.Entails.{u} E (baseBg.map VE.Order.embed) (VE.Order.embed (VE.Norms.targetConclusion t)) :=
  VE.Order.Tableau.checkCertificate_sound E _ _ c h

/-- The mode's reported answer. -/
def runCaseReported (j : Json) : Json := Standalone.reported runCase j

end VE.Service.FamilyNorms
