/-! ## 10.1 D-all: today's gate against Python on every sorted list of registered profiles -/

/-- The registry in code point order. -/
def registrySorted : List String :=
  ["alternatives@0", "closure@0", "data@0", "definitions@0", "documents@1", "nary@0", "norm-defaults@0", "norms@0", "order@0", "relational-fol@0", "reports@0", "rights@0", "risk@0", "soft-norms@0", "speech-acts@0", "time@0"]

#guard decide (registrySorted.Pairwise (· < ·))
#guard registrySorted.length == registered.length && registrySorted.all registered.contains &&
  registered.all registrySorted.contains

/-- List `m`: the registered profiles whose bit is set in `m`, in code point order. -/
def maskList (m : Nat) : List String :=
  (List.range registrySorted.length).filterMap (fun j => if m.testBit j then registrySorted[j]? else none)

/-- The position of a code character in the alphabet `0-9a-zA-Z`. -/
def codeIndex (c : Char) : Nat :=
  if c.isDigit then c.toNat - '0'.toNat
  else if c.isLower then c.toNat - 'a'.toNat + 10
  else c.toNat - 'A'.toNat + 36

/-- `ok` when today's gate accepts, its text when it rejects. -/
def todayText (ps : List String) : String :=
  match today ps with
  | .ok _ => "ok"
  | .error e => e

def todayTexts : List String :=
  ["UnsupportedProfile: Missing profile relational-fol@0",
   "UnsupportedProfile: alternatives@0 requires norms@0",
   "ok",
   "UnsupportedProfile: Unsupported profile nary@0 without closure@0",
   "UnsupportedProfile: norm-defaults@0 requires norms@0",
   "UnsupportedProfile: Unsupported profile combination closure@0 x order@0",
   "UnsupportedProfile: Unsupported profile combination nary@0 x order@0",
   "UnsupportedProfile: reports@0 requires the fol checker, not closure@0",
   "UnsupportedProfile: reports@0 with data@0 layers",
   "UnsupportedProfile: reports@0 with definitions@0 layers",
   "UnsupportedProfile: reports@0 requires the fol checker, not nary@0",
   "UnsupportedProfile: reports@0 with norms@0 layers",
   "UnsupportedProfile: reports@0 requires the fol checker, not order@0",
   "UnsupportedProfile: rights@0 requires soft-norms@0",
   "UnsupportedProfile: risk@0 requires alternatives@0",
   "UnsupportedProfile: risk@0 with norm-defaults@0 is not implemented",
   "UnsupportedProfile: the risk norms route admits FOL documents only",
   "UnsupportedProfile: alternatives@0 with soft-norms@0",
   "UnsupportedProfile: soft-norms@0 requires norms@0",
   "UnsupportedProfile: speech-acts@0 requires norms@0",
   "UnsupportedProfile: speech-acts@0 with alternatives@0",
   "UnsupportedProfile: speech-acts@0 with closure@0",
   "UnsupportedProfile: speech-acts@0 with data@0",
   "UnsupportedProfile: speech-acts@0 with definitions@0",
   "UnsupportedProfile: speech-acts@0 with documents@1",
   "UnsupportedProfile: speech-acts@0 with nary@0",
   "UnsupportedProfile: speech-acts@0 with norm-defaults@0",
   "UnsupportedProfile: speech-acts@0 with order@0",
   "UnsupportedProfile: speech-acts@0 with reports@0",
   "UnsupportedProfile: speech-acts@0 with rights@0",
   "UnsupportedProfile: speech-acts@0 with soft-norms@0",
   "UnsupportedProfile: speech-acts@0 with time@0"]

def todayCodes : String := ""

#guard todayTexts.length ≤ 62 && todayCodes.length == 2 ^ registrySorted.length
#guard (List.range (2 ^ registrySorted.length)).all (fun m =>
  todayTexts[codeIndex (todayCodes.toList.toArray.getD m ' ')]? == some (todayText (maskList m)))

/-! ## AR-10: the profile table runs today's gate

On every list of D-all, the table answers as `dispatch` and its base rows as `today` (`gate_legacy` and
`baseGate_today` prove both); a list with an unregistered profile is refused by that profile before any row's check
(DELTA row 1 of docs/ar-10a: `today` names it after the alternatives and risk checks). -/

#guard (List.range (2 ^ registrySorted.length)).all fun m =>
  gateOf profileTable (maskList m) == dispatch (maskList m) && gateOf baseRows (maskList m) == today (maskList m)
#guard gateOf profileTable ["alternatives@0", "relational-fol@0", "zzz@0"] ==
  .error "UnsupportedProfile: Unsupported profile zzz@0"
#guard today ["alternatives@0", "relational-fol@0", "zzz@0"] == .error "UnsupportedProfile: alternatives@0 requires norms@0"
#guard gateOf baseRows ["norms@0", "relational-fol@0", "ve.discourse@1"] ==
  .error "UnsupportedProfile: Unsupported profile ve.discourse@1"
#guard gateOf profileTable ["norms@0", "relational-fol@0", "ve.discourse@1"] == .ok .discourse
#guard environmentProfiles.length == 18 && !environmentProfiles.contains "judgments@0" &&
  !environmentProfiles.contains "cardinality@0" &&
  environmentProfiles.getLast? == some "readings@1"
#guard legacyProfiles.all (fun p => profileTable.any (·.profile == p)) &&
  (profileTable.map (·.profile)).eraseDups.filter (!legacyProfiles.contains ·) ==
    ["acts@0", "judgments@0", "cardinality@0", "scope@0"]

/-! JT-2's row (judgment-terms-PLAN.md JT-2): `judgments@0` requires `documents@1`, refuses nothing and keeps the
route of the list without it (`gate_judgments`). -/
#guard gateOf profileTable ["judgments@0", "relational-fol@0"] ==
  .error "UnsupportedProfile: judgments@0 requires documents@1"
#guard gateOf profileTable ["documents@1", "judgments@0", "relational-fol@0"] == .ok .frozen
#guard gateOf profileTable ["definitions@0", "documents@1", "judgments@0", "norm-defaults@0", "norms@0",
  "readings@1", "relational-fol@0"] == .ok .readings
#guard gateOf profileTable ["documents@1", "judgments@0", "relational-fol@0", "zzz@0"] ==
  .error "UnsupportedProfile: Unsupported profile zzz@0"

/-! act-phrases 4.4 (AP-1): `acts@0` requires `norms@0`, keeps the route of the list without it (`gate_acts`) and
refuses every route whose norm decoder it does not hook, each with its own text (D-30). -/
#guard gateOf profileTable ["acts@0", "relational-fol@0"] == .error "UnsupportedProfile: acts@0 requires norms@0"
#guard gateOf profileTable ["acts@0", "norms@0", "relational-fol@0"] == .ok .norms
#guard gateOf profileTable ["acts@0", "definitions@0", "norm-defaults@0", "norms@0", "relational-fol@0"] ==
  .ok .normDefaults
#guard gateOf profileTable ["acts@0", "norms@0", "readings@1", "relational-fol@0"] == .ok .readings
#guard gateOf baseRows ["acts@0", "data@0", "norms@0", "relational-fol@0", "time@0"] == .ok .norms
#guard [(["acts@0", "norms@0", "relational-fol@0", "soft-norms@0"], "acts@0 with soft-norms@0"),
    (["acts@0", "alternatives@0", "norms@0", "relational-fol@0"], "acts@0 with alternatives@0"),
    (["acts@0", "norms@0", "relational-fol@0", "speech-acts@0"], "acts@0 with speech-acts@0"),
    (["acts@0", "closure@0", "norms@0", "relational-fol@0"], "acts@0 on the closure family"),
    (["acts@0", "norms@0", "order@0", "relational-fol@0"], "acts@0 on the order family"),
    (["acts@0", "norms@0", "relational-fol@0", "ve.discourse@1"], "acts@0 with ve.discourse@1")].all fun (ps, t) =>
  gateOf profileTable ps == .error s!"UnsupportedProfile: {t} is not implemented"
-- `rights@0` requires `soft-norms@0`, which `acts@0` refuses first; its own refusal is the row's data.
#guard gateOf profileTable ["acts@0", "norms@0", "relational-fol@0", "rights@0", "soft-norms@0"] ==
    .error "UnsupportedProfile: acts@0 with soft-norms@0 is not implemented" &&
  actsRefuses.lookup "rights@0" == some "acts@0 with rights@0 is not implemented" && actsRefuses.length == 7

/-- `TableAdmits` reads the refusals: soft-norms@0 is refused with alternatives@0, and admitted with norms@0. -/
example : ¬ TableAdmits profileTable ["alternatives@0", "norms@0", "relational-fol@0", "soft-norms@0"] := by
  unfold TableAdmits; decide
example : TableAdmits profileTable ["norms@0", "relational-fol@0", "soft-norms@0"] := by
  unfold TableAdmits; decide

/-- The wrappers with every profile a route or a wrapper reads: 4,096 sorted lists. -/
def stackSorted : List String :=
  ["alternatives@0", "norm-defaults@0", "norms@0", "readings@1", "relational-fol@0", "reports@0", "right-clauses@0",
   "rights@0", "risk@0", "soft-norms@0", "speech-acts@0", "ve.discourse@1"]

#guard (List.range (2 ^ stackSorted.length)).all fun m =>
  let ps := (List.range stackSorted.length).filterMap fun j => if m.testBit j then stackSorted[j]? else none
  gateOf profileTable ps == dispatch ps

