import VE.Readings.Faithful
import VE.Readings.Strings

/-! The superposed document without open sets, and the shape of the slot (docs/spec/composition-s2.md 8.4:
`sup_no_sets`, `slot_wellLabelled`, `slot_wellFormed`).

Without an open set the copy mapping is the identity (every name has one copy, itself; `over_drop` puts a `cites`
key `over:<n>` back together), the frame keeps its environment, and every generated key of `sup D` is generated by
the fixed units alone, so no reading premise is emitted. -/
namespace VE.Readings
open VE.Norms (Sat envAt size)
open VE.SoftNorms (SoftNode SoftDoc soften)
open VE.Rights (RightsDoc correlate limPremises limPremisesLabelled)
open VE.Compose (Content Labelled)
universe u

/-! ## No open set -/

section NoSets
variable {D : Doc} (h : D.sets = [])
include h

theorem copies_no_sets (n : String) : copies D n = [n] := by
  simp [copies, h]

theorem copyOver_no_sets (N : SoftNode) : copyOver D N = N := by
  have hc : copies D = fun n => [n] := funext (copies_no_sets h)
  have hf : ∀ l : List String, l.flatMap (fun n => [n]) = l := by
    intro l; induction l with
    | nil => rfl
    | cons x l ih => simp [List.flatMap_cons, ih]
  simp only [copyOver, hc, hf]

theorem copyCites_no_sets (cs : List (String × List String)) : copyCites D cs = cs := by
  unfold copyCites
  induction cs with
  | nil => rfl
  | cons kv cs ih =>
    rw [List.flatMap_cons, ih]
    split
    · rename_i hs
      rw [copies_no_sets h]
      simp only [List.map_cons, List.map_nil, List.singleton_append, List.cons.injEq, and_true]
      rw [over_drop hs]
    · rfl

theorem copyContent_no_sets (c : Content) : copyContent D c = c := by
  cases c with
  | norm N => simp only [copyContent, copyOver_no_sets h]
  | _ => rfl

theorem supFrame_no_sets : supFrame D = D.frame := by
  have : choiceEnv D D.frame.soft.E = D.frame.soft.E := by simp [choiceEnv, h]
  simp only [supFrame, this]

theorem not_set_of_no_sets {it : Item} (hit : it ∈ D.items) : isSet it = false := by
  cases it with
  | set R => exact absurd (mem_sets.mpr hit) (by rw [h]; simp)
  | _ => rfl

theorem sup_fold_no_sets : ∀ (l : List Item), (∀ it ∈ l, it ∈ D.items) →
    ∀ (acc : RightsDoc × List VE.Formula) (k : Nat),
      (l.foldl (supStep D) (acc, k)).1 = l.foldl (buildStep (fun _ => true) (fun _ => none)) acc
  | [], _, _, _ => rfl
  | it :: l, hl, acc, k => by
    simp only [List.foldl_cons]
    have hit := hl it List.mem_cons_self
    have ih := sup_fold_no_sets l (fun x hx => hl x (List.mem_cons_of_mem _ hx))
    cases it with
    | fixed u c cs =>
      have := ih ((place acc.1 (copyContent D c) (copyCites D cs), acc.2 ++ asserted c)) k
      simp only [supStep, buildStep, if_true]
      rw [this, copyContent_no_sets h, copyCites_no_sets h]
    | bar u b =>
      have := ih (({ acc.1 with bars := acc.1.bars ++ [b] }, acc.2)) k
      simp only [supStep, buildStep, if_true]
      exact this
    | set R => exact absurd (not_set_of_no_sets h hit) (by simp [isSet])

theorem sup_no_sets_doc : sup D = build D (fun _ => true) (fun _ => none) := by
  rw [sup_eq, build_eq, supFrame_no_sets h]
  exact sup_fold_no_sets h D.items (fun _ hx => hx) _ 0

theorem origin_no_sets (n : String) : origin D n = none := by
  simp [origin, h]

end NoSets

theorem mem_genKeys_outweighs {X : RightsDoc} {g : GenKey × String × List String} (hg : g ∈ genKeys X)
    {a L H : String} (hk : g.1 = .outweighs a L H) : (a, L, H) ∈ VE.SoftNorms.outweighsTriples (correlate X) := by
  simp only [genKeys, List.mem_append, List.mem_map, List.mem_filter, List.mem_flatMap] at hg
  rcases hg with (((((⟨e, _, rfl⟩ | ⟨e, _, π, _, rfl⟩) | ⟨x, hx, rfl⟩) | ⟨k, _, rfl⟩) | ⟨k, _, rfl⟩) | hb)
  · cases hk
  · cases hk
  · simp only [GenKey.outweighs.injEq] at hk
    obtain ⟨rfl, rfl, rfl⟩ := hk
    exact hx
  · cases hk
  · cases hk
  · split at hb
    · cases hb
    · obtain ⟨m, _, rfl⟩ := List.mem_map.mp hb
      cases hk

theorem fixedGenerated_no_sets {D : Doc} (h : D.sets = []) {g : GenKey × String × List String}
    (hg : g ∈ genKeys (sup D).1) : fixedGenerated D g.1 = true := by
  unfold fixedGenerated
  cases hk : g.1 with
  | excepted r b => simp [owners, origin_no_sets h]
  | off r b π => simp [owners, origin_no_sets h]
  | outweighs a L H =>
    obtain ⟨_, M, N, hp, hcmp, ht⟩ := mem_outweighsTriples.mp (mem_genKeys_outweighs hg hk)
    simp only [owners, List.contains_iff_mem, VE.SoftNorms.mem_dedup, List.mem_filterMap]
    refine ⟨(M, N), hp, ?_⟩
    simp only [hcmp, ht, beq_self_eq_true, Bool.and_self, if_true, pairOwner, origin_no_sets h]
    rfl
  | lim L a => simp [owners]
  | cond L a c => simp [owners]
  | aimed m => simp [owners]

theorem choiceLabelled_no_sets {D : Doc} (h : D.sets = []) : choiceLabelled D = [] := by
  have h1 : onePremises D = [] := by simp [onePremises, h]
  have h2 : quietOwn D = [] := by simp [quietOwn, h]
  have h3 : quietShared D = [] := by
    unfold quietShared
    rw [List.map_eq_nil_iff, List.filter_eq_nil_iff]
    intro g hg
    simp [fixedGenerated_no_sets h hg]
  have h4 : couplingPremises D = [] := by
    unfold couplingPremises
    rw [List.filterMap_eq_nil_iff]
    intro K _
    simp [h]
  have h5 : narrowingPremises D = [] := by
    unfold narrowingPremises
    rw [List.filterMap_eq_nil_iff]
    intro N _
    simp [inForce, h]
  simp [choiceLabelled, h1, h2, h3, h4, h5]

/-- 4.7: without an open set, `sup D` is the document of every fixed unit and `Choice_D` is empty. -/
theorem sup_no_sets (D : Doc) (h : D.sets = []) :
    sup D = build D (fun _ => true) (fun _ => none) ∧ choicePremises D = [] ∧ slotP D = limPremises (sup D).1 := by
  refine ⟨sup_no_sets_doc h, ?_, ?_⟩
  · simp [choicePremises, choiceLabelled_no_sets h, Labelled.formulas]
  · simp [slotP, slotLabelled, choiceLabelled_no_sets h, gatedRel, Labelled.formulas, limPremises]

end VE.Readings
