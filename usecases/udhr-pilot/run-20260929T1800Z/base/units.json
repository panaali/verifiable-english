      ],
      "status": "LABELLED",
      "source": "# Universal Declaration of Human Rights",
      "old_unit": "u001",
      "previous_unit": "u001"
    },
    {
      "id": "u002",
      "article": "Preamble",
      "span": [
        41,
        54
      ],
      "status": "LABELLED",
      "source": "## Preamble",
      "old_unit": "u002",
      "previous_unit": "u002"
    },
    {
      "id": "u003",
      "article": "Preamble",
      "span": [
        54,
        236
      ],
      "status": "UNFORMALISED",
      "source": "Whereas recognition of the inherent dignity and of the equal and inalienable rights of all members of the human family is the foundation of freedom, justice and peace in the world,",
      "missing_feature": "causation",
      "open_terms": [
        "inherent_dignity",
        "inalienable_rights",
        "justice"
      ],
      "old_unit": "u003",
      "previous_unit": "u003",
      "semantic_kind": "evaluative causal claim"
    },
    {
      "id": "u004",
      "article": "Preamble",
      "span": [
        236,
        363
      ],
      "status": "UNFORMALISED",
      "source": "Whereas disregard and contempt for human rights have resulted in barbarous acts which have outraged the conscience of mankind,",
      "missing_feature": "causation",
      "old_unit": "u004",
      "previous_unit": "u004",
      "semantic_kind": "causal claim with evaluative words"
    },
    {
      "id": "u005",
      "article": "Preamble",
      "span": [
        363,
        552
      ],
      "status": "UNFORMALISED",
      "source": "and the advent of a world in which human beings shall enjoy freedom of speech and belief and freedom from fear and want has been proclaimed as the highest aspiration of the common people,",
      "missing_feature": "attribution",
      "old_unit": "u005",
      "previous_unit": "u005",
      "semantic_kind": [
        "attributed",
        "unstated",
        "says",
        "asserted"
      ]
    },
    {
      "id": "u006",
      "article": "Preamble",
      "span": [
        552,
        747
      ],
      "status": "UNFORMALISED",
      "source": "Whereas it is essential, if man is not to be compelled to have recourse, as a last resort, to rebellion against tyranny and oppression, that human rights should be protected by the rule of law,",
      "missing_feature": "modality/belief",
      "open_terms": [
        "essential"
      ],
      "old_unit": "u006",
      "previous_unit": "u006",
      "semantic_kind": "evaluative conditional claim with should"
    },
    {
      "id": "u007",
      "article": "Preamble",
      "span": [
        747,
        838
      ],
      "status": "UNFORMALISED",
      "source": "Whereas it is essential to promote the development of friendly relations between nations,",
      "missing_feature": "modality/belief",
      "open_terms": [
        "essential"
      ],
      "old_unit": "u007",
      "previous_unit": "u007",
      "semantic_kind": "evaluative claim"
    },
    {
      "id": "u008a",
      "article": "Preamble",
      "span": [
        838,
        1037
      ],
      "status": "UNFORMALISED",
      "source": "Whereas the peoples of the United Nations have in the Charter reaffirmed their faith in fundamental human rights, in the dignity and worth of the human person and in the equal rights of men and women",
      "missing_feature": "attribution",
      "old_unit": "u008",
      "previous_unit": "u008a",
      "semantic_kind": [
        "attributed",
        "peoples_of_un",
        "believes",
        "asserted"
      ]
    },
    {
      "id": "u008b",
      "article": "Preamble",
      "span": [
        1037,
        1134
      ],
      "status": "UNFORMALISED",
      "source": "and have determined to promote social progress and better standards of life in larger freedom,",
      "missing_feature": "attribution",
      "old_unit": "u008",
      "previous_unit": "u008b",
      "semantic_kind": [
        "attributed",
        "peoples_of_un",
        "intends",
        "norm"
      ]
    },
    {
      "id": "u009",
      "article": "Preamble",
      "span": [
        1134,
        1330
      ],
      "status": "UNFORMALISED",
      "source": "Whereas Member States have pledged themselves to achieve, in co-operation with the United Nations, the promotion of universal respect for and observance of human rights and fundamental freedoms,",
      "missing_feature": "attribution",
      "old_unit": "u009",
      "previous_unit": "u009",
      "semantic_kind": [
        "attributed",
        "member_states",
        "promised",
        "norm"
      ]
    },
    {
      "id": "u010",
      "article": "Preamble",
      "span": [
        1330,
        1462
      ],
      "status": "UNFORMALISED",
      "source": "Whereas a common understanding of these rights and freedoms is of the greatest importance for the full realization of this pledge,",
      "open_terms": [
        "greatest_importance"
      ],
      "old_unit": "u010",
      "missing_feature": "other:evaluative_open_claim",
      "previous_unit": "u010",
      "semantic_kind": "evaluative claim"
    },
    {
      "id": "u011",
      "article": "Preamble",
      "span": [
        1462,
        1479
      ],
      "status": "LABELLED",
      "source": "Now, therefore,",
      "old_unit": "u011",
      "previous_unit": "u011"
    },
    {
      "id": "u012",
      "article": "Preamble",
      "span": [
        1479,
        1502
      ],
      "status": "LABELLED",
      "source": "The General Assembly,",
      "old_unit": "u012",
      "previous_unit": "u012"
    },
    {
      "id": "u013a",
      "article": "Preamble",
      "span": [
        1502,
        1622
      ],
      "status": "UNFORMALISED",
      "source": "Proclaims this Universal Declaration of Human Rights as a common standard of achievement for all peoples and all nations",
      "missing_feature": "norms",
      "old_unit": "u013",
      "previous_unit": "u013a",
      "semantic_kind": [
        "attributed",
        "general_assembly",
        "says",
        "norm"
      ]
    },
    {
      "id": "u013ba",
      "article": "Preamble",
      "span": [
        1622,
        1817
      ],
      "status": "UNFORMALISED",
      "source": ", to the end that every individual and every organ of society, keeping this Declaration constantly in mind, shall strive by teaching and education to promote respect for these rights and freedoms",
      "missing_feature": "norms",
      "old_unit": "u013",
      "previous_unit": "u013b"
    },
    {
      "id": "u013bb",
      "article": "Preamble",
      "span": [
        1817,
        2058
      ],
      "status": "UNFORMALISED",
      "source": "and by progressive measures, national and international, to secure their universal and effective recognition and observance, both among the peoples of Member States themselves and among the peoples of territories under their jurisdiction.",
      "missing_feature": "norms",
      "old_unit": "u013",
      "previous_unit": "u013b"
    },
    {
      "id": "u014",
      "article": "Article 1",
      "span": [
        2058,
        2072
      ],
      "status": "LABELLED",
      "source": "## Article 1",
      "old_unit": "u014",
      "previous_unit": "u014"
    },
    {
      "id": "u015",
      "article": "Article 1",
      "span": [
        2072,
        2136
      ],
      "status": "UNFORMALISED",
      "source": "All human beings are born free and equal in dignity and rights.",
      "missing_feature": "time",
      "old_unit": "u015",
      "previous_unit": "u015"
    },
    {
      "id": "u016",
      "article": "Article 1",
      "span": [
        2136,
        2179
      ],
      "status": "UNFORMALISED",
      "source": "They are endowed with reason and conscience",
      "missing_feature": "other:metaphorical_endowment",
      "old_unit": "u016",
      "previous_unit": "u016"
    },
    {
      "id": "u017",
      "article": "Article 1",
      "span": [
        2179,
        2244
      ],
      "status": "UNFORMALISED",
      "source": "and should act towards one another in a spirit of brotherhood.",
      "reading_set": "rs_u017",
      "unresolved_features": [
        "norms",
        "defaults"
      ],
      "old_unit": "u017",
      "missing_feature": "norms",
      "reading_elaboration": "pending; candidates have no VE content",
      "open_terms": [
        "spirit_of_brotherhood"
      ],
      "previous_unit": "u017",
      "audit_gap": "Both candidate forces remain unformalised. Reciprocal actors, the act, and the open 'spirit of brotherhood' standard have no checked content; force separation is unverified.",
      "audit_disposition": "unrepaired semantic gap; excluded from claimed and audit-verified coverage"
    },
    {
      "id": "u018",
      "article": "Article 2",
      "span": [
        2244,
        2258
      ],
      "status": "LABELLED",
      "source": "## Article 2",
      "old_unit": "u018",
      "previous_unit": "u018"
    },
    {
      "id": "u019",
      "article": "Article 2",
      "span": [
        2258,
        2509
      ],
      "status": "UNFORMALISED",
      "source": "Everyone is entitled to all the rights and freedoms set forth in this Declaration, without distinction of any kind, such as race, colour, sex, language, religion, political or other opinion, national or social origin, property, birth or other status.",
      "missing_feature": "norms",
      "old_unit": "u019",
      "previous_unit": "u019"
    },
    {
      "id": "u020",
      "article": "Article 2",
      "span": [
        2509,
        2776
      ],
      "status": "UNFORMALISED",
      "source": "Furthermore, no distinction shall be made on the basis of the political, jurisdictional or international status of the country or territory to which a person belongs, whether it be independent, trust, non-self-governing or under any other limitation of sovereignty.",
      "missing_feature": "norms",
      "old_unit": "u020",
      "previous_unit": "u020"
    },
    {
      "id": "u021",
      "article": "Article 3",
      "span": [
        2776,
        2790
      ],
      "status": "LABELLED",
      "source": "## Article 3",
      "old_unit": "u021",
      "previous_unit": "u021"
    },
    {
      "id": "u022",
      "article": "Article 3",
      "span": [
        2790,
        2855
      ],
      "status": "UNFORMALISED",
      "source": "Everyone has the right to life, liberty and security of person.",
      "missing_feature": "norms",
      "old_unit": "u022",
      "previous_unit": "u022"
    },
    {
      "id": "u023",
      "article": "Article 4",
      "span": [
        2855,
        2869
      ],
      "status": "LABELLED",
      "source": "## Article 4",
      "old_unit": "u023",
      "previous_unit": "u023"
    },
    {
      "id": "u024",
      "article": "Article 4",
      "span": [
        2869,
        2915
      ],
      "status": "UNFORMALISED",
      "source": "No one shall be held in slavery or servitude;",
      "missing_feature": "norms",
      "old_unit": "u024",
      "previous_unit": "u024"
    },
    {
      "id": "u025",
      "article": "Article 4",
      "span": [
        2915,
        2984
      ],
      "status": "UNFORMALISED",
      "source": "slavery and the slave trade shall be prohibited in all their forms.",
      "missing_feature": "norms",
      "old_unit": "u025",
      "previous_unit": "u025"
    },
    {
      "id": "u026",
      "article": "Article 5",
      "span": [
        2984,
        2998
      ],
      "status": "LABELLED",
      "source": "## Article 5",
      "old_unit": "u026",
      "previous_unit": "u026"
    },
    {
      "id": "u027",
      "article": "Article 5",
      "span": [
        2998,
        3095
      ],
      "status": "UNFORMALISED",
      "source": "No one shall be subjected to torture or to cruel, inhuman or degrading treatment or punishment.",
      "missing_feature": "norms",
      "old_unit": "u027",
      "previous_unit": "u027"
    },
    {
      "id": "u028",
      "article": "Article 6",
      "span": [
        3095,
        3109
      ],
      "status": "LABELLED",
      "source": "## Article 6",
      "old_unit": "u028",
      "previous_unit": "u028"
    },
    {
      "id": "u029",
      "article": "Article 6",
      "span": [
        3109,
        3187
      ],
      "status": "UNFORMALISED",
      "source": "Everyone has the right to recognition everywhere as a person before the law.",
      "missing_feature": "norms",
      "old_unit": "u029",
      "previous_unit": "u029"
    },
    {
      "id": "u030",
      "article": "Article 7",
      "span": [
        3187,
        3201
      ],
      "status": "LABELLED",
      "source": "## Article 7",
      "old_unit": "u030",
      "previous_unit": "u030"
    },
    {
      "id": "u031",
      "article": "Article 7",
      "span": [
        3201,
        3229
      ],
      "status": "UNFORMALISED",
      "source": "All are equal before the law",
      "open_terms": [
        "equal_before_law"
      ],
      "old_unit": "u031",
      "missing_feature": "norms",
      "previous_unit": "u031"
    },
    {
      "id": "u032",
      "article": "Article 7",
      "span": [
        3229,
        3306
      ],
      "status": "UNFORMALISED",
      "source": "and are entitled without any discrimination to equal protection of the law.",
      "missing_feature": "norms",
      "old_unit": "u032",
      "previous_unit": "u032"
    },
    {
      "id": "u033a",
      "article": "Article 7",
      "span": [
        3306,
        3402
      ],
      "status": "UNFORMALISED",
      "source": "All are entitled to equal protection against any discrimination in violation of this Declaration",
      "missing_feature": "norms",
      "old_unit": "u033",
      "previous_unit": "u033"
    },
    {
      "id": "u033b",
      "article": "Article 7",
      "span": [
        3402,
        3455
      ],
      "status": "UNFORMALISED",
      "source": "and against any incitement to such discrimination.",
      "missing_feature": "norms",
      "old_unit": "u033",
      "previous_unit": "u033"
    },
    {
      "id": "u034",
      "article": "Article 8",
      "span": [
        3455,
        3469
      ],
      "status": "LABELLED",
      "source": "## Article 8",
      "old_unit": "u034",
      "previous_unit": "u034"
    },
    {
      "id": "u035",
      "article": "Article 8",
      "span": [
        3469,
        3637
      ],
      "status": "UNFORMALISED",
      "source": "Everyone has the right to an effective remedy by the competent national tribunals for acts violating the fundamental rights granted him by the constitution or by law.",
      "missing_feature": "norms",
      "old_unit": "u035",
      "previous_unit": "u035"
    },
    {
      "id": "u036",
      "article": "Article 9",
      "span": [
        3637,
        3651
      ],
      "status": "LABELLED",
      "source": "## Article 9",
      "old_unit": "u036",
      "previous_unit": "u036"
    },
    {
      "id": "u037",
      "article": "Article 9",
      "span": [
        3651,
        3719
      ],
      "status": "UNFORMALISED",
      "source": "No one shall be subjected to arbitrary arrest, detention or exile.",
      "missing_feature": "norms",
      "open_terms": [
        "arbitrary"
      ],
      "old_unit": "u037",
      "previous_unit": "u037"
    },
    {
      "id": "u038",
      "article": "Article 10",
      "span": [
        3719,
        3734
      ],
      "status": "LABELLED",
      "source": "## Article 10",
      "old_unit": "u038",
      "previous_unit": "u038"
    },
    {
      "id": "u039",
      "article": "Article 10",
      "span": [
        3734,
        3935
      ],
      "status": "UNFORMALISED",
      "source": "Everyone is entitled in full equality to a fair and public hearing by an independent and impartial tribunal, in the determination of his rights and obligations and of any criminal charge against him.",
      "missing_feature": "norms",
      "open_terms": [
        "fair"
      ],
      "old_unit": "u039",
      "previous_unit": "u039"
    },
    {
      "id": "u040",
      "article": "Article 11",
      "span": [
        3935,
        3950
      ],
      "status": "LABELLED",
      "source": "## Article 11",
      "old_unit": "u040",
      "previous_unit": "u040"
    },
    {
      "id": "u041",
      "article": "Article 11",
      "span": [
        3950,
        4151
      ],
      "status": "UNFORMALISED",
      "source": "1. Everyone charged with a penal offence has the right to be presumed innocent until proved guilty according to law in a public trial at which he has had all the guarantees necessary for his defence.",
      "missing_feature": "norms",
      "old_unit": "u041",
      "previous_unit": "u041"
    },
    {
      "id": "u042",
      "article": "Article 11",
      "span": [
        4151,
        4351
      ],
      "status": "UNFORMALISED",
      "source": "2. No one shall be held guilty of any penal offence on account of any act or omission which did not constitute a penal offence, under national or international law, at the time when it was committed.",
      "missing_feature": "norms",
      "old_unit": "u042",
      "previous_unit": "u042"
    },
    {
      "id": "u043",
      "article": "Article 11",
      "span": [
        4351,
        4469
      ],
      "status": "UNFORMALISED",
      "source": "Nor shall a heavier penalty be imposed than the one that was applicable at the time the penal offence was committed.",
      "missing_feature": "norms",
      "old_unit": "u043",
      "previous_unit": "u043"
    },
    {
      "id": "u044",
      "article": "Article 12",
      "span": [
        4469,
        4484
      ],
      "status": "LABELLED",
      "source": "## Article 12",
      "old_unit": "u044",
      "previous_unit": "u044"
    },
    {
      "id": "u045a",
      "article": "Article 12",
      "span": [
        4484,
        4584
      ],
      "status": "UNFORMALISED",
      "source": "No one shall be subjected to arbitrary interference with his privacy, family, home or correspondence",
      "missing_feature": "norms",
      "open_terms": [
        "arbitrary"
      ],
      "old_unit": "u045",
      "previous_unit": "u045"
    },
    {
      "id": "u045b",
      "article": "Article 12",
      "span": [
        4584,
        4633
      ],
      "status": "UNFORMALISED",
      "source": ", nor to attacks upon his honour and reputation.",
      "missing_feature": "norms",
      "open_terms": [
        "arbitrary"
      ],
      "old_unit": "u045",
      "previous_unit": "u045"
    },
    {
      "id": "u046",
      "article": "Article 12",
      "span": [
        4633,
        4724
      ],
      "status": "UNFORMALISED",
      "source": "Everyone has the right to the protection of the law against such interference or attacks.",
      "missing_feature": "norms",
      "old_unit": "u046",
      "previous_unit": "u046"
    },
    {
      "id": "u047",
      "article": "Article 13",
      "span": [
        4724,
        4739
      ],
      "status": "LABELLED",
      "source": "## Article 13",
      "old_unit": "u047",
      "previous_unit": "u047"
    },
    {
