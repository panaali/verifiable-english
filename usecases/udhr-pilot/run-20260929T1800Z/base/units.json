      "article": "Article 13",
      "span": [
        4739,
        4837
      ],
      "status": "UNFORMALISED",
      "source": "1. Everyone has the right to freedom of movement and residence within the borders of each state.",
      "missing_feature": "norms",
      "old_unit": "u048",
      "previous_unit": "u048"
    },
