 "reasons_for_new_terms": {
  "adequate_standard_of_living": "'adequate' is evaluative: the standard of adequacy is not stated",
  "equal_pay_for_equal_work": "which work counts as equal and which pay as equal needs a comparison standard the text does not state; it also classifies work, so it is borderline",
  "free_education": "'free' needs a threshold the text does not state (does a nominal fee, or the cost of books, make education not free?); a graded word",
  "moral_and_material_interests": "which interests result from a production is a matter of classifying interests; no evaluative or threshold standard is involved",
  "natural_and_fundamental_group_unit_of_society": "carried from phase 1 (judgment): 'natural' and 'fundamental' need standards the text does not state; the record replaces the unused natural_group_unit placeholder (JT-0p item 2)",
  "of_greatest_importance_for": "carried from phase 1 (judgment): 'greatest importance' is graded and evaluative; the record replaces the unused greatest_importance placeholder (JT-0p item 2)",
  "own_country": "which country is a person's own is a matter of classifying the relation (the words do not say which relation); no evaluative standard"
 },
